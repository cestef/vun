//! Starting with the list that was kept, and giving everything back at the end.

..std.text.string.{ String };
..todo.ui.state.{ State };

Heap: type = std.os.heap.Heap;

/// The environment variable naming the user's directory.
home: &static [u8] = "HOME";
/// Where the list is kept, inside it.
file: &static [u8] = "/.local/share/todo.json";
/// Where the list is kept when there is no such directory.
fallback: &static [u8] = "todo.json";

impl State {
    /// The state of a session that starts from the list in the user's file, an empty one when there is none.
    open := (sys: &mut std.os.System) -> Result(State, todo.store.file.Problem(std.mem.alloc.Error)) {
        mut heap := Heap{};
        mut path := match State.locate(&mut heap, sys.env(home)) {
            .ok(p) => p,
            .err(e) => return .err(.allocation(e)),
        };
        list := match todo.store.file.load(Heap, &mut heap, sys, path.as_text()) {
            .ok(l) => l,
            .err(e) => {
                path.deinit(Heap, &mut heap);
                return .err(e);
            },
        };
        .ok(.{
            .sys = sys,
            .heap = heap,
            .path = path,
            .list = list,
            .filter = .all,
            .editing = .none,
            .widgets = .none
        })
    };

    /// The file the list is kept in.
    locate := (heap: &mut Heap, dir: ?&[u8]) -> Result(String, std.mem.alloc.Error) {
        parts: [2]&[u8] = match dir {
            .some(root) => [root, file],
            .none => [fallback, ""],
        };
        mut path := String.empty();
        for part in parts {
            match path.push_str(Heap, heap, part) {
                .ok(_) => {},
                .err(e) => {
                    path.deinit(Heap, heap);
                    return .err(e);
                },
            }
        }
        .ok(path)
    };

    close := (self: State) {
        .{ .sys = _, .heap = heap, .path = path, .list = list, .filter = _, .editing = _, .widgets = _ } := self;
        list.deinit(Heap, &mut heap);
        path.deinit(Heap, &mut heap);
    };
}
