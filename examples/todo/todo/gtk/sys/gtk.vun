//! Bindings to the C headers in `gtk`, written by `vun util ffi bind`: regenerate them
//! rather than edit them.

/// Its variants name the tags C gives them.
#[lang.layout.tag(lang.int.unsigned(32))]
GtkOrientation := enum {
    horizontal = 0,
    vertical = 1,
};

/// Its variants name the tags C gives them.
#[lang.layout.tag(lang.int.unsigned(32))]
GtkSelectionMode := enum {
    none = 0,
    single = 1,
    browse = 2,
    multiple = 3,
};

