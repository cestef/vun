//! The C library functions this program calls, and the heap they give it.

..std.mem.alloc.{ Allocator };

#[link.symbol("malloc"), abi.c]
malloc: unsafe (size: usize) -> *u8 = _;

#[link.symbol("free"), abi.c]
release: unsafe (p: *u8) = _;

#[link.symbol("getenv"), abi.c]
getenv: unsafe (name: *u8) -> *u8 = _;

/// The most `malloc` aligns what it gives.
align_max: usize = 16;

/// The C library's heap.
Heap := struct {};

impl Allocator for Heap {
    Error: type = std.mem.alloc.Error;
    alloc := (self, size, align) {
        if align > align_max { return .err(.exhausted); }
        p := unsafe { malloc(size) };
        if p.address() == 0 { .err(.exhausted) } else { .ok(p) }
    };
    free := (self, p, size, align) { unsafe { release(p); } };
}

/// The value of the environment variable `name`, a string for C; none when it is not set.
variable := (name: &static [u8]) -> ?&[u8] {
    found := unsafe { getenv(name.ptr()) };
    if found.address() == 0 { .none } else { .some(unsafe std.ffi.cstr.CStr.at(found).text()) }
};
