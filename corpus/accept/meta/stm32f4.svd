<?xml version="1.0" encoding="utf-8"?>
<device>
  <name>STM32F405</name>
  <peripherals>
    <peripheral>
      <name>GPIOA</name>
      <baseAddress>0x40020000</baseAddress>
      <registers>
        <register><name>MODER</name><addressOffset>0x0</addressOffset><size>32</size><resetValue>0xA8000000</resetValue></register>
        <register><name>ODR</name><addressOffset>0x14</addressOffset><size>32</size><resetValue>0x00000000</resetValue></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
