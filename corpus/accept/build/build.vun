//! Blinky: an LED and a serial echo on an STM32F4 (spec 12, section 2).

package := .{
    .name = "blinky",
    .id = 0x6a80_91f5_7c7f_07ff,
    .version = "0.3.1",
    .edition = 2026,
    .toolchain = "0.4.2",
    .include = .{ "build.vun", "blinky.vun", "blinky", "LICENSE" },
    .deps = .{
        .stm32f4 = .{ .version = "1.3.0", .hash = "blake3:k3f2aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", .urls = .{ "https://git.example.org/stm32f4/1.3.0.tar.gz" } },
        .util = .{ .path = "../util" },
    },
};

build := (b: &mut std.build.Build) {
    chip := b.dep(.stm32f4, .{ .variant = .f407 });
    fw := b.program(.{
        .root = "blinky/app.vun",
        .target = targets.bare.cortex_m4f,
        .deps = .{ .stm32f4 = chip },
        .memory = .{
            .flash = .{ .origin = 0x0800_0000, .len = 512 * 1024 },
            .ram = .{ .origin = 0x2000_0000, .len = 128 * 1024 },
        },
    });
    b.flash(fw, .probe(.{ .chip = "STM32F407VGTx" }));
    b.lints(.{ .{ std.lints.pedantic, .warn } });
};
