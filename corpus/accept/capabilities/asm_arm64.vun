//! Blocks of arm64 instructions (spec 07, section 6): registers named by width (`w0`, `x0`),
//! conditions and access widths as leading operands, barriers as words, and memory as
//! `mem(base, offset)`, written back before the access (`pre`) or after it (`post`).

add3 := (a: u64) -> u64 {
    mut r: u64 = 0;
    unsafe lang.arch.asm({ ..lang.arch.arm64.names; add(out(r), in(a), 3); });
    r
};

countdown := (n: u32) -> u32 {
    mut left: u32 = n;
    unsafe lang.arch.asm({
        ..lang.arch.arm64.names;
        top := here();
        subs(inout(left), inout(left), 1);
        b(ne, top);
    });
    left
};

loads := (p: *u8) -> u64 {
    mut r: u64 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.arm64.names;
        ldr(u8, w1, mem(in(p), 3));
        ldr(x2, pre(mem(in(p), 8)));
        ldr(x3, post(mem(in(p)), 16));
        add(out(r), x2, x3);
        dmb(ish);
        mrs(x4, nzcv);
    });
    r
};
