//! Blocks of WebAssembly instructions (spec 07, section 6): the stack machine written as the text
//! format has it, Vun values bound to locals (`in`, `out`, `inout`) and the stack as the
//! instructions leave it.

add := (a: i32, b: i32) -> i32 {
    mut sum: i32 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(a));
        local_get(in(b));
        i32_add();
        local_set(out(sum));
    });
    sum
};

/// An immediate is a constant pushed; a value of 64 bits is a local of its own class.
widen := (a: i32) -> i64 {
    mut wide: i64 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(a));
        i64_extend_i32_u();
        i64_const(1);
        i64_shl();
        local_set(out(wide));
    });
    wide
};

/// Memory is reached by an address on the stack and two immediates: the alignment as a power of
/// two, and an offset.
poke := (at: u32, value: u32) {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(at));
        local_get(in(value));
        i32_store(2, 0);
    });
};

/// `local_tee` writes a local and keeps the value; `drop` discards one.
count := (n: i32) -> i32 {
    mut m: i32 = n;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(n));
        i32_const(1);
        i32_add();
        local_tee(inout(m));
        drop();
    });
    m
};

/// After an instruction that ends the code, any stack goes.
never_returns := () -> never {
    unsafe {
        lang.arch.asm({
            ..lang.arch.wasm32.names;
            i32_const(1);
            unreachable();
        });
        lang.hint.unreachable()
    }
};

/// Blocks, loops and `if`s hold no values, and a branch counts the blocks it leaves outward from
/// the innermost; `br_if` branches on the value it pops. A variable bound `inout` in several
/// instructions is one local, read where a block wrote it.
tri := (n: i32) -> i32 {
    mut left: i32 = n;
    mut total: i32 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block();
        loop();
        local_get(inout(left));
        i32_eqz();
        br_if(1);
        local_get(inout(total));
        local_get(inout(left));
        i32_add();
        local_set(inout(total));
        local_get(inout(left));
        i32_const(1);
        i32_sub();
        local_set(inout(left));
        br(0);
        end();
        end();
    });
    total
};

/// `if_` pops the condition and runs up to `else_` or `end` when it is not zero.
pick := (flag: i32, cell: &mut i32) {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(flag));
        if_();
        local_get(in(cell));
        i32_const(7);
        i32_store(2, 0);
        else_();
        local_get(in(cell));
        i32_const(9);
        i32_store(2, 0);
        end();
    });
};

/// A float constant is its bits, as the format stores them: `0x3f000000` is 0.5 of 32 bits.
half := (x: f32) -> f32 {
    mut r: f32 = 0.0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(x));
        f32_const(0x3f000000);
        f32_mul();
        local_set(out(r));
    });
    r
};

/// A block gives the value its type names, which a branch to it carries.
sign := (x: i32) -> i32 {
    mut r: i32 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block(yield_i32);
        i32_const(100);
        local_get(in(x));
        i32_const(0);
        i32_lt_s();
        br_if(0);
        drop();
        i32_const(200);
        end();
        local_set(out(r));
    });
    r
};

/// A table branches by the value popped, the last depth being the default.
dispatch := (n: i32) -> i32 {
    mut r: i32 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block();
        block();
        block();
        local_get(in(n));
        br_table(0, 1, 2);
        end();
        i32_const(10);
        local_set(out(r));
        br(1);
        end();
        i32_const(20);
        local_set(out(r));
        br(0);
        end();
    });
    r
};

/// A float literal is rounded to the format of its instruction.
more := (x: f64) -> f64 {
    mut r: f64 = 0.0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(x));
        f64_const(1.5);
        f64_add();
        local_set(out(r));
    });
    r
};

twice := (x: i32) -> i32 {
    mut y: i32 = x;
    y +%= x;
    y
};

/// A call takes its parameters off the stack and leaves its result, as the function's type says.
call_twice := (x: i32) -> i32 {
    mut r: i32 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(x));
        call(twice);
        local_set(out(r));
    });
    r
};

/// A global the linker defines is named by the choice of its kind.
stack_top := () -> u32 {
    mut sp: u32 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        global_get(stack_pointer);
        local_set(out(sp));
    });
    sp
};

/// A vector lives on the stack: made from a scalar, added to a constant, and a lane taken.
lanes := (x: i32) -> i32 {
    mut r: i32 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(x));
        i32x4_splat();
        v128_const(0x0000000200000001, 0x0000000400000003);
        i32x4_add();
        i32x4_extract_lane(3);
        local_set(out(r));
    });
    r
};
