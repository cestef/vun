//! Blocks of WebAssembly instructions (spec 07, section 6): the stack machine written as the text
//! format has it, Vun values bound to locals (`in`, `out`, `inout`) and the stack as the
//! instructions leave it.

add := (a: i32, b: i32) -> i32 {
    mut sum: i32 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(a));
        local_get(in(b));
        i32_add();
        local_set(out(sum));
    });
    sum
};

/// An immediate is a constant pushed; a value of 64 bits is a local of its own class.
widen := (a: i32) -> i64 {
    mut wide: i64 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(a));
        i64_extend_i32_u();
        i64_const(1);
        i64_shl();
        local_set(out(wide));
    });
    wide
};

/// Memory is reached by an address on the stack and two immediates: the alignment as a power of
/// two, and an offset.
poke := (at: u32, value: u32) {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(at));
        local_get(in(value));
        i32_store(2, 0);
    });
};

/// `local_tee` writes a local and keeps the value; `drop` discards one.
count := (n: i32) -> i32 {
    mut m: i32 = n;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(n));
        i32_const(1);
        i32_add();
        local_tee(inout(m));
        drop();
    });
    m
};

/// After an instruction that ends the code, any stack goes.
never_returns := () -> never {
    unsafe {
        lang.arch.asm({
            ..lang.arch.wasm32.names;
            i32_const(1);
            unreachable();
        });
        lang.hint.unreachable()
    }
};

/// Blocks, loops and `if`s hold no values, and a branch counts the blocks it leaves outward from
/// the innermost; `br_if` branches on the value it pops. A variable bound `inout` in several
/// instructions is one local, read where a block wrote it.
tri := (n: i32) -> i32 {
    mut left: i32 = n;
    mut total: i32 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block();
        loop();
        local_get(inout(left));
        i32_eqz();
        br_if(1);
        local_get(inout(total));
        local_get(inout(left));
        i32_add();
        local_set(inout(total));
        local_get(inout(left));
        i32_const(1);
        i32_sub();
        local_set(inout(left));
        br(0);
        end();
        end();
    });
    total
};

/// `if_` pops the condition and runs up to `else_` or `end` when it is not zero.
pick := (flag: i32, cell: &mut i32) {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        local_get(in(flag));
        if_();
        local_get(in(cell));
        i32_const(7);
        i32_store(2, 0);
        else_();
        local_get(in(cell));
        i32_const(9);
        i32_store(2, 0);
        end();
    });
};
