//! Blocks of x86-64 instructions (spec 07, section 6): operands are the table's registers,
//! integers, labels, memory and Vun values bound to registers; each call takes the first form of
//! its instruction that fits, and a block whose end is not reached is `never`.

add3 := (a: u64) -> u64 {
    mut r: u64 = 0;
    unsafe lang.arch.asm({ ..lang.arch.x86_64.names; lea(out(r), mem(in(a), 3)); });
    r
};

countdown := (n: u32) -> u32 {
    mut left: u32 = n;
    unsafe lang.arch.asm({
        ..lang.arch.x86_64.names;
        top := here();
        sub(inout(left), 1);
        j(nz, top);
    });
    left
};

sum := (xs: *u64, i: u64) -> u64 {
    mut r: u64 = 0;
    unsafe lang.arch.asm({
        ..lang.arch.x86_64.names;
        mov(out(r).at(rax), mem(in(xs), scaled(in(i), 8), 16));
        add(rax, -1);
        movzx(ecx, cl);
    });
    r
};

halt := () -> never {
    unsafe lang.arch.asm({ ..lang.arch.x86_64.names; ud2(); })
};
