//! Bindings, statics and destructuring (spec 01, section 3).

limit := 64;
mut count: u32 = 0;

bounds := (xs: &[u32]) -> (u32, u32) { (xs[0], xs[xs.len() - 1]) };

spread := (xs: &[u32]) -> u32 {
    mut buf: [4096]u8;
    buf[0] = 1;
    (lo, hi) := bounds(xs);
    (hi - lo + buf[0]).to(u32)
};

uart := mydrivers.serial.uart;
Baud: type = uart.Baud;
