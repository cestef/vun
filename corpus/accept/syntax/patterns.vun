//! Patterns mirror constructors, and parse as expressions (spec 01, section 6).

Shape := enum { circle(u16), rect(Point, Point), empty };
Point := struct { x: i32, y: i32 };

describe := (s: &Shape) -> u64 {
    match s.* {
        .circle(0) => 0,
        .circle(r) => r * r * 3,
        .rect(.{ .x = x0, .y = y0 }, .{ .x = x1, .y = y1 }) if x0 < x1 and y0
            < y1 => ((x1 - x0) * (y1 - y0)).to(u64),
        .rect(_, _) => 0,
        .empty => 0,
    }
};

first_negative := (rows: &[4][4]i32) -> ?(usize, usize) {
    'search: for (i, row) in rows.enumerate() {
        for (j, v) in row.enumerate() {
            if v < 0 { return .some((i, j)); }
            if v == 0 { continue 'search; }
        }
    }
    .none
};

swap := (pair: (u8, u8)) -> (u8, u8) {
    (a, b) := pair;
    (b, a)
};

Token := enum { word(u16), number(u16), space, end };

/// Alternatives bind the same names, which what follows uses whichever matched.
length := (t: &Token) -> u16 {
    match t.* {
        .word(n) | .number(n) => n,
        .space | .end => 0,
    }
};
