//! A coroutine function's frame type is named by `std.meta.Frame`, the type of a call by
//! `std.meta.TypeOf`, and a frame's size is known at compile time (spec 06, section 1).

counter := (limit: u8) -> Iter(u8) {
    for i in 0..limit { yield i; }
};

Counter := std.meta.Frame(counter);

/// Reports `msg` unless `holds`.
require := ($holds: bool, $msg: &[u8]) -> u8 {
    $if !holds { std.diag.error(.{ .msg = msg }); }
    0
};

small := require(std.meta.size(Counter) <= 16, "a counter's frame outgrew 16 bytes");
named := require(std.meta.same(Counter, std.meta.TypeOf(counter(3))), "a call makes another frame");

first := (c: &mut Counter) -> ?u8 {
    match c.resume() {
        .yielded(i) => .some(i),
        .done(_) => .none,
    }
};
