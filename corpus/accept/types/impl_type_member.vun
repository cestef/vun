//! A member of an impl leaving its annotation out has the interface's: `Error := ();` is a type
//! the naming lint accepts unannotated.

Sink := struct { taken: usize };

#[impl(std.fmt.Writer(Sink))]
sink_writer := struct {
    Error := ();
    closed: () = ();
    write := (self: &mut Sink, bytes: &[u8]) -> Result(usize, ()) {
        self.taken += bytes.len();
        .ok(bytes.len())
    };
};
