//! Interfaces are functions from a type to a requirement struct (spec 02, section 3).

Writer := interface(($Self: type) -> type { struct {
    Error: type = _;
    write: (self: &mut Self, bytes: &[u8]) -> Result(usize, Error) = _;
    write_all := (self: &mut Self, bytes: &[u8]) -> Result((), Error) {
        mut rest := bytes;
        for rest.len > 0 { rest = rest[self.write(rest)?..]; }
        .ok(())
    };
}});

#[impl(Writer(Uart))]
UartWriter := struct {
    Error := uart.Error;
    write := (self: &mut Uart, bytes: &[u8]) -> Result(usize, uart.Error) { self.send(bytes) };
};

log := ($W: Writer, w: &mut W, msg: &[u8]) -> Result((), W.Error) {
    w.write_all(msg)
};

#[impl(Serialize(Point))]
PointSerialize := serde.derive(Point);
