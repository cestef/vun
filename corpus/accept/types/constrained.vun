//! A constrained parameter may use only its interface's members (spec 02, section 3).

Shape := interface(($Self: type) -> type { struct {
    area: (self: &Self) -> u64 = _;
    name := (self: &Self) -> &[u8] { std.meta.name_of(Self) };
} });

Square := struct { side: u16 };

#[impl(Shape(Square))]
SquareShape := struct {
    area := (self: &Square) -> u64 { self.side * self.side };
};

total := ($S: Shape, shapes: &[S]) -> u64 {
    mut acc: u64 = 0;
    for s in shapes { acc += s.area(); }
    acc
};

squares := [Square{ .side = 2 }, Square{ .side = 3 }];
sum := total(Square, &squares);

/// The total area of squares, dispatched statically.
area_of := (shapes: &[Square]) -> u64 { total(Square, shapes) };
/// A default member of the interface, reached through the witness.
label := (s: &Square) -> &[u8] { s.name() };
