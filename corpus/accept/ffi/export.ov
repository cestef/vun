//! A library is a root file with exports and no runtime (spec 08, section 2).

#[link.export("overt_crc32"), abi.c]
crc32 := (data: *u8, len: usize) -> u32 {
    bytes := unsafe { lang.mem.slice(data, len) };
    mut crc: u32 = 0xffff_ffff;
    for b in bytes {
        crc ^= b;
        $for _ in 0..8 {
            mask := 0 - (crc & 1);
            crc = (crc >> 1) ^ (0xedb8_8320 & mask.wrap(u32));
        }
    }
    ~crc
};

#[layout.c]
Version := struct { major: u16, minor: u16 };

#[link.export("overt_version"), abi.c]
version := () -> Version { .{ .major = 0, .minor = 1 } };
