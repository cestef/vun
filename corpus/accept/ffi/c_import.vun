//! C functions are declarations provided by the linker; calling them is `unsafe`
//! (spec 07, section 5).

#[link.symbol("strlen"), abi.c]
strlen: unsafe (s: *u8) -> usize = _;

#[link.symbol("write"), abi.c]
write: unsafe (fd: i32, buf: *u8, len: usize) -> isize = _;

/// A safe wrapper: the audit boundary is this one block.
say := (msg: &[u8]) -> bool {
    written := unsafe { write(1, msg.ptr(), msg.len()) };
    written == msg.len().to(isize)
};

c_len := (s: &static [u8]) -> usize { unsafe { strlen(s.ptr()) } };

/// An enum that names its tags is the integer they are stored in, which C reads (spec 05,
/// section 6): a field of a `#[layout.c]` struct, and a parameter of an import.
#[layout.tag(u32)]
Mode := enum { read = 1, write = 2 };

#[layout.c]
Open := struct { path: *u8, mode: Mode };

#[link.symbol("open_with"), abi.c]
open_with: unsafe (request: *Open) -> i32 = _;
