//! Compile-time code reports diagnostics with the compiler's model (spec 10, section 3).

..std.{ fmt };

format := ($spec: &[u8]) {
    $if !fmt.valid(spec) {
        bad := fmt.first_error(spec);
        std.diag.error(.{
            .at = std.meta.span(spec, bad.lo, bad.hi),
            .msg = "unknown format specifier",
            .fixes = .{ .{ .msg = "use {x}", .safety = .safe, .text = "{x}" } },
        });
    }
};
