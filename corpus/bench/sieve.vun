//! Memory and loops: the primes below 4000000 by the sieve of Eratosthenes.

start := std.os.start(main);

main := (sys: &mut std.os.System) -> std.os.Exit {
    mut out := sys.stdout();
    mut composite: [4000000]bool = [false; 4000000];
    mut count: u32 = 0;
    for i in 2..4000000 {
        if !composite[i] {
            count = (count + 1).wrap(u32);
            mut j: usize = (i * i).wrap(usize);
            for j < 4000000 {
                composite[j] = true;
                j = (j + i).wrap(usize);
            }
        }
    }
    std.fmt.println(&mut out, "{}", count);
    .ok
};
