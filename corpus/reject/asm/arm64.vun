//! What a block of arm64 instructions reports (spec 07, section 6).

lines := () {
    unsafe lang.arch.asm({
        ..lang.arch.arm64.names;
        add(x0, x1, 5000); //~ asm.immediate_too_wide
        add(x0, w1, 3); //~ asm.no_form
        ldr(x0, mem(x1, 1048576)); //~ asm.no_form
        dmb(nzcv); //~ asm.no_form
    });
};

/// Names the table lacks: a register of another architecture, a condition of none.
misspelled := () {
    unsafe lang.arch.asm({
        ..lang.arch.arm64.names;
        end := label();
        mov(x0, rax); //~ names.unresolved
        b(zz, end); //~ names.unresolved
        place(end);
    });
};
