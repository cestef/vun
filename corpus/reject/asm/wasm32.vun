//! What a block of WebAssembly instructions reports of its blocks (spec 07, section 6): an `end`
//! or a branch that leaves the block of assembly, an `else` with no `if`, a block left open, and
//! values on the stack where a block ends, a block that does not give the value it is typed with, and
//! a call without the arguments its function takes (their types are checked for the target only)
//! or without the index of an indirect one,
//! a vector taken as a scalar, and a lane past the vector's.

lines := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        end(); //~ asm.stack
    });
};

reaches_out := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block();
        br(1); //~ asm.stack
        end();
    });
};

no_if := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block();
        else_(); //~ asm.stack
        end();
    });
};

stays_open := () {
    unsafe lang.arch.asm({ //~ asm.stack
        ..lang.arch.wasm32.names;
        loop();
    });
};

carries := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block();
        i32_const(1);
        end(); //~ asm.stack
    });
};

gives := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block(yield_i32);
        end(); //~ asm.stack
    });
};

gives_wrong_type := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block(yield_i32);
        i64_const(1);
        end(); //~ asm.stack
    });
};

if_without_else := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        i32_const(1);
        if_(yield_i32);
        i32_const(1);
        end(); //~ asm.stack
    });
};

table_mixes := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        block(yield_i32);
        block();
        i32_const(0);
        br_table(0, 1); //~ asm.stack
        end();
        i32_const(1);
        end();
        drop();
    });
};

twice := (x: i32) -> i32 { x };

call_without_its_argument := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        call(twice); //~ asm.stack
    });
};

call_through_without_an_index := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        call_indirect(twice); //~ asm.stack
    });
};

vector_where_a_scalar_is_taken := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        v128_const(0, 0);
        i32_const(1);
        i32_add(); //~ asm.stack
        drop();
        drop();
    });
};

lane_past_the_immediate := () {
    unsafe lang.arch.asm({
        ..lang.arch.wasm32.names;
        v128_const(0, 0);
        i32x4_extract_lane(300); //~ asm.immediate_too_wide
        drop();
    });
};
