//! What a block of x86-64 instructions reports (spec 07, section 6): a call of no instruction, an
//! operand of no kind, a name the table and the block do not have, operands no form takes,
//! immediates too wide, registers of another class, an output that is no place, a block outside
//! `unsafe`, and instructions of two architectures.

helper := () {};

lines := () {
    unsafe lang.arch.asm({
        ..lang.arch.x86_64.names;
        helper(); //~ asm.unknown_mnemonic
        mov(rax, 1.5); //~ asm.unknown_operand
        mov(1, rax); //~ asm.no_form
        add(eax, 5000000000); //~ asm.immediate_too_wide
        cvtss2sd(rax, xmm1); //~ asm.register_class
        mov(mem(rax), 1); //~ asm.no_form
    });
};

/// A name the table lacks is unresolved, and the block is read no further.
misspelled := () {
    unsafe lang.arch.asm({
        ..lang.arch.x86_64.names;
        mov(rxa, 1); //~ names.unresolved
    });
};

unplaced := () {
    unsafe lang.arch.asm({
        ..lang.arch.x86_64.names;
        mov(out(1), rax); //~ asm.unknown_operand
    });
};

unvouched := () {
    lang.arch.asm({ ..lang.arch.x86_64.names; ret(); }); //~ safety.requires_unsafe
};

mixed := () {
    unsafe lang.arch.asm({
        ..lang.arch.x86_64.names;
        ret();
        lang.arch.arm64.control.ret(); //~ asm.unknown_arch
    });
};
