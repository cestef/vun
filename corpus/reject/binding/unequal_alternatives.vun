//! The alternatives of an or-pattern bind the same names with the same types (spec 01,
//! section 6).

Reading := enum { small(u8), large(u32), pair(u8, u8), none };

value := (r: Reading) -> u32 {
    match r {
        .small(a) | .large(b) => a, //~ binding.unequal_alternatives
        .pair(x, _) | .none => x, //~ binding.unequal_alternatives
    }
};

width := (r: Reading) -> u32 {
    match r {
        .small(n) | .large(n) => n, //~ binding.unequal_alternatives
        _ => 0,
    }
};
