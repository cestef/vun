//! A function's parameters are typed where they are written: nothing else says what a caller
//! passes, so a name alone is no parameter (spec 01, section 4).

identity := (x) { x }; //~ types.untyped_param

// The annotation of what it is the value of gives a parameter its type where it has that
// position; a parameter past the ones it has is untyped, and a literal taking fewer parameters
// is a mismatch with it.
more: (a: u8) -> u8 = (a, b) { a }; //~ types.untyped_param
fewer: (a: u8, b: u8) -> u8 = (a) { a }; //~ types.mismatch

// A member of an impl has the types its requirement gives its parameters, as many as it has.
Shape := struct { sides: u8 };

impl lang.ops.Eq for Shape {
    eq := (a, b, c) { a.sides == b.sides }; //~ types.untyped_param
}

// A member with another number of parameters than its requirement is given none of its types.
impl lang.ops.Ord for Shape {
    cmp := (a) { .equal }; //~ types.untyped_param
}

// A member the interface requires nothing of has no requirement to take its types from.
Sided := interface(($Self: type) -> type { struct { sides: (s: &Self) -> u8 = _; } });
Square := struct { side: u8 };

impl Sided for Square {
    sides := (s) { 4 };
    area := (s) -> u8 { 1 }; //~ types.untyped_param
}

// A closure's parameter whose type neither the arguments nor what is expected of the call say,
// as the accumulator of a `fold` whose result is not used as anything, is written.
evens := (limit: u32) -> Iter(u32) { for i in 0..limit { if i % 2 == 0 { yield i; } } };
unsaid := () -> u32 {
    total := evens(10).fold(0, [] (acc, x: u32) { (acc + x).sat(u32) }); //~ types.untyped_param
    total
};
