//! A `$` parameter annotated with an interface takes a type that meets it: one with an impl of the
//! interface, or for `lang.ops.Call` a function or closure taking what the call passes and giving
//! what it expects. The report is at the argument that fixed the type.

Shape := interface(($Self: type) -> type { struct { area: (self: &Self) -> u8 = _; } });
Square := struct { side: u8 };

measure := ($T: Shape, v: T) { _ = v; };
apply := ($F: lang.ops.Call((u8), u8), f: F) { _ = f; };

go := () {
    measure(Square{ .side = 2 }); //~ types.no_impl
    apply((x: bool) -> u8 { 1 }); //~ types.no_impl
    apply((x: u8) -> u16 { 1 }); //~ types.no_impl
    apply((x: u8, y: u8) -> u8 { x }); //~ types.no_impl
};
