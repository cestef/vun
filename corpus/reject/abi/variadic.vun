//! A C function's pack is its variadic arguments: of an import, each as C's default promotions
//! leave it (spec 07, section 5).

#[link.symbol("printf"), abi.c]
single: unsafe (format: *u8, ..args: .{ f32 }) -> i32 = _; //~ abi.variadic

#[link.export("defined"), abi.c]
defined := (format: *u8, ..args: .{ i32 }) -> i32 { 0 }; //~ abi.variadic
