//! A field placed by `#[layout.offset(N)]` keeps its declaration order and its alignment: the
//! compiler never reorders (spec 05, section 6).

Regs := struct {
    #[layout.offset(4)]
    status: u32,
    #[layout.offset(0)]
    control: u32, //~ layout.offset
};

Aligned := struct {
    flag: u8,
    #[layout.offset(2)]
    word: u32, //~ layout.offset
};

Past := struct {
    #[layout.offset(18446744073709551615)]
    last: u8, //~ layout.offset
};
