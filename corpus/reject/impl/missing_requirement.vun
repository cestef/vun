//! An impl provides every requirement of its interface (spec 02, section 3).

Writer := interface(($Self: type) -> type { struct {
    Error: type = _;
    write: (self: &mut Self, bytes: &[u8]) -> Result(usize, Error) = _;
} });

Sink := struct {};

#[impl(Writer(Sink))] //~ impl.missing_requirement
SinkWriter := struct {
    Error := ();
};
