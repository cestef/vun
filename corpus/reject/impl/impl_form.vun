//! What is said of an `impl I for T { }` points at its head, as what is said of `#[impl(I(T))]`
//! points at the attribute (spec 02, section 3). The witness of a constructor is checked where it
//! is used.

Writer := interface(($Self: type) -> type { struct {
    Error: type = _;
    write: (self: &mut Self, bytes: &[u8]) -> Result(usize, Error) = _;
} });

Sink := struct {};

Pipe := ($T: type) -> type { struct { item: T } };

impl Writer for Sink { //~ impl.missing_requirement
    Error: type = ();
}

impl Writer for Pipe($T) {
    Error: type = ();
}

use := (s: &mut Sink, p: &mut Pipe(u8)) {
    _ = s.write(&[]); //~ types.no_member
    _ = p.write(&[]); //~ types.no_member
};
