//! Stand-ins for what corpus programs take from drivers, other libraries, other corpus files and
//! parts of `std` not written yet. The corpus prelude lists this namespace, so its public names
//! are visible in every corpus file; its children (`serde`, `svd`, ...) stand for packages.

/// Memory and files.
Own := std.mem.Own;
Alloc := struct {
    create := (self: &mut Alloc, $T: type) -> Result(Own(T), Error) { .err(.oom) };
    destroy := (self: &mut Alloc, $T: type, o: Own(T)) { o.into_raw(); };
};
/// An open file, which must be closed.
File := #[kind.linear] struct {
    fd: u32,
    size := (self: &File) -> u64 { 0 };
};
Fs := struct {
    open := (self: &mut Fs, path: &[u8]) -> Result(File, Error) { .err(.fs) };
    close := (self: &mut Fs, f: File) { .{ .fd = _ } := f; };
};
Config := struct {
    done := (self: &Config) -> bool { true };
};
Error := enum { fs, oom, parse };
#[impl(lang.ops.Eq(Error))]
error_eq := std.cmp.derive_eq(Error);
parse := (f: &File, cfg: &out Config) -> Result((), Error) {
    cfg.* = .{};
    .ok(())
};

/// Capabilities and devices. Asynchronous stand-ins wait on `ready` once.
ready := std.task.Event.init();
Duration := enum { ms(u32) };
Led := struct {
    toggle := (self: &mut Led) {};
};
Timer := struct {
    after := (self: &Timer, d: Duration) -> Async(()) { yield ..ready.wait(); };
};
Serial := struct {
    enable := (self: &mut Serial) {};
    disable := (self: &mut Serial) {};
    read_byte := (self: &mut Serial) -> Async(u8) { yield ..ready.wait(); 0 };
    read := (self: &mut Serial, buf: &out [64]u8) -> Async(usize) {
        buf.* = [0; 64];
        yield ..ready.wait();
        0
    };
    write := (self: &mut Serial, bytes: &[u8]) -> Async(()) { yield ..ready.wait(); };
};
Uart := struct {
    send := (self: &mut Uart, bytes: &[u8]) -> Result(usize, support.uart.Error) { .ok(bytes.len()) };
};
Point := struct { x: i32, y: i32 };
Reg := ($T: type) -> type { struct { raw: T } };

/// Interfaces.
Dyn := ($I: lang.Interface) -> type { struct {
    begin_struct := (self: &mut Dyn(I), name: &[u8]) -> Result((), Encoder.Error) { .ok(()) };
    field := (self: &mut Dyn(I), name: &[u8]) -> Result((), Encoder.Error) { .ok(()) };
    end_struct := (self: &mut Dyn(I)) -> Result((), Encoder.Error) { .ok(()) };
} };
Encoder := interface(($Self: type) -> type { struct {
    Error: type = _;
} });
Serialize := ($T: type) -> lang.Interface {
    interface(($Self: type) -> type { struct {
        serialize: ($E: type, v: &T, w: &mut E) -> Result((), E.Error) = _;
    } })
};

/// Program pieces the examples call.
Cache := struct {
    get := (self: &Cache, key: u32) -> ?u32 { .none };
};
Job := struct {
    run := (self: &Job) {};
};
Queue := struct {
    pop := (self: &mut Queue) -> ?Job { .none };
};
Packet := struct {
    bytes: [16]u8,
    encode := (self: &Packet) -> [16]u8 { self.bytes };
    decode := (bytes: &[u8]) -> Result(Packet, Error) { .err(.parse) };
};
#[impl(lang.ops.Eq(Packet))]
packet_eq := std.cmp.derive_eq(Packet);
use := ($T: type, v: T) {};
handle_read := (r: u8) {};
handle_write := (w: u8) {};
reset := () {};
poll := () {};
load := (key: u32) -> Result(Config, Error) { .ok(.{}) };
crc32 := (bytes: &[u8]) -> u32 { 0 };
node := ($N: type, net: N, i: u32) -> Async(never) { for {} };
leaders := ($S: type, s: &S) -> u32 { 0 };
blink := (led: &mut Led, timer: &Timer) -> Async(never) { for {} };

/// A hosted runtime's system capability.
System := struct {
    /// The capability, from what the system left on the stack at the entry point.
    from_stack := unsafe (sp: *usize) -> System { .{} };
};
Exit := enum { code(Int(1..=125)) };
exit := (e: Exit) -> never { for {} };
report := (t: &lang.panic.Trap) {};

/// Visible only inside `support`; the reject corpus selects it to show `names.private`.
_hidden := 0;
