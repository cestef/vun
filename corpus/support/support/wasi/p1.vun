//! Preview 1 commands.

System := struct {
    stdout := (self: &mut System) -> Stdout { .{} };
    args := (self: &System) -> &[&[u8]] { &[] };
};
/// The standard output stream.
Stdout := struct {};
#[impl(std.fmt.Writer(Stdout))]
StdoutWriter := struct {
    Error := Errno;
    closed: Errno = .{ .code = Errno.pipe };
    write := (self: &mut Stdout, bytes: &[u8]) -> Result(usize, Errno) { .ok(bytes.len()) };
};
/// Why a call failed.
Errno := struct {
    code: u16,

    /// A pipe or stream whose reader is gone.
    pipe := 64;
};
Exit := enum { ok, code(u8) };
command := ($main: (&mut System) -> Exit) -> type { struct {} };
