start := std.os.start(main);

main := (sys: &mut std.os.System) -> std.os.Exit {
    n: u8 = sys.args().len().sat(u8);
    mut failed: Int(0..=10) = 0;
    // A register written and read back through volatile accesses.
    mut word: u32 = 0;
    reg := unsafe &lang.mem.cast(u32, std.hw.Reg(u32), lang.mem.pointer_to(u32, &word)).*;
    reg.write(0x1234 * n);
    if !(reg.read() == 0x1234 and word == 0x1234) { failed +|= 1; }
    // A write through a pointer, whose result is `()`, still writes.
    mut x: u16 = 0;
    unsafe lang.mem.write(u16, lang.mem.pointer_to(u16, &x), 700);
    if x != 700 { failed +|= 1; }
    // Overlapping copies, forward and backward.
    mut xs: [5]u8 = [1, 2, 3, 4, 5];
    base := lang.mem.pointer_to([5]u8, &xs);
    items := unsafe lang.mem.cast([5]u8, u8, base);
    unsafe lang.mem.copy(u8, lang.mem.offset(u8, items, 1), items, 3);
    if xs != [1, 1, 2, 3, 5] { failed +|= 1; }
    unsafe lang.mem.copy(u8, items, lang.mem.offset(u8, items, 2), 3);
    if xs != [2, 3, 5, 3, 5] { failed +|= 1; }
    // A fill of items wider than a byte.
    mut ws: [3]u32 = [0, 0, 0];
    unsafe lang.mem.fill(u32, lang.mem.cast([3]u32, u32, lang.mem.pointer_to([3]u32, &ws)), 70000 + n, 2);
    if ws != [70001, 70001, 0] { failed +|= 1; }
    // An unused narrowing still checks: this one holds.
    _ = (n * 200).to(u8);
    // Items overlapping those they are copied to by less than an item.
    mut bytes: [7]u8 = [1, 2, 3, 4, 5, 6, 7];
    at := unsafe lang.mem.cast([7]u8, u8, lang.mem.pointer_to([7]u8, &bytes));
    triples := unsafe lang.mem.cast(u8, [3]u8, at);
    unsafe lang.mem.copy([3]u8, lang.mem.cast(u8, [3]u8, lang.mem.offset(u8, at, 1)), triples, 2);
    if bytes != [1, 1, 2, 3, 4, 5, 6] { failed +|= 1; }
    // Atomics on a wide word, given constants a narrower type holds: each is the word's width.
    mut wide: u64 = 1 << 40;
    wide_at := lang.mem.pointer_to(u64, &wide);
    unsafe lang.mem.atomic_store(u64, wide_at, 0, .relaxed);
    if wide != 0 { failed +|= 1; }
    held := unsafe lang.mem.atomic_compare_swap(u64, wide_at, 0, 1 << 33, .acquire);
    added := unsafe lang.mem.atomic_add(u64, wide_at, 2, .relaxed);
    if !(held == 0 and added == 1 << 33 and wide == (1 << 33) + 2) { failed +|= 1; }
    // How many checks failed: 0 when all hold.
    std.os.Exit.of(failed)
};
