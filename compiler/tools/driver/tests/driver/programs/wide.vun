start := std.os.start(main);

main := (sys: &mut std.os.System) -> std.os.Exit {
    n: u64 = sys.args().len();
    k: u8 = n.sat(u8);
    big: u64 = 0xffff_ffff_ffff_fff0;
    wide: u128 = 0x1_0000_0000_0000_0000 * k + 7;
    signed: i128 = 7 - 0x2_0000_0000_0000_0000 * k;
    mut failed: Int(0..=8) = 0;
    if (big + n * 20).wrap(u64) != 4 { failed +|= 1; }
    if wide / 3 != 0x5555_5555_5555_5557 { failed +|= 1; }
    if wide % 3 != 2 { failed +|= 1; }
    if (wide >> 64).wrap(u8) != 1 { failed +|= 1; }
    if wide <= 0xffff_ffff_ffff_ffff { failed +|= 1; }
    if signed / 3 != -0xaaaa_aaaa_aaaa_aaa8 { failed +|= 1; }
    if signed % 3 != -1 { failed +|= 1; }
    if (big + big).wrap(u64) != 0xffff_ffff_ffff_ffe0 { failed +|= 1; }
    // How many checks failed: 0 when all hold.
    std.os.Exit.of(failed)
};
