start := std.os.start(main);

/// A linear handle, consumed by `close`.
Handle := #[kind.linear] struct { n: u8 };
close := (h: Handle, log: &mut u8) { .{ .n = n } := h; log.* = (log.* + n).wrap(u8); };

/// Closes the handle at every exit unless it was handed on.
kept := (keep: bool, log: &mut u8) -> ?Handle {
    h := Handle{ .n = 1 };
    if keep { return .some(h); }
    defer close(h, log);
    .none
};

Fault := enum { io(u8), other };
#[impl(lang.ops.Eq(Fault))]
FaultEq := std.cmp.derive_eq(Fault);

Point := struct { x: u16, y: i8 };
#[impl(lang.ops.Eq(Point))]
PointEq := std.cmp.derive_eq(Point);

failing := (n: u8) -> Result(u8, u8) { if n > 0 { .err(n) } else { .ok(0) } };

twice := ($F: lang.ops.Call((u8), u8), f: F, x: u8) -> u8 { f(f(x)) };
add_one := (x: u8) -> u8 { (x + 1).wrap(u8) };

main := (sys: &mut std.os.System) -> std.os.Exit {
    n: u8 = sys.args().len().sat(u8);
    mut code: u8 = 0;
    // A closure capturing by borrow and by value.
    mut total: u32 = 0;
    bump := [&mut total] (by: u8) { total += by; };
    bump(3);
    three := [n] () -> u8 { (n + 2).wrap(u8) };
    if total == 3 and three() == 3 { code = code | 1; }
    // A function value called through its address.
    f: (u8) -> u8 = add_one;
    if twice(f, n) == 3 { code = code | 2; }
    // A variant's constructor as a function value.
    if failing(n).map_err(Fault.io) == .err(.io(1)) { code = code | 4; }
    // A deferred statement consuming a linear value runs only where it is still held.
    mut log: u8 = 0;
    if .some(h) = kept(false, &mut log) { close(h, &mut log); log = 100; }
    if .some(h) = kept(true, &mut log) { close(h, &mut log); }
    if log == 2 { code = code | 8; }
    // Integers: fits, abs, bytes.
    m: i16 = (-300 * n).sat(i16);
    if m.try_to(i8).is_none() and m.abs() == 300 { code = code | 16; }
    bytes: [4]u8 = [0x78, 0x56, 0x34, n];
    if u32.from_le(&bytes) == 0x0134_5678 { code = code | 32; }
    // The variant of an enum value, and sizes.
    pt: Point = .{ .x = 300, .y = -1 };
    same := pt == Point{ .x = 300, .y = -1 } and pt != Point{ .x = 300, .y = n.wrap(i8) };
    if lang.meta.variant(Fault, &Fault.other) == 1 and std.meta.size(u64) == 8 and same { code = code | 64; }
    // Pointers: offset, cast and address.
    items: [2]u16 = [7, 9];
    p := lang.mem.pointer_to([2]u16, &items);
    second := unsafe lang.mem.offset(u16, lang.mem.cast([2]u16, u16, p), 1);
    if unsafe lang.mem.read(u16, second) == 9 and lang.mem.address(u16, second) % 2 == 0 {
        code = code | 128;
    }
    // The checks that failed: 0 when all hold, a status every system can return.
    .code(code ^ 255)
};
