//! Failure is a value: `Result`, and `?`.

start := std.os.start(main);

Error := enum { empty, not_a_number, too_big };

// A `Result(T, E)` is `.ok(T)` or `.err(E)`. A trailing `?` hands an error
// straight back to the caller, and otherwise gives the value.
double := (text: &[u8]) -> Result(u16, Error) {
    if text.len() == 0 { return .err(.empty); }
    n := Int(0..=100000).parse(text).ok_or(Error.not_a_number)?;
    if n > 1000 { return .err(.too_big); }
    .ok(n * 2)
};

main := (sys: &mut std.os.System) -> std.os.Exit {
    mut out := sys.stdout();
    std.fmt.print(&mut out, "{?}\n", double("21"));
    std.fmt.print(&mut out, "{?}\n", double(""));
    std.fmt.print(&mut out, "{?}\n", double("abc"));
    std.fmt.print(&mut out, "{?}\n", double("5000"));
    .ok
};
