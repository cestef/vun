//! Narrowing is explicit.

start := std.os.start(main);

main := (sys: &mut std.os.System) -> std.os.Exit {
    mut out := sys.stdout();
    big: u32 = 300;

    // Going to a smaller type is a choice, and you name it.
    std.fmt.print(&mut out, "wrap: {}\n", big.wrap(u8)); // modulo 256
    std.fmt.print(&mut out, "sat:  {}\n", big.sat(u8)); // the nearest end
    std.fmt.print(&mut out, "try:  {?}\n", big.try_to(u8)); // an optional

    // `to` traps when the value does not fit. A comparison tells the compiler
    // what it needs to know: in here, `big` is below 256.
    if big < 256 {
        std.fmt.print(&mut out, "to:   {}\n", big.to(u8));
    }
    .ok
};
