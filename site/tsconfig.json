{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": [
    "src",
    "build",
    "tests",
    "astro.config.ts",
    ".astro/types.d.ts"
  ],
  "extends": "astro/tsconfigs/strict",
  "exclude": [
    "dist"
  ]
}