//! `for` and `if`.

start := std.os.start(main);

main := (sys: &mut std.os.System) -> std.os.Exit {
    mut out := sys.stdout();
    // `1..=15` includes 15, `1..15` stops at 14.
    for i in 1..=15 {
        if i % 15 == 0 {
            std.fmt.print(&mut out, "fizzbuzz\n");
        } else if i % 3 == 0 {
            std.fmt.print(&mut out, "fizz\n");
        } else if i % 5 == 0 {
            std.fmt.print(&mut out, "buzz\n");
        } else {
            std.fmt.print(&mut out, "{}\n", i);
        }
    }
    .ok
};
