%YAML 1.2
---
# Syntax highlighting for Vun code blocks in the whitepaper.
# Token classes follow spec/01-syntax.md; keep in sync with lang/syntax/grammar.vun.
name: Vun
file_extensions: [vun]
scope: source.vun

contexts:
  main:
    - match: '//[/!].*$'
      scope: comment.line.documentation.vun
    - match: '//.*$'
      scope: comment.line.vun
    - match: '\\\\.*$'
      scope: string.unquoted.raw.vun
    - match: '\\"[^"\n]*"?'
      scope: string.quoted.raw.vun
    - match: '\\[A-Za-z_][A-Za-z0-9_]*'
      scope: variable.other.escaped.vun
    - match: '"'
      push: string
    - match: "'(\\\\.|[^'\\\\])'"
      scope: constant.character.vun
    - match: "'[a-z_][a-z0-9_]*"
      scope: entity.name.label.vun
    - match: '\b(mut|if|else|match|for|break|continue|return|yield|defer|and|or|struct|enum|unsafe)\b'
      scope: keyword.control.vun
    - match: '(?<=&)(out|take|static)\b|\bin\b'
      scope: keyword.other.vun
    - match: '#\[|#\{'
      scope: punctuation.definition.annotation.vun
    - match: '\$'
      scope: keyword.operator.stage.vun
    - match: '\b(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9]+)?)\b'
      scope: constant.numeric.vun
    - match: '\b[A-Z][A-Za-z0-9]*\b'
      scope: entity.name.type.vun
    - match: '\b[a-z_][a-z0-9_]*(?=\s*:=)'
      scope: entity.name.function.vun
    - match: '(:=|->|=>|\.\.=?|\.\*|&mut|&)'
      scope: keyword.operator.vun
    - match: '\.[a-z_][a-z0-9_]*'
      scope: variable.other.member.vun

  string:
    - meta_scope: string.quoted.double.vun
    - match: '\\.'
      scope: constant.character.escape.vun
    - match: '"'
      pop: true
