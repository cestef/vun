%YAML 1.2
---
# Syntax highlighting for Vun code blocks in the whitepaper.
# Token classes follow spec/01-syntax.md; keep in sync with lib/lang/lang/syntax/grammar.vun
# (keywords, contextual keywords, prefix, postfix, infix and assignment tables).
name: Vun
file_extensions: [vun]
scope: source.vun

variables:
  ident: '[A-Za-z_][A-Za-z0-9_]*'
  keywords: 'mut|if|else|match|for|break|continue|return|yield|defer|and|or|struct|enum|unsafe'

contexts:
  main:
    - include: comments
    - include: strings
    - include: attributes
    - include: literals
    - include: keywords
    - include: names
    - include: operators
    - include: punctuation

  comments:
    - match: '//[/!].*$'
      scope: comment.line.documentation.vun
    - match: '//.*$'
      scope: comment.line.double-slash.vun

  strings:
    # A run of lines starting with `\\` is a literal multi-line string.
    - match: '\\\\.*$'
      scope: string.unquoted.raw.vun
    # `\"..."` takes the text literally, with no escapes.
    - match: '\\"'
      scope: punctuation.definition.string.begin.vun
      push: raw_string
    - match: '"'
      scope: punctuation.definition.string.begin.vun
      push: string
    - match: "'(\\\\(x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\}|[ntr0\\\\\"'])|[^'\\\\])'"
      scope: constant.character.vun

  raw_string:
    - meta_scope: string.quoted.raw.vun
    - match: '"'
      scope: punctuation.definition.string.end.vun
      pop: true

  string:
    - meta_scope: string.quoted.double.vun
    - match: '\\(x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]{1,6}\}|[ntr0\\"''])'
      scope: constant.character.escape.vun
    - match: '\\.'
      scope: invalid.illegal.escape.vun
    - match: '"'
      scope: punctuation.definition.string.end.vun
      pop: true

  attributes:
    - match: '#\['
      scope: punctuation.definition.annotation.begin.vun
    - match: '#\{'
      scope: keyword.operator.quote.vun

  literals:
    - match: '\b(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+)\b'
      scope: constant.numeric.integer.vun
    - match: '\b[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\b'
      scope: constant.numeric.vun

  keywords:
    - match: '\b({{keywords}})\b'
      scope: keyword.control.vun
    # Contextual keywords: `in` after a `for` pattern; `out`, `take`, `static`, `temp` after `&`.
    - match: '(?<=&)(temp\s+mut|temp|out|take|static)\b'
      scope: keyword.other.borrow.vun
    - match: '(?<=&)mut\b'
      scope: keyword.control.vun
    - match: '\bin\b'
      scope: keyword.other.vun

  names:
    # A backslash takes a reserved word as a name: `\unsafe`.
    - match: '\\{{ident}}'
      scope: variable.other.escaped.vun
    # Loop and block labels.
    - match: "'[a-z_][a-z0-9_]*"
      scope: entity.name.label.vun
    # The hole: a discard in patterns, a value provided from outside in declarations.
    - match: '\b_\b'
      scope: constant.language.hole.vun
    # Computed names and staged expressions: `$(e)`, `$for`, `$T`.
    - match: '\$(?=\()'
      scope: keyword.operator.stage.vun
    - match: '\$+'
      scope: keyword.operator.stage.vun
    - match: '\b[A-Z][A-Za-z0-9]*\b'
      scope: entity.name.type.vun
    - match: '\b[a-z_][a-z0-9_]*(?=\s*:=)'
      scope: entity.name.function.vun
    # `.name` looks up a member of the expected type.
    - match: '\.[a-z_][a-z0-9_]*'
      scope: variable.other.member.vun
    - match: '\b[a-z_][a-z0-9_]*(?=\s*\()'
      scope: variable.function.vun

  operators:
    - match: '(:=|->|=>)'
      scope: keyword.operator.declaration.vun
    - match: '\.\.=?|\.\*|\.\{'
      scope: keyword.operator.vun
    - match: '(\+|-|\*)[%|]='
      scope: keyword.operator.assignment.vun
    - match: '(<<|>>|\+|-|\*|/|%|&|\||\^)='
      scope: keyword.operator.assignment.vun
    - match: '==|!=|<=|>=|<<|>>|\+\+|[-+*/%<>!~^|?]'
      scope: keyword.operator.vun
    - match: '&'
      scope: keyword.operator.borrow.vun

  punctuation:
    - match: '[;,]'
      scope: punctuation.separator.vun
    - match: '[(){}\[\]]'
      scope: punctuation.section.vun
