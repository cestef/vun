//! A program that shows it ran: it prints a line a second over USB, which the host sees as a
//! serial port (`/dev/ttyACM0`; `picocom /dev/ttyACM0` or `screen /dev/ttyACM0` shows it).
//! It waits for a program on the host to open the port, and `vun flash` replaces it without the
//! button: the console answers the programmer's request to reboot.
//!
//! A trap or a fault reboots into BOOTSEL with a record of why, which `picotool info -a` shows
//! (`rp2350.record`).

start := rp2350.start(.{ .main = main });

main := (p: rp2350.Peripherals) -> never {
    timer := rp2350.time.Timer.init(p.timer0);
    mut console := rp2350.usb.console.Console.open();
    mut count: u32 = 0;
    for {
        std.fmt.print(&mut console, "hello from the RP2350, {}\n", count);
        console.delay(&timer, .millis(1000));
        count = (count + 1).wrap(u32);
    }
};
