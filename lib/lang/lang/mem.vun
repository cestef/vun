//! Borrows, raw pointers and memory access (spec 05).

Ref: ($T: type) -> type = _;
RefMut: ($T: type) -> type = _;
RefOut: ($T: type) -> type = _;
RefTake: ($T: type) -> type = _;
/// `&temp T` and `&temp mut T`: a parameter's borrow lent for the call only (spec 05, section 4).
RefTemp: ($T: type) -> type = _;
RefTempMut: ($T: type) -> type = _;
/// `&static T`: a borrow of what lives as long as the program (spec 05, section 4).
RefStatic: ($T: type) -> type = _;
Ptr: ($T: type) -> type = _;
/// `[T]`: the items of an array of any length, reached through a borrow (`&[T]`).
Slice: ($T: type) -> type = _;
/// `[n]T`: `n` items of type `T`, a value.
Array: ($n: Int(0..), $T: type) -> type = _;

/// The number of items `xs` borrows.
#[panic.never]
len: ($T: type, xs: &[T]) -> usize = _;
/// A pointer to the first item `xs` borrows, for passing it to code outside the language.
#[panic.never]
items_pointer: ($T: type, xs: &[T]) -> *T = _;
/// A borrow of the `n` items at `p`, as code outside the language hands them over: they must
/// stay valid and unchanged for as long as the borrow is used.
#[panic.never]
items_at: unsafe ($T: type, p: *T, n: usize) -> &[T] = _;
/// An exclusive borrow of the `n` items at `p`: the memory must be valid, and nothing else may
/// reach it, for as long as the borrow is used.
#[panic.never]
items_at_mut: unsafe ($T: type, p: *T, n: usize) -> &mut [T] = _;

/// Unsynchronized interior mutability. Only usable in `unsafe` code (spec 07, section 2).
Cell: ($T: type) -> type = _;
/// A cell holding `value`.
#[panic.never]
cell: ($T: type, value: T) -> Cell(T) = _;
/// A pointer to what `c` holds, through which it may change while `c` is borrowed shared.
#[panic.never]
cell_pointer: unsafe ($T: type, c: &Cell(T)) -> *T = _;

/// A pointer to what `r` borrows. Creating a pointer is safe; using it is not (spec 05, section 5).
#[panic.never]
pointer_to: ($T: type, r: &T) -> *T = _;
/// The address `p` holds.
#[panic.never]
address: ($T: type, p: *T) -> usize = _;
/// The pointer holding `address`, as code outside the language hands one over (a mapping, a
/// device's registers): what it points to must be a `T` wherever it is used.
#[panic.never]
pointer_at: unsafe ($T: type, address: usize) -> *T = _;
/// The pointer `n` items of `T` past `p`.
#[panic.never]
offset: unsafe ($T: type, p: *T, n: isize) -> *T = _;
/// `p` as a pointer to a `U`.
#[panic.never]
cast: unsafe ($T: type, $U: type, p: *T) -> *U = _;
/// The value at `p`, which must be `init`.
#[panic.never, check.by(.pointers, lang.check.mem.read)]
read: unsafe ($T: type, p: *T) -> T = _;
/// Stores `value` at `p`, whatever was there.
#[panic.never, check.by(.pointers, lang.check.mem.write)]
write: unsafe ($T: type, p: *T, value: T) = _;
/// Copies `n` items from `from` to `to`, which may overlap.
#[panic.never, check.by(.pointers, lang.check.mem.copy)]
copy: unsafe ($T: type, to: *T, from: *T, n: usize) = _;
/// Stores `value` in `n` items from `to`.
#[panic.never, check.by(.pointers, lang.check.mem.fill)]
fill: unsafe ($T: type, to: *T, value: T, n: usize) = _;

#[panic.never]
volatile_load: unsafe ($T: type, p: *T) -> T = _;
#[panic.never]
volatile_store: unsafe ($T: type, p: *T, value: T) = _;

/// How an atomic access orders the accesses around it, as C11 defines the orders.
Order := enum { relaxed, acquire, release, acq_rel, seq_cst };

/// Atomic accesses to what `p` points to, which must be aligned for `T` and accessed atomically
/// only while shared (spec 05, section 5). The read-modify-write ones return the value held
/// before; `atomic_add` and `atomic_sub` wrap within `T`. An integer wider than an address runs
/// as `lang.mem.soft`'s, where the processor reaches it atomically as two words.
#[panic.never, lower.soft(lang.mem.soft.load)]
atomic_load: unsafe ($T: type, p: *T, order: Order) -> T = _;
#[panic.never, lower.soft(lang.mem.soft.store)]
atomic_store: unsafe ($T: type, p: *T, value: T, order: Order) = _;
#[panic.never, lower.soft(lang.mem.soft.swap)]
atomic_swap: unsafe ($T: type, p: *T, value: T, order: Order) -> T = _;
/// Stores `new` when `p` holds `expected`.
#[panic.never, lower.soft(lang.mem.soft.compare_swap)]
atomic_compare_swap: unsafe ($T: type, p: *T, expected: T, new: T, order: Order) -> T = _;
#[panic.never, lower.soft(lang.mem.soft.add)]
atomic_add: unsafe ($T: type, p: *T, value: T, order: Order) -> T = _;
#[panic.never, lower.soft(lang.mem.soft.sub)]
atomic_sub: unsafe ($T: type, p: *T, value: T, order: Order) -> T = _;
