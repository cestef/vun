//! Every compiler diagnostic, grouped by area. `cargo xtask generate` derives the ids of
//! `overt-diag` from this file. Each entry's explanation page lives next to it under `errors/`.

/// Tokens and syntax trees (spec 01).
syntax := struct {
    unknown_character := diag.Diag{ .explanation = meta.embed("errors/syntax/unknown_character.md") };
    unterminated_string := diag.Diag{ .explanation = meta.embed("errors/syntax/unterminated_string.md") };
    unterminated_char := diag.Diag{ .explanation = meta.embed("errors/syntax/unterminated_char.md") };
    invalid_escape := diag.Diag{ .explanation = meta.embed("errors/syntax/invalid_escape.md") };
    malformed_number := diag.Diag{ .explanation = meta.embed("errors/syntax/malformed_number.md") };
    stray_escape := diag.Diag{ .explanation = meta.embed("errors/syntax/stray_escape.md") };
    expected_token := diag.Diag{ .explanation = meta.embed("errors/syntax/expected_token.md") };
    expected_expression := diag.Diag{ .explanation = meta.embed("errors/syntax/expected_expression.md") };
    expected_declaration := diag.Diag{ .explanation = meta.embed("errors/syntax/expected_declaration.md") };
    expected_name := diag.Diag{ .explanation = meta.embed("errors/syntax/expected_name.md") };
    unclosed_delimiter := diag.Diag{ .explanation = meta.embed("errors/syntax/unclosed_delimiter.md") };
    chained_operator := diag.Diag{ .explanation = meta.embed("errors/syntax/chained_operator.md") };
    nesting_too_deep := diag.Diag{ .explanation = meta.embed("errors/syntax/nesting_too_deep.md") };
};

/// Range integers (spec 04).
int := struct {
    does_not_fit := diag.Diag{ .explanation = meta.embed("errors/int/does_not_fit.md") };
    width_cap := diag.Diag{ .explanation = meta.embed("errors/int/width_cap.md") };
};

/// Type checking (spec 02).
types := struct {
    mismatch := diag.Diag{ .explanation = meta.embed("errors/types/mismatch.md") };
    no_member := diag.Diag{ .explanation = meta.embed("errors/types/no_member.md") };
    no_impl := diag.Diag{ .explanation = meta.embed("errors/types/no_impl.md") };
};

/// Name resolution and visibility (spec 01, sections 3, 7 and 8).
names := struct {
    unresolved := diag.Diag{ .explanation = meta.embed("errors/names/unresolved.md") };
    shadowed := diag.Diag{ .explanation = meta.embed("errors/names/shadowed.md") };
    private := diag.Diag{ .explanation = meta.embed("errors/names/private.md") };
    duplicate := diag.Diag{ .explanation = meta.embed("errors/names/duplicate.md") };
};

/// Bindings and patterns (spec 01, sections 3 and 6).
binding := struct {
    hole_value := diag.Diag{ .explanation = meta.embed("errors/binding/hole_value.md") };
    irrefutable_test := diag.Diag{ .explanation = meta.embed("errors/binding/irrefutable_test.md") };
};

/// The `unsafe` boundary (spec 01, section 3; spec 05, section 5).
safety := struct {
    requires_unsafe := diag.Diag{ .explanation = meta.embed("errors/safety/requires_unsafe.md") };
};

/// Interface conformance (spec 02, section 3).
impl := struct {
    missing_requirement := diag.Diag{ .explanation = meta.embed("errors/impl/missing_requirement.md") };
    duplicate := diag.Diag{ .explanation = meta.embed("errors/impl/duplicate.md") };
};

/// Coroutine frames (spec 06, section 1).
coroutine := struct {
    recursive_frame := diag.Diag{ .explanation = meta.embed("errors/coroutine/recursive_frame.md") };
};

/// Layout attributes (spec 05, section 6).
layout := struct {
    bits_width := diag.Diag{ .explanation = meta.embed("errors/layout/bits_width.md") };
};

/// Compile-time evaluation and reflection (spec 03).
meta := struct {
    frozen := diag.Diag{ .explanation = meta.embed("errors/meta/frozen.md") };
};

/// Place states (spec 05, section 2).
place := struct {
    read_uninit := diag.Diag{ .explanation = meta.embed("errors/place/read_uninit.md") };
    linear_leak := diag.Diag{ .explanation = meta.embed("errors/place/linear_leak.md") };
    ambiguous_join := diag.Diag{ .explanation = meta.embed("errors/place/ambiguous_join.md") };
    out_unwritten := diag.Diag{ .explanation = meta.embed("errors/place/out_unwritten.md") };
};

/// Scoped borrows and exclusivity (spec 05, sections 4 and 8).
borrow := struct {
    conflict := diag.Diag{ .explanation = meta.embed("errors/borrow/conflict.md") };
    escape := diag.Diag{ .explanation = meta.embed("errors/borrow/escape.md") };
    in_free_value := diag.Diag{ .explanation = meta.embed("errors/borrow/in_free_value.md") };
};

/// Trap freedom (spec 07, section 3).
panic := struct {
    never_violated := diag.Diag{ .explanation = meta.embed("errors/panic/never_violated.md") };
};

/// Code generation backends (spec 13).
backend := struct {
    unavailable := diag.Diag{ .explanation = meta.embed("errors/backend/unavailable.md") };
};

/// Linking (spec 13).
link := struct {
    unavailable := diag.Diag{ .explanation = meta.embed("errors/link/unavailable.md") };
};

/// Package manifests: the `package` literal of `build.ov` (spec 12, section 2).
manifest := struct {
    missing_package := diag.Diag{ .explanation = meta.embed("errors/manifest/missing_package.md") };
    missing_field := diag.Diag{ .explanation = meta.embed("errors/manifest/missing_field.md") };
    unknown_field := diag.Diag{ .explanation = meta.embed("errors/manifest/unknown_field.md") };
    invalid_field := diag.Diag{ .explanation = meta.embed("errors/manifest/invalid_field.md") };
};

/// Packages and their namespaces on disk (spec 01, section 8, and spec 12, section 3).
package := struct {
    missing_dep := diag.Diag{ .explanation = meta.embed("errors/package/missing_dep.md") };
    missing_namespace := diag.Diag{ .explanation = meta.embed("errors/package/missing_namespace.md") };
    hash_mismatch := diag.Diag{ .explanation = meta.embed("errors/package/hash_mismatch.md") };
};

/// Reading and writing files.
io := struct {
    unreadable_file := diag.Diag{ .explanation = meta.embed("errors/io/unreadable_file.md") };
};

/// The command line (spec 12, section 7).
cli := struct {
    unknown_command := diag.Diag{ .explanation = meta.embed("errors/cli/unknown_command.md") };
    missing_argument := diag.Diag{ .explanation = meta.embed("errors/cli/missing_argument.md") };
    unexpected_argument := diag.Diag{ .explanation = meta.embed("errors/cli/unexpected_argument.md") };
    unknown_option := diag.Diag{ .explanation = meta.embed("errors/cli/unknown_option.md") };
    missing_value := diag.Diag{ .explanation = meta.embed("errors/cli/missing_value.md") };
    invalid_value := diag.Diag{ .explanation = meta.embed("errors/cli/invalid_value.md") };
    unavailable_command := diag.Diag{ .explanation = meta.embed("errors/cli/unavailable_command.md") };
};
