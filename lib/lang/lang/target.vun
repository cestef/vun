//! Target descriptions and feature requirements.

/// The order of a word's bytes in memory.
Endian := enum { little, big };

/// A C integer type of a target: its width in bits and its alignment in bytes.
CInt := struct { bits: u8, align: u8 };

/// The machine a C compiler's command builds for.
BuildsFor := enum {
    /// The target: a cross compiler (`arm-none-eabi-gcc`), or one its flags tell the target
    /// (`clang --target=...`).
    target,
    /// The machine it runs on, as a system's own `cc` does: it builds for the target only on a
    /// machine of it, and elsewhere the machine's tools file names another.
    host,
};

/// What a C compiler offers beyond C99 for atomic memory access.
Atomics := enum {
    /// Nothing: atomic access is refused.
    none,
    /// The `__atomic_*` builtins of GCC and Clang.
    gnu,
};

/// What a C compiler offers beyond C99 for placing data: alignments past every C type's, and
/// link sections.
Attributes := enum {
    /// Nothing: such data is refused.
    none,
    /// `__attribute__((aligned(n), section(name)))` of GCC and Clang.
    gnu,
};

/// How a C compiler reports the size of each function's frame.
FrameSizes := enum {
    /// It does not.
    none,
    /// `-fstack-usage`: a `.su` file beside each object, as GCC and Clang write it.
    stack_usage,
};

/// The C compiler building a target's C, and driving its link: its command, the flags that give
/// the C backend's rules (strict C99, memory without type-based aliasing), those its links take
/// (bare metal brings no C runtime), the libraries of its own they name, and what it offers
/// beyond C99.
CCompiler := struct {
    command: &[u8],
    builds_for: BuildsFor = .target,
    /// The program bundling objects into a static library, as `ar` does.
    archiver: &[u8],
    flags: &[&[u8]],
    /// The flags a release build adds to `flags`.
    optimize: &[&[u8]],
    link_flags: &[&[u8]],
    /// The libraries its links take after the objects, found where it finds its own (`gcc`).
    libraries: &[&[u8]],
    atomics: Atomics,
    attributes: Attributes,
    frame_sizes: FrameSizes,
    /// The option telling it the oldest release of the target's system, the release following
    /// it (clang's `-mmacos-version-min=`); none where the target records no release.
    version_flag: ?&[u8] = .none,
    /// The directory holding the headers and libraries of the target's system that its tools
    /// build against (a sysroot, an SDK): where a machine keeps them, which its tools file
    /// names, and none where they are the tools' own.
    sysroot: ?&[u8] = .none,
};

/// The C types of a target as its C compiler lays them out: the C backend declares its own
/// fixed-width types from them, and checks each while compiling (spec 13, section 8.2). A `char`
/// is 8 bits everywhere Vun runs.
C := struct {
    short: CInt,
    int: CInt,
    long: CInt,
    long_long: CInt,
    /// The alignment of an address.
    pointer_align: u8,
    compiler: CCompiler,
};

/// The calling convention of a target's C functions (spec 13, section 8.5): where a call passes
/// its arguments and gets its result.
Convention := enum {
    /// System V AMD64.
    sysv,
    /// The procedure call standard for 64-bit ARM (AAPCS64).
    aapcs64,
    /// Apple's variant of AAPCS64: a C call's scalars on the stack at their own size.
    darwin_arm64,
    /// The RISC-V convention for 64-bit integers and double-precision floats in registers.
    lp64d,
    /// The procedure call standard for 32-bit ARM, floats in VFP registers (hard-float EABI).
    aapcs_vfp,
    /// The procedure call standard for 32-bit ARM, floats in general registers (soft-float EABI).
    aapcs,
    /// The RISC-V convention for 32-bit integers, floats in general registers.
    ilp32,
    /// The C convention of `wasm32`, as clang follows it.
    wasm32,
};

/// The backends a target builds with under each profile, most preferred first: a build takes
/// the first the toolchain has that generates code for the target (spec 13, section 8).
Backends := struct {
    /// Fast to build, easy to debug: what `vun build` uses.
    debug: &[lang.meta.Name],
    /// Fast to run: `vun build --release`.
    release: &[lang.meta.Name],
};

/// A release of a system, as `11.0` is of macOS.
Version := struct {
    major: u16,
    minor: u16 = 0,
};

/// How many threads the programs of a target run.
Threads := enum {
    /// One: bare metal, WASI. Storage per thread is the program's.
    one,
    /// As many as they start, each with storage of its own.
    many,
};

/// A target, as data (spec 13, section 7): the package `targets` declares one per system,
/// architecture and ABI (`targets.linux.x86_64.kernel`), so adding a target changes no code. Architectures, CPUs, systems,
/// ABIs, object formats, backends and linkers are names, the sets of them open to what the
/// toolchain registers.
Spec := struct {
    /// The instruction set: `x86_64`, `arm64`, `riscv64`, `riscv32`, `arm`, `wasm32`.
    arch: lang.meta.Name,
    /// The instruction set its code is written in, which a block of inline assembly names as
    /// `lang.arch.<isa>` (spec 07, section 6): `thumb` for Arm's M profile, the arch otherwise.
    isa: lang.meta.Name,
    /// What its processor has of the instruction set beyond what every processor of it has, as
    /// the set's table names it (`lang.arch.thumb.Feature`): a block of instructions compiled for
    /// the target uses no form needing one it lacks.
    features: &[lang.meta.Name] = &[],
    /// The processor the code is for, `generic` for any of the architecture.
    cpu: lang.meta.Name,
    /// The system programs run on; `bare` on bare metal.
    os: lang.meta.Name,
    /// The conventions of the system's binaries: `gnu` (the GNU C library), `eabihf`, ...
    abi: lang.meta.Name,
    convention: Convention,
    /// The width of an address.
    pointer_bits: u8,
    /// The width of a general register: the widest integer its processor computes with, wider
    /// ones being computed in parts, and accessed atomically by `lang.mem.soft`
    /// (`lang.lower.soft`).
    register_bits: u8,
    /// The float types its processor computes; `lang.float.soft` computes the others
    /// (`lang.lower.soft`).
    floats: &[type],
    /// How many threads its programs run, which storage per thread follows (spec 07, section 2).
    threads: Threads = .one,
    endian: Endian,
    object_format: lang.meta.Name,
    /// The symbol a program starts at, when the target has one.
    entry_symbol: ?&[u8],
    /// The oldest release of its system its programs run on, where its binaries record one (as
    /// Mach-O's do); none where they do not.
    os_version: ?Version = .none,
    backends: Backends,
    linker: lang.meta.Name,
    c: C,
};

require: ($features: Features) -> Attribute(&[Place.functions]) = _;
Features: type = _;

/// The largest address of the target: `usize` is `Int(0..=usize_max)`.
usize_max: Int(0..) = _;

/// The target being built for, as its declaration gives it: code picks what differs between
/// systems by its members at compile time (`lang.target.current.os`). A machine's tools file
/// changes only where the tools are, which this value does not say.
current: Spec = _;

/// Whether the target's processor has `feature` (`Spec.features`).
has := ($feature: lang.meta.Name) -> bool {
    mut found := false;
    for f in current.features {
        if f.* == feature { found = true; }
    }
    found
};
