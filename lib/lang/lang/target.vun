//! Target descriptions and feature requirements.

/// The order of a word's bytes in memory.
Endian := enum { little, big };

/// A C integer type of a target: its width in bits and its alignment in bytes.
CInt := struct { bits: u8, align: u8 };

/// The C types of a target as its C compiler lays them out: the C backend declares its own
/// fixed-width types from them, and checks each while compiling (spec 13, section 8.2). A `char`
/// is 8 bits everywhere Vun runs.
C := struct {
    short: CInt,
    int: CInt,
    long: CInt,
    long_long: CInt,
    /// The alignment of an address.
    pointer_align: u8,
};

/// A target, as data (spec 13, section 7): the package `targets` declares one per system and CPU
/// (`targets.linux.x86_64`), so adding a target rebuilds nothing. Architectures, CPUs, systems,
/// ABIs, object formats, backends and linkers are names, the sets of them open to what the
/// toolchain registers.
Spec := struct {
    /// The instruction set: `x86_64`, `arm64`, `riscv64`, `riscv32`, `arm`, `wasm32`.
    arch: lang.meta.Name,
    /// The processor the code is for, `generic` for any of the architecture.
    cpu: lang.meta.Name,
    /// The system programs run on; `bare` on bare metal.
    os: lang.meta.Name,
    /// The conventions of the system's binaries: `gnu` (the GNU C library), `eabihf`, ...
    abi: lang.meta.Name,
    /// The width of an address.
    pointer_bits: u8,
    endian: Endian,
    object_format: lang.meta.Name,
    /// The symbol a program starts at, when the target has one.
    entry_symbol: ?&[u8],
    default_backend: lang.meta.Name,
    default_linker: lang.meta.Name,
    c: C,
};

/// A machine the toolchain runs on, as the toolchain names it, and the target it builds for
/// there unless told otherwise.
Host := struct {
    arch: lang.meta.Name,
    os: lang.meta.Name,
    target: Spec,
};
require: ($features: Features) -> Attribute = _;
Features: type = _;

/// The largest address of the target: `usize` is `Int(0..=usize_max)`.
usize_max: Int(0..) = _;
