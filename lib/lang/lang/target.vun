//! Target descriptions and feature requirements.

/// The order of a word's bytes in memory.
Endian := enum { little, big };

/// A target, as data (spec 13, section 7): a file of the package `targets` declares one, so
/// adding a target rebuilds nothing. Architectures, object formats, backends and linkers are
/// names, the sets of them open to what the toolchain registers.
Spec := struct {
    arch: lang.meta.Name,
    /// The width of an address.
    pointer_bits: u8,
    endian: Endian,
    object_format: lang.meta.Name,
    /// The symbol a program starts at, when the target has one.
    entry_symbol: ?&[u8],
    default_backend: lang.meta.Name,
    default_linker: lang.meta.Name,
};
require: ($features: Features) -> Attribute = _;
Features: type = _;

/// The largest address of the target: `usize` is `Int(0..=usize_max)`.
usize_max: Int(0..) = _;
