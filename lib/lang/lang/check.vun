//! Checks of unsafe code at run time (spec 07, section 7; spec 13, section 8.7): what a program
//! may be built to check, the operations its runtime provides for the checks, and how a failed
//! one is reported.

/// What a program may be built to check (`std.build.Options.checks`).
Kind := enum {
    /// Reads and writes through raw pointers.
    pointers,
    /// What allocators hand out and are given back.
    allocations,
    /// The memory assembly blocks write, and the stack pointer they return with.
    asm,
};

/// The checks the program is built with (`std.build.Options.checks`), known when compiling, as
/// `lang.target.current` is: a runtime exports the operations below only for a program they check.
current: &[Kind] = _;

/// At run time, in a program built with `kind` checked, each call of the declaration this marks
/// is a call of `f`: its arguments, then the call's origin as a `$` `lang.meta.Origin`.
by: ($kind: Kind, $F: type, $f: F) -> Attribute(&[Place.decls]) = _;

/// The bytes of memory one byte of the runtime's shadow describes, which a slot with a redzone
/// starts at a multiple of.
granule := 8;
/// The bytes poisoned past a stack slot whose address is taken, a multiple of `granule`.
redzone := 16;
/// The bytes of memory given back that the quarantine holds poisoned before giving them to their
/// allocator, past which each free gives back the oldest its allocator has there.
quarantine := 1 << 20;

/// Why a check fails, or why memory is poisoned.
Violation := enum {
    /// Bytes no object holds: past an allocation, a slot or a datum.
    outside,
    /// Memory an allocator was given back.
    freed,
    /// A slot of a function that has returned.
    returned,
    /// Memory given back twice.
    double_free,
    /// Memory given back that the allocator did not hand out.
    foreign_free,
    /// Memory given back with another size than it was handed out with.
    size_mismatch,
    /// An assembly block returning with the stack pointer moved.
    stack_moved,
};

/// How an access touches memory.
Access := enum { read, write };

/// A failed check: its site in the message table, why it failed, and the address it failed at.
Failure := struct {
    site: u32,
    violation: Violation,
    address: usize,
};

/// Memory an allocator was given back, held in the quarantine: where, how much, the alignment it
/// was handed out with, and the allocator's address.
Held := struct {
    address: usize,
    bytes: usize,
    align: usize,
    allocator: usize,
};

/// The link symbols of this namespace's declarations, which a runtime exports.
symbols := struct {
    access := "vun_check_access";
    poison := "vun_check_poison";
    unpoison := "vun_check_unpoison";
    allocated := "vun_check_allocated";
    freed := "vun_check_freed";
    hold := "vun_check_hold";
    evict := "vun_check_evict";
    fail := "vun_check_fail";
    asm_write := "vun_check_asm_write";
    asm_stack := "vun_check_asm_stack";
};

/// Why the `bytes` at `address` may not be accessed, if they may not.
#[link.symbol(symbols.access)]
access: (address: usize, bytes: usize, access: Access) -> ?Violation = _;

/// Marks the `bytes` at `address` as held by no object, for `why`.
#[link.symbol(symbols.poison)]
poison: (address: usize, bytes: usize, why: Violation) = _;

/// Marks the `bytes` at `address` as held by an object.
#[link.symbol(symbols.unpoison)]
unpoison: (address: usize, bytes: usize) = _;

/// Records that an allocator handed out the `bytes` at `address`.
#[link.symbol(symbols.allocated)]
allocated: (address: usize, bytes: usize) = _;

/// Records that an allocator was given back the `bytes` at `address` and poisons them; why it may
/// not be, if it may not: they were given back already, never handed out, or with another size.
#[link.symbol(symbols.freed)]
freed: (address: usize, bytes: usize) -> ?Violation = _;

/// Holds `held` in the quarantine; gives it back when the quarantine has no room for it.
#[link.symbol(symbols.hold)]
hold: (held: &Held) -> ?Held = _;

/// The oldest memory the allocator at `allocator` has in the quarantine, to give it back now, while
/// the quarantine holds more than `quarantine` bytes or has no room left.
#[link.symbol(symbols.evict)]
evict: (allocator: usize) -> ?Held = _;

/// Reports `f` and ends the program, as a trap does.
#[link.symbol(symbols.fail)]
fail: (f: &Failure) -> lang.never = _;

/// Fails at the site `site` unless the `bytes` at `address` may be written: what a backend calls
/// before an instruction of an assembly block writing memory, from machine code, with scalars.
#[link.symbol(symbols.asm_write), abi.c]
asm_write: (address: usize, bytes: usize, site: u32) = _;

/// Fails at the site `site` for an assembly block returning with the stack pointer moved from
/// `before` to `after`.
#[link.symbol(symbols.asm_stack), abi.c]
asm_stack: (site: u32, before: usize, after: usize) -> lang.never = _;

/// The id of a new trap site at `at`, which a check made there fails at: the message table
/// records it as it records a trap site.
site: ($at: lang.meta.Origin) -> u32 = _;

/// Fails the check made at `at` for `violation`, at `address`.
failed := ($at: lang.meta.Origin, violation: Violation, address: usize) -> lang.never {
    fail(&.{ .site = site(at), .violation = violation, .address = address })
};

/// Fails the check made at `at` unless the `bytes` at `address` may be accessed as `how` says.
accessed := ($at: lang.meta.Origin, address: usize, bytes: usize, how: Access) {
    match access(address, bytes, how) {
        .some(violation) => failed(at, violation, address),
        .none => {},
    }
};
