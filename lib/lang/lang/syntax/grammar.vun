//! The grammar of Vun, defined once. Generates the Rust `vun-grammar` crate, `lang.syntax`,
//! the formatter's tables and the editor grammar (spec 13, section 5).
//!
//! `cargo xtask grammar` reads this file as literal data, by shape and never by name:
//! - a `PascalCase` record of lists defines a kind: its entries are the kind's variants, and each
//!   list is also a table of its own. An entry is `.name`, a spelling `"text"` (named after
//!   itself), `.{ .name = .x, .text = "..." }`, or `.name(.count(.field), ...)` for a kind with
//!   named children: `count` is a variant of `Count`, and a field named after a variant of the kind
//!   holds a node of that kind, any other field any node;
//! - an `enum` declaration defines an enum;
//! - any other list is a table; `.name` items resolve to the one kind or enum that has them all.

/// Kinds of tokens.
TokenKind := .{
    .trivia = [.whitespace, .comment],
    .atoms = [
        .doc_comment,
        .module_doc_comment,
        .ident,
        .raw_ident,
        .int,
        .float,
        .char,
        .string,
        .raw_string,
        .raw_string_line,
        .label,
        .error,
    ],
    .keywords = [
        "mut",
        "if",
        "else",
        "match",
        "for",
        "break",
        "continue",
        "return",
        "yield",
        "defer",
        "and",
        "or",
        "struct",
        "enum",
        "unsafe",
    ],
    .punctuation = [
        .{ .name = .colon_eq, .text = ":=" },
        .{ .name = .colon, .text = ":" },
        .{ .name = .eq, .text = "=" },
        .{ .name = .eq_eq, .text = "==" },
        .{ .name = .bang_eq, .text = "!=" },
        .{ .name = .lt, .text = "<" },
        .{ .name = .le, .text = "<=" },
        .{ .name = .gt, .text = ">" },
        .{ .name = .ge, .text = ">=" },
        .{ .name = .arrow, .text = "->" },
        .{ .name = .fat_arrow, .text = "=>" },
        .{ .name = .dot, .text = "." },
        .{ .name = .dot_star, .text = ".*" },
        .{ .name = .dot_dot, .text = ".." },
        .{ .name = .dot_dot_eq, .text = "..=" },
        .{ .name = .dot_l_brace, .text = ".{" },
        .{ .name = .comma, .text = "," },
        .{ .name = .semi, .text = ";" },
        .{ .name = .l_paren, .text = "(" },
        .{ .name = .r_paren, .text = ")" },
        .{ .name = .l_bracket, .text = "[" },
        .{ .name = .r_bracket, .text = "]" },
        .{ .name = .l_brace, .text = "{" },
        .{ .name = .r_brace, .text = "}" },
        .{ .name = .hash_l_bracket, .text = "#[" },
        .{ .name = .hash_l_brace, .text = "#{" },
        .{ .name = .dollar, .text = "$" },
        .{ .name = .question, .text = "?" },
        .{ .name = .amp, .text = "&" },
        .{ .name = .pipe, .text = "|" },
        .{ .name = .caret, .text = "^" },
        .{ .name = .tilde, .text = "~" },
        .{ .name = .bang, .text = "!" },
        .{ .name = .plus, .text = "+" },
        .{ .name = .minus, .text = "-" },
        .{ .name = .star, .text = "*" },
        .{ .name = .slash, .text = "/" },
        .{ .name = .percent, .text = "%" },
        .{ .name = .plus_plus, .text = "++" },
        .{ .name = .shl, .text = "<<" },
        .{ .name = .shr, .text = ">>" },
        .{ .name = .plus_eq, .text = "+=" },
        .{ .name = .minus_eq, .text = "-=" },
        .{ .name = .star_eq, .text = "*=" },
        .{ .name = .slash_eq, .text = "/=" },
        .{ .name = .percent_eq, .text = "%=" },
        .{ .name = .amp_eq, .text = "&=" },
        .{ .name = .pipe_eq, .text = "|=" },
        .{ .name = .caret_eq, .text = "^=" },
        .{ .name = .shl_eq, .text = "<<=" },
        .{ .name = .shr_eq, .text = ">>=" },
        .{ .name = .plus_percent_eq, .text = "+%=" },
        .{ .name = .minus_percent_eq, .text = "-%=" },
        .{ .name = .star_percent_eq, .text = "*%=" },
        .{ .name = .plus_pipe_eq, .text = "+|=" },
        .{ .name = .minus_pipe_eq, .text = "-|=" },
        .{ .name = .star_pipe_eq, .text = "*|=" },
        .{ .name = .underscore, .text = "_" },
    ],
    .end = [.eof],
};

/// How many nodes a child position of a kind holds.
Count := enum {
    one,
    optional,
    many,
};

/// Kinds of syntax tree nodes (spec 13, section 2). A leaf never has children. A branch lists its
/// children in source order, punctuation left out; `Cst::fields` matches them. An `error` stands for
/// skipped or absent source; a skipped group holds the tokens after its first.
NodeKind := .{
    .leaves = [
        .punct, .module_doc, .\mut, .mode, .name, .hole, .int, .float, .char, .string,
        .raw_string_line, .label, .rest, .flow, .writeback,
    ],
    .branches = [
        .error(.many(.skipped)),
        .file(.many(.items)),
        .doc(.one(.target)),
        .attr(.many(.values), .one(.target)),
        .binding(.optional(.\mut), .one(.pattern), .one(.value)),
        .typed_binding(.optional(.\mut), .one(.pattern), .one(.type), .optional(.value)),
        .field(.optional(.\mut), .one(.pattern), .one(.type), .optional(.value)),
        .spread(.one(.source), .optional(.select)),
        .select(.many(.names)),
        .param(.one(.pattern), .one(.type)),
        .returns(.one(.type)),
        .\fn(.many(.params), .optional(.returns), .one(.block)),
        .fn_type(.many(.params), .optional(.returns)),
        .closure(.many(.captures), .one(.\fn)),
        .block(.many(.statements)),
        .quote(.many(.statements)),
        .\struct(.many(.members)),
        .\enum(.many(.variants), .optional(.namespace)),
        .namespace(.many(.members)),
        .paren(.one(.inner)),
        .tuple(.many(.items)),
        .array(.many(.items)),
        .array_repeat(.one(.value), .one(.count)),
        .array_type(.one(.length), .one(.element)),
        .struct_lit(.many(.fields)),
        .typed_lit(.one(.type), .many(.fields)),
        .field_init(.one(.target), .one(.value)),
        .dot_name(.one(.property)),
        .member(.one(.object), .one(.property)),
        .call(.one(.callee), .many(.args)),
        .index(.one(.object), .one(.subscript)),
        .prefix(.many(.mode), .one(.operand)),
        .postfix(.one(.operand)),
        .infix(.one(.left), .optional(.right)),
        .assign(.one(.place), .one(.value)),
        .\if(.one(.condition), .one(.block), .optional(.otherwise)),
        .test(.one(.pattern), .one(.value)),
        .\for(.optional(.head), .one(.block)),
        .in(.one(.pattern), .one(.value)),
        .\match(.one(.scrutinee), .many(.arms)),
        .arm(.one(.pattern), .optional(.guard), .optional(.value)),
        .guard(.one(.condition)),
        .labeled(.one(.body)),
        .\return(.optional(.value)),
        .\break(.optional(.label), .optional(.value)),
        .\continue(.optional(.label)),
        .\yield(.one(.value)),
        .\defer(.one(.body)),
        .multiline_string(.many(.lines)),
        .asm(.one(.target), .many(.lines)),
        .line(.many(.suffix), .many(.operands)),
        .suffix(.one(.name)),
        .bound(.optional(.flow), .optional(.register), .one(.value)),
        .memory(.many(.parts), .optional(.writeback)),
    ],
};

/// Where a contextual keyword is recognized; elsewhere it is a name.
Context := enum {
    /// After the pattern of a `for`.
    for_pattern,
    /// After a `.` and before `{`: a block of an architecture's instructions (spec 07, section 6).
    asm_block,
};

/// The words after `&` naming a borrow mode (appendix B, the table `borrows`): first a qualifier
/// of how long a call holds the borrow, then a word of what it does to the place. `mut` is a
/// keyword; the others are words only there.
BorrowWord := .{
    .qualifiers = ["temp"],
    .modes = ["mut", "out", "take", "static"],
};

/// The words opening a value bound to an instruction's operand (spec 07, section 6): whether the
/// instruction reads it, writes it, or both. They are words only there.
Flow := .{
    .flows = ["in", "out", "inout"],
};

/// How an infix operator groups with its own level.
Assoc := enum {
    left,
    /// Chaining is an error: `a < b < c`.
    none,
};

/// Words that are keywords only in one context.
contextual := [
    .{ .text = "in", .context = .for_pattern },
    .{ .text = "asm", .context = .asm_block },
];

/// How the formatter spaces tokens where a table says (spec 13, section 5).
Spacing := enum {
    /// No space: `(a)`, `0..n`.
    tight,
    /// One space: `{ x }`, `a + b`.
    spaced,
};

/// Opening delimiters, the tokens that close them, and how their contents are spaced inside.
delimiters := [
    .{ .open = .l_paren, .close = .r_paren, .inside = .tight },
    .{ .open = .l_bracket, .close = .r_bracket, .inside = .tight },
    .{ .open = .hash_l_bracket, .close = .r_bracket, .inside = .tight },
    .{ .open = .l_brace, .close = .r_brace, .inside = .spaced },
    .{ .open = .hash_l_brace, .close = .r_brace, .inside = .spaced },
    .{ .open = .dot_l_brace, .close = .r_brace, .inside = .spaced },
];

/// Punctuation written right after what it follows, and a space after it: `a, b`, `x: T`.
separators := [.comma, .semi, .colon];

/// Infix operator levels, loosest first (spec 01, section 6), and how the formatter spaces them.
/// Each level lists its tokens by borrow, so that levels of different sizes share one type.
infix := [
    .{ .assoc = .left, .tokens = &[.\or], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.\and], .around = .spaced },
    .{ .assoc = .none, .tokens = &[.eq_eq, .bang_eq, .lt, .le, .gt, .ge], .around = .spaced },
    .{ .assoc = .none, .tokens = &[.dot_dot, .dot_dot_eq], .around = .tight },
    .{ .assoc = .left, .tokens = &[.pipe], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.caret], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.amp], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.shl, .shr], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.plus_plus], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.plus, .minus], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.star, .slash, .percent], .around = .spaced },
];

/// Operators written before their operand. `&` may be followed by borrow modes (`&temp mut`);
/// `..` without an operand is a rest pattern.
prefix := [.minus, .bang, .tilde, .amp, .star, .question, .dot_dot, .dollar, .\unsafe];

/// Operators written after their operand, besides member access, calls, indexing and literals.
postfix := [.dot_star, .question];

/// Operators of assignment statements.
assign := [
    .eq, .plus_eq, .minus_eq, .star_eq, .slash_eq, .percent_eq, .amp_eq, .pipe_eq, .caret_eq,
    .shl_eq, .shr_eq, .plus_percent_eq, .minus_percent_eq, .star_percent_eq, .plus_pipe_eq,
    .minus_pipe_eq, .star_pipe_eq,
];

/// Tokens that can start an operand, besides prefix operators.
operands := [
    .ident, .raw_ident, .underscore, .int, .float, .char, .string, .raw_string, .raw_string_line,
    .dot, .dot_l_brace, .l_paren, .l_bracket, .l_brace, .hash_l_brace, .hash_l_bracket, .\if,
    .\for, .\match, .label, .\struct, .\enum, .\return, .\break, .\continue, .\yield, .\defer,
    .error,
];

/// Tokens after `[n]` that make it the array type `[n]T` rather than a one-element array.
element_types := [
    .ident, .raw_ident, .underscore, .l_bracket, .star, .question, .amp, .dollar, .\struct,
    .\enum, .hash_l_bracket, .\unsafe,
];

/// Nodes after which `{` opens a typed struct literal: `Point{ }`, `lang.target.Spec{ }`.
literal_types := [.name, .member, .call];
