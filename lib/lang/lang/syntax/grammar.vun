//! The grammar of Vun, defined once with `nodes.vun`, which holds the kinds of nodes and their
//! productions, and `tables.vun`, the tables that say how they nest: its tokens and tables. Generates the Rust `vun-grammar` crate, `lang.syntax`, the
//! formatter's tables and the editor grammars (spec 13, section 5).
//!
//! `cargo gen` reads both files as literal data. Into Rust it translates each declaration by shape,
//! never by name:
//! - a `PascalCase` record of lists defines a kind: its entries are the kind's variants, and each
//!   list is also a table of its own. An entry is `.name`, a spelling `"text"` (named after
//!   itself), `.{ .name = .x, .text = "..." }`, or `.name(terms...)` for a kind with a production
//!   (see `NodeKind`), whose fields and their counts, variants of `Count`, it derives;
//! - an `enum` declaration defines an enum;
//! - any other list is a table; `.name` items resolve to the one kind or enum that has them all.
//!
//! What it interprets, the productions and the tables editors and the parser share (`parts`,
//! `admits`, `precedence`, ...), it reads by type, and resolves every name and path in them; what
//! editors make of the grammar is in `editors.vun`.

/// Kinds of tokens.
#[lint.allow(std.lints.naming.case, "the grammar generator makes a Rust enum of it")]
TokenKind := .{
    .trivia = [.whitespace, .comment],
    .atoms = [
        .doc_comment,
        .module_doc_comment,
        .ident,
        .raw_ident,
        .int,
        .float,
        .char,
        .string,
        .raw_string,
        .raw_string_line,
        .label,
        .error,
    ],
    .keywords = [
        "mut",
        "if",
        "else",
        "match",
        "for",
        "break",
        "continue",
        "return",
        "yield",
        "defer",
        "and",
        "or",
        "struct",
        "enum",
        "unsafe",
    ],
    .punctuation = [
        .{ .name = .colon_eq, .text = ":=" },
        .{ .name = .colon, .text = ":" },
        .{ .name = .eq, .text = "=" },
        .{ .name = .eq_eq, .text = "==" },
        .{ .name = .bang_eq, .text = "!=" },
        .{ .name = .lt, .text = "<" },
        .{ .name = .le, .text = "<=" },
        .{ .name = .gt, .text = ">" },
        .{ .name = .ge, .text = ">=" },
        .{ .name = .arrow, .text = "->" },
        .{ .name = .fat_arrow, .text = "=>" },
        .{ .name = .dot, .text = "." },
        .{ .name = .dot_star, .text = ".*" },
        .{ .name = .dot_dot, .text = ".." },
        .{ .name = .dot_dot_eq, .text = "..=" },
        .{ .name = .dot_l_brace, .text = ".{" },
        .{ .name = .comma, .text = "," },
        .{ .name = .semi, .text = ";" },
        .{ .name = .l_paren, .text = "(" },
        .{ .name = .r_paren, .text = ")" },
        .{ .name = .l_bracket, .text = "[" },
        .{ .name = .r_bracket, .text = "]" },
        .{ .name = .l_brace, .text = "{" },
        .{ .name = .r_brace, .text = "}" },
        .{ .name = .hash_l_bracket, .text = "#[" },
        .{ .name = .hash_l_brace, .text = "#{" },
        .{ .name = .dollar, .text = "$" },
        .{ .name = .question, .text = "?" },
        .{ .name = .amp, .text = "&" },
        .{ .name = .pipe, .text = "|" },
        .{ .name = .caret, .text = "^" },
        .{ .name = .tilde, .text = "~" },
        .{ .name = .bang, .text = "!" },
        .{ .name = .plus, .text = "+" },
        .{ .name = .minus, .text = "-" },
        .{ .name = .star, .text = "*" },
        .{ .name = .slash, .text = "/" },
        .{ .name = .percent, .text = "%" },
        .{ .name = .plus_plus, .text = "++" },
        .{ .name = .shl, .text = "<<" },
        .{ .name = .shr, .text = ">>" },
        .{ .name = .plus_eq, .text = "+=" },
        .{ .name = .minus_eq, .text = "-=" },
        .{ .name = .star_eq, .text = "*=" },
        .{ .name = .slash_eq, .text = "/=" },
        .{ .name = .percent_eq, .text = "%=" },
        .{ .name = .amp_eq, .text = "&=" },
        .{ .name = .pipe_eq, .text = "|=" },
        .{ .name = .caret_eq, .text = "^=" },
        .{ .name = .shl_eq, .text = "<<=" },
        .{ .name = .shr_eq, .text = ">>=" },
        .{ .name = .plus_percent_eq, .text = "+%=" },
        .{ .name = .minus_percent_eq, .text = "-%=" },
        .{ .name = .star_percent_eq, .text = "*%=" },
        .{ .name = .plus_pipe_eq, .text = "+|=" },
        .{ .name = .minus_pipe_eq, .text = "-|=" },
        .{ .name = .star_pipe_eq, .text = "*|=" },
        .{ .name = .underscore, .text = "_" },
    ],
    .end = [.eof],
};

/// Where a contextual keyword is recognized; elsewhere it is a name.
Context := enum {
    /// After the pattern of a `for`.
    for_pattern,
    /// Where a declaration starts and a name follows, as `impl` in `impl Format for Int($r) { }`.
    declaration,
};

/// The words after `&` naming a borrow mode (appendix B, the table `borrows`): first a qualifier
/// of how long a call holds the borrow, then a word of what it does to the place. `mut` is a
/// keyword; the others are words only there.
#[lint.allow(std.lints.naming.case, "the grammar generator makes a Rust enum of it")]
BorrowWord := .{
    .qualifiers = ["temp"],
    .modes = ["mut", "out", "take", "static"],
};

/// How an infix operator groups with its own level.
Assoc := enum {
    left,
    /// Chaining is an error: `a < b < c`.
    none,
};

/// Words that are keywords only in one context.
contextual := [
    .{ .text = "in", .context = .for_pattern },
    .{ .text = "impl", .context = .declaration },
];

/// How the formatter spaces tokens where a table says (spec 13, section 5).
Spacing := enum {
    /// No space: `(a)`, `0..n`.
    tight,
    /// One space: `{ x }`, `a + b`.
    spaced,
};

/// Opening delimiters, the tokens that close them, and how their contents are spaced inside.
delimiters := [
    .{ .open = .l_paren, .close = .r_paren, .inside = .tight },
    .{ .open = .l_bracket, .close = .r_bracket, .inside = .tight },
    .{ .open = .hash_l_bracket, .close = .r_bracket, .inside = .tight },
    .{ .open = .l_brace, .close = .r_brace, .inside = .spaced },
    .{ .open = .hash_l_brace, .close = .r_brace, .inside = .spaced },
    .{ .open = .dot_l_brace, .close = .r_brace, .inside = .spaced },
];

/// Punctuation written right after what it follows, and a space after it: `a, b`, `x: T`.
separators := [.comma, .semi, .colon];

/// Infix operator levels, loosest first (spec 01, section 6), and how the formatter spaces them.
/// Each level lists its tokens by borrow, so that levels of different sizes share one type.
infix := [
    .{ .assoc = .left, .tokens = &[.\or], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.\and], .around = .spaced },
    .{ .assoc = .none, .tokens = &[.eq_eq, .bang_eq, .lt, .le, .gt, .ge], .around = .spaced },
    .{ .assoc = .none, .tokens = &[.dot_dot, .dot_dot_eq], .around = .tight },
    .{ .assoc = .left, .tokens = &[.pipe], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.caret], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.amp], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.shl, .shr], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.plus_plus], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.plus, .minus], .around = .spaced },
    .{ .assoc = .left, .tokens = &[.star, .slash, .percent], .around = .spaced },
];

/// Infix operators whose right operand may be left out: `a..` has no upper bound.
open_ended := [.dot_dot];

/// Operators written before their operand. `&` may be followed by borrow modes (`&temp mut`);
/// `..` without an operand is a rest pattern.
prefix := [.minus, .bang, .tilde, .amp, .star, .question, .dot_dot, .dollar, .\unsafe];

/// Operators written after their operand, besides member access, calls, indexing and literals.
postfix := [.dot_star, .question];

/// Operators of assignment statements.
assign := [
    .eq, .plus_eq, .minus_eq, .star_eq, .slash_eq, .percent_eq, .amp_eq, .pipe_eq, .caret_eq,
    .shl_eq, .shr_eq, .plus_percent_eq, .minus_percent_eq, .star_percent_eq, .plus_pipe_eq,
    .minus_pipe_eq, .star_pipe_eq,
];

/// Tokens that can start an operand, besides prefix operators.
operands := [
    .ident, .raw_ident, .underscore, .int, .float, .char, .string, .raw_string, .raw_string_line,
    .dot, .dot_l_brace, .l_paren, .l_bracket, .l_brace, .hash_l_brace, .hash_l_bracket, .\if,
    .\for, .\match, .label, .\struct, .\enum, .\return, .\break, .\continue, .\yield, .\defer,
    .error,
];

/// Tokens after `[n]` that make it the array type `[n]T` rather than a one-element array, which
/// its element starts with: `[4](u8, u8)` too.
element_types := [
    .l_paren, .ident, .raw_ident, .underscore, .l_bracket, .star, .question, .amp, .dollar, .\struct,
    .\enum, .hash_l_bracket, .\unsafe,
];

/// Nodes after which `{` opens a typed struct literal: `Point{ }`, `lang.target.Spec{ }`.
literal_types := [.name, .member, .call];
