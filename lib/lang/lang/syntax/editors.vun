//! How editors show and navigate Vun, beside its grammar (spec 13, section 5): what the
//! tree-sitter queries capture and the Sublime syntax scopes. `cargo gen` reads it with
//! `grammar.vun` and `nodes.vun`; captures and scopes are named as the generator declares them,
//! and each editor names a capture its own way.
//!
//! A pattern captures nodes `.{ .nodes = &[...], .capture = .c }`, named after a node kind or a
//! token kind, or captures a node where it stands `.{ .kind = .k, .field = .f, .node = .n,
//! .capture = .c }`: a node `n` in the field `f` of a `k`, or, with `.inner = .g`, in the field `g`
//! of what that field holds.

// The files whose kinds, tokens and tables this names.
grammar := lang.syntax.grammar;
nodes := lang.syntax.nodes;

// Highlights, general patterns first: a later one wins where several match.
highlights := .{
    // The leaf names are, captured as variables, or as types where they start with a capital.
    .name = .name,
    // Tokens by the list or table they are in, a later one over an earlier: a keyword operator
    // (`and`) is a keyword.
    .tokens = .{
        .{ .tokens = grammar.separators, .capture = .delimiter },
        .{ .tokens = grammar.delimiters, .capture = .bracket },
        .{ .tokens = grammar.postfix, .capture = .operator },
        .{ .tokens = grammar.prefix, .capture = .operator },
        .{ .tokens = grammar.infix, .capture = .operator },
        .{ .tokens = grammar.assign, .capture = .operator },
        .{ .tokens = grammar.TokenKind.keywords, .capture = .keyword },
    },
    .nodes = [
        .{ .nodes = &[.comment], .capture = .comment },
        .{ .nodes = &[.doc_comment, .module_doc], .capture = .documentation },
        .{ .nodes = &[.int, .float], .capture = .number },
        .{ .nodes = &[.string, .raw_string_line], .capture = .string },
        .{ .nodes = &[.char], .capture = .character },
        .{ .nodes = &[.label], .capture = .label },
        .{ .nodes = &[.hole], .capture = .builtin },
        .{ .nodes = &[.rest], .capture = .operator },
        .{ .nodes = &[.\mut, .qualifier, .mode], .capture = .keyword },
    ],
    .places = .{
        .{ .kind = .param, .field = .pattern, .node = .name, .capture = .parameter },
        .{ .kind = .member, .field = .property, .node = .name, .capture = .property },
        .{ .kind = .dot_name, .field = .property, .node = .name, .capture = .variant },
        .{ .kind = .call, .field = .callee, .node = .name, .capture = .call },
        .{ .kind = .call, .field = .callee, .inner = .property, .node = .name, .capture = .method },
    },
    // Bindings whose value says what their name names.
    .bindings = [
        .{
            .kinds = [.binding, .typed_binding],
            .name = .pattern,
            .value = .value,
            .values = [.\fn, .closure],
            .capture = .function,
        },
        .{
            .kinds = [.binding, .typed_binding],
            .name = .pattern,
            .value = .value,
            .values = [.\struct, .\enum],
            .capture = .type,
        },
    ],
};

// The outline: declarations, by the name in their pattern.
outline := .{ .kinds = [.binding, .typed_binding, .field], .field = .pattern, .node = .name };

// Text objects: functions and their bodies, types, parameters, comments.
text_objects := .{
    .nodes = [
        .{ .nodes = &[.\fn, .closure], .capture = .function_around },
        .{ .nodes = &[.\struct, .\enum], .capture = .type_around },
        .{ .nodes = &[.param], .capture = .parameter_inside },
        .{ .nodes = &[.comment, .doc_comment], .capture = .comment_around },
    ],
    .places = .{ .{ .kind = .\fn, .field = .block, .node = .block, .capture = .function_inside } },
};

// The Sublime syntax: the scope of each punctuation token, and the tokens around names that say
/// what they name.
sublime := .{
    // Punctuation by the first of these tables it is in.
    .tables = .{
        .{ .tokens = grammar.assign, .scope = .assignment },
        .{ .tokens = grammar.infix, .scope = .operator },
        .{ .tokens = grammar.prefix, .scope = .operator },
        .{ .tokens = grammar.postfix, .scope = .operator },
        .{ .tokens = grammar.delimiters, .scope = .section },
        .{ .tokens = grammar.separators, .scope = .separator },
    },
    // Punctuation whose scope says more than its tables do.
    .special = [
        .{ .token = .colon_eq, .scope = .declaration },
        .{ .token = .arrow, .scope = .declaration },
        .{ .token = .fat_arrow, .scope = .declaration },
        .{ .token = .dollar, .scope = .stage },
        .{ .token = .hash_l_brace, .scope = .quote },
        .{ .token = .hash_l_bracket, .scope = .annotation },
        .{ .token = .underscore, .scope = .hole },
    ],
    // The words it scopes as keywords, a borrow's words, and the punctuation.
    .keywords = grammar.TokenKind.keywords,
    .qualifiers = grammar.BorrowWord.qualifiers,
    .modes = grammar.BorrowWord.modes,
    .punctuation = grammar.TokenKind.punctuation,
    // A member after `.`, a call before `(`, a definition before `:=`, a borrow's words after
    // `&`.
    .member = .dot,
    .call = .l_paren,
    .binds = .colon_eq,
    .borrow = .amp,
};

// The tree-sitter grammar: what tree-sitter has its own of, the token keywords are spelled as,
/// which it keeps apart from them, and the tokens standing anywhere.
tree_sitter := .{
    .error = .error,
    .end = grammar.TokenKind.end,
    .word = .ident,
    .extras = [.comment],
};
