//! What syntax means (appendix B): the `lang` items operators, borrows and other forms desugar
//! into, as data the compiler looks up, so no `lang` name is written in the compiler. Read with
//! `grammar.vun`, whose token kinds these tables name. A table naming `lang` items by their paths
//! is a tuple, since the items it names have types of their own.

/// What infix operators desugar to (appendix B): `a op b` calls `function`, a requirement of an
/// interface, in the witness of that interface for the type of `a`, the operands passed as the
/// function's parameters ask. `and`, `or` and ranges are not interfaces.
operators := .{
    .{ .token = .plus, .function = lang.ops.Add.add },
    .{ .token = .minus, .function = lang.ops.Sub.sub },
    .{ .token = .star, .function = lang.ops.Mul.mul },
    .{ .token = .slash, .function = lang.ops.Div.div },
    .{ .token = .percent, .function = lang.ops.Rem.rem },
    .{ .token = .amp, .function = lang.ops.BitAnd.bit_and },
    .{ .token = .pipe, .function = lang.ops.BitOr.bit_or },
    .{ .token = .caret, .function = lang.ops.BitXor.bit_xor },
    .{ .token = .shl, .function = lang.ops.Shl.shl },
    .{ .token = .shr, .function = lang.ops.Shr.shr },
    .{ .token = .plus_plus, .function = lang.ops.Concat.concat },
    .{ .token = .eq_eq, .function = lang.ops.Eq.eq },
    .{ .token = .bang_eq, .function = lang.ops.Eq.ne },
    .{ .token = .lt, .function = lang.ops.PartialOrd.lt },
    .{ .token = .le, .function = lang.ops.PartialOrd.le },
    .{ .token = .gt, .function = lang.ops.PartialOrd.gt },
    .{ .token = .ge, .function = lang.ops.PartialOrd.ge },
};

/// How a comparison relates its left operand to its right.
Comparison := enum {
    less,
    at_most,
    greater,
    at_least,
    equal,
    unequal,
};

/// The comparisons that narrow ranges (spec 04, rule 4): where `a op b` holds on integers, `a`
/// and `b` are related as `holds` says, and where it fails, as its negation says.
comparisons := [
    .{ .token = .lt, .holds = .less },
    .{ .token = .le, .holds = .at_most },
    .{ .token = .gt, .holds = .greater },
    .{ .token = .ge, .holds = .at_least },
    .{ .token = .eq_eq, .holds = .equal },
    .{ .token = .bang_eq, .holds = .unequal },
];

/// What prefix operators desugar to (appendix B): `op a` calls `function` in the witness of its
/// interface for the type of `a`. `!` is not an interface: it negates a condition (`forms`).
prefix_operators := .{
    .{ .token = .minus, .function = lang.ops.Neg.neg },
    .{ .token = .tilde, .function = lang.ops.Not.not },
};

/// Syntax whose meaning is a `lang` item, besides operators and borrows (appendix B).
Form := enum {
    /// The type of `if` and `for` conditions and match guards, and of the operands and results
    /// of `and`, `or` and `!`.
    condition,
    /// The value of the condition type on which a condition holds.
    truth,
    /// The values `a..b` and `a..=b` at compile time.
    range,
    /// The type of `a..b` and `a..=b`.
    bounds,
    /// The type `[n]T`.
    array,
    /// The type `[T]`.
    slice,
};

/// The item each form means.
forms := .{
    .{ .form = .condition, .item = lang.bool },
    .{ .form = .truth, .item = lang.true },
    .{ .form = .range, .item = lang.Range },
    .{ .form = .bounds, .item = lang.Bounds },
    .{ .form = .array, .item = lang.mem.Array },
    .{ .form = .slice, .item = lang.mem.Slice },
};

/// Prefix operators on types (appendix B): `?T` is `lang.Option(T)`, `*T` is `lang.mem.Ptr(T)`.
type_prefixes := .{
    .{ .token = .question, .item = lang.Option },
    .{ .token = .star, .item = lang.mem.Ptr },
};

/// The states of a place (spec 05, section 2).
PlaceState := enum {
    uninit,
    init,
};

/// What else may reach a borrowed place while the borrow lives (spec 05, section 8).
Access := enum {
    /// Reads, and other shared borrows; nothing writes.
    shared,
    /// Nothing: the place is reached only through the borrow.
    exclusive,
};

/// How long a borrow passed to a call is held (spec 05, section 4).
Extent := enum {
    /// As long as the call's result: a scoped result is tied to it.
    tied,
    /// For the call only: the result is not tied to it, and the callee may not return it.
    temp,
    /// For the whole program: a borrow of a literal or of an immutable top-level binding, which
    /// is free, and is the only extent required where it is written (spec 05, section 4).
    static,
};

/// Borrow types by the words after `&` (appendix B): `&T` is `lang.mem.Ref(T)`. Each mode is named
/// by the transition it performs on the place it borrows (spec 05, section 2): the state it
/// needs before, and the state the place has after; by the access it leaves others; and by how
/// long a call holds it. Borrows of one transition and access are accepted for each other, but
/// where `&static` is written.
borrows := .{
    .{ .mode = [], .item = lang.mem.Ref, .before = .init, .after = .init, .access = .shared, .extent = .tied },
    .{ .mode = [.\mut], .item = lang.mem.RefMut, .before = .init, .after = .init, .access = .exclusive, .extent = .tied },
    .{ .mode = [.out], .item = lang.mem.RefOut, .before = .uninit, .after = .init, .access = .exclusive, .extent = .tied },
    .{ .mode = [.take], .item = lang.mem.RefTake, .before = .init, .after = .uninit, .access = .exclusive, .extent = .tied },
    .{ .mode = [.temp], .item = lang.mem.RefTemp, .before = .init, .after = .init, .access = .shared, .extent = .temp },
    .{ .mode = [.temp, .\mut], .item = lang.mem.RefTempMut, .before = .init, .after = .init, .access = .exclusive, .extent = .temp },
    .{ .mode = [.static], .item = lang.mem.RefStatic, .before = .init, .after = .init, .access = .shared, .extent = .static },
};

/// How a compound assignment brings its result back to the place's type (spec 04, rule 9).
Narrowing := enum {
    /// Traps outside the type: `x = (x op y).to(TypeOf(x))`.
    to,
    /// Modular reduction: `.wrap`.
    wrap,
    /// Clamps to the bounds: `.sat`.
    sat,
};

/// Compound assignments: `x op= y` is `x = (x op y)` narrowed back to the type of `x`.
compound := [
    .{ .token = .plus_eq, .op = .plus, .narrowing = .to },
    .{ .token = .minus_eq, .op = .minus, .narrowing = .to },
    .{ .token = .star_eq, .op = .star, .narrowing = .to },
    .{ .token = .slash_eq, .op = .slash, .narrowing = .to },
    .{ .token = .percent_eq, .op = .percent, .narrowing = .to },
    .{ .token = .amp_eq, .op = .amp, .narrowing = .to },
    .{ .token = .pipe_eq, .op = .pipe, .narrowing = .to },
    .{ .token = .caret_eq, .op = .caret, .narrowing = .to },
    .{ .token = .shl_eq, .op = .shl, .narrowing = .to },
    .{ .token = .shr_eq, .op = .shr, .narrowing = .to },
    .{ .token = .plus_percent_eq, .op = .plus, .narrowing = .wrap },
    .{ .token = .minus_percent_eq, .op = .minus, .narrowing = .wrap },
    .{ .token = .star_percent_eq, .op = .star, .narrowing = .wrap },
    .{ .token = .plus_pipe_eq, .op = .plus, .narrowing = .sat },
    .{ .token = .minus_pipe_eq, .op = .minus, .narrowing = .sat },
    .{ .token = .star_pipe_eq, .op = .star, .narrowing = .sat },
];

/// Prefixes that mark what they apply to with a `lang` item: `unsafe (...) -> T` carries
/// `lang.safety.unsafe` in its type, as a property calls are checked against (spec 07, section 4).
markers := .{
    .{ .token = .\unsafe, .item = lang.safety.\unsafe },
};

/// How a function carrying a marker is accepted where a function type is expected (spec 07,
/// section 4).
Relation := enum {
    /// A duty of the callers: accepted when the function has no duty the expected type lacks.
    duty,
    /// A promise to the callers: accepted when the function makes every promise expected.
    guarantee,
    /// A limit: accepted when the function's is at most the expected one, or none is expected.
    bound,
    /// A convention: accepted when both have the same ones.
    identity,
};

/// The properties a function type carries as markers (spec 07, section 4): attributes on a
/// function literal, a function type or a declaration, and the prefixes of the table `markers`.
fn_markers := .{
    .{ .item = lang.safety.\unsafe, .relation = .duty },
    .{ .item = lang.target.require, .relation = .duty },
    .{ .item = lang.panic.never, .relation = .guarantee },
    .{ .item = lang.stack.max, .relation = .bound },
    .{ .item = lang.abi.c, .relation = .identity },
    .{ .item = lang.abi.interrupt, .relation = .identity },
    .{ .item = lang.abi.naked, .relation = .identity },
};

/// What calling a value that is not a function literal means (spec 01, section 4): `f(a, b)` is
/// `function(&mut f, (a, b))` of the witness of its interface, which function values and closures
/// implement, so a parameter `$F: Call((T), U)` takes either.
calls := .{
    .{ .function = lang.ops.Call.call },
};

/// What `e?` means (appendix B): the witness of the interface of `function` for the type of `e`
/// gives it, and its result carries the value in the variant `go` and what the function returns
/// in the variant `stop`.
early_return := .{
    .{
        .function = lang.ops.Try.branch,
        .go = lang.Branch.go,
        .stop = lang.Branch.stop,
    },
};

/// What `for p in e` drives (appendix B): the witness of the interface of `function` for the type
/// of `e` gives the iterator through it and names its coroutine interface `iterator`; each item is
/// the payload of the variant `each` of what the interface's `resume` returns, and the variant
/// `done` carries what the coroutine returns. A frame answers the interface's `resume` and `end`
/// itself (spec 06, section 1).
iteration := .{
    .{
        .function = lang.ops.Iterate.iter,
        .iterator = lang.ops.Iterate.Iter,
        .resume = lang.Coroutine.resume,
        .end = lang.Coroutine.end,
        .each = lang.Step.yielded,
        .done = lang.Step.done,
    },
};
