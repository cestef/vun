//! What syntax means (appendix B): the `lang` items operators, borrows and other forms desugar
//! into, as data the compiler looks up, so no `lang` name is written in the compiler. Read with
//! `grammar.ov`, whose token kinds these tables name.

/// What infix operators desugar to (appendix B): `a op b` is `function(a, b)` of the interface at
/// `interface`, for the type of `a`. `and`, `or` and ranges are not interfaces.
operators := [
    .{ .token = .plus, .interface = "lang.ops.Add", .function = "add" },
    .{ .token = .minus, .interface = "lang.ops.Sub", .function = "sub" },
    .{ .token = .star, .interface = "lang.ops.Mul", .function = "mul" },
    .{ .token = .slash, .interface = "lang.ops.Div", .function = "div" },
    .{ .token = .percent, .interface = "lang.ops.Rem", .function = "rem" },
    .{ .token = .amp, .interface = "lang.ops.BitAnd", .function = "bit_and" },
    .{ .token = .pipe, .interface = "lang.ops.BitOr", .function = "bit_or" },
    .{ .token = .caret, .interface = "lang.ops.BitXor", .function = "bit_xor" },
    .{ .token = .shl, .interface = "lang.ops.Shl", .function = "shl" },
    .{ .token = .shr, .interface = "lang.ops.Shr", .function = "shr" },
    .{ .token = .plus_plus, .interface = "lang.ops.Concat", .function = "concat" },
    .{ .token = .eq_eq, .interface = "lang.ops.Eq", .function = "eq" },
    .{ .token = .bang_eq, .interface = "lang.ops.Eq", .function = "ne" },
    .{ .token = .lt, .interface = "lang.ops.Ord", .function = "lt" },
    .{ .token = .le, .interface = "lang.ops.Ord", .function = "le" },
    .{ .token = .gt, .interface = "lang.ops.Ord", .function = "gt" },
    .{ .token = .ge, .interface = "lang.ops.Ord", .function = "ge" },
];

/// Syntax whose meaning is a `lang` item, besides operators and borrows (appendix B).
Form := enum {
    /// The type of `if` and `for` conditions and match guards, and of the operands and results
    /// of `and`, `or` and `!`.
    condition,
    /// The value of the condition type on which a condition holds.
    truth,
    /// The values `a..b` and `a..=b` at compile time.
    range,
    /// The type of `a..b` and `a..=b`.
    bounds,
    /// The type `[n]T`.
    array,
    /// The type `[T]`.
    slice,
};

/// The item each form means.
forms := [
    .{ .form = .condition, .item = "lang.bool" },
    .{ .form = .truth, .item = "lang.bool.true" },
    .{ .form = .range, .item = "lang.Range" },
    .{ .form = .bounds, .item = "lang.Bounds" },
    .{ .form = .array, .item = "lang.mem.Array" },
    .{ .form = .slice, .item = "lang.mem.Slice" },
];

/// Prefix operators on types (appendix B): `?T` is `lang.Option(T)`, `*T` is `lang.mem.Ptr(T)`.
type_prefixes := [
    .{ .token = .question, .item = "lang.Option" },
    .{ .token = .star, .item = "lang.mem.Ptr" },
];

/// Borrow types by the word after `&` (appendix B): `&T` is `lang.mem.Ref(T)`.
borrows := [
    .{ .mode = "", .item = "lang.mem.Ref" },
    .{ .mode = "mut", .item = "lang.mem.RefMut" },
    .{ .mode = "out", .item = "lang.mem.RefOut" },
    .{ .mode = "take", .item = "lang.mem.RefTake" },
];

/// How a compound assignment brings its result back to the place's type (spec 04, rule 9).
Narrowing := enum {
    /// Traps outside the type: `x = (x op y).to(TypeOf(x))`.
    to,
    /// Modular reduction: `.wrap`.
    wrap,
    /// Clamps to the bounds: `.sat`.
    sat,
};

/// Compound assignments: `x op= y` is `x = (x op y)` narrowed back to the type of `x`.
compound := [
    .{ .token = .plus_eq, .op = .plus, .narrowing = .to },
    .{ .token = .minus_eq, .op = .minus, .narrowing = .to },
    .{ .token = .star_eq, .op = .star, .narrowing = .to },
    .{ .token = .slash_eq, .op = .slash, .narrowing = .to },
    .{ .token = .percent_eq, .op = .percent, .narrowing = .to },
    .{ .token = .amp_eq, .op = .amp, .narrowing = .to },
    .{ .token = .pipe_eq, .op = .pipe, .narrowing = .to },
    .{ .token = .caret_eq, .op = .caret, .narrowing = .to },
    .{ .token = .shl_eq, .op = .shl, .narrowing = .to },
    .{ .token = .shr_eq, .op = .shr, .narrowing = .to },
    .{ .token = .plus_percent_eq, .op = .plus, .narrowing = .wrap },
    .{ .token = .minus_percent_eq, .op = .minus, .narrowing = .wrap },
    .{ .token = .star_percent_eq, .op = .star, .narrowing = .wrap },
    .{ .token = .plus_pipe_eq, .op = .plus, .narrowing = .sat },
    .{ .token = .minus_pipe_eq, .op = .minus, .narrowing = .sat },
    .{ .token = .star_pipe_eq, .op = .star, .narrowing = .sat },
];

/// What `e?` means (appendix B): the witness of `interface` for the type of `e` gives
/// `function`, whose result carries the value in the variant `go` and what the function returns
/// in the variant `stop`.
early_return := [
    .{ .interface = "lang.ops.Try", .function = "branch", .go = "go", .stop = "stop" },
];

/// What `for p in e` drives (appendix B): the witness of `interface` for the type of `e` gives
/// the iterator through `function` and names its coroutine interface `iterator`; each item is
/// the payload of the variant `item` of what the interface's `resume` returns.
iteration := [
    .{ .interface = "lang.ops.Iterate", .function = "iter", .iterator = "Iter", .resume = "resume", .item = "yielded" },
];
