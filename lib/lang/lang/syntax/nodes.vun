//! The kinds of syntax tree nodes and their productions, part of the grammar with `grammar.vun`,
//! whose header says how both are read.

/// The file of tokens and tables the productions name.
grammar := lang.syntax.grammar;

/// How many nodes a child position of a kind holds.
Count := enum {
    one,
    optional,
    many,
};

/// Kinds of syntax tree nodes (spec 13, section 2), each with its production: the tokens and
/// children it spells, in source order.
///
/// A term of a production is a token spelled `"text"` (a punctuation or keyword token, or a name
/// spelled so where the grammar makes it a word), `.token(...)` for a token of one of the kinds
/// listed, each `.kind` or a path to a list of the token kind or a table of tokens,
/// `.word(path)` for a name or keyword spelled as a variant of the kind, or the list of one, the
/// path names, a child `.field`, `.optional(...)` and `.many(...)` for terms written once or not
/// and any number of times, `.separated(term, "sep")` for any number of `term` with `sep` between
/// them and after the last if written, `.choice(a, ...)` for one of the terms,
/// `.of(.field, table)` for a child in `field` of a kind the table lists,
/// `.ending(.field, table)` for one of such a kind or of a `transparent` kind ending with one,
/// `.starting(.field, tokens)` for one starting with a token a table of tokens lists, and
/// `.seq(...)` for terms in sequence. Tables are named by paths, as `grammar.infix`.
///
/// A node is anchored at the first token of its production; its other tokens are `punct` leaves,
/// its children fill its fields. A field's count follows from where it stands: `many` in `many` or
/// `separated`, else `optional` in `optional` or `choice`, else `one`. A field named after a kind
/// holds a node of that kind, any other field any node. A leaf spells one token and holds nothing;
/// `punct` holds the token its parent's production names. An `error` stands for skipped or absent
/// source, and fits any field; an `error`, and a node holding one or anchored at an absent token,
/// are recovery's shapes: they fit their kind's fields, not its production.
NodeKind := .{
    .leaves = [
        .punct,
        .module_doc(.token(.module_doc_comment)),
        .\mut("mut"),
        .qualifier(.word(grammar.BorrowWord.qualifiers)),
        .mode(.word(grammar.BorrowWord.modes)),
        .name(.token(.ident, .raw_ident)),
        .hole("_"),
        .int(.token(.int)),
        .float(.token(.float)),
        .char(.token(.char)),
        .string(.token(.string, .raw_string)),
        .raw_string_line(.token(.raw_string_line)),
        .label(.token(.label)),
        .rest(".."),
        .flow(.word(grammar.Flow)),
        .writeback("!"),
    ],
    .structure = [
        .error(.many(.skipped)),
        .file(
            .many(.choice(.seq(.members, ";"), .seq(.members, ","), .ending(.members, unterminated), ";")),
            .optional(.members),
            .token(.eof),
        ),
        .doc(.token(.doc_comment), .target),
        .attr("#[", .separated(.values, ","), "]", .target),
    ],
    .declarations = [
        .binding(.optional(.\mut), .pattern, ":=", .value),
        .typed_binding(.optional(.\mut), .pattern, ":", .type, .optional("=", .value)),
        .field(.optional(.\mut), .pattern, ":", .type, .optional("=", .value)),
        .spread("..", .source, .optional(.select)),
        .select(".{", .separated(.names, ","), "}"),
        .namespace(
            ";",
            .many(.choice(.seq(.members, ";"), .seq(.members, ","), .ending(.members, unterminated), ";")),
            .optional(.members),
        ),
    ],
    .functions = [
        .param(.pattern, ":", .type),
        .returns("->", .type),
        .\fn("(", .separated(.params, ","), ")", .optional(.returns), .block),
        .fn_type("(", .separated(.params, ","), ")", .optional(.returns)),
        .closure("[", .separated(.captures, ","), "]", .\fn),
    ],
    .values = [
        // Under `$` among members or items, a block holds those: `$for f in fs { x: T, }`.
        .block(
            "{",
            .many(.choice(.seq(.statements, ";"), .seq(.statements, ","), .ending(.statements, unterminated), ";")),
            .optional(.statements),
            "}",
        ),
        .quote(
            "#{",
            .many(.choice(.seq(.statements, ";"), .ending(.statements, unterminated), ";")),
            .optional(.statements),
            "}",
        ),
        .\struct(
            "struct",
            "{",
            .many(.choice(.seq(.members, ";"), .seq(.members, ","), .ending(.members, unterminated), ";")),
            .optional(.members),
            "}",
        ),
        .\enum("enum", "{", .separated(.variants, ","), .optional(.namespace), "}"),
        .paren("(", .inner, ")"),
        .tuple("(", .separated(.items, ","), ")"),
        .array("[", .separated(.items, ","), "]"),
        .array_repeat("[", .value, ";", .count, "]"),
        .array_type("[", .length, "]", .starting(.element, grammar.element_types)),
        .struct_lit(".{", .separated(.fields, ","), "}"),
        .typed_lit(.of(.type, grammar.literal_types), "{", .separated(.fields, ","), "}"),
        .field_init(.target, "=", .value),
        .multiline_string(.token(.raw_string_line), .many(.raw_string_line)),
    ],
    .operators = [
        .dot_name(".", .ending(.property, member_names)),
        .member(.object, ".", .ending(.property, member_names)),
        .call(.callee, "(", .separated(.args, ","), ")"),
        .index(.object, "[", .subscript, "]"),
        .prefix(.token(grammar.prefix), .optional(.qualifier), .optional(.mode), .operand),
        .postfix(.operand, .token(grammar.postfix)),
        .infix(.left, .choice(.seq(.token(grammar.infix), .right), .token(grammar.open_ended))),
        .assign(.place, .token(grammar.assign), .value),
    ],
    .control = [
        .\if("if", .condition, .block, .optional("else", .otherwise)),
        .test(.pattern, "=", .value),
        .\for("for", .optional(.head), .block),
        .in(.pattern, "in", .value),
        .\match("match", .scrutinee, "{", .separated(.arms, ","), "}"),
        .arm(.pattern, .optional(.guard), "=>", .optional(.value)),
        .guard("if", .condition),
        .labeled(.token(.label), ":", .of(.body, labeled_bodies)),
        .\return("return", .optional(.value)),
        .\break("break", .optional(.label), .optional(.value)),
        .\continue("continue", .optional(.label)),
        .\yield("yield", .value),
        .\defer("defer", .body),
    ],
    .assembly = [
        .asm(.arch, ".", "asm", "{", .many(.lines, .optional(":")), "}"),
        .line(.token(.ident, grammar.TokenKind.keywords), .many(.suffix), .separated(.operands, ",")),
        .suffix(".", .name),
        .bound("{", .optional(.flow, .optional("(", .register, ")")), .value, "}"),
        .memory("[", .separated(.parts, ","), "]", .optional(.writeback)),
    ],
};

/// Kinds that are never operands: they stand only in the fields that name them, hold them or
/// admit them.
parts := [
    .\mut, .qualifier, .mode, .raw_string_line, .flow, .writeback, .select, .namespace, .returns, .guard, .line,
    .suffix, .bound, .memory, .label, .binding, .typed_binding, .field, .assign, .spread, .field_init,
    .param, .test, .in, .arm, .module_doc,
];

/// Fields holding the kinds listed besides any operand: the entries of lists, the forms of heads
/// and patterns.
admits := [
    .{
        .fields = &[.members, .statements, .target],
        .kinds = &[.binding, .typed_binding, .field, .assign, .spread, .module_doc],
    },
    .{ .fields = &[.items, .values, .args, .fields, .variants], .kinds = &[.field_init] },
    .{ .fields = &[.params], .kinds = &[.param] },
    .{ .fields = &[.head, .condition], .kinds = &[.test, .\in] },
];

/// Fields read in a context of their own, at any depth of the operands they hold: an
/// instruction's operands and a memory operand's parts, where the kinds listed are operands in
/// place of those starting with the same token: `{` opens a bound, not a block, `[` a memory
/// operand, and a label names an address.
operand_contexts := [
    .{ .fields = &[.operands, .parts], .kinds = &[.bound, .memory, .label] },
];

/// Fields holding only the kinds listed.
holds := [
    .{ .fields = &[.arms], .kinds = &[.arm] },
    .{ .fields = &[.lines], .kinds = &[.line, .label] },
    .{ .fields = &[.otherwise], .kinds = &[.block, .\if] },
    .{ .fields = &[.register], .kinds = &[.name, .int, .prefix] },
];

/// Kinds that may spell the same source, which the parser tells apart by what follows them or
/// what they hold, each listed before those it is preferred to where several fit: `()` is a tuple,
/// `() {}` a function. Editor grammars that try each keep the preferred.
preferred := [
    &[.paren, .tuple, .fn_type],
    &[.tuple, .fn_type],
    &[.\fn, .tuple, .fn_type],
    &[.typed_binding, .field],
    &[.array, .closure],
    &[.memory, .array],
    &[.memory, .array, .closure],
    &[.assign, .field_init],
    &[.suffix, .dot_name],
    &[.spread, .prefix],
    &[.block, .typed_lit],
];

/// Kinds of entries of a list needing no `;` after them: module docs, blocks and the forms ending
/// with one.
unterminated := [.module_doc, .block, .\if, .\for, .\match, .labeled];

/// What a label names: a loop or a block.
labeled_bodies := [.\for, .block];

/// What names a member after `.`: a name, an index, or `$` and the value naming it (`.$(f.name)`).
member_names := [.name, .int, .paren];

/// Kinds that end with the kind of their last child when written with one of the tokens listed,
/// where a production says so (`.ending`): `$if a {}` and `unsafe {}` are unterminated as an `if`
/// and a block are.
transparent := [.{ .kind = .prefix, .tokens = &[.dollar, .\unsafe] }];

/// Kinds that end with their line: an instruction's operands stop where it does.
line_ends := [.line];

/// How tightly the forms whose productions begin or end with an operand hold it, loosest first, as
/// the parser nests them (spec 01, section 6); `infix` stands for the levels of the table `infix`.
/// Editor grammars resolve by it what the parser decides by nesting.
precedence := [
    &[.doc, .attr, .binding, .typed_binding, .field, .assign, .field_init, .param, .test, .in, .arm],
    &[.\if, .\for, .\match],
    &[.\return, .\break, .\yield, .\defer, .labeled, .returns, .guard],
    &[.infix],
    &[.prefix, .spread, .array_type],
    &[.member, .call, .index, .postfix, .asm, .dot_name, .closure, .qualifier, .mode, .suffix, .bound],
];
