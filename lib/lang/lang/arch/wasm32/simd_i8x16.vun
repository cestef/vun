    .pushes = &[.v128],
    .requires = _simd,
}] };

i8x16_all_true := _w.Instruction{ .forms = &[.{
    .base = 0xfd0063,
    .pops = &[.v128],
    .pushes = &[.i32],
    .requires = _simd,
}] };

i8x16_bitmask := _w.Instruction{ .forms = &[.{
