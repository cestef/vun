//! The i8x16 lane instructions.

_w := lang.arch.wasm32;

_align: _w.Arg = .{ .kind = .imm(.unsigned(32)) };
_offset: _w.Arg = .{ .kind = .imm(.unsigned(32)) };
_lane: _w.Arg = .{ .kind = .imm(.unsigned(8)) };
_half: _w.Arg = .{ .kind = .imm(.bits(64)) };

_simd: ?_w.Need = .some(.feature(.simd128));

i8x16_abs := _w.Instruction{ .forms = &[.{
    .base = 0xfd0060,
    .pops = &[.v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

i8x16_neg := _w.Instruction{ .forms = &[.{
    .base = 0xfd0061,
    .pops = &[.v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

