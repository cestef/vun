//! Bit operations on the whole vector.

_w := lang.arch.wasm32;

_align: _w.Arg = .{ .kind = .imm(.unsigned(32)) };
_offset: _w.Arg = .{ .kind = .imm(.unsigned(32)) };
_lane: _w.Arg = .{ .kind = .imm(.unsigned(8)) };
_half: _w.Arg = .{ .kind = .imm(.bits(64)) };

_simd: ?_w.Need = .some(.feature(.simd128));

v128_not := _w.Instruction{ .forms = &[.{
    .base = 0xfd004d,
    .pops = &[.v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

v128_and := _w.Instruction{ .forms = &[.{
    .base = 0xfd004e,
    .pops = &[.v128, .v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

v128_andnot := _w.Instruction{ .forms = &[.{
    .base = 0xfd004f,
    .pops = &[.v128, .v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

v128_or := _w.Instruction{ .forms = &[.{
    .base = 0xfd0050,
    .pops = &[.v128, .v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

v128_xor := _w.Instruction{ .forms = &[.{
    .base = 0xfd0051,
    .pops = &[.v128, .v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

v128_bitselect := _w.Instruction{ .forms = &[.{
    .base = 0xfd0052,
    .pops = &[.v128, .v128, .v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

v128_any_true := _w.Instruction{ .forms = &[.{
    .base = 0xfd0053,
    .pops = &[.v128],
    .pushes = &[.i32],
    .requires = _simd,
}] };
