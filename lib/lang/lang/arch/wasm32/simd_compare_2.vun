//! Comparisons lane by lane, each lane all ones where it holds. (continued)

_w := lang.arch.wasm32;

_align: _w.Arg = .{ .kind = .imm(.unsigned(32)) };
_offset: _w.Arg = .{ .kind = .imm(.unsigned(32)) };
_lane: _w.Arg = .{ .kind = .imm(.unsigned(8)) };
_half: _w.Arg = .{ .kind = .imm(.bits(64)) };

_simd: ?_w.Need = .some(.feature(.simd128));

f64x2_eq := _w.Instruction{ .forms = &[.{
    .base = 0xfd0047,
    .pops = &[.v128, .v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

