i64x2_shr_u := _w.Instruction{ .forms = &[.{
    .base = 0xfd00cd,
    .pops = &[.v128, .i32],
    .pushes = &[.v128],
    .requires = _simd,
}] };

i64x2_add := _w.Instruction{ .forms = &[.{
    .base = 0xfd00ce,
    .pops = &[.v128, .v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

i64x2_sub := _w.Instruction{ .forms = &[.{
    .base = 0xfd00d1,
    .pops = &[.v128, .v128],
    .pushes = &[.v128],
    .requires = _simd,
}] };

i64x2_mul := _w.Instruction{ .forms = &[.{
    .base = 0xfd00d5,
    .pops = &[.v128, .v128],
    .pushes = &[.v128],
    .requires = _simd,
