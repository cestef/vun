//! Thumb, the instruction set of Arm's M profile and of Arm's A profile in its Thumb state (spec
//! 07, section 6): its registers, and each instruction with its forms as the toolchain's
//! assembler encodes them (Armv7-M, Thumb-2 with the floating-point extension), with what each
//! form reads and writes. The instructions are declared in `data`, `multiply`, `memory`,
//! `control`, `fp` and `system`; `vun-isa-thumb`'s tables are generated from these declarations.
//!
//! A form's base is its encoding: a halfword for a 16-bit instruction, the two halfwords of a
//! 32-bit one as one word, the first in the high bits, and a field's position counts in that word.
//! A 16-bit form that computes sets the flags: it is declared under the mnemonic ending in `s`, as
//! the unified syntax writes it outside an `if-then` block, which the table has none of.

/// The width of an operation or an access.
Size := enum { b8, b16, b32, b64 };

/// A general register, by its encoding.
Reg := enum {
    r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12,
    sp,
    /// The link register.
    lr,
    pc,
};

/// A floating-point register, by its number as a single-precision one: `v{2k}` is also the
/// double-precision `d{k}`, which overlaps `s{2k}` and `s{2k+1}`.
V := enum {
    v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15,
    v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31,
};

/// A special register, which `mrs` reads and `msr` writes: the interrupt masks and the control
/// of the stack and privilege.
Special := enum {
    /// Masks every interrupt of configurable priority.
    primask,
    /// Masks the interrupts at or below a priority.
    basepri,
    /// Masks every interrupt and fault but the non-maskable one.
    faultmask,
    control,
};

/// The registers `vmrs` names: the floating-point status and control register, and the flags it
/// is read into.
Status := enum { apsr_nzcv, fpscr };

/// The classes of registers an operand names: general ones (`Reg`), floating-point ones (`V`),
/// special ones (`Special`) and those `vmrs` names (`Status`).
Class := enum { general, fp, special, status };

/// A condition, by its encoding.
Cond := enum {
    eq, ne,
    /// Unsigned higher or same (carry set).
    hs,
    /// Unsigned lower (carry clear).
    lo,
    mi, pl, vs, vc,
    /// Unsigned higher.
    hi,
    /// Unsigned lower or same.
    ls,
    ge, lt, gt, le,
    /// Always, which an unconditional branch is written without.
    al,
};

/// The interrupts `cpsid` and `cpsie` mask and unmask, by their bit: those of configurable
/// priority and the faults (`f`, the mask `faultmask` holds), or those alone (`i`, `primask`).
Mask := enum { f, i };

/// The domain a barrier orders: the full system.
Barrier := enum { sy };

/// The kinds of named choice a position takes, each an enum of its own.
Choice := enum { mask, barrier };

/// The width of an operand: the instruction's, or its own.
Width := enum { inst, is(Size) };

/// The general registers a position names.
Regs := enum {
    /// `r0` to `r7`, in three bits.
    low,
    /// Every one but `sp` and `pc`.
    general,
    /// Those and `sp`.
    sp,
    /// Every one, `pc` among them.
    any,
    /// `sp` alone, in no field.
    only_sp,
};

/// An immediate encoding.
Imm := enum {
    /// A byte, shifted or repeated, in the fields `i:imm3:imm8` (the manual's `ThumbExpandImm`).
    modified,
    /// 12 bits in the fields `i:imm3:imm8`: `addw`, `subw`.
    plain,
    /// 16 bits in the fields `imm4:i:imm3:imm8`: `movw`, `movt`.
    half,
    /// An unsigned value of this many bits, in one field.
    unsigned(u8),
    /// A multiple of 4, as a count of words of this many bits, in one field.
    words(u8),
    /// A left shift, 0 to 31.
    lsl(Place),
    /// A right shift, 1 to 32, 32 written as 0.
    shr(Place),
    /// Floating-point zero, which `vcmp` compares with.
    zero,
};

/// Where a shift's amount goes.
Place := enum {
    /// Five bits in one field.
    narrow,
    /// `imm3` at 12 and `imm2` at 6.
    wide,
};

/// An addressing mode: which memory operands a position takes. The base register's field is part
/// of the mode.
Mode := enum {
    /// `[base, #offset]`: the base low at 3, the offset a count of accesses in five bits at 6.
    narrow,
    /// `[sp, #offset]`: the offset a count of words in eight bits at 0.
    narrow_sp,
    /// `[base, index]`: both low, the base at 3 and the index at 6.
    narrow_index,
    /// `[base, #offset]`: the base at 16, the offset 0 to 4095 in twelve bits.
    offset,
    /// `[base, #-offset]`: the base at 16, the offset 1 to 255 in eight bits.
    byte,
    /// `[base, #offset]!` and `[base], #offset`, -255 to 255.
    byte_pre,
    byte_post,
    /// `[base, index, lsl #n]`: the base at 16, the index at 0 and `n`, 0 to 3, at 4.
    index,
    /// `[base, #offset]` of a pair: the base at 16, the offset a multiple of 4, -1020 to 1020, as
    /// a count of words in eight bits; and written back before or after the access.
    pair,
    pair_pre,
    pair_post,
    /// `[base, #offset]` of a floating-point register: the base at 16, the offset a multiple of 4,
    /// -1020 to 1020.
    fp,
    /// `[base, #offset]` of an exclusive access: the base at 16, the offset a multiple of 4, 0 to
    /// 1020.
    exclusive,
};

/// Which fields a floating-point register's number is split into: `Vd:D`, `Vn:N` or `Vm:M`, the
/// four bits at 12, 16 or 0 and the fifth at 22, 7 or 5.
Fields := enum { d, n, m };

/// Which registers a list takes.
List := enum {
    /// `r0` to `r7` in eight bits, and `lr` in bit 8: a 16-bit `push`.
    push,
    /// `r0` to `r7`, and `pc` in bit 8: a 16-bit `pop`.
    pop,
    /// Sixteen bits, a register each, but `sp` and `pc`: a 32-bit `push`.
    wide,
    /// Those and `pc`: a 32-bit `pop`.
    wide_pc,
    /// Consecutive double-precision registers: the first in `Vd:D`, twice their count at 0.
    doubles,
};

/// A branch's field, and the relocation that fills it with a symbol's address.
Branch := enum {
    /// Eight bits at 0, conditional: a 16-bit `b<c>`.
    narrow_cond,
    /// Eleven bits at 0: a 16-bit `b`.
    narrow,
    /// `i:imm5`, forward only: `cbz`, `cbnz`.
    compare,
    /// `S:J2:J1:imm6:imm11`, conditional: a 32-bit `b<c>`.
    cond,
    /// `S:J1:J2:imm10:imm11`: a 32-bit `b`.
    jump,
    /// The same, for a call: `bl`.
    call,
};

/// What an operand position takes.
Kind := enum {
    gpr(Regs),
    /// Any register in a low register's field with a fourth bit at 7: a 16-bit `add` or `mov`.
    split,
    fpr(Width, Fields),
    imm(Imm),
    /// A register, shifted or not: the amount in `imm3:imm2`, the shift's kind at 4, the register
    /// at 0.
    shifted,
    /// Memory accessed at a width.
    mem(Mode, Width),
    /// A condition, as the mnemonic's suffix.
    cond,
    /// A label, or a symbol the linker places.
    target(Branch),
    /// The low or high 16 bits of a symbol's address: `movw`, `movt`.
    low,
    high,
    list(List),
    special,
    status(Status),
    mask,
    barrier,
};

/// What a form does with an operand, or with the flags.
Access := enum {
    read,
    write,
    read_write,
    /// Nothing but compute its address.
    address,
};

/// Where control goes after a form.
Flow := enum {
    /// To the next instruction, and for a conditional branch also to its target.
    next,
    /// To its target only.
    jump,
    /// Out of the code: it returns or traps.
    ends,
};

/// An operand position: what it takes, the bit its field starts at, and what the form does with
/// it.
Arg := struct {
    kind: Kind,
    at: u8 = 0,
    /// Where the same field goes again, for an encoding naming a register in two fields (`clz`).
    again: ?u8 = .none,
    access: Access,
};

/// A width a form is defined at, the bits it sets in the word, and the suffix it gives the
/// mnemonic.
Sized := struct { size: Size, bits: u32 = 0, suffix: &[u8] = "" };

/// A base word of the forms of a family: fixed, or its member's bits with these set.
Word := enum { fixed(u32), \or(u32) };

/// One form of an instruction, its base word of type `W`: the widths it is defined at, its
/// operands, and what it reads and writes beyond them.
Form := ($W: type) -> type { struct {
    base: W,
    sizes: &[Sized] = &[.{ .size = .b32 }],
    args: &[Arg],
    /// The mnemonic, where it is not the instruction's (`ldrb`).
    name: ?&[u8] = .none,
    reads: &[Reg] = &[],
    writes: &[Reg] = &[],
    flags: ?Access = .none,
    flow: Flow = .next,
    /// Pairs of operand positions whose registers must differ, a memory operand's by its base:
    /// the manual calls the instruction unpredictable where they do not.
    apart: &[[2]u8] = &[],
} };

/// An instruction, named as its declaration is unless `mnemonic` says otherwise (`bcond` is
/// written `b`).
Instruction := struct { forms: &[Form(u32)], mnemonic: ?&[u8] = .none };

/// An instruction of a family, and the bits it sets in the family's base words.
Member := struct { name: lang.meta.Name, bits: u32 = 0 };

/// Instructions sharing their forms but for a few bits.
Family := struct { members: &[Member], forms: &[Form(Word)] };
