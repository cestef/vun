//! 64-bit ARM (spec 07, section 6): its registers, and each instruction with its forms as the
//! toolchain's assembler encodes them (Arm A64 ISA), with what each form reads and writes. The
//! instructions are declared in `control`, `fp`, `int` and `mem`; `vun-asm-arm64`'s tables are
//! generated from these declarations. An alias is an instruction of its own, its fixed fields in
//! its base word: `mov` is `orr` from the zero register, `cmp` is `subs` into it.

/// The width of an operation or an operand.
Size := enum { b8, b16, b32, b64 };

/// A general register. Register 31 is the stack pointer in some operands and the zero register
/// in others: the two are distinct registers, and each operand kind takes the one its field means.
Reg := enum {
    x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28,
    /// The frame pointer.
    x29,
    /// The link register.
    x30,
    sp,
    zr,
};

/// A general register's name at each width.
Names := struct { w: &[u8], x: &[u8] };

/// The names of each general register.
names := .{
    .x0 = Names{ .w = "w0", .x = "x0" },
    .x1 = Names{ .w = "w1", .x = "x1" },
    .x2 = Names{ .w = "w2", .x = "x2" },
    .x3 = Names{ .w = "w3", .x = "x3" },
    .x4 = Names{ .w = "w4", .x = "x4" },
    .x5 = Names{ .w = "w5", .x = "x5" },
    .x6 = Names{ .w = "w6", .x = "x6" },
    .x7 = Names{ .w = "w7", .x = "x7" },
    .x8 = Names{ .w = "w8", .x = "x8" },
    .x9 = Names{ .w = "w9", .x = "x9" },
    .x10 = Names{ .w = "w10", .x = "x10" },
    .x11 = Names{ .w = "w11", .x = "x11" },
    .x12 = Names{ .w = "w12", .x = "x12" },
    .x13 = Names{ .w = "w13", .x = "x13" },
    .x14 = Names{ .w = "w14", .x = "x14" },
    .x15 = Names{ .w = "w15", .x = "x15" },
    .x16 = Names{ .w = "w16", .x = "x16" },
    .x17 = Names{ .w = "w17", .x = "x17" },
    .x18 = Names{ .w = "w18", .x = "x18" },
    .x19 = Names{ .w = "w19", .x = "x19" },
    .x20 = Names{ .w = "w20", .x = "x20" },
    .x21 = Names{ .w = "w21", .x = "x21" },
    .x22 = Names{ .w = "w22", .x = "x22" },
    .x23 = Names{ .w = "w23", .x = "x23" },
    .x24 = Names{ .w = "w24", .x = "x24" },
    .x25 = Names{ .w = "w25", .x = "x25" },
    .x26 = Names{ .w = "w26", .x = "x26" },
    .x27 = Names{ .w = "w27", .x = "x27" },
    .x28 = Names{ .w = "w28", .x = "x28" },
    .x29 = Names{ .w = "w29", .x = "x29" },
    .x30 = Names{ .w = "w30", .x = "x30" },
    .sp = Names{ .w = "wsp", .x = "sp" },
    .zr = Names{ .w = "wzr", .x = "xzr" },
};

/// A condition, by its encoding: what the flags say after a comparison (`hs`, higher or same,
/// for unsigned; `ge` for signed).
Cond := enum { eq, ne, hs, lo, mi, pl, vs, vc, hi, ls, ge, lt, gt, le, al, nv };

/// What register 31 is at a position.
R31 := enum { zr, sp };

/// The width of an operand: the instruction's, or its own.
Width := enum { inst, is(Size) };

/// An immediate encoding.
Imm := enum {
    /// 12 bits, or 12 bits shifted left by 12: `add`, `sub`.
    arith,
    /// A run of ones, rotated and repeated: the logical instructions.
    bitmask,
    /// A value whose set bits lie in one aligned 16 bits (`movz`), written whole.
    wide,
    /// A value whose complement is `wide` (`movn`), written whole.
    wide_not,
    /// `wide`, written as its 16 bits and their shift (`movk`).
    half,
    /// A left shift by 1 to the width less one, as `ubfm`'s rotation and top bit.
    lsl,
    /// A right shift by 1 to the width less one, as the rotation and top bit of `ubfm` or `sbfm`.
    shr,
    /// 16 bits, unsigned.
    u16,
    /// Floating-point zero, which `fcmp` compares with.
    zero,
};

/// An addressing mode: which memory operands a position takes. `pre` and `post` write the base
/// register back.
Mode := enum {
    /// `[base, #offset]`, the offset a multiple of the access width, below 4096 of them.
    scaled,
    /// `[base, #offset]`, the offset -256 to 255 (`ldur`, `stur`).
    unscaled,
    /// `[base, #offset]!`, -256 to 255.
    pre,
    /// `[base], #offset`, -256 to 255.
    post,
    /// `[base, index, extend]`, the index 64 bits or 32 extended, scaled by 1 or the access width.
    index,
    /// `[base, #offset]` of a pair, the offset a multiple of the access width, -64 to 63 of them.
    pair,
    pair_pre,
    pair_post,
    /// `[base]`: exclusive and atomic accesses.
    base,
    /// `[base, :lo12:target]`, through the global offset table for a 64-bit load only.
    lo12,
};

/// Which shifts a shifted register operand takes: `lsl`, `lsr`, `asr`, and for `logic` `ror`.
Shifts := enum { arith, logic };

/// How a condition is written and encoded.
Condition := enum {
    /// As the mnemonic's suffix: `b.eq`.
    suffix,
    operand,
    /// As an operand, encoded as the condition it is not: `cset` is `csinc` of the inverse.
    inverted,
};

/// A branch's field, and the relocation that fills it with a symbol's address.
Branch := enum { jump26, call26, cond19 };

/// What an operand position takes.
Kind := enum {
    gpr(R31, Width),
    fpr(Width),
    imm(Imm),
    /// A register, shifted or not, at the instruction's width; 31 is the zero register.
    shifted(Shifts),
    /// A register, extended or read as it is; 31 is the zero register.
    extended,
    /// Memory accessed at a width.
    mem(Mode, Width),
    cond(Condition),
    /// A label, or a symbol the linker places.
    target(Branch),
    /// A symbol's page, or its entry's in the global offset table (`adrp`).
    page,
    /// A symbol's low 12 bits (`add`).
    lo12,
};

/// What a form does with an operand, or with the flags.
Access := enum {
    read,
    write,
    read_write,
    /// Nothing but compute its address.
    address,
};

/// An operand position: what it takes, the bit its field starts at, and what the form does with
/// it.
Arg := struct {
    kind: Kind,
    at: u8,
    /// Where the same field goes again, for an alias reading one register in two fields (`cneg`
    /// is `csneg` of a register and itself).
    again: ?u8 = .none,
    access: Access,
};

/// A width a form is defined at, the bits it sets in the word, and the suffix it gives the
/// mnemonic.
Sized := struct { size: Size, bits: u32 = 0, suffix: &[u8] = "" };

/// A base word of the forms of a family: fixed, or its member's bits with these set.
Word := enum { fixed(u32), \or(u32) };

/// One form of an instruction, its base word of type `W`: the widths it is defined at, its
/// operands, and what it reads and writes beyond them.
Form := ($W: type) -> type { struct {
    base: W,
    sizes: &[Sized],
    args: &[Arg],
    /// The mnemonic, where it is not the instruction's (`ldur`).
    name: ?&[u8] = .none,
    reads: &[Reg] = &[],
    writes: &[Reg] = &[],
    flags: ?Access = .none,
} };

/// An instruction, named as its declaration is unless `mnemonic` says otherwise (`bcond` is
/// written `b`).
Instruction := struct { forms: &[Form(u32)], mnemonic: ?&[u8] = .none };

/// An instruction of a family, and the bits it sets in the family's base words.
Member := struct { name: lang.meta.Name, bits: u32 = 0 };

/// Instructions sharing their forms but for a few bits.
Family := struct { members: &[Member], forms: &[Form(Word)] };
