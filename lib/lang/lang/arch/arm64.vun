//! 64-bit ARM (spec 07, section 6): its registers, and each instruction with its forms as the
//! toolchain's assembler encodes them (Arm A64 ISA), with what each form reads and writes. The
//! instructions are declared in `control`, `fp`, `int` and `memory`, what their operand positions
//! take in `operand`; `vun-isa-arm64`'s tables are generated from these declarations. An alias is an instruction of its own, its fixed fields in
//! its base word: `mov` is `orr` from the zero register, `cmp` is `subs` into it.

/// The width of an operation or an operand.
Size := enum { b8, b16, b32, b64 };

/// A general register. Register 31 is the stack pointer in some operands and the zero register
/// in others: the two are distinct registers, and each operand kind takes the one its field means.
Reg := enum {
    x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28,
    /// The frame pointer.
    x29,
    /// The link register.
    x30,
    sp,
    zr,
};

/// A general register named at 64 bits, in the order of `Reg`.
#[Registers{ .class = .general, .size = .some(.b64) }]
X := enum {
    x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, sp, xzr,
};

/// A general register named at 32 bits, in the order of `Reg`.
#[Registers{ .class = .general, .size = .some(.b32) }]
W := enum {
    w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29, w30, wsp, wzr,
};

/// A condition, by its encoding: what the flags say after a comparison (`hs`, higher or same,
/// for unsigned; `ge` for signed).
Cond := enum {
    eq, ne,
    /// Unsigned higher or same (carry set).
    hs,
    /// Unsigned lower (carry clear).
    lo,
    mi, pl, vs, vc,
    /// Unsigned higher.
    hi,
    /// Unsigned lower or same.
    ls,
    ge, lt, gt, le,
    /// Always, which an unconditional branch is written without.
    al,
    nv,
};

/// The classes of registers an operand names: general ones (`Reg`) and floating-point and vector
/// ones (`V`).
Class := enum { general, fp };

/// A floating-point and vector register, by its number.
V := enum {
    v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15,
    v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31,
};

/// A floating-point register named at 8 bits, in the order of `V`.
#[Registers{ .class = .fp, .size = .some(.b8) }]
B := enum {
    b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29, b30, b31,
};

/// A floating-point register named at 16 bits, in the order of `V`.
#[Registers{ .class = .fp, .size = .some(.b16) }]
H := enum {
    h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, h24, h25, h26, h27, h28, h29, h30, h31,
};

/// A floating-point register named at 32 bits, in the order of `V`.
#[Registers{ .class = .fp, .size = .some(.b32) }]
S := enum {
    s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31,
};

/// A floating-point register named at 64 bits, in the order of `V`.
#[Registers{ .class = .fp, .size = .some(.b64) }]
D := enum {
    d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20, d21, d22, d23, d24, d25, d26, d27, d28, d29, d30, d31,
};

/// A floating-point register named at 128 bits, in the order of `V`.
#[Registers{ .class = .fp }]
Q := enum {
    q0, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14, q15, q16, q17, q18, q19, q20, q21, q22, q23, q24, q25, q26, q27, q28, q29, q30, q31,
};

/// What a memory barrier orders (`dmb`): accesses within the outer (`osh`), non-shareable (`nsh`)
/// or inner (`ish`) shareability domain, or the full system (`sy`), each for loads (`ld`),
/// stores (`st`) or both.
#[Choice.barrier]
Barrier := enum {
    oshld, oshst, osh, nshld, nshst, nsh, ishld, ishst, ish, ld, st, sy,
};

/// A system register `mrs` reads and `msr` writes: the flags, and the thread pointer.
#[Choice.sys]
SysReg := enum {
    nzcv, tpidr_el0,
};

/// The kinds of named choice a position takes, each an enum of its own marked with its kind as an
/// attribute (`#[Choice.barrier]`): a barrier's domain (`ish`), a system register (`nzcv`).
Choice := enum { barrier, sys };

/// What a form does with an operand, or with the flags.
Access := enum {
    read,
    write,
    read_write,
    /// Nothing but compute its address.
    address,
};

/// Where control goes after a form.
Flow := enum {
    /// To the next instruction, and for a conditional branch also to its target.
    next,
    /// To its target only.
    jump,
    /// Out of the code: it returns or traps.
    ends,
};

/// An operand position: what it takes, the bit its field starts at, and what the form does with
/// it.
Arg := struct {
    kind: lang.arch.arm64.operand.Kind,
    at: u8,
    /// Where the same field goes again, for an alias reading one register in two fields (`cneg`
    /// is `csneg` of a register and itself).
    again: ?u8 = .none,
    access: Access,
};

/// What a processor has of A64 beyond Armv8.0 (`lang.target.Spec.features`): `lse`, Armv8.1's
/// atomic read-modify-writes in one instruction (`ldadd`, `swp`, `cas`).
Feature := enum { lse };

/// What a form needs of a processor beyond Armv8.0.
Need: type = lang.arch.Need(Feature, Size);

/// A width a form is defined at, the bits it sets in the word, and the type a call writes before
/// its operands to select it, where the mnemonic names the width apart (`ldr(u8, ...)` is `ldrb`).
Sized := struct { size: Size, bits: u32 = 0, types: &[type] = &[] };

/// A base word of the forms of a family: fixed, or its member's bits with these set.
Word := enum { fixed(u32), \or(u32) };

/// One form of an instruction, its base word of type `Base`: the widths it is defined at, its
/// operands, and what it reads and writes beyond them.
Form := ($Base: type) -> type { struct {
    base: Base,
    sizes: &[Sized],
    args: &[Arg],
    /// The mnemonic, where it is not the instruction's (`ldur`).
    name: ?&[u8] = .none,
    reads: &[Reg] = &[],
    writes: &[Reg] = &[],
    flags: ?Access = .none,
    flow: Flow = .next,
    /// What a processor needs to have the form, if not every one has it.
    requires: ?Need = .none,
} };

/// An instruction, named as its declaration is.
Instruction := struct { forms: &[Form(u32)] };

/// An instruction of a family, named as its declaration is, and the bits it sets in the family's
/// base words.
Member := struct { family: Family, bits: u32 = 0 };

/// Instructions sharing their forms but for a few bits, each a `Member` declared after it.
Family := struct { forms: &[Form(Word)] };

/// A mnemonic spelling several instructions, named here, each tried in order (`b` is `b_always`
/// or, given a condition, `bcond`).
Mnemonic := struct { instructions: &[lang.meta.Name] };

/// What an enum of registers names, written as its attribute.
Registers: type = lang.arch.Registers(Class, Size);

/// Each instruction is called in a block with the operands it takes (spec 07, section 6).
#[impl(lang.ops.Call(_, ())(Instruction))]
instruction_call := lang.arch.called(Instruction);
#[impl(lang.ops.Call(_, ())(Member))]
member_call := lang.arch.called(Member);
#[impl(lang.ops.Call(_, ())(Mnemonic))]
mnemonic_call := lang.arch.called(Mnemonic);

/// The names a block of instructions is written with, spread first in it
/// (`lang.arch.asm({ ..lang.arch.arm64.names; ... })`): the operand forms, the registers at each
/// width, the conditions, the named choices and the instructions.
names := struct {
    ..lang.arch.{ in, out, inout, mem, scaled, pre, post, here, label, place };
    ..lang.arch.arm64.X;
    ..lang.arch.arm64.W;
    ..lang.arch.arm64.B;
    ..lang.arch.arm64.H;
    ..lang.arch.arm64.S;
    ..lang.arch.arm64.D;
    ..lang.arch.arm64.Q;
    ..lang.arch.arm64.Cond;
    ..lang.arch.arm64.Barrier;
    ..lang.arch.arm64.SysReg;
    ..lang.arch.arm64.control;
    ..lang.arch.arm64.fp;
    ..lang.arch.arm64.int;
    ..lang.arch.arm64.memory;
};
