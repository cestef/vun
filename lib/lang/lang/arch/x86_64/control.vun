//! Conditions, jumps, calls, the stack, and atomic and string operations.

_x := lang.arch.x86_64;

_cond: _x.Operand = _x.Operand{ .kind = .cond, .access = .read };
_rel: _x.Operand = _x.Operand{ .kind = .rel, .access = .read };
_r: _x.Operand = _x.Operand{ .kind = .r, .access = .read };
_rw: _x.Operand = _x.Operand{ .kind = .r, .access = .read_write };
_rm: _x.Operand = _x.Operand{ .kind = .rm, .access = .read };
_rm_rw: _x.Operand = _x.Operand{ .kind = .rm, .access = .read_write };
_m_rw: _x.Operand = _x.Operand{ .kind = .m, .access = .read_write };
_all: &[_x.Size] = &[.b8, .b16, .b32, .b64];
_dst_src: _x.Layout(u8) = .reg_rm(_x.RegRm{ .reg = 1, .rm = 0 });
_stack: &[_x.Reg] = &[.rsp];
_reads: ?_x.Access = .some(.read);
_sets: ?_x.Access = .some(.write);

/// 1 in the byte if the condition holds, else 0.
set := _x.Instruction{ .forms = &[
    .{
        .operands = &[_cond, _x.Operand{ .kind = .rmn(.b8), .access = .write }],
        .sizes = _all,
        .opcode = &[0x0f, 0x90],
        .layout = .digit(.{ .digit = 0, .rm = 1 }),
        .w = .never,
        .flags = _reads,
    },
] };

/// A move if the condition holds.
cmov := _x.Instruction{ .forms = &[
    .{
        .operands = &[_cond, _rw, _rm],
        .sizes = &[.b16, .b32, .b64],
        .opcode = &[0x0f, 0x40],
        .layout = .reg_rm(_x.RegRm{ .reg = 1, .rm = 2 }),
        .flags = _reads,
    },
] };

/// A jump if the condition holds.
j := _x.Instruction{ .forms = &[
    .{
        .operands = &[_cond, _rel],
        .sizes = _all,
        .opcode = &[0x0f, 0x80],
        .layout = .bare,
        .w = .never,
        .flags = _reads,
    },
] };

/// An indirect jump's operand is 64 bits without REX.W, as a call's.
jmp := _x.Instruction{ .forms = &[
    .{ .operands = &[_rel], .sizes = _all, .opcode = &[0xe9], .layout = .bare, .w = .never, .flow = .jump },
    .{
        .operands = &[_x.Operand{ .kind = .rmn(.b64), .access = .read }],
        .sizes = _all,
        .opcode = &[0xff],
        .layout = .digit(.{ .digit = 4, .rm = 0 }),
        .w = .never,
        .flow = .jump,
    },
] };

/// A call's operand is 64 bits without REX.W.
call := _x.Instruction{ .forms = &[
    .{ .operands = &[_rel], .sizes = _all, .opcode = &[0xe8], .layout = .bare, .w = .never },
    .{
        .operands = &[_x.Operand{ .kind = .rmn(.b64), .access = .read }],
        .sizes = _all,
        .opcode = &[0xff],
        .layout = .digit(.{ .digit = 2, .rm = 0 }),
        .w = .never,
    },
] };

ret := _x.Instruction{ .forms = &[
    .{ .operands = &[], .sizes = _all, .opcode = &[0xc3], .layout = .bare, .w = .never, .flow = .ends },
] };

push := _x.Instruction{ .forms = &[
    .{
        .operands = &[_x.Operand{ .kind = .rn(.b64), .access = .read }],
        .sizes = _all,
        .opcode = &[0x50],
        .layout = .plus_reg(0),
        .w = .never,
        .reads = _stack,
        .writes = _stack,
    },
] };

pop := _x.Instruction{ .forms = &[
    .{
        .operands = &[_x.Operand{ .kind = .rn(.b64), .access = .write }],
        .sizes = _all,
        .opcode = &[0x58],
        .layout = .plus_reg(0),
        .w = .never,
        .reads = _stack,
        .writes = _stack,
    },
] };

/// Pushes the flags, 64 bits of them.
pushf := _x.Instruction{ .forms = &[
    .{
        .operands = &[],
        .sizes = _all,
        .opcode = &[0x9c],
        .layout = .bare,
        .w = .never,
        .reads = _stack,
        .writes = _stack,
        .flags = _reads,
    },
] };

/// Pops the flags.
popf := _x.Instruction{ .forms = &[
    .{
        .operands = &[],
        .sizes = _all,
        .opcode = &[0x9d],
        .layout = .bare,
        .w = .never,
        .reads = _stack,
        .writes = _stack,
        .flags = _sets,
    },
] };

leave := _x.Instruction{ .forms = &[
    .{
        .operands = &[],
        .sizes = _all,
        .opcode = &[0xc9],
        .layout = .bare,
        .w = .never,
        .reads = &[.rbp],
        .writes = &[.rsp, .rbp],
    },
] };

ud2 := _x.Instruction{ .forms = &[
    .{ .operands = &[], .sizes = _all, .opcode = &[0x0f, 0x0b], .layout = .bare, .w = .never, .flow = .ends },
] };

xchg := _x.Instruction{ .forms = &[
    .{
        .operands = &[_rm_rw, _rw],
        .sizes = _all,
        .opcode = &[0x87],
        .byte = .some(0x86),
        .layout = _dst_src,
    },
] };

/// Adds to memory, the register receiving what it held; atomic with `lock`.
xadd := _x.Instruction{ .forms = &[
    .{
        .operands = &[_m_rw, _rw],
        .sizes = _all,
        .opcode = &[0x0f, 0xc1],
        .byte = .some(0xc0),
        .layout = _dst_src,
        .prefix = .lock,
        .flags = _sets,
    },
] };

/// Stores the register in memory if memory holds `rax`, else loads it into `rax`; atomic with
/// `lock`.
cmpxchg := _x.Instruction{ .forms = &[
    .{
        .operands = &[_m_rw, _r],
        .sizes = _all,
        .opcode = &[0x0f, 0xb1],
        .byte = .some(0xb0),
        .layout = _dst_src,
        .prefix = .lock,
        .reads = &[.rax],
        .writes = &[.rax],
        .flags = _sets,
    },
] };

/// Copies `rcx` bytes from `[rsi]` to `[rdi]` with `rep`.
movsb := _x.Instruction{ .forms = &[
    .{
        .operands = &[],
        .sizes = _all,
        .opcode = &[0xa4],
        .layout = .bare,
        .prefix = .rep,
        .w = .never,
        .reads = _string,
        .writes = _string,
    },
] };

/// Fills `rcx` bytes at `[rdi]` with `al` with `rep`.
stosb := _x.Instruction{ .forms = &[
    .{
        .operands = &[],
        .sizes = _all,
        .opcode = &[0xaa],
        .layout = .bare,
        .prefix = .rep,
        .w = .never,
        .reads = &[.rdi, .rcx, .rax],
        .writes = &[.rdi, .rcx],
    },
] };

/// Clears the direction flag: string operations go up.
cld := _x.Instruction{ .forms = &[
    .{ .operands = &[], .sizes = _all, .opcode = &[0xfc], .layout = .bare, .w = .never, .flags = _sets },
] };

/// Sets the direction flag: string operations go down.
\std := _x.Instruction{ .forms = &[
    .{ .operands = &[], .sizes = _all, .opcode = &[0xfd], .layout = .bare, .w = .never, .flags = _sets },
] };

/// Calls the kernel: the call's number in `rax`, its result there too; the kernel keeps every
/// register but `rcx` and `r11`, which the return address and the flags pass through.
syscall := _x.Instruction{ .forms = &[
    .{
        .operands = &[],
        .sizes = _all,
        .opcode = &[0x0f, 0x05],
        .layout = .bare,
        .w = .never,
        .reads = &[.rax],
        .writes = &[.rax, .rcx, .r11],
    },
] };

_string: &[_x.Reg] = &[.rsi, .rdi, .rcx];
