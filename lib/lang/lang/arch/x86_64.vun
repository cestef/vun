//! x86-64 (spec 07, section 6): its registers, and each instruction with its forms as the
//! toolchain's assembler encodes them (Intel SDM volume 2), with what each form reads and writes.
//! The instructions are declared in `arith`, `control`, `int` and `sse`; `vun-isa-x86_64`'s tables
//! are generated from these declarations, so the language, the assembler and its listings share
//! one table. `names` holds what a block of instructions is written with.

/// The width of an operation or an operand.
Size := enum { b8, b16, b32, b64 };

/// A general register, by its encoding, named at 64 bits.
#[Registers{ .class = .general, .size = .some(.b64) }]
Reg := enum {
    rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi, r8, r9, r10, r11, r12, r13, r14, r15,
};

/// A general register named at 32 bits.
#[Registers{ .class = .general, .size = .some(.b32) }]
R32 := enum {
    eax, ecx, edx, ebx, esp, ebp, esi, edi, r8d, r9d, r10d, r11d, r12d, r13d, r14d, r15d,
};

/// A general register named at 16 bits.
#[Registers{ .class = .general, .size = .some(.b16) }]
R16 := enum {
    ax, cx, dx, bx, sp, bp, si, di, r8w, r9w, r10w, r11w, r12w, r13w, r14w, r15w,
};

/// A general register named at 8 bits.
#[Registers{ .class = .general, .size = .some(.b8) }]
R8 := enum {
    al, cl, dl, bl, spl, bpl, sil, dil, r8b, r9b, r10b, r11b, r12b, r13b, r14b, r15b,
};

/// A condition, by its encoding: what the flags say after a comparison (`z` for equal, `b`,
/// below, for unsigned less than; `l`, less, for signed; `p`, parity, where either operand of
/// `ucomis` is a NaN).
Cond := enum {
    o, no, b, ae, z, nz, be, a, s, ns,
    /// Parity: after `ucomis`, the operands are unordered (a NaN among them).
    p,
    np, l, ge, le, g,
};

/// The classes of registers an operand names: general ones (`Reg`) and SSE ones (`Xmm`).
Class := enum { general, sse };

/// An SSE register, by its encoding.
#[Registers{ .class = .sse }]
Xmm := enum {
    xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15,
};

/// What an enum of registers names, written as its attribute.
Registers := lang.arch.Registers(Class, Size);

/// What an operand position takes. A register or memory operand without a width of its own has
/// the instruction's.
Kind := enum {
    /// A general register.
    r,
    /// A general register at this width, whatever the instruction's.
    rn(Size),
    /// Memory.
    m,
    /// A general register or memory.
    rm,
    rmn(Size),
    /// An SSE register.
    x,
    /// An SSE register, or memory of this width.
    xmn(Size),
    /// `cl`, the count of a shift.
    cl,
    /// 8 bits, sign-extended to the instruction's width.
    i8,
    /// The instruction's width up to 32 bits, sign-extended to 64.
    iz,
    /// 32 bits, zero-extended to 64.
    u32,
    i64,
    /// A label or a symbol, 32 bits from the end of the instruction.
    rel,
    /// A condition, which the mnemonic's suffix names (`je`).
    cond,
};

/// What a form does with an operand, or with the flags.
Access := enum {
    read,
    write,
    read_write,
    /// Nothing but compute its address (`lea`).
    address,
};

/// Where control goes after a form.
Flow := enum {
    /// To the next instruction, and for a conditional branch also to its target.
    next,
    /// To its target only.
    jump,
    /// Out of the code: it returns or traps.
    ends,
};

Operand := struct { kind: Kind, access: Access };

/// What a processor has of x86-64 beyond its baseline (`lang.target.Spec.features`): nothing the
/// table's forms need yet.
Feature := enum {};

/// What a form needs of a processor beyond x86-64's baseline.
Need := lang.arch.Need(Feature, Size);

/// A prefix before REX: `lock`, `rep`, or the mandatory prefix of an SSE instruction.
Prefix := enum { none, lock, rep, p66, f2, f3 };

/// How the instruction's width is encoded.
W := enum {
    /// `66` at 16 bits, REX.W at 64: integer operations.
    size,
    /// REX.W at 64 only: SSE instructions over a general register of that width.
    rex,
    always,
    never,
};

/// A byte of the forms of a family: fixed, or its member's opcode with these bits set, or its
/// member's opcode extension.
Byte := enum { fixed(u8), opcode(u8), digit };

/// `ModRM` with a register in `reg` and a register or memory in `rm`, by operand position.
RegRm := struct { reg: u8, rm: u8 };
/// `ModRM` with an opcode extension in `reg`.
Digit := ($B: type) -> type { struct { digit: B, rm: u8 } };

/// Where the operands go in the encoding, by position.
Layout := ($B: type) -> type { enum {
    reg_rm(RegRm),
    digit(Digit(B)),
    /// The register at this position added to the opcode's last byte.
    plus_reg(u8),
    /// No `ModRM`.
    bare,
} };

/// One form of an instruction, its bytes of type `B`: the operands it takes and the widths it is
/// defined at, its encoding, and what it reads and writes beyond its operands.
Form := ($B: type) -> type { struct {
    operands: &[Operand],
    sizes: &[Size],
    /// Up to three bytes, the first `0F` for a two-byte opcode.
    opcode: &[B],
    layout: Layout(B),
    /// The opcode's last byte at 8 bits, where it differs.
    byte: ?B = .none,
    prefix: Prefix = .none,
    w: W = .size,
    /// The mnemonic, where it is not the instruction's (`movsxd`).
    name: ?&[u8] = .none,
    reads: &[Reg] = &[],
    writes: &[Reg] = &[],
    flags: ?Access = .none,
    flow: Flow = .next,
    /// What a processor needs to have the form, if not every one has it.
    requires: ?Need = .none,
} };

/// An instruction, named as its declaration is (`\and` for `and`).
Instruction := struct { forms: &[Form(u8)] };

/// An instruction of a family, named as its declaration is, and the bytes it fills the family's
/// forms with.
Member := struct { family: Family, opcode: u8 = 0, digit: u8 = 0 };

/// Instructions sharing their forms but for a few bytes, each a `Member` declared after it.
Family := struct { forms: &[Form(Byte)] };

/// Each instruction is called in a block with the operands it takes (spec 07, section 6).
#[impl(lang.ops.Call(_, ())(Instruction))]
instruction_call := lang.arch.called(Instruction);
#[impl(lang.ops.Call(_, ())(Member))]
member_call := lang.arch.called(Member);

/// The names a block of instructions is written with, spread first in it
/// (`lang.arch.asm({ ..lang.arch.x86_64.names; ... })`): the operand forms, the registers at each
/// width, the conditions, the named choices and the instructions.
names := struct {
    ..lang.arch.{ in, out, inout, mem, scaled, pre, post, here, label, place };
    ..lang.arch.x86_64.Reg;
    ..lang.arch.x86_64.R32;
    ..lang.arch.x86_64.R16;
    ..lang.arch.x86_64.R8;
    ..lang.arch.x86_64.Xmm;
    ..lang.arch.x86_64.Cond;
    ..lang.arch.x86_64.arith;
    ..lang.arch.x86_64.control;
    ..lang.arch.x86_64.int;
    ..lang.arch.x86_64.sse;
};
