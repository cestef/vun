//! Branches, calls, traps, barriers and page addresses (Arm A64 ISA, branches, exception
//! generation and system instructions).

_a := lang.arch.arm64;

_any: &[_a.Sized] = &[.{ .size = .b8 }, .{ .size = .b16 }, .{ .size = .b32 }, .{ .size = .b64 }];
_sf: &[_a.Sized] = &[.{ .size = .b32 }, .{ .size = .b64, .bits = 0x80000000 }];

_call26_d: _a.Arg = .{ .kind = .target(.call26), .at = 0, .access = .read };
_cond19_n: _a.Arg = .{ .kind = .target(.cond19), .at = 5, .access = .read };
_cond_d: _a.Arg = .{ .kind = .cond(.suffix), .at = 0, .access = .read };
_jump26_d: _a.Arg = .{ .kind = .target(.jump26), .at = 0, .access = .read };
_page_d: _a.Arg = .{ .kind = .page, .at = 0, .access = .read };
_r_d: _a.Arg = .{ .kind = .gpr(.zr, .inst), .at = 0, .access = .read };
_u16_d: _a.Arg = .{ .kind = .imm(.u16), .at = 0, .access = .read };
_u16_n: _a.Arg = .{ .kind = .imm(.u16), .at = 5, .access = .read };
_x_d: _a.Arg = .{ .kind = .gpr(.zr, .is(.b64)), .at = 0, .access = .read };
_x_d_w: _a.Arg = .{ .kind = .gpr(.zr, .is(.b64)), .at = 0, .access = .write };
_x_n: _a.Arg = .{ .kind = .gpr(.zr, .is(.b64)), .at = 5, .access = .read };

b := _a.Instruction{ .forms = &[
    .{ .base = 0x14000000, .sizes = _any, .args = &[_jump26_d], .flow = .jump },
] };

/// A conditional branch, written with its condition as the mnemonic's suffix (`b.eq`).
bcond := _a.Instruction{ .mnemonic = .some("b"), .forms = &[
    .{ .base = 0x54000000, .sizes = _any, .args = &[_cond_d, _cond19_n], .flags = .some(.read) },
] };

bl := _a.Instruction{ .forms = &[
    .{ .base = 0x94000000, .sizes = _any, .args = &[_call26_d], .writes = &[.x30] },
] };

br := _a.Instruction{ .forms = &[
    .{ .base = 0xd61f0000, .sizes = _any, .args = &[_x_n], .flow = .jump },
] };

blr := _a.Instruction{ .forms = &[
    .{ .base = 0xd63f0000, .sizes = _any, .args = &[_x_n], .writes = &[.x30] },
] };

ret := _a.Instruction{ .forms = &[
    .{ .base = 0xd65f03c0, .sizes = _any, .args = &[], .reads = &[.x30], .flow = .ends },
] };

cbz := _a.Instruction{ .forms = &[
    .{ .base = 0x34000000, .sizes = _sf, .args = &[_r_d, _cond19_n] },
] };

cbnz := _a.Instruction{ .forms = &[
    .{ .base = 0x35000000, .sizes = _sf, .args = &[_r_d, _cond19_n] },
] };

udf := _a.Instruction{ .forms = &[
    .{ .base = 0x0, .sizes = _any, .args = &[_u16_d], .flow = .ends },
] };

brk := _a.Instruction{ .forms = &[
    .{ .base = 0xd4200000, .sizes = _any, .args = &[_u16_n], .flow = .ends },
] };

/// Calls the kernel (the supervisor): Linux takes the call's number in `x8` and returns its
/// result in `x0`, keeping every other register.
svc := _a.Instruction{ .forms = &[
    .{ .base = 0xd4000001, .sizes = _any, .args = &[_u16_n], .reads = &[.x8], .writes = &[.x0] },
] };

/// The page of an address, which a following `add` or load completes with its low 12 bits.
adrp := _a.Instruction{ .forms = &[
    .{ .base = 0x90000000, .sizes = _any, .args = &[_x_d_w, _page_d] },
] };

/// Strips the pointer authentication code from the address in `x30`, as a return address is
/// saved where code is built with return addresses signed; a hint, which does nothing on a
/// processor without pointer authentication.
xpaclri := _a.Instruction{ .forms = &[
    .{ .base = 0xd50320ff, .sizes = _any, .args = &[], .reads = &[.x30], .writes = &[.x30] },
] };

/// A data memory barrier: accesses the barrier orders complete, as its operand says, before any
/// after it.
dmb := _a.Instruction{ .forms = &[
    .{ .base = 0xd50330bf, .sizes = _any, .args = &[.{ .kind = .barrier, .at = 8, .access = .read }] },
] };

/// Reads a system register.
mrs := _a.Instruction{ .forms = &[
    .{
        .base = 0xd5300000,
        .sizes = _any,
        .args = &[_x_d_w, .{ .kind = .sys, .at = 5, .access = .read }],
        .flags = .some(.read),
    },
] };

/// Writes a system register.
msr := _a.Instruction{ .forms = &[
    .{
        .base = 0xd5100000,
        .sizes = _any,
        .args = &[.{ .kind = .sys, .at = 5, .access = .write }, _x_d],
        .flags = .some(.write),
    },
] };
