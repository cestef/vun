//! The special registers, interrupt masks, waits and barriers (Armv7-M, system instructions).

_t := lang.arch.thumb;

_r: _t.Operand = _t.Operand{ .kind = .r, .access = .read };
_r_w: _t.Operand = _t.Operand{ .kind = .r, .access = .write };
_special: _t.Operand = _t.Operand{ .kind = .special, .access = .read };
_special_w: _t.Operand = _t.Operand{ .kind = .special, .access = .write };
_mask: _t.Operand = _t.Operand{ .kind = .mask, .access = .read };
_barrier: _t.Operand = _t.Operand{ .kind = .barrier, .access = .read };

/// A special register read into a general one.
mrs := _t.Instruction{ .forms = &[.{ .operands = &[_r_w, _special] }] };

/// A general register written into a special one.
msr := _t.Instruction{ .forms = &[.{ .operands = &[_special_w, _r] }] };

/// Masks interrupts: `cpsid i` sets `primask`, `cpsid f` sets `faultmask`.
cpsid := _t.Instruction{ .forms = &[.{ .operands = &[_mask], .writes = &[.primask, .faultmask] }] };

/// Unmasks interrupts, clearing what `cpsid` sets.
cpsie := _t.Instruction{ .forms = &[.{ .operands = &[_mask], .writes = &[.primask, .faultmask] }] };

/// Waits for an interrupt.
wfi := _t.Instruction{ .forms = &[.{ .operands = &[] }] };

/// Waits for an event.
wfe := _t.Instruction{ .forms = &[.{ .operands = &[] }] };

nop := _t.Instruction{ .forms = &[.{ .operands = &[] }] };

/// Barriers: every access before completes before any after (`dsb`), in order of memory
/// (`dmb`), and the instructions after are fetched again (`isb`).
barriers := _t.Family{
    .members = &[_t.Member{ .name = .dsb }, _t.Member{ .name = .dmb }, _t.Member{ .name = .isb }],
    .forms = &[.{ .operands = &[_barrier] }],
};

/// A trap into the debugger, or a fault without one.
bkpt := _t.Instruction{ .forms = &[.{ .operands = &[], .flow = .ends }] };

/// Moves a general register, `sp` among them, into another.
mov := _t.Instruction{ .forms = &[.{ .operands = &[_r_w, _r] }] };
