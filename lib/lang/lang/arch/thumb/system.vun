//! The special registers, interrupt masks, waits and barriers (Armv7-M, system instructions).

_t := lang.arch.thumb;

_r_w: _t.Arg = .{ .kind = .gpr(.general), .at = 8, .access = .write };
_r: _t.Arg = .{ .kind = .gpr(.general), .at = 16, .access = .read };
_mask: _t.Arg = .{ .kind = .mask, .access = .read };

/// A special register read into a general one.
mrs := _t.Instruction{ .forms = &[.{ .base = 0xf3ef8000, .args = &[_r_w, .{ .kind = .special, .access = .read }] }] };

/// A general register written into a special one.
msr := _t.Instruction{ .forms = &[.{ .base = 0xf3808800, .args = &[.{ .kind = .special, .access = .write }, _r] }] };

/// Masks interrupts: `cpsid i` sets `primask`, `cpsid f` sets `faultmask`; `cpsie` clears them.
cpsid := _t.Instruction{ .forms = &[.{ .base = 0xb670, .args = &[_mask] }] };
cpsie := _t.Instruction{ .forms = &[.{ .base = 0xb660, .args = &[_mask] }] };

/// Waits for an interrupt, or for an event.
wfi := _t.Instruction{ .forms = &[.{ .base = 0xbf30, .args = &[] }] };
wfe := _t.Instruction{ .forms = &[.{ .base = 0xbf20, .args = &[] }] };

nop := _t.Instruction{ .forms = &[.{ .base = 0xbf00, .args = &[] }] };

/// Barriers: every access before completes before any after (`dsb`), in order of memory
/// (`dmb`), and the instructions after are fetched again (`isb`).
barriers := _t.Family{
    .members = &[
        _t.Member{ .name = .dsb, .bits = 0x40 },
        _t.Member{ .name = .dmb, .bits = 0x50 },
        _t.Member{ .name = .isb, .bits = 0x60 },
    ],
    .forms = &[.{ .base = .\or(0xf3bf8f00), .args = &[.{ .kind = .barrier, .access = .read }] }],
};
