//! Layout attributes (spec 05, section 6).

bits: ($Backing: type) -> Attribute(&[Place.types]) = _;
c: Attribute(&[Place.types]) = _;
tag: ($Tag: type) -> Attribute(&[Place.types]) = _;
align: ($bytes: usize) -> Attribute(&[Place.types]) = _;
offset: ($bytes: usize) -> Attribute(&[Place.fields]) = _;
