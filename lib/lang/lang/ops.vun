//! Operators as interfaces. Every operator desugars to one of these (spec 02, section 4); the
//! table `operators` of `lang.syntax.desugar` says which.

/// `a + b`.
Add := interface(($Self: type) -> type { struct {
    Rhs: type = _;
    Output: type = _;
    add: (a: Self, b: Rhs) -> Output = _;
}});

/// `a - b`.
Sub := interface(($Self: type) -> type { struct {
    Rhs: type = _;
    Output: type = _;
    sub: (a: Self, b: Rhs) -> Output = _;
}});

/// `a * b`.
Mul := interface(($Self: type) -> type { struct {
    Rhs: type = _;
    Output: type = _;
    mul: (a: Self, b: Rhs) -> Output = _;
}});

/// `a / b`.
Div := interface(($Self: type) -> type { struct {
    Rhs: type = _;
    Output: type = _;
    div: (a: Self, b: Rhs) -> Output = _;
}});

/// `a % b`.
Rem := interface(($Self: type) -> type { struct {
    Rhs: type = _;
    Output: type = _;
    rem: (a: Self, b: Rhs) -> Output = _;
}});

/// `a ++ b`, and `[..a, x]`.
Concat := interface(($Self: type) -> type { struct {
    Rhs: type = _;
    Output: type = _;
    concat: (a: Self, b: Rhs) -> Output = _;
}});

/// `a & b`: bit operations keep the type (spec 04, rule 8).
BitAnd := interface(($Self: type) -> type { struct {
    bit_and: (a: Self, b: Self) -> Self = _;
}});

/// `a | b`: bit operations keep the type (spec 04, rule 8).
BitOr := interface(($Self: type) -> type { struct {
    bit_or: (a: Self, b: Self) -> Self = _;
}});

/// `a ^ b`: bit operations keep the type (spec 04, rule 8).
BitXor := interface(($Self: type) -> type { struct {
    bit_xor: (a: Self, b: Self) -> Self = _;
}});

/// `a << n`: shifts keep the type of `a` (spec 04, rule 8).
Shl := interface(($Self: type) -> type { struct {
    Amount: type = _;
    shl: (a: Self, n: Amount) -> Self = _;
}});

/// `a >> n`: shifts keep the type of `a` (spec 04, rule 8).
Shr := interface(($Self: type) -> type { struct {
    Amount: type = _;
    shr: (a: Self, n: Amount) -> Self = _;
}});

/// `a == b` and `a != b`.
Eq := interface(($Self: type) -> type { struct {
    eq: (a: &Self, b: &Self) -> bool = _;
    ne := (a: &Self, b: &Self) -> bool { !eq(a, b) };
}});

/// `a < b`, `a <= b`, `a > b` and `a >= b`: a total order, from `cmp`.
Ord := interface(($Self: type) -> type { struct {
    cmp: (a: &Self, b: &Self) -> Ordering = _;
    lt := (a: &Self, b: &Self) -> bool { match cmp(a, b) { .less => true, _ => false } };
    le := (a: &Self, b: &Self) -> bool { match cmp(a, b) { .greater => false, _ => true } };
    gt := (a: &Self, b: &Self) -> bool { match cmp(a, b) { .greater => true, _ => false } };
    ge := (a: &Self, b: &Self) -> bool { match cmp(a, b) { .less => false, _ => true } };
}});

/// Integers in their order.
#[impl(Ord(Int))]
IntOrd := ($r: Range) -> type { struct {
    #[panic.never]
    cmp := (a: &Int(r), b: &Int(r)) -> Ordering {
        if a.* < b.* { .less } else if a.* > b.* { .greater } else { .equal }
    };
} };

Index := interface(($Self: type) -> type { struct {
    Key: type = _;
    Item: type = _;
    at: (self: &Self, key: Key) -> &Item = _;
}});

/// What `e?` desugars to: continue with a value, or stop the function with a result.
Try := interface(($Self: type) -> type { struct {
    Value: type = _;
    Stop: type = _;
    branch: (self: Self) -> Branch(Value, Stop) = _;
}});

/// `o?` gives the value of `.some`, or returns `.none`, an `Option(never)`, which every option
/// type accepts.
#[impl(Try(Option))]
OptionTry := ($T: type) -> type { struct {
    Value := T;
    Stop := Option(never);
    branch := (self: Option(T)) -> Branch(T, Option(never)) {
        match self { .some(v) => .go(v), .none => .stop(.none) }
    };
} };

/// `r?` gives the value of `.ok`, or returns the error as a `Result(never, E)`, which every
/// result type with errors `E` accepts.
#[impl(Try(Result))]
ResultTry := ($T: type, $E: type) -> type { struct {
    Value := T;
    Stop := Result(never, E);
    branch := (self: Result(T, E)) -> Branch(T, Result(never, E)) {
        match self { .ok(v) => .go(v), .err(e) => .stop(.err(e)) }
    };
} };

/// What calling a value that is no function means (spec 01, section 4): a closure is an anonymous
/// struct of its captures with this impl, and `f(a, b)` is `call(&mut f, (a, b))`.
Call := ($Params: type, $R: type) -> Interface {
    interface(($Self: type) -> type { struct {
        call: (self: &mut Self, args: Params) -> R = _;
    }})
};

/// What `for p in e` iterates.
Iterate := interface(($Self: type) -> type { struct {
    Iter: Interface = _;
    iter: (self: Self) -> Iter = _;
}});

/// A coroutine is its own iterator (spec 06, section 2). The impl's target is an interface
/// constructor: it covers every type implementing a `Coroutine(Y, R)`, which it takes first.
#[impl(Iterate(Coroutine))]
CoroutineIterate := ($Self: type, $Y: type, $R: type) -> type { struct {
    Iter := Coroutine(Y, R);
    iter := (self: Self) -> Self { self };
} };

/// Bounds give their items from the start up (spec 04).
#[impl(Iterate(Bounds))]
BoundsIterate := ($T: type) -> type { struct {
    Iter := Coroutine(T, ());
    iter := (self: Bounds(T)) -> Iter {
        if bounds.empty(T, self) { return; }
        mut i := bounds.first(T, self);
        for {
            yield i;
            if bounds.ends(T, self, i) { break; }
            i += 1;
        }
    };
} };

/// A slice, through a borrow, gives a borrow of each of its items in order.
#[impl(Iterate(mem.Slice))]
SliceIterate := ($T: type) -> type { struct {
    Iter := Coroutine(&T, ());
    iter := (self: &[T]) -> Iter {
        mut i: usize = 0;
        for i < mem.len(T, self) {
            yield &self[i];
            i += 1;
        }
    };
} };

/// An array value gives each of its items in order.
#[impl(Iterate(mem.Array))]
ArrayIterate := ($n: Int(0..), $T: type) -> type { struct {
    Iter := Coroutine(T, ());
    iter := (self: [n]T) -> Iter {
        mut i: usize = 0;
        for i < n {
            yield self[i];
            i += 1;
        }
    };
} };
