//! Every compiler diagnostic, grouped by area. `cargo gen` derives the ids of
//! `vun-diag` from this file. Each entry's explanation page is the file its binding path names,
//! `errors/<group>/<name>.md` (spec 10, section 1).

/// Tokens and syntax trees (spec 01).
syntax := struct {
    unknown_character := diag.Diag{};
    unterminated_string := diag.Diag{};
    unterminated_char := diag.Diag{};
    invalid_escape := diag.Diag{};
    malformed_number := diag.Diag{};
    stray_escape := diag.Diag{};
    expected_token := diag.Diag{};
    expected_expression := diag.Diag{};
    expected_declaration := diag.Diag{};
    expected_name := diag.Diag{};
    unclosed_delimiter := diag.Diag{};
    chained_operator := diag.Diag{};
    nesting_too_deep := diag.Diag{};
    unknown_borrow := diag.Diag{};
};

/// Attributes (spec 02, section 5).
attr := struct {
    misplaced := diag.Diag{};
};

/// Range integers (spec 04).
int := struct {
    does_not_fit := diag.Diag{};
    width_cap := diag.Diag{};
};

/// Type checking (spec 02).
types := struct {
    mismatch := diag.Diag{};
    no_member := diag.Diag{};
    no_impl := diag.Diag{};
    cannot_infer := diag.Diag{};
    arity := diag.Diag{};
    slice_value := diag.Diag{};
    pack_position := diag.Diag{};
};

/// Name resolution and visibility (spec 01, sections 3, 7 and 8).
names := struct {
    unresolved := diag.Diag{};
    shadowed := diag.Diag{};
    private := diag.Diag{};
    visibility := diag.Diag{};
    duplicate := diag.Diag{};
};

/// Bindings and patterns (spec 01, sections 3 and 6).
binding := struct {
    hole_value := diag.Diag{};
    irrefutable_test := diag.Diag{};
    unequal_alternatives := diag.Diag{};
    missing_case := diag.Diag{};
};

/// The `unsafe` boundary (spec 01, section 3; spec 05, section 5).
safety := struct {
    requires_unsafe := diag.Diag{};
};

/// Blocks of an architecture's instructions (spec 07, section 6).
asm := struct {
    unknown_arch := diag.Diag{};
    unknown_mnemonic := diag.Diag{};
    unknown_operand := diag.Diag{};
    no_form := diag.Diag{};
    immediate_too_wide := diag.Diag{};
    register_class := diag.Diag{};
    unavailable := diag.Diag{};
};

/// Interface conformance (spec 02, section 3).
impl := struct {
    missing_requirement := diag.Diag{};
    requirement_type := diag.Diag{};
    duplicate := diag.Diag{};
    collision := diag.Diag{};
};

/// Coroutine frames (spec 06, section 1).
coroutine := struct {
    recursive_frame := diag.Diag{};
};

/// Layout attributes (spec 05, section 6).
layout := struct {
    bits_width := diag.Diag{};
    not_c := diag.Diag{};
    tag := diag.Diag{};
    align := diag.Diag{};
    offset := diag.Diag{};
};

/// Compile-time evaluation and reflection (spec 03).
meta := struct {
    frozen := diag.Diag{};
    escape := diag.Diag{};
};

/// Compile-time evaluation (spec 03, section 7).
comptime := struct {
    trap := diag.Diag{};
    exhausted := diag.Diag{};
    reported := diag.Diag{};
    unsupported := diag.Diag{};
    runtime := diag.Diag{};
    export := diag.Diag{};
};

/// Place states (spec 05, section 2).
place := struct {
    read_uninit := diag.Diag{};
    linear_leak := diag.Diag{};
    ambiguous_join := diag.Diag{};
    out_unwritten := diag.Diag{};
    move_out_of_borrow := diag.Diag{};
};

/// Scoped borrows and exclusivity (spec 05, sections 4 and 8).
borrow := struct {
    conflict := diag.Diag{};
    escape := diag.Diag{};
    in_free_value := diag.Diag{};
};

/// Trap freedom (spec 07, section 3).
panic := struct {
    never_violated := diag.Diag{};
};

/// Checks of unsafe code at run time (spec 07, section 7).
check := struct {
    unsupported := diag.Diag{};
};

/// Code generation backends (spec 13).
backend := struct {
    unavailable := diag.Diag{};
    unsupported := diag.Diag{};
    unchosen := diag.Diag{};
    lacks := diag.Diag{};
    tool := diag.Diag{};
    unlowered := diag.Diag{};
};

/// Stack bounds (spec 07, section 4).
stack := struct {
    exceeded := diag.Diag{};
    unbounded := diag.Diag{};
    unreported := diag.Diag{};
};

/// Targets (spec 13, section 7).
target := struct {
    unchosen := diag.Diag{};
};

/// Linking (spec 13).
link := struct {
    unavailable := diag.Diag{};
    unsupported := diag.Diag{};
    export_mismatch := diag.Diag{};
};

/// Calling conventions (spec 07, section 4).
abi := struct {
    variadic := diag.Diag{};
};

/// Package manifests: the `package` literal of `build.vun` (spec 12, section 2).
manifest := struct {
    missing_package := diag.Diag{};
    missing_field := diag.Diag{};
    unknown_field := diag.Diag{};
    invalid_field := diag.Diag{};
    uneditable := diag.Diag{};
};

/// Packages and their namespaces on disk (spec 01, section 8, and spec 12, section 3).
package := struct {
    missing_dep := diag.Diag{};
    missing_namespace := diag.Diag{};
    hash_mismatch := diag.Diag{};
    fetch_failed := diag.Diag{};
    no_project := diag.Diag{};
    duplicate_dep := diag.Diag{};
    unnamed := diag.Diag{};
    version_conflict := diag.Diag{};
    stale_lock := diag.Diag{};
};

/// A package's plan, which its `build` records (spec 12, section 2).
plan := struct {
    missing_build := diag.Diag{};
    stopped := diag.Diag{};
    unread := diag.Diag{};
    unsupported := diag.Diag{};
};

/// Running a namespace's tests through `std.testing.runner` (spec 11).
test := struct {
    no_namespace := diag.Diag{};
    unrunnable := diag.Diag{};
};

/// The toolchain's tools and the native libraries they load (decision 131).
tool := struct {
    missing_library := diag.Diag{};
    bind_failed := diag.Diag{};
    bind_skipped := diag.Diag{};
    nothing_to_reduce := diag.Diag{};
};

/// The toolchains installed side by side, and releases (spec 12, section 6).
toolchain := struct {
    install_failed := diag.Diag{};
    not_installed := diag.Diag{};
    in_use := diag.Diag{};
};

/// Reading and writing files.
io := struct {
    unreadable_file := diag.Diag{};
    unwritable_file := diag.Diag{};
};

/// The command line (spec 12, section 7).
cli := struct {
    unknown_command := diag.Diag{};
    missing_argument := diag.Diag{};
    unexpected_argument := diag.Diag{};
    unknown_option := diag.Diag{};
    missing_value := diag.Diag{};
    invalid_value := diag.Diag{};
    unavailable := diag.Diag{};
};
