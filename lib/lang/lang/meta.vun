//! Code values, names, reflection and origins (spec 03).

Code: ($T: type) -> type = _;
Name: type = _;
/// The type of files, directories and packages as values (spec 01, section 8).
Namespace: type = _;
Origin: type = _;

/// The type of the expression `e`, which is typed and never run: a `Code` parameter quotes its
/// argument (spec 03, section 4), so `TypeOf(x)` works on run-time expressions too.
TypeOf := ($T: type, $e: Code(T)) -> type { T };
origin: ($T: type) -> Origin = _;
/// The struct `T`'s impl of the interface `I` gives, as the impls seen where it is asked see
/// them: `witness(lang.ops.Add, u8).Output(u8)` is `Int(0..=510)`.
#[
    lint.allow(
        std.lints.naming.case,
        "it gives an impl, a namespace, which a primitive's annotation cannot say"
    )
]
witness: ($I: lang.Interface, $T: type) -> type = _;
/// Whether `T` has an impl of the interface `I`, as impls are seen where it is asked: whether
/// `witness(I, T)` gives one.
implements: ($I: lang.Interface, $T: type) -> bool = _;
/// The bytes of the file at `path`, from the directory of the file calling, in its package
/// (spec 03, section 7): the one input compile-time code reads, recorded as a dependency.
embed: ($path: &[u8]) -> &static [u8] = _;

/// Whether the namespace `inner` is `outer` or nested in it.
inside: (inner: Namespace, outer: Namespace) -> bool = _;

/// Whether `a` and `b` are one compile-time value: two types made by the same constructor from
/// the same arguments, one name.
same: ($T: type, $a: T, $b: T) -> bool = _;

/// Types are equal when they are one type (spec 02, section 1: `Pair(u16)` is one type).
#[impl(lang.ops.Eq(type))]
type_eq := struct {
    eq := (a: &type, b: &type) -> bool { same(type, a.*, b.*) };
};

/// Names are equal when they are one name: `lang.target.current.os == .linux`.
#[impl(lang.ops.Eq(Name))]
name_eq := struct {
    eq := (a: &Name, b: &Name) -> bool { same(Name, a.*, b.*) };
};

/// A compile-time value of any type, with its type: what a plan records of a record whose type
/// each call infers (spec 03, section 7). It exists at compile time only.
Any: type = _;
/// `value`, of type `T`, as an `Any`.
any: ($T: type, value: T) -> Any = _;
/// The value `a` holds, when it is of type `T`.
value: ($T: type, a: Any) -> ?T = _;
/// The items of `items` followed by `item`, in compile-time memory (spec 03, section 7).
append: ($T: type, items: &[T], item: T) -> &static [T] = _;
/// The items of `a` followed by those of `b`, in compile-time memory.
concat: ($T: type, a: &[T], b: &[T]) -> &static [T] = _;

/// `a ++ b` on sequences, at compile time: the items of both (spec 02, section 4).
#[impl(lang.ops.Concat(lang.mem.Slice))]
slice_concat := ($T: type) -> type { struct {
    Output := ($R: type) -> type { &static [T] };
    concat := (a: &[T], b: &[T]) -> &static [T] { lang.meta.concat(T, a, b) };
} };

/// `a ++ b` on an array, as on the slice of its items: a string literal is a borrow of one.
#[impl(lang.ops.Concat(lang.mem.Array))]
array_concat := ($n: Int(0..), $T: type) -> type { struct {
    Output := ($R: type) -> type { &static [T] };
    concat := (a: &[T], b: &[T]) -> &static [T] { lang.meta.concat(T, a, b) };
} };

/// A part of a value, as reflection gives it (spec 03, section 6): a field of a struct, an item
/// of a variant's payload, named by its position (`0`, `1`, ...), or a parameter of a function,
/// a part of the tuple a call passes.
Field := struct {
    name: &[u8],
    /// Its position among the parts of its variant.
    index: usize,
    type: type,
    /// The values of the attributes written on it, plain data found by type (`std.meta.attr`);
    /// none for an item of a payload.
    attrs: &[Any],
};

/// The fields of the struct type `T` in declaration order, generated ones included.
fields: ($T: type) -> &[Field] = _;
/// A variant of a type, as reflection gives it: every value of a `struct` or `enum` type is one
/// of its type's variants and the parts that variant holds. A struct is one variant, named by
/// nothing, whose parts are its fields.
Variant := struct {
    name: &[u8],
    /// Its position among the variants of its type.
    index: usize,
    parts: &[Field],
    /// The values of the attributes written on it; none for the variant a struct is.
    attrs: &[Any],
};

/// A member of a namespace, as reflection gives it: its name, the values of the attributes
/// written on it, and, for a file or directory below, that namespace. Its value, `ns.$(name)`, is
/// computed only where it is read.
Decl := struct {
    name: &[u8],
    attrs: &[Any],
    nested: ?Namespace,
};

/// The members of `ns` the namespace calling sees, in the order they are declared: every one
/// within its package, the public ones from another.
decls: ($ns: Namespace) -> &[Decl] = _;

/// The variants of `T` in declaration order: an enum's, the one a struct is, none for another
/// type.
variants: ($T: type) -> &[Variant] = _;
/// The position among the variants of `T` of the variant `v` is: 0 for a struct.
#[panic.never]
variant: ($T: type, v: &T) -> usize = _;
/// The type of the part `index` of the variant `variant` of `T`.
Part: ($T: type, $variant: usize, $index: usize) -> type = _;
/// The part `index` of `v`, when `v` is the variant `variant` of `T`.
#[panic.never]
part: ($T: type, v: &T, $variant: usize, $index: usize) -> ?&Part(T, variant, index) = _;
/// The types of the parts of the variant `variant` of `T`, as a tuple.
Parts: ($T: type, $variant: usize) -> type = _;
/// The value of `T` that is its variant `variant` holding `parts`: what `part` takes apart.
make: ($T: type, $variant: usize, parts: Parts(T, variant)) -> T = _;
/// The item types of the tuple type `T`, in order; none for another type.
items: ($T: type) -> &[type] = _;
/// `T` without the borrows around it, `U` for `&&U`: the type a method called on a value of `T` is
/// looked up in.
Unborrowed: ($T: type) -> type = _;
/// The name of `T` as diagnostics show it: a `struct` or `enum` literal by the declaration it is
/// written in, with its compile-time arguments.
name_of: ($T: type) -> &[u8] = _;

/// The parameters of the function `f`, in order: each by its name, or its position when it binds
/// no name, the type `F` gives it and the values of the attributes written on it.
params: ($F: type, $f: F) -> &[Field] = _;

/// The type of the frames the coroutine function `f` makes (spec 06, section 1): the result of
/// its signature.
Frame: ($F: type, $f: F) -> type = _;

/// The size of `T` in bytes under the target (spec 05, section 6).
size: ($T: type) -> usize = _;
/// The alignment of `T` in bytes under the target (spec 05, section 6).
align: ($T: type) -> usize = _;

/// The source text of the code `c`, as written.
source: ($T: type, c: &Code(T)) -> &[u8] = _;
/// Where the code `c` is written.
span: ($T: type, c: &Code(T)) -> Origin = _;
/// Where the bytes `bytes` of the string literal the code `c` writes are written: a part of its
/// origin, which a report points inside the literal with (spec 10, section 3); the code's own
/// origin when it writes no literal.
within: ($T: type, c: &Code(T), $bytes: lang.Range) -> Origin = _;
