//! Floating-point operations that are explicit about precision (spec 04, section 2).

#[lower.by(lang.float.soft.mul_add)]
mul_add: ($T: type, a: T, b: T, c: T) -> T = _;

/// IEEE 754 arithmetic in the float type `T`, rounding to nearest: none traps, a division by
/// zero giving an infinity, a NaN result the canonical NaN (spec 04, section 2).
#[panic.never, lower.soft(lang.float.soft.arith.add)]
add: ($T: type, a: T, b: T) -> T = _;
#[panic.never, lower.soft(lang.float.soft.arith.sub)]
sub: ($T: type, a: T, b: T) -> T = _;
#[panic.never, lower.soft(lang.float.soft.arith.mul)]
mul: ($T: type, a: T, b: T) -> T = _;
#[panic.never, lower.soft(lang.float.soft.arith.div)]
div: ($T: type, a: T, b: T) -> T = _;
#[panic.never, lower.by(lang.float.soft.rem)]
rem: ($T: type, a: T, b: T) -> T = _;
#[panic.never]
neg: ($T: type, a: T) -> T = _;
/// IEEE 754 comparisons: a NaN is equal to nothing, itself included, and in no order.
#[panic.never, lower.soft(lang.float.soft.compare.equal)]
equal: ($T: type, a: &T, b: &T) -> bool = _;
#[panic.never, lower.soft(lang.float.soft.compare.unequal)]
unequal: ($T: type, a: &T, b: &T) -> bool = _;
#[panic.never, lower.soft(lang.float.soft.compare.less)]
less: ($T: type, a: &T, b: &T) -> bool = _;
#[panic.never, lower.soft(lang.float.soft.compare.less_equal)]
less_equal: ($T: type, a: &T, b: &T) -> bool = _;
#[panic.never, lower.soft(lang.float.soft.compare.greater)]
greater: ($T: type, a: &T, b: &T) -> bool = _;
#[panic.never, lower.soft(lang.float.soft.compare.greater_equal)]
greater_equal: ($T: type, a: &T, b: &T) -> bool = _;
/// IEEE 754 `totalOrder`: every float in one order, `-NaN < -inf < ... < -0 < +0 < ... < NaN`.
#[panic.never]
total_order: ($T: type, a: &T, b: &T) -> Ordering = _;

/// The unsigned integer type as wide as the float type `T`, which holds its IEEE 754 encoding.
Bits: ($T: type) -> type = _;
/// The IEEE 754 encoding of `x`.
#[panic.never]
bits: ($T: type, x: T) -> Bits(T) = _;
/// The float whose IEEE 754 encoding is `b`.
#[panic.never]
from_bits: ($T: type, b: Bits(T)) -> T = _;
/// How many bits of the float type `T`'s encoding hold the fraction of its significand.
fraction_bits: ($T: type) -> usize = _;

/// The float of type `T` nearest the integer `x`, ties to even.
#[panic.never, lower.soft(lang.float.soft.convert.from_int)]
from_int: ($r: Range, x: Int(r), $T: type) -> T = _;
/// `x` rounded toward zero to an integer and clamped to the bounds of the integer type `U`; a
/// NaN gives 0, clamped likewise.
#[panic.never, lower.soft(lang.float.soft.convert.to_int)]
to_int: ($T: type, x: T, $U: type) -> U = _;
/// The float of type `U` nearest `x`, of type `T`, ties to even; a NaN gives the canonical NaN.
#[panic.never, lower.soft(lang.float.soft.convert.convert)]
convert: ($T: type, x: T, $U: type) -> U = _;
