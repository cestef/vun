//! Primitives of Vun.
//!
//! Every declaration whose value is `_` is provided by the compiler. Syntax desugars only into
//! items of this package (spec appendix B), so reading it tells you what the syntax means.

type: type = _;

/// The integer type whose values are exactly those of the range `r` (spec 04).
Int: ($r: Range) -> type = _;
Range: type = _;
/// The type of `a..b`, `a..=b` and `a..` at run time: bounds whose items are all values of `T`,
/// so `0..n` with `n: u8` is `Bounds(Int(0..=254))`. Where a `Range` is expected, bounds are
/// that range.
Bounds: ($T: type) -> type = _;

/// The type of functions from a tuple of `params` to `result`: `(A, B) -> R` is
/// `Fn((A, B), R)` (appendix B).
Fn: ($params: type, $result: type) -> type = _;
/// The type of a function's last parameter when it gathers the arguments after the others into
/// a tuple of the types `items`: `(A, ..P) -> R` is `Fn((A, Pack(P)), R)` (spec 01, section 4).
Pack: ($items: type) -> type = _;

/// The IEEE 754 binary floats of `bits` bits: 16, 32 or 64 (spec 04, section 2).
Float: ($bits: Int(1..)) -> type = _;
f16 := Float(16);
f32 := Float(32);
f64 := Float(64);

bool := enum { false, true };
/// The two conditions by name, so that `true` reads as `.true` does where a `bool` is expected.
true := bool.true;
false := bool.false;
never := enum {};
/// How two values compare (`lang.ops.Ord.cmp`).
Ordering := enum { less, equal, greater };

/// Conditions are equal when both hold or neither does.
#[impl(lang.ops.Eq(bool))]
bool_eq := struct {
    eq := (a: &bool, b: &bool) -> bool {
        match a.* {
            .true => b.*,
            .false => match b.* { .true => .false, .false => .true },
        }
    };
};

Option := ($T: type) -> type { enum { none, some(T) } };
Result := ($T: type, $E: type) -> type { enum { ok(T), err(E) } };
Step := ($Y: type, $R: type) -> type { enum { yielded(Y), done(R) } };
/// What `lang.ops.Try.branch` gives: go on with a value, or stop with what the function returns.
Branch := ($V: type, $S: type) -> type { enum { go(V), stop(S) } };

Interface: type = _;
/// Wraps a function from a type to its requirement struct, so it can constrain `$` parameters.
interface: ($requirements: ($Self: type) -> type) -> Interface = _;

/// The suspension protocol (spec 06).
Coroutine := ($Y: type, $R: type) -> Interface {
    interface(($Self: type) -> type { struct {
        resume: (self: &mut Self) -> Step(Y, R) = _;
        end: (self: &take Self) = _;
    } })
};

/// Where an attribute is written (spec 02, section 5).
Place := enum {
    /// A declaration, whatever its value, a local one included.
    decls,
    /// A function: a function literal or function type, or a declaration of one.
    functions,
    /// A type: a `struct` or `enum` literal, or a declaration of one.
    types,
    /// A field of a `struct` literal.
    fields,
    /// A parameter of a function literal.
    params,
};

/// The type of an attribute written only at the places `on`; the compiler reports one written
/// elsewhere. An attribute of any other type is plain data, written anywhere.
Attribute := ($on: &[Place]) -> type { struct {} };
/// `#[impl(I(T))]`: checks and registers a witness of the interface `I` for `T` (spec 02,
/// section 3).
impl: ($witness: type) -> Attribute(&[Place.decls]) = _;
/// `#[derive(f)]` on an interface: a struct or an enum with no impl of it has the witness `f(T)`,
/// built by reflection, when every part of it has the interface too (spec 02, section 3).
derive: ($witness: ($T: type) -> type) -> Attribute(&[Place.decls]) = _;
/// `#[visible(scope)]`: widens where a name starting with `_` is visible from its namespace to
/// `scope` (spec 01, section 7).
visible: ($scope: scope.Scope) -> Attribute(&[Place.decls, Place.fields]) = _;
