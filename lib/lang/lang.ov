//! Primitives of Overt.
//!
//! Every declaration whose value is `_` is provided by the compiler. Syntax desugars only into
//! items of this package (spec appendix B), so reading it tells you what the syntax means.

type: type = _;

/// The integer type whose values are exactly those of the range `r` (spec 04).
Int: ($r: Range) -> type = _;
Range: type = _;
/// The type of `a..b`, `a..=b` and `a..` at run time: bounds whose items are all values of `T`,
/// so `0..n` with `n: u8` is `Bounds(Int(0..=254))`. Where a `Range` is expected, bounds are
/// that range.
Bounds: ($T: type) -> type = _;

/// The type of functions from a tuple of `params` to `result`: `(A, B) -> R` is
/// `Fn((A, B), R)` (appendix B).
Fn: ($params: type, $result: type) -> type = _;

f16: type = _;
f32: type = _;
f64: type = _;

bool := enum { false, true };
/// The two conditions by name, so that `true` reads as `.true` does where a `bool` is expected.
true := bool.true;
false := bool.false;
never := enum {};
/// How two values compare (`lang.ops.Ord`).
Ordering := enum { less, equal, greater };

Option := ($T: type) -> type { enum { none, some(T) } };
Result := ($T: type, $E: type) -> type { enum { ok(T), err(E) } };
Step := ($Y: type, $R: type) -> type { enum { yielded(Y), done(R) } };
/// What `lang.ops.Try.branch` gives: go on with a value, or stop with what the function returns.
Branch := ($V: type, $S: type) -> type { enum { go(V), stop(S) } };

Interface: type = _;
/// Wraps a function from a type to its requirement struct, so it can constrain `$` parameters.
interface: ($requirements: ($Self: type) -> type) -> Interface = _;

/// The suspension protocol (spec 06).
Coroutine := ($Y: type, $R: type) -> Interface {
    interface(($Self: type) -> type { struct {
        resume: (self: &mut Self) -> Step(Y, R) = _;
        end: (self: &take Self) = _;
    }})
};

/// The type of the attributes the compiler acts on (spec 02, section 5).
Attribute: type = _;
/// `#[impl(I(T))]`: checks and registers a witness of the interface `I` for `T` (spec 02,
/// section 3).
impl: ($witness: type) -> Attribute = _;
/// `#[visible(scope)]`: widens where a name starting with `_` is visible from its namespace to
/// `scope` (spec 01, section 7).
visible: ($scope: scope.Scope) -> Attribute = _;
