//! How a property's case passes an argument of a type that borrows what it reaches (spec 11,
//! section 2): it holds a value generated as any other, and lends it.

/// How many items a slice lent to a parameter holds at most.
longest: usize = 32;

/// How a case passes an argument of a type that borrows what it reaches, such as `&[u8]`: it
/// holds a generated `Holder`, and lends it.
Lent := interface(($Self: type) -> type { struct {
    Holder: type = _;
    lend: (held: &Holder) -> Self = _;
} });

/// How a case stores what a borrow of `Self` reaches, where `Self` has no value of its own, such
/// as `[T]`: a generated `Holder`, which it views as `&Self`.
Store := interface(($Self: type) -> type { struct {
    Holder: type = _;
    view: (held: &Holder) -> &Self = _;
} });

/// What a case stores for a borrow of `T` to reach: its `Store`'s holder, or a `T`.
Stored := ($T: type) -> type {
    $if lang.meta.implements(Store, T) { lang.meta.witness(Store, T).Holder } else { T }
};

/// A borrow of what `held` stores, as a `&T`.
stored := ($T: type, held: &Stored(T)) -> &T {
    $if lang.meta.implements(Store, T) { lang.meta.witness(Store, T).view(held) } else { held }
};

/// A shared borrow is lent what the case stores for its target.
impl Lent for lang.mem.Ref($T) {
    Holder := Stored(T);
    lend := (held) -> &T { stored(T, held) };
}

/// The first `len` of `items`: what a case stores for a slice, generated as any struct is.
Prefix := ($T: type) -> type { struct { items: [longest]T, len: Int(0..=longest) } };

/// A slice is stored as a prefix.
impl Store for lang.mem.Slice($T) {
    Holder := Prefix(T);
    view := (held) -> &[T] { &held.items[0..held.len] };
}

/// What a case holds for a parameter of type `T`: what it lends, or the argument itself.
Held := ($T: type) -> type {
    $if lang.meta.implements(Lent, T) { lang.meta.witness(Lent, T).Holder } else { T }
};

/// The argument a case passes for a parameter of type `T` from what it holds for it.
passed := ($T: type, held: &Held(T)) -> T {
    $if lang.meta.implements(Lent, T) { lang.meta.witness(Lent, T).lend(held) } else { held.* }
};
