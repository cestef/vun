//! Property tests (spec 11, section 2): a test's arguments are generated from its parameters'
//! types, each read from a stream of choices, so the case that fails is replayed and shrunk as
//! its choices, whatever generated it. A parameter whose type borrows, such as `&[u8]`, is lent
//! what the case holds for it (`lend`).

/// How many choices a case takes at most; past them, each is 0.
room: usize = 256;

/// The greatest choice.
widest: u64 = 0xFFFF_FFFF_FFFF_FFFF;

/// How many cases a property test runs, each with arguments generated anew, unless the run asks
/// for another count.
cases: usize = 100;

/// How many cases shrinking a failing one runs at most.
tries: usize = 1000;

/// A stream of choices, each a `u64` at most a bound: those recorded to replay first, then drawn
/// from a seeded generator, or 0 where it replays only; each recorded as taken.
Choices := struct {
    /// The state of the generator (splitmix64).
    state: u64,
    /// Whether the choices past those replayed are drawn from the generator rather than 0.
    random: bool,
    replay: [room]u64,
    replayed: usize,
    taken: [room]u64,
    len: usize,

    /// A stream drawing from `seed`.
    seeded := (seed: u64) -> Choices {
        .{ .state = seed, .random = true, .replay = [0; room], .replayed = 0, .taken = [0; room], .len = 0 }
    };

    /// A stream replaying the first `len` of `choices`, then 0.
    replaying := (choices: &[room]u64, len: usize) -> Choices {
        .{ .state = 0, .random = false, .replay = choices.*, .replayed = len, .taken = [0; room], .len = 0 }
    };

    /// The next choice, at most `bound`.
    draw := (self: &mut Choices, bound: u64) -> u64 {
        if self.len == room { return 0; }
        raw := if self.len < self.replayed {
            self.replay[self.len]
        } else if self.random {
            next(&mut self.state)
        } else {
            0
        };
        choice := raw % (bound + 1);
        self.taken[self.len] = choice;
        self.len += 1;
        choice
    };
};

/// The next value of the generator whose state is `state`: splitmix64.
next := (state: &mut u64) -> u64 {
    state.* +%= 0x9E37_79B9_7F4A_7C15;
    mut z := state.*;
    z = z ^ (z >> 30);
    z *%= 0xBF58_476D_1CE4_E5B9;
    z = z ^ (z >> 27);
    z *%= 0x94D0_49BB_1331_11EB;
    z ^ (z >> 31)
};

/// How a type's values are generated its own way, rather than by reflection (spec 11,
/// section 2).
Arbitrary := interface(($Self: type) -> type { struct {
    arbitrary: (c: &mut Choices) -> Self = _;
} });

/// A value of `T` read from `c`: by `T`'s `Arbitrary` where it has one, and otherwise, for a
/// struct or an enum, a variant, then each of its parts.
gen := ($T: type, c: &mut Choices) -> T {
    $if lang.meta.implements(Arbitrary, T) {
        lang.meta.witness(Arbitrary, T).arbitrary(c)
    } else if lang.meta.variants(T).len() == 0 {
        $std.diag.error(.{
            .msg = "no values of this type are generated: implement `std.testing.Arbitrary` for it"
        });
        unsafe lang.hint.unreachable()
    } else {
        derived(T, c)
    }
};

/// A value of the struct or enum type `T` read from `c`: a variant, the first for the least
/// choice, so that shrinking moves towards it, then each of its parts.
derived := ($T: type, c: &mut Choices) -> T {
    $last := lang.meta.variants(T).len() - 1;
    at := c.draw(last.to(u64));
    $for v in lang.meta.variants(T) {
        $if v.index == last {
            return lang.meta.make(T, v.index, ($for p in v.parts { gen(p.type, c) },));
        } else {
            if at == v.index { return lang.meta.make(T, v.index, ($for p in v.parts { gen(p.type, c) },)); }
        }
    }
    unsafe lang.hint.unreachable()
};

/// A float of `lang.Float(bits)`: its encoding chosen whole, so the least choice is `0.0` and a
/// smaller positive choice a smaller positive float.
impl Arbitrary for lang.Float($bits) {
    arbitrary := (c) -> lang.Float(bits) {
        encoding := c.draw(((1 << bits) - 1).sat(u64));
        lang.float.from_bits(lang.Float(bits), encoding.wrap(lang.float.Bits(lang.Float(bits))))
    };
}

/// An array of `n` items, each generated in turn.
impl Arbitrary for lang.mem.Array($n, $T) {
    arbitrary := (c) -> [n]T {
        $if n == 0 {
            []
        } else {
            mut items := [gen(T, c); n];
            for i in 1..n { items[i] = gen(T, c); }
            items
        }
    };
}

/// A generator a parameter names with `#[test.gen(g)]`, making what a case holds for it.
Generated := ($T: type) -> type { struct { with: (c: &mut Choices) -> T } };

/// An integer of `Int(r)`: its distance from the integer of the range nearest 0, then, where both
/// sides hold that distance, which side, above first. A smaller choice is an integer of smaller
/// magnitude, and shrinking the distance keeps the side. A range of more than 2^64 integers has
/// only the 2^64 on each side nearest 0 chosen.
impl Arbitrary for Int($r) {
    arbitrary := (c) -> Int(r) {
        // Of a type holding it alone, so that adding an offset from it spans `r` exactly.
        $at := 0.sat(Int(r));
        $nearest := at.to(Int(at..=at));
        $below := (at - lang.int.least(r)).sat(u64);
        $above := (lang.int.greatest(r) - at).sat(u64);
        $farthest := if below < above { above } else { below };
        $Offset := Int(lang.int.least(r) - at..=lang.int.greatest(r) - at);
        distance := c.draw(farthest);
        up := distance <= above and (distance == 0 or distance > below or c.draw(1) == 0);
        offset: Offset = if up { distance.to(Offset) } else { (-distance).to(Offset) };
        nearest + offset
    };
}

/// The tuple of what a case of `f` holds for each of its parameters.
Args := ($F: type, $f: F) -> type { (
    $for p in lang.meta.params(F, f) { std.testing.property.lend.Held(p.type) },
) };

/// What a case of `f` holds for each of its parameters, read from `c`.
arguments := ($F: type, $f: F, c: &mut Choices) -> Args(F, f) {
    ($for p in lang.meta.params(F, f) { argument(p, c) },)
};

/// What a case holds for the parameter `p`, read from `c`: by the generator it names, or by its
/// type.
argument := ($p: lang.meta.Field, c: &mut Choices) -> std.testing.property.lend.Held(p.type) {
    $if .some(g) = std.meta.attr(lang.meta.Field, p, Generated(std.testing.property.lend.Held(p.type))) {
        with := g.with;
        with(c)
    } else {
        gen(std.testing.property.lend.Held(p.type), c)
    }
};

/// Runs `f` with arguments read from `c`, or a simulation with its schedule drawn from `c`, on a
/// thread of its own, reporting a trap unless `quiet`: the trap that ended it, if one did. Where
/// the system runs one thread, on the calling one, and a trap ends the run.
attempt := ($F: type, $f: F, sys: &mut std.os.System, c: &mut Choices, quiet: bool) -> ?lang.panic.Trap {
    $if std.testing.takes(F, f, &mut std.testing.Sim) {
        std.testing.sim.attempt(F, f, sys, c, quiet)
    } else {
        generated(F, f, sys, c, quiet)
    }
};

/// Runs `f` with arguments read from `c`, as `attempt` does.
generated := ($F: type, $f: F, sys: &mut std.os.System, c: &mut Choices, quiet: bool) -> ?lang.panic.Trap {
    held := arguments(F, f, c);
    mut case := [held, quiet] () {
        std.os.thread.reporting.set(!quiet);
        _ = f.call((
            $for p in lang.meta.params(F, f) { std.testing.property.lend.passed(p.type, &held.$(p.index)) },
        ));
    };
    match sys.spawn(&mut case) {
        .ok(t) => match t.join() {
            .ok(_) => .none,
            .err(trap) => .some(trap),
        },
        .err(_) => {
            case();
            .none
        },
    }
};

/// A failing case: the choices it took, the trap that ended it, and how many smaller cases
/// shrinking found before it.
Failing := struct {
    taken: [room]u64,
    len: usize,
    trap: lang.panic.Trap,
    shrinks: usize,

    /// Whether it took fewer choices than `other`, or as many and a smaller one at the first
    /// place they differ: what shrinking a case makes of it.
    smaller := (self: &Failing, other: &Failing) -> bool {
        if self.len != other.len { return self.len < other.len; }
        for i in 0..self.len {
            if self.taken[i] != other.taken[i] { return self.taken[i] < other.taken[i]; }
        }
        false
    };
};

/// The property test `f` run over `count` cases drawn from `seed`, each on a thread of its own:
/// `.none` when none trapped, else the first that did, shrunk, with the case it was. Only the
/// smallest case reports its trap, run once more.
check := ($F: type, $f: F, sys: &mut std.os.System, seed: u64, count: usize) -> ?(Failing, usize) {
    mut master := seed;
    for case in 0..count {
        mut c := Choices.seeded(next(&mut master));
        if .some(trap) = attempt(F, f, sys, &mut c, true) {
            failing: Failing = .{ .taken = c.taken, .len = c.len, .trap = trap, .shrinks = 0 };
            smallest := std.testing.property.shrink.smallest(F, f, sys, failing);
            mut replayed := Choices.replaying(&smallest.taken, smallest.len);
            _ = attempt(F, f, sys, &mut replayed, false);
            return .some((smallest, case));
        }
    }
    .none
};

/// Writes the arguments `failing` replays for `f`, each on a line of its own
/// (`std.testing.Argued`); a simulation has none.
write := ($F: type, $f: F, w: &mut std.os.Stream, failing: &Failing) -> Result((), std.os.Error) {
    $if std.testing.takes(F, f, &mut std.testing.Sim) { .ok(()) } else { arguments_written(F, f, w, failing) }
};

/// Writes the arguments `failing` replays for the property `f`, as `write` does.
arguments_written := ($F: type, $f: F, w: &mut std.os.Stream, failing: &Failing) -> Result((), std.os.Error) {
    mut c := Choices.replaying(&failing.taken, failing.len);
    held := arguments(F, f, &mut c);
    $for p in lang.meta.params(F, f) {
        value := std.testing.property.lend.passed(p.type, &held.$(p.index));
        std.fmt.json.write(w, &std.testing.Argued(p.type).argument(.{ .name = p.name, .value = value }))?;
        w.write_all("\n")?;
    }
    .ok(())
};
