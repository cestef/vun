//! The coverage a run of the tests writes (spec 11, section 6).

/// The counts of `lang.cover.map` the tests make: how many times a block of that number started.
Covered := struct {
    counts: [lang.cover.size]u32,

    /// The counts as they are now.
    read := () -> Covered { .{ .counts = unsafe lang.cover.map } };
};
