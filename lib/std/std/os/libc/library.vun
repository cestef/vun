//! Loading libraries through the C library (`dlopen`, `dlsym`, `dlclose`): the exports a
//! runtime on top of it holds, `library := std.os.libc.library.exports`. The loader reports a
//! failure as text rather than an error number, so each is `unresolved`.

#[link.symbol("dlopen"), abi.c]
dlopen: unsafe (path: *u8, flags: i32) -> usize = _;
#[link.symbol("dlsym"), abi.c]
dlsym: unsafe (library: usize, name: *u8) -> usize = _;
#[link.symbol("dlclose"), abi.c]
dlclose: unsafe (library: usize) -> i32 = _;

/// What a call giving `handle` gives: it, or `unresolved` where it gave none.
found := (handle: usize) -> Result(usize, std.os.Error) {
    if handle == 0 { .err(.unresolved) } else { .ok(handle) }
};

/// The exports, which a runtime holds.
exports := struct {
    #[link.export(std.os.library.symbols.load)]
    load_library := (path: &[u8]) -> Result(usize, std.os.Error) {
        ended := std.os.file.Path.of(path)?;
        found(unsafe dlopen(ended.start(), std.os.libc.system.load))
    };

    #[link.export(std.os.library.symbols.symbol)]
    find := (library: usize, name: &[u8]) -> Result(usize, std.os.Error) {
        ended := std.os.file.Path.of(name)?;
        found(unsafe dlsym(library, ended.start()))
    };

    #[link.export(std.os.library.symbols.unload)]
    unload_library := (library: usize) -> Result((), std.os.Error) {
        if unsafe dlclose(library) == 0 { .ok(()) } else { .err(.unresolved) }
    };
};
