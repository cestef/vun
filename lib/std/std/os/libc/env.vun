//! `std.os.env` for the runtime over a C library: `getenv`, whose argument ends with a zero byte.

#[link.symbol("getenv"), abi.c]
getenv: unsafe (name: *u8) -> *u8 = _;

#[link.symbol("strlen"), abi.c]
strlen: unsafe (s: *u8) -> usize = _;

/// The longest name asked for, which a zero byte follows in the copy `getenv` is given.
name_max: usize = 255;

/// The exports, which the runtime holds: `env := std.os.libc.env.exports`.
exports := struct {
    /// What `getenv` finds, of a name not longer than `name_max`.
    #[link.export(std.os.env.symbols.get)]
    get := (name: &[u8]) -> ?&[u8] {
        if name.len() > name_max { return .none; }
        mut ended: [name_max + 1]u8 = [0; name_max + 1];
        for i in 0..name.len() { ended[i] = name[i]; }
        found := unsafe { getenv(lang.mem.items_pointer(u8, &ended[0..name.len() + 1])) };
        if found.address() == 0 { return .none; }
        .some(unsafe lang.mem.items_at(u8, found, strlen(found)))
    };
};
