//! Threads the system runs beside the one starting them (spec 08, section 2). A thread runs a
//! closure borrowed for as long as it runs: `Thread` is linear and holds the borrow, so the
//! closure, and what it borrows, stay until the thread is joined, and joining gives what the
//! closure returned. Values safe to share are safe to share across threads (spec 07, section 2),
//! so a closure may borrow what the thread starting it goes on reading.
//!
//! A runtime starts a thread through `std.os.spawn`, with a function of this namespace and a copy
//! of the thread's context it keeps until `std.os.join` copies it back.
//!
//! A trap ends the thread it happens in (spec 07, section 3): the runtime's handler keeps the trap
//! where `join` reads how the thread ended, and ends that thread alone. A trap in the thread the
//! program started in ends the program.

/// What a runtime starts a thread at: a function given the address of the thread's context.
Start := #[abi.c] (context: usize) -> ();

/// The alignment of what a runtime places for a thread, a stack's on every architecture `std`
/// builds for.
align: usize = 16;

/// Where a runtime places a thread's pieces in memory it mapped for the thread, ending at `end`:
/// its own record of `Record` at the top, how the thread ended below it, then the copy of a
/// context of `bytes`.
Placed := struct {
    record: usize,
    ended: usize,
    context: usize,

    of := ($Record: type, end: usize, bytes: usize) -> Placed {
        record := down((end - lang.meta.size(Record)).wrap(usize));
        ended := down((record - lang.meta.size(Ended)).wrap(usize));
        .{ .record = record, .ended = ended, .context = down((ended - bytes).wrap(usize)) }
    };

    /// Writes how the thread ended before it begins: returned, until a trap says otherwise.
    begin := unsafe (self: &Placed) { unsafe lang.mem.pointer_at(Ended, self.ended).write(.returned); };
};

/// How a thread ended, which its runtime keeps at `Placed.ended` and `std.os.join` gives back.
Ended := enum {
    returned,
    trapped(lang.panic.Trap),
};

/// Where the calling thread's runtime keeps how it ended, which the runtime sets when the thread
/// begins; 0 in the thread the program started in.
ending: std.sync.Local(usize) = .init(0);

/// Keeps the trap `t` as how the calling thread ended, and tells whether a runtime spawned the
/// thread: a trap in the thread the program started in ends the program instead.
trapped := (t: &lang.panic.Trap) -> bool {
    at := ending.get();
    if at == 0 { return false; }
    unsafe lang.mem.pointer_at(Ended, at).write(.trapped(t.*));
    true
};

/// `at` rounded down to `align`.
down := (at: usize) -> usize { (at - at % align).wrap(usize) };

/// A thread running a closure of type `F` that returns `R`: linear, joined once.
Thread := ($R: type, $F: lang.ops.Call((), R)) -> type { #[kind.linear] struct {
    _f: &mut F,
    _handle: usize,

    /// What the thread starts with: its closure, where what it returns goes, and the calls that
    /// spawned it, which its backtrace names.
    Context := struct {
        f: *F,
        result: ?R,
        spawn: std.trace.Spawn,

        /// Its bytes, which a runtime copies.
        bytes := (self: &Context) -> *u8 { unsafe std.ptr.to(Context, self).cast(u8) };
    };

    /// Starts a thread running `f`.
    spawn := (f: &mut F) -> Result(Thread(R, F), std.os.Error) {
        origin := std.trace.spawning(std.trace.code((f: &mut F) -> Result(Thread(R, F), std.os.Error), Thread(R, F).spawn));
        context := Context{ .f = std.ptr.to(F, f), .result = .none, .spawn = origin };
        handle := unsafe std.os.spawn(run, context.bytes(), lang.meta.size(Context))?;
        .ok(.{ ._f = f, ._handle = handle })
    };

    /// Waits for the thread to end, and gives what its closure returned, or the trap that ended
    /// it.
    join := (self: Thread(R, F)) -> Result(R, lang.panic.Trap) {
        .{ ._f = f, ._handle = handle } := self;
        mut context := Context{ .f = std.ptr.to(F, f), .result = .none, .spawn = .{} };
        match unsafe std.os.join(handle, context.bytes(), lang.meta.size(Context)) {
            .trapped(t) => .err(t),
            .returned => match context.result {
                .some(result) => .ok(result),
                .none => lang.panic.fail(.message("a thread returned without its result")),
            },
        }
    };

    /// Where the thread starts: calls the closure and puts what it returns in the context, the
    /// calls that spawned the thread kept here meanwhile.
    #[abi.c]
    run := (at: usize) {
        context := unsafe lang.mem.pointer_at(Context, at);
        held := unsafe context.read();
        (at_f, from) := (held.f, held.spawn);
        std.trace.spawned(&from);
        result := unsafe { at_f.*() };
        unsafe context.write(Context{ .f = at_f, .result = .some(result), .spawn = from });
    };
} };
