//! The linear memory of a WASI program, which grows by whole pages and is never given back.

/// The bytes of a page of linear memory, which grows by whole pages.
page: usize = 65536;
/// The bits of a byte's offset in a page.
page_bits := 16;

/// `bytes` of linear memory more, in whole pages, the engine backing them where they are touched;
/// 0 where the memory cannot grow.
#[panic.never]
map := (bytes: usize) -> usize {
    pages: u32 = ((bytes + page - 1).wrap(usize) >> page_bits).wrap(u32);
    old := lang.mem.grow_memory(pages);
    if old == 0xffff_ffff { 0 } else { (old * 65536).wrap(usize) }
};

/// Memory grown is never given back.
#[panic.never]
unmap := (address: usize, bytes: usize) {};

/// The state of the checks of unsafe code, in memory grown the first time a check needs it.
state := () -> std.check.State { std.check.mapped(map, unmap) };
