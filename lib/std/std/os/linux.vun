//! Linux.

/// Linux runs static programs through a runtime calling the kernel itself, with no C library.
runtime: std.os.Runtime = .{ .os = .linux, .abi = .kernel, .start = std.os.linux.kernel.start };

/// Linux with the GNU C library runs programs through the C library's runtime.
gnu: std.os.Runtime = .{ .os = .linux, .abi = .gnu, .start = std.os.libc.start };

/// The numbers Linux gives its clocks (`CLOCK_MONOTONIC`, `CLOCK_REALTIME`).
clocks: std.os.Clocks = .{ .monotonic = 1, .real = 0 };

/// The GNU C library's layout on Linux: 1024-bit signal sets, of which Linux uses the first 64;
/// memory reserved is `MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE`.
c: std.os.libc.System = .{
    .os = .linux,
    .errno = "__errno_location",
    .Word = u64,
    .words = 16,
    .block = 0,
    .set_mask = 2,
    .reserve = 0x4022,
    .clocks = clocks,
};
