//! A runtime on top of the C library: exports C `main`, the trap handler, the critical section
//! and the executors' sleep, and reaches the system through the C library's functions (spec 08,
//! section 2).

#[link.symbol("write"), abi.c]
write: unsafe (fd: i32, bytes: *u8, count: usize) -> isize = _;
#[link.symbol("read"), abi.c]
read: unsafe (fd: i32, bytes: *u8, count: usize) -> isize = _;
/// C's `open` is variadic, its permissions read only with `O_CREAT`: passed always.
#[link.symbol("open"), abi.c]
open: unsafe (path: *u8, flags: u32, ..permissions: .{ u32 }) -> i32 = _;
#[link.symbol("close"), abi.c]
close: unsafe (fd: i32) -> i32 = _;
#[link.symbol("exit"), abi.c]
exit: unsafe (status: i32) -> lang.never = _;
#[link.symbol("mmap"), abi.c]
mmap: unsafe (address: usize, bytes: usize, protection: i32, flags: i32, fd: i32, offset: isize) -> usize = _;
#[link.symbol("munmap"), abi.c]
munmap: unsafe (address: usize, bytes: usize) -> i32 = _;
#[link.symbol("clock_gettime"), abi.c]
clock_gettime: unsafe (clock: i32, at: *std.os.Timespec) -> i32 = _;
#[link.symbol("nanosleep"), abi.c]
nanosleep: unsafe (span: *std.os.Timespec, left: *std.os.Timespec) -> i32 = _;
/// What the C library of a system lays out its own way: each system declares its row
/// (`std.os.linux.c`), and a program uses the row of the system it is built for.
System := struct {
    os: lang.meta.Name,
    /// The function giving where the calling thread's `errno` is.
    errno: &[u8],
    /// A signal set: `words` words of type `Word`, the first holding the signals 1 up.
    Word: type,
    words: usize,
    /// `how` for `pthread_sigmask`: add the set to the mask, or make it the mask.
    block: i32,
    set_mask: i32,
    /// `flags` for `mmap` of private memory reserved, not backed until touched.
    reserve: i32,
    clocks: std.os.Clocks,
    /// The error the system reports as a number.
    error: (i32) -> std.os.Error,
    flags: std.os.file.Flags,
};

/// The systems whose C library the runtime knows.
systems := [std.os.linux.c, std.os.macos.c];

/// The row of the system `os`.
of := ($os: lang.meta.Name) -> System {
    $for row in systems {
        if row.os == os { return row; }
    }
    lang.panic.fail(.message("the runtime knows no C library for this system"))
};

/// The row of the system being built for.
system := of(lang.target.current.os);

/// Where the calling thread's `errno` is.
#[link.symbol(system.errno), abi.c]
errno_location: unsafe () -> *i32 = _;

/// A signal set as the C library lays it out, and the one holding no signal.
Sigset := [system.words]system.Word;
no_signals: Sigset = [0; system.words];
#[link.symbol("sigfillset"), abi.c, panic.never]
sigfillset: unsafe (set: *Sigset) -> i32 = _;
#[link.symbol("pthread_sigmask"), abi.c, panic.never]
pthread_sigmask: unsafe (how: i32, set: *Sigset, old: *Sigset) -> i32 = _;
#[link.symbol("pthread_self"), abi.c, panic.never]
pthread_self: unsafe () -> usize = _;
#[link.symbol("sched_yield"), abi.c]
sched_yield: unsafe () -> i32 = _;
/// C's `start` returns a pointer, which nothing here reads: a function returning nothing is
/// called alike.
#[link.symbol("pthread_create"), abi.c]
pthread_create: unsafe (thread: *usize, attributes: usize, start: std.os.thread.Start, context: usize) -> i32 = _;
#[link.symbol("pthread_join"), abi.c]
pthread_join: unsafe (thread: usize, result: usize) -> i32 = _;
#[link.symbol("pthread_exit"), abi.c]
pthread_exit: unsafe (result: usize) -> lang.never = _;

/// What the runtime keeps of a thread, at the top of the memory mapped for its context.
#[layout.c]
Thread := struct {
    /// The C library's handle, which `pthread_create` writes, perhaps once the thread began.
    handle: usize,
    begun: Begun,
    mapped: usize,
    bytes: usize,
};

/// What a thread reads of its record when it begins, past the handle.
#[layout.c]
Begun := struct {
    start: std.os.thread.Start,
    context: usize,
    /// Where how the thread ended is kept (`std.os.thread.Placed.ended`).
    ended: usize,
};

/// Where a thread starts, given the address of its record's `Begun`: sets where it keeps how it
/// ends, then runs it.
#[abi.c]
begin := (at: usize) {
    held := unsafe lang.mem.pointer_at(Begun, at).read();
    std.os.thread.ending.set(held.ended);
    held.start(held.context);
};

/// `protection` for `mmap` of memory read and written.
read_write: i32 = 3;
/// Private memory of `bytes` reserved, backed only where touched.
reserve := (bytes: usize) -> usize { unsafe mmap(0, bytes, read_write, system.reserve, -1, 0) };

/// Gives back the `bytes` mapped at `address`.
unmap := (address: usize, bytes: usize) { unsafe { munmap(address, bytes); } };

/// The state of the checks of unsafe code, mapped the first time a check needs it.
state := () -> std.check.State { std.check.mapped(reserve, unmap) };

/// What a call returning `result` gives: the count or number it returned, or, where it returned
/// -1, the error it set `errno` to.
outcome := (result: isize) -> Result(usize, std.os.Error) {
    if result < 0 {
        .err(system.error(unsafe errno_location().read()))
    } else {
        .ok(result.to(usize))
    }
};

/// Ends the process with `status`.
end := (status: std.os.Status) -> lang.never { unsafe exit(status.to(i32)) };

/// The thread holding the critical section, 0 when none: a thread entering it again nests.
owner: std.sync.Atomic(usize) = .init(0);

/// The exports of a program whose `main` the C library calls.
start := ($main: std.os.Main) -> type { struct {
    #[link.export("main"), abi.c]
    entry := (argc: i32, argv: *(*u8)) -> i32 {
        mut sys := unsafe std.os.System.claim(std.os.Args.of(argc.to(usize), argv));
        main(&mut sys).status()
    };

    #[link.export(lang.panic.symbols.trap)]
    trap := (t: &lang.panic.Trap) -> lang.never {
        if std.os.thread.reporting.get() { std.trace.trapped(t, trap); }
        if std.os.thread.trapped(t) { unsafe pthread_exit(0) } else { end(std.os.trapped) }
    };

    /// The operations of the checks of unsafe code, for a program built with checks.
    checks := if lang.check.current.len() > 0 { std.check.exports(state, end) } else { struct {} };

    #[link.export(std.os.symbols.write)]
    write_to := (fd: i32, bytes: &[u8]) -> Result(usize, std.os.Error) {
        outcome(unsafe write(fd, lang.mem.items_pointer(u8, bytes), bytes.len()))
    };

    #[link.export(std.os.symbols.read)]
    read_from := (fd: i32, bytes: &mut [u8]) -> Result(usize, std.os.Error) {
        outcome(unsafe read(fd, lang.mem.items_pointer(u8, bytes), bytes.len()))
    };

    #[link.export(std.os.symbols.open)]
    open_file := (path: &[u8], mode: std.os.file.Mode) -> Result(i32, std.os.Error) {
        ended := std.os.file.Path.of(path)?;
        .ok(outcome(unsafe open(ended.start(), system.flags.of(mode), std.os.file.created).to(isize))?.to(i32))
    };

    #[link.export(std.os.symbols.close)]
    close_file := (fd: i32) -> Result((), std.os.Error) {
        outcome(unsafe close(fd).to(isize))?;
        .ok(())
    };

    #[link.export(std.os.symbols.now)]
    now := (clock: std.time.Clock) -> Result(std.time.Instant, std.os.Error) {
        mut at := std.os.Timespec{ .seconds = 0, .nanos = 0 };
        outcome(unsafe clock_gettime(system.clocks.id(clock), lang.mem.pointer_to(std.os.Timespec, &at)).to(isize))?;
        .ok(at.instant())
    };

    /// Sleeps, going on with what is left when a signal interrupts it.
    #[link.export(std.os.symbols.pause)]
    pause := (span: std.time.Duration) -> Result((), std.os.Error) {
        mut left := std.os.Timespec.of(span);
        for {
            request := left;
            asked := lang.mem.pointer_to(std.os.Timespec, &request);
            match outcome(unsafe nanosleep(asked, lang.mem.pointer_to(std.os.Timespec, &left)).to(isize)) {
                .ok(_) => return .ok(()),
                .err(.interrupted) => {},
                .err(e) => return .err(e),
            }
        }
    };

    /// Blocks the thread's signals, the interrupts of a hosted program, and takes the section
    /// from other threads.
    #[link.export(std.sync.symbols.enter), panic.never]
    enter := () -> std.sync.Mask {
        mut all := no_signals;
        mut old := no_signals;
        unsafe {
            sigfillset(lang.mem.pointer_to(Sigset, &all));
            pthread_sigmask(system.block, lang.mem.pointer_to(Sigset, &all), lang.mem.pointer_to(Sigset, &old));
        }
        me := unsafe pthread_self();
        outer := owner.load(.acquire) != me;
        if outer {
            for owner.compare_swap(0, me, .acquire) != 0 {}
        }
        unsafe std.sync.Mask.of(old[0], outer)
    };

    #[link.export(std.sync.symbols.leave), panic.never]
    leave := (mask: std.sync.Mask) {
        if mask.outer() {
            owner.store(0, .release);
        }
        mut set := no_signals;
        set[0] = mask.bits().wrap(system.Word);
        mut old := no_signals;
        unsafe {
            pthread_sigmask(system.set_mask, lang.mem.pointer_to(Sigset, &set), lang.mem.pointer_to(Sigset, &old));
        }
    };

    /// Gives the core to other threads: what fires an event runs on one of them, or in a
    /// signal handler, and nothing is missed between an executor's check and its sleep.
    #[link.export(std.task.symbols.sleep)]
    sleep := () { unsafe { sched_yield(); } };

    /// Starts a thread through the C library, its context copied into memory mapped for it.
    #[link.export(std.os.symbols.spawn)]
    spawn := unsafe (thread: std.os.thread.Start, context: *u8, bytes: usize) -> Result(usize, std.os.Error) {
        total := (lang.meta.size(Thread) + bytes + 2 * std.os.thread.align).wrap(usize);
        mapped := outcome(reserve(total).wrap(isize))?;
        placed := std.os.thread.Placed.of(Thread, (mapped + total).wrap(usize), bytes);
        unsafe {
            lang.mem.pointer_at(Thread, placed.record).write(Thread{
                .handle = 0,
                .begun = .{ .start = thread, .context = placed.context, .ended = placed.ended },
                .mapped = mapped,
                .bytes = total,
            });
            lang.mem.copy(u8, lang.mem.pointer_at(u8, placed.context), context, bytes);
            placed.begin();
        }
        begun := (placed.record + lang.meta.size(usize)).wrap(usize);
        failed := unsafe pthread_create(lang.mem.pointer_at(usize, placed.record), 0, begin, begun);
        if failed != 0 {
            unmap(mapped, total);
            return .err(system.error(failed));
        }
        .ok(placed.record)
    };

    #[link.export(std.os.symbols.join)]
    join := unsafe (thread: usize, context: *u8, bytes: usize) -> std.os.thread.Ended {
        held := unsafe lang.mem.pointer_at(Thread, thread).read();
        ended := unsafe {
            pthread_join(held.handle, 0);
            lang.mem.copy(u8, context, lang.mem.pointer_at(u8, held.begun.context), bytes);
            lang.mem.pointer_at(std.os.thread.Ended, held.begun.ended).read()
        };
        unmap(held.mapped, held.bytes);
        ended
    };
} };
