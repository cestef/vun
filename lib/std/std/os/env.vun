//! The environment of a hosted program (spec 08, section 2): the value of a variable by its
//! name, which a runtime that has an environment gives and one without does not.

/// The link symbols of this namespace's declarations, which a runtime exports.
symbols := struct {
    get := "vun_os_env";
};

/// The value of the variable `name`, valid for as long as the environment is not changed; none
/// when it is not set.
#[link.symbol(symbols.get)]
get: (name: &[u8]) -> ?&[u8] = _;

impl std.os.System {
    /// The value of the environment variable `name`, none when it is not set.
    env := (self: &std.os.System, name: &[u8]) -> ?&[u8] { get(name) };
}

/// The exports of a runtime with no environment: no variable is set.
unsupported := struct {
    #[link.export(symbols.get)]
    unset := (name: &[u8]) -> ?&[u8] { .none };
};
