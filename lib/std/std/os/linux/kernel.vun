//! A runtime calling the kernel itself, for static programs without a C library (spec 08,
//! section 2). `_start` finds the arguments where the kernel puts them, on the stack it starts
//! the process with, and every request is a system call. The C compiler may call the four
//! functions of C's `string.h` a freestanding program must provide, so the runtime exports them.

/// The numbers of the system calls, the architecture's being built for.
numbers := std.os.linux.kernel.calls.current;

/// A system call: its number and six arguments, which the architecture's instruction takes in
/// registers. A block loads them from here, binding the one register the address comes in and
/// the result goes out in, rather than eight. On Thumb the number goes in `r7`, the frame
/// pointer, which the block keeps on the stack meanwhile.
#[layout.c]
Call := struct { number: usize, args: [6]usize };

/// Makes the system call `number` with `args`, returning what the kernel returns: a negative
/// error number where the call failed.
#[panic.never]
request := (number: usize, args: [6]usize) -> isize {
    call := Call{ .number = number, .args = args };
    at := std.ptr.to(Call, &call).address();
    mut result: usize = 0;
    $if lang.target.current.arch == .x86_64 {
        unsafe lang.arch.asm({
            ..lang.arch.x86_64.names;
            mov(rdi, mem(in(at).at(rax), 8));
            mov(rsi, mem(rax, 16));
            mov(rdx, mem(rax, 24));
            mov(r10, mem(rax, 32));
            mov(r8, mem(rax, 40));
            mov(r9, mem(rax, 48));
            mov(rax, mem(rax));
            syscall();
            mov(out(result).at(rax), rax);
        });
    } else {
        $if lang.target.current.arch == .arm64 {
            unsafe lang.arch.asm({
                ..lang.arch.arm64.names;
                ldr(x8, mem(in(at).at(x0)));
                ldr(x1, mem(x0, 16));
                ldr(x2, mem(x0, 24));
                ldr(x3, mem(x0, 32));
                ldr(x4, mem(x0, 40));
                ldr(x5, mem(x0, 48));
                ldr(x0, mem(x0, 8));
                svc(0);
                mov(out(result).at(x0), x0);
            });
        } else {
            unsafe lang.arch.asm({
                ..lang.arch.thumb.names;
                push(r4, r5, r7);
                ldr(r7, mem(in(at).at(r0)));
                ldr(r1, mem(r0, 8));
                ldr(r2, mem(r0, 12));
                ldr(r3, mem(r0, 16));
                ldr(r4, mem(r0, 20));
                ldr(r5, mem(r0, 24));
                ldr(r0, mem(r0, 4));
                svc(0);
                pop(r4, r5, r7);
                mov(out(result).at(r0), r0);
            });
        }
    }
    result.wrap(isize)
};

/// `how` for `rt_sigprocmask`: add the set to the mask, or make it the mask.
block: usize = 0;
set_mask: usize = 2;
/// The kernel's signal set: 64 bits, a bit per signal from 1 up.
Sigset := u64;
sigset_bytes: usize = 8;
every_signal: Sigset = 0xffff_ffff_ffff_ffff;

/// `protection` for `mmap` of memory read and written, and `flags` for private memory reserved,
/// not backed until touched (`MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE`).
read_write: usize = 3;
reserve: usize = 0x4022;
/// The file descriptor `mmap` is given for memory backed by no file: -1.
no_file: usize = (-1).wrap(usize);

/// Maps private memory of `bytes` reserved, backed only where touched: what the kernel returns.
mapping := (bytes: usize) -> isize { request(numbers.mmap, [0, bytes, read_write, reserve, no_file, 0]) };

/// Private memory of `bytes` reserved, backed only where touched.
map := (bytes: usize) -> usize { mapping(bytes).wrap(usize) };

/// Gives back the `bytes` mapped at `address`.
unmap := (address: usize, bytes: usize) { request(numbers.munmap, [address, bytes, 0, 0, 0, 0]); };

/// The state of the checks of unsafe code, mapped the first time a check needs it.
state := () -> std.check.State { std.check.mapped(map, unmap) };

/// What a system call returning `result` gives: the count or number it returned, or the error
/// it reported as a negative number.
outcome := (result: isize) -> Result(usize, std.os.Error) {
    if result < 0 { .err(std.os.linux.error((-result).to(i32))) } else { .ok(result.to(usize)) }
};

/// The number of `clock`.
clock_id := (clock: std.time.Clock) -> usize { std.os.linux.clocks.id(clock).to(usize) };

/// Ends the process with `code`, 0 where it succeeded.
exit := (code: Int(0..=125)) -> lang.never {
    request(numbers.exit_group, [code.to(usize), 0, 0, 0, 0, 0]);
    unsafe lang.hint.unreachable()
};

/// Ends the process with the failure `status`.
end := (status: std.os.Status) -> lang.never { exit(status) };

/// The thread holding the critical section, 0 when none: a thread entering it again nests.
owner: std.sync.Atomic(usize) = .init(0);

/// The exports of a program the kernel starts at `_start`.
start := ($main: std.os.Main) -> type { struct {
    /// The kernel enters with the stack pointer at the argument count, without a return address
    /// and with the stack aligned: the frame pointer is cleared to end the chain of frames, and
    /// `boot` is called with the stack's address.
    #[link.export("_start"), abi.naked]
    entry := () -> lang.never {
        unsafe {
            $if lang.target.current.arch == .x86_64 {
                lang.arch.asm({
                    ..lang.arch.x86_64.names;
                    xor(ebp, ebp);
                    mov(rdi, rsp);
                    \and(rsp, -16);
                    call(boot);
                });
            } else {
                $if lang.target.current.arch == .arm64 {
                    lang.arch.asm({
                        ..lang.arch.arm64.names;
                        mov(x29, 0);
                        mov(x30, 0);
                        mov(x0, sp);
                        bl(boot);
                    });
                } else {
                    lang.arch.asm({
                        ..lang.arch.thumb.names;
                        mov(r7, 0);
                        mov(lr, 0);
                        mov(r0, sp);
                        bl(boot);
                    });
                }
            }
            lang.hint.unreachable()
        }
    };

    /// The argument count at `stack`, then the arguments' addresses.
    boot := (stack: *usize) -> lang.never {
        std.os.linux.kernel.tls.start(stack);
        count := unsafe stack.read();
        values := unsafe stack.offset(1).cast(*u8);
        mut sys := unsafe std.os.System.claim(std.os.Args.of(count, values));
        exit(main(&mut sys).status())
    };

    #[link.export(lang.panic.symbols.trap)]
    trap := (t: &lang.panic.Trap) -> lang.never {
        std.trace.trapped(t, trap);
        if std.os.thread.trapped(t) { std.os.linux.kernel.thread.end() } else { end(std.os.trapped) }
    };

    /// The operations of the checks of unsafe code, for a program built with checks.
    checks := if lang.check.current.len() > 0 { std.check.exports(state, end) } else { struct {} };

    #[link.export(std.os.symbols.write)]
    write := (fd: i32, bytes: &[u8]) -> Result(usize, std.os.Error) {
        address := lang.mem.items_pointer(u8, bytes).address();
        outcome(request(numbers.write, [fd.to(usize), address, bytes.len(), 0, 0, 0]))
    };

    #[link.export(std.os.symbols.read)]
    read := (fd: i32, bytes: &mut [u8]) -> Result(usize, std.os.Error) {
        address := lang.mem.items_pointer(u8, bytes).address();
        outcome(request(numbers.read, [fd.to(usize), address, bytes.len(), 0, 0, 0]))
    };

    #[link.export(std.os.symbols.open)]
    open := (path: &[u8], mode: std.os.file.Mode) -> Result(i32, std.os.Error) {
        ended := std.os.file.Path.of(path)?;
        at := [std.os.linux.cwd.wrap(usize), ended.start().address(), std.os.linux.flags.of(mode).to(usize), std.os.file.created, 0, 0];
        .ok(outcome(request(numbers.openat, at))?.to(i32))
    };

    #[link.export(std.os.symbols.close)]
    close := (fd: i32) -> Result((), std.os.Error) {
        outcome(request(numbers.close, [fd.to(usize), 0, 0, 0, 0, 0]))?;
        .ok(())
    };

    #[link.export(std.os.symbols.now)]
    now := (clock: std.time.Clock) -> Result(std.time.Instant, std.os.Error) {
        mut at := std.os.Timespec{ .seconds = 0, .nanos = 0 };
        outcome(request(numbers.clock_gettime, [clock_id(clock), std.ptr.to(std.os.Timespec, &at).address(), 0, 0, 0, 0]))?;
        .ok(at.instant())
    };

    /// Sleeps on the monotonic clock, going on with what is left when a signal interrupts it.
    #[link.export(std.os.symbols.pause)]
    pause := (span: std.time.Duration) -> Result((), std.os.Error) {
        mut left := std.os.Timespec.of(span);
        for {
            wanted := left;
            asked := std.ptr.to(std.os.Timespec, &wanted).address();
            at := std.ptr.to(std.os.Timespec, &left).address();
            match outcome(request(numbers.clock_nanosleep, [clock_id(.monotonic), 0, asked, at, 0, 0])) {
                .ok(_) => return .ok(()),
                .err(.interrupted) => {},
                .err(e) => return .err(e),
            }
        }
    };

    /// Blocks the thread's signals, the interrupts of a hosted program, and takes the section
    /// from other threads.
    #[link.export(std.sync.symbols.enter), panic.never]
    enter := () -> std.sync.Mask {
        all := every_signal;
        mut old: Sigset = 0;
        request(numbers.rt_sigprocmask, [block, std.ptr.to(Sigset, &all).address(), std.ptr.to(Sigset, &old).address(), sigset_bytes, 0, 0]);
        me := request(numbers.gettid, [0, 0, 0, 0, 0, 0]).wrap(usize);
        outer := owner.load(.acquire) != me;
        if outer {
            for owner.compare_swap(0, me, .acquire) != 0 {}
        }
        unsafe std.sync.Mask.of(old.wrap(usize), outer)
    };

    #[link.export(std.sync.symbols.leave), panic.never]
    leave := (mask: std.sync.Mask) {
        if mask.outer() {
            owner.store(0, .release);
        }
        set: Sigset = mask.bits().wrap(Sigset);
        mut old: Sigset = 0;
        request(numbers.rt_sigprocmask, [set_mask, std.ptr.to(Sigset, &set).address(), std.ptr.to(Sigset, &old).address(), sigset_bytes, 0, 0]);
    };

    /// Gives the core to other threads: what fires an event runs on one of them, or in a
    /// signal handler, and nothing is missed between an executor's check and its sleep.
    #[link.export(std.task.symbols.sleep)]
    sleep := () { request(numbers.sched_yield, [0, 0, 0, 0, 0, 0]); };

    memory := std.os.linux.kernel.memory.exports;
    division := if lang.target.current.arch == .arm { std.os.linux.kernel.division.exports } else { struct {} };
    threads := std.os.linux.kernel.thread.exports;
} };
