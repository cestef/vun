//! Arrays and slices (spec 05): what every `[n]T` and `[T]` answers, by impls for
//! `lang.mem.Array` and `lang.mem.Slice` over the primitives of `lang.mem`.

/// A run of items.
Sequence := interface(($Self: type) -> type { struct {
    /// The number of items.
    len: (xs: &Self) -> usize = _;
}});

#[impl(Sequence(lang.mem.Slice))]
SliceSequence := ($T: type) -> type { struct {
    #[panic.never]
    len := (xs: &[T]) -> usize { lang.mem.len(T, xs) };
    /// A pointer to the first item, for passing the items to code outside the language.
    #[panic.never]
    ptr := (xs: &[T]) -> *T { lang.mem.items_pointer(T, xs) };
    /// A borrow of each item with its position, from 0.
    enumerate := (xs: &[T]) -> std.iter.Iter((usize, &T)) { yield ..xs.iter().enumerate(); };
} };

#[impl(Sequence(lang.mem.Array))]
ArraySequence := ($n: Int(0..), $T: type) -> type { struct {
    #[panic.never]
    len := (xs: &[n]T) -> usize { n };
    /// A pointer to the first item, for passing the items to code outside the language.
    #[panic.never]
    ptr := (xs: &[n]T) -> *T { lang.mem.items_pointer(T, xs) };
    /// A borrow of each item with its position, from 0.
    enumerate := (xs: &[n]T) -> std.iter.Iter((usize, &T)) {
        items: &[T] = xs;
        yield ..items.iter().enumerate();
    };
} };
