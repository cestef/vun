//! Arrays and slices (spec 05): what every `[n]T` and `[T]` answers, by impls for
//! `lang.mem.Array` and `lang.mem.Slice` over the primitives of `lang.mem`.

/// A run of items.
Sequence := interface(($Self: type) -> type { struct {
    /// The number of items.
    len: (xs: &Self) -> usize = _;
} });

impl Sequence for lang.mem.Slice($T) {
    #[panic.never]
    len := (xs) { lang.mem.len(T, xs) };
    /// A pointer to the first item, for passing the items to code outside the language.
    #[panic.never]
    ptr := (xs) { lang.mem.items_pointer(T, xs) };
    /// A borrow of each item with its position, from 0.
    enumerate := (xs: &[T]) -> std.iter.Iter((usize, &T)) { yield ..xs.iter().enumerate(); };
}

/// An array has the length it is declared with; its other methods are those of the slice of its
/// items.
impl Sequence for lang.mem.Array($n, $T) {
    #[panic.never]
    len := (xs) { n };
}

/// Slices are equal when they hold as many items, equal in order.
impl lang.ops.Eq for lang.mem.Slice($T) {
    eq := (a, b) {
        if a.len() != b.len() { return false; }
        for i in 0..a.len() {
            if a[i] != b[i] { return false; }
        }
        true
    };
}

/// Arrays are equal when their items are, in order.
impl lang.ops.Eq for lang.mem.Array($n, $T) {
    eq := (a, b) {
        for i in 0..n {
            if a[i] != b[i] { return false; }
        }
        true
    };
}
