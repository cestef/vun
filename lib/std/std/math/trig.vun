//! Trigonometry by reduction to a quarter turn and a series on the remainder. The reduction is
//! accurate for arguments below about 100000 in magnitude and loses digits above; an infinity
//! gives a NaN. Each result is within a few units in the last place.

two_over_pi: f64 = 0.6366197723675814;
/// π/2 as a part with trailing zero bits, so `n * pio2_1` is exact, and what is left of it in
/// two more parts.
pio2_1: f64 = 1.57079632673412561417e+00;
pio2_1_tail: f64 = 6.07710050650619224932e-11;
pi: f64 = 3.141592653589793;
frac_pi_2: f64 = 1.5707963267948966;
/// π/2 less `frac_pi_2`.
frac_pi_2_low: f64 = 6.123233995736766e-17;
frac_pi_4: f64 = 0.7853981633974483;

/// The sine of `r` within a quarter turn of zero.
sin_kernel := (r: f64) -> f64 {
    r2 := r * r;
    mut sum: f64 = 1.0;
    mut n: f64 = 9.0;
    for n > 0.0 {
        sum = 1.0 - r2 / (2.0 * n * (2.0 * n + 1.0)) * sum;
        n = n - 1.0;
    }
    r * sum
};

/// The cosine of `r` within a quarter turn of zero.
cos_kernel := (r: f64) -> f64 {
    r2 := r * r;
    mut sum: f64 = 1.0;
    mut n: f64 = 10.0;
    for n > 0.0 {
        sum = 1.0 - r2 / ((2.0 * n - 1.0) * (2.0 * n)) * sum;
        n = n - 1.0;
    }
    sum
};

/// The quarter turns in `x` modulo four, and the remainder.
reduce := (x: f64) -> (i64, f64) {
    nf := std.math.round.round_even(x * two_over_pi);
    r := (x - nf * pio2_1) - nf * pio2_1_tail;
    n := lang.float.to_int(f64, nf, i64);
    (((n % 4) + 4) % 4, r)
};

sin := (x: f64) -> f64 {
    if !std.math.round.is_finite(x) { return std.math.round.not_a_number; }
    (quarter, r) := reduce(x);
    if quarter == 0 { sin_kernel(r) }
        else if quarter == 1 { cos_kernel(r) }
        else if quarter == 2 { -sin_kernel(r) }
        else { -cos_kernel(r) }
};

cos := (x: f64) -> f64 {
    if !std.math.round.is_finite(x) { return std.math.round.not_a_number; }
    (quarter, r) := reduce(x);
    if quarter == 0 { cos_kernel(r) }
        else if quarter == 1 { -sin_kernel(r) }
        else if quarter == 2 { -cos_kernel(r) }
        else { sin_kernel(r) }
};

tan := (x: f64) -> f64 { sin(x) / cos(x) };

/// The arc tangent, in -π/2 to π/2.
atan := (x: f64) -> f64 {
    if std.math.round.is_nan(x) { return x; }
    a := std.math.round.abs(x);
    big := a > 1.0;
    mut y: f64 = if big { 1.0 / a } else { a };
    // atan y = 2 atan (y / (1 + sqrt (1 + y²))), twice, brings y under 0.2.
    y = y / (1.0 + std.math.root.sqrt(1.0 + y * y));
    y = y / (1.0 + std.math.root.sqrt(1.0 + y * y));
    y2 := y * y;
    mut sum: f64 = 0.0;
    // The series alternates, so each step flips the sign of what it has added up.
    mut n: f64 = 13.0;
    for n >= 0.0 {
        sum = 1.0 / (2.0 * n + 1.0) - y2 * sum;
        n = n - 1.0;
    }
    small := 4.0 * y * sum;
    result := if big { frac_pi_2 - (small - frac_pi_2_low) } else { small };
    std.math.round.copysign(result, x)
};

/// The angle of the point `(x, y)` from the positive x axis, in -π to π.
atan2 := (y: f64, x: f64) -> f64 {
    if std.math.round.is_nan(x) or std.math.round.is_nan(y) { return std.math.round.not_a_number; }
    if std.math.round.is_infinite(x) {
        if x > 0.0 {
            return if std.math.round.is_infinite(y) { std.math.round.copysign(frac_pi_4, y) }
                else { std.math.round.copysign(0.0, y) };
        }
        return if std.math.round.is_infinite(y) { std.math.round.copysign(3.0 * frac_pi_4, y) }
            else { std.math.round.copysign(pi, y) };
    }
    if std.math.round.is_infinite(y) { return std.math.round.copysign(frac_pi_2, y); }
    if x == 0.0 {
        if y == 0.0 {
            return if std.math.round.is_sign_negative(x) { std.math.round.copysign(pi, y) } else { y };
        }
        return std.math.round.copysign(frac_pi_2, y);
    }
    angle := atan(y / x);
    if x > 0.0 { angle }
        else if std.math.round.is_sign_negative(y) { angle - pi }
        else { angle + pi }
};

asin := (x: f64) -> f64 {
    atan2(x, std.math.root.sqrt((1.0 - x) * (1.0 + x)))
};

acos := (x: f64) -> f64 {
    atan2(std.math.root.sqrt((1.0 - x) * (1.0 + x)), x)
};

sinh := (x: f64) -> f64 {
    e := std.math.exp.exp(x);
    (e - 1.0 / e) * 0.5
};

cosh := (x: f64) -> f64 {
    e := std.math.exp.exp(x);
    (e + 1.0 / e) * 0.5
};

tanh := (x: f64) -> f64 {
    if x > 20.0 { return 1.0; }
    if x < -20.0 { return -1.0; }
    e := std.math.exp.exp(2.0 * x);
    (e - 1.0) / (e + 1.0)
};

/// The length of the hypotenuse of a right triangle with legs `x` and `y`.
hypot := (x: f64, y: f64) -> f64 {
    if std.math.round.is_infinite(x) or std.math.round.is_infinite(y) { return std.math.round.infinity; }
    std.math.root.sqrt(x * x + y * y)
};
