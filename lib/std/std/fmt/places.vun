//! The places of arguments in a format string (spec 03, section 4): `{}`, `{?}`, `{x}` and `{b}`,
//! each a row of `specs`, then optionally a `:` and a layout (`fmt/layout.vun`), read once at
//! compile time into the text between them, or the first problem.

/// How an argument is written, as the bytes between the braces of its place say: the interface
/// that writes it, and the method of it that does.
Spec := struct {
    /// The bytes between the braces.
    mark: &[u8],
    interface: lang.Interface,
    /// The interface as a report names it.
    name: &[u8],
    method: &[u8],
};

/// Every specifier, the first being that of `{}`.
specs: [4]Spec = [
    .{ .mark = "", .interface = std.fmt.Format, .name = "std.fmt.Format", .method = "format" },
    .{ .mark = "?", .interface = std.fmt.Debug, .name = "std.fmt.Debug", .method = "debug" },
    .{ .mark = "x", .interface = std.fmt.Hex, .name = "std.fmt.Hex", .method = "hex" },
    .{ .mark = "b", .interface = std.fmt.Binary, .name = "std.fmt.Binary", .method = "binary" },
];

/// A run of text of a format string, and the argument written after it.
Piece := struct {
    text: &[u8],
    /// The position of the argument; past the last argument for the text that ends the string.
    arg: usize,
    /// The bytes of the place that takes the argument; none for the text that ends the string.
    hole: lang.Range = 0..0,
    /// How the argument is written.
    spec: Spec = specs[0],
    /// Where it sits in its width.
    layout: std.fmt.layout.Layout = .{},
};

/// Opens and closes the place of an argument.
open := "{"[0];
close := "}"[0];
colon := ":"[0];

/// The place of an argument that starts at `at` in `format`: a `{`, a specifier, optionally a `:`
/// and a layout, and the `}` that closes it.
Place := struct {
    spec: Spec,
    layout: std.fmt.layout.Layout,
    /// The bytes the place covers.
    len: usize,
};

/// The specifier that `mark` writes.
specifier := (mark: &[u8]) -> Option(Spec) {
    for spec in specs {
        if mark == spec.mark { return .some(spec); }
    }
    .none
};

/// The index of the first `byte` in `text`, or its length.
find := (text: &[u8], byte: u8) -> usize {
    for i in 0..text.len() {
        if text[i] == byte { return i; }
    }
    text.len()
};

/// The place of an argument that starts at `at` in `format`; none where no place starts there.
hole := (format: &[u8], at: usize) -> Option(Place) {
    if format[at] != open { return .none; }
    rest := format[at + 1..];
    n := find(rest, close);
    if n == rest.len() { return .none; }
    inner := rest[0..n];
    cut := find(inner, colon);
    parsed := if cut == inner.len() { Option(std.fmt.layout.Layout).some(.{}) } else {
        std.fmt.layout.layout_of(inner[cut + 1..])
    };
    if .some(spec) = specifier(inner[0..cut]) {
        if .some(layout) = parsed {
            return .some(.{ .spec = spec, .layout = layout, .len = (n + 2).to(usize) });
        }
    }
    .none
};

/// The number of arguments `format` takes: its places.
holes := ($format: &[u8]) -> usize {
    mut n: usize = 0;
    mut i: usize = 0;
    for i < format.len() {
        if .some(place) = hole(format, i) { n += 1; i += place.len; } else { i += 1; }
    }
    n
};

/// `format` split at each place of an argument: one piece per argument, then the text after the
/// last.
pieces := ($format: &[u8]) -> [holes(format) + 1]Piece {
    mut out: [holes(format) + 1]Piece = [.{ .text = "", .arg = 0 }; holes(format) + 1];
    mut n: usize = 0;
    mut start: usize = 0;
    mut i: usize = 0;
    for i < format.len() {
        if .some(place) = hole(format, i) {
            out[n] = .{
                .text = format[start..i],
                .arg = n,
                .hole = i..i + place.len,
                .spec = place.spec,
                .layout = place.layout,
            };
            n += 1;
            i += place.len;
            start = i;
        } else {
            i += 1;
        }
    }
    out[n] = .{ .text = format[start..], .arg = n };
    out
};

/// What is wrong in a format string, whose places of arguments are those of `specs`.
Problem := enum {
    /// A `{` that no `}` closes.
    unclosed,
    /// A `{` closed after something that is no specifier.
    unknown,
    /// A `}` that closes no `{`.
    unopened;

    /// The problem, as a report says it.
    text := (self: Problem) -> &[u8] {
        match self {
            .unclosed => "this `{` is not closed",
            .unknown => "unknown format specifier or layout",
            .unopened => "this `}` closes no `{`",
        }
    };

    /// What to do about it.
    help := (self: Problem) -> &[u8] {
        match self {
            .unclosed => "an argument goes where `{}` is written; close the `{` with a `}`",
            .unknown => "`{}` writes the next argument as its `Format` impl does, `{?}` as its `Debug` impl, `{x}` in base 16 and `{b}` in base 2; after a `:` goes a layout, such as `{:>8}` or `{x:0>4}`",
            .unopened => "a `}` only closes a `{`; write `{}` where an argument goes",
        }
    };
};

/// A problem of a format string, and the bytes of the string it covers.
Error := struct {
    reason: Problem,
    at: lang.Range,
};

/// `format` split at each place of an argument, or its first problem: every `{` starts a place.
parse := ($format: &[u8]) -> Result([holes(format) + 1]Piece, Error) {
    mut i: usize = 0;
    for i < format.len() {
        if .some(place) = hole(format, i) {
            i += place.len;
        } else if format[i] == open {
            // Not a place: a `}` closes it after something that is no specifier or layout, or none does.
            for j in i..format.len() {
                if format[j] == close { return .err(.{ .reason = .unknown, .at = i..j + 1 }); }
            }
            return .err(.{ .reason = .unclosed, .at = i..i + 1 });
        } else if format[i] == close {
            return .err(.{ .reason = .unopened, .at = i..i + 1 });
        } else {
            i += 1;
        }
    }
    .ok(pieces(format))
};
