//! Tests of `std.fmt`: the places of arguments in a format string, and debug output.

Point := struct { x: i32, y: i32 };

Empty := struct {};

Shape := enum {
    dot,
    line(Point, Point),
    named(&[u8]),
};

Segment := struct { from: Point, to: ?Point };

#[test]
a_place_without_a_specifier_writes_the_argument_as_it_is_formatted := () {
    mut slab := std.text.Slab(32).empty();
    std.fmt.print(&mut slab, "{} {}", "text", 7).expect("room");
    std.testing.assert(slab.bytes() == "text 7");
};

#[test]
debug_writes_scalars_as_their_source := () {
    mut slab := std.text.Slab(32).empty();
    std.fmt.print(&mut slab, "{?} {?} {?}", 42, -7, true).expect("room");
    std.testing.assert(slab.bytes() == "42 -7 true");
};

#[test]
debug_quotes_and_escapes_text := () {
    mut slab := std.text.Slab(64).empty();
    std.fmt.print(&mut slab, "{?}", "a \"b\"\n\tc\\ \u{1b} \u{e9}").expect("room");
    std.testing.assert(slab.bytes() == "\"a \\\"b\\\"\\n\\tc\\\\ \\u{1b} \u{e9}\"");
};

#[test]
debug_writes_sequences_and_tuples_in_brackets := () {
    mut slab := std.text.Slab(64).empty();
    numbers: [3]i32 = [1, 2, 3];
    std.fmt.print(&mut slab, "{?} {?} {?}", numbers, (1, true), "").expect("room");
    std.testing.assert(slab.bytes() == "[1, 2, 3] (1, true) \"\"");
};

#[test]
debug_writes_options_as_variants := () {
    mut slab := std.text.Slab(64).empty();
    some: ?i32 = .some(3);
    none: ?i32 = .none;
    std.fmt.print(&mut slab, "{?} {?}", some, none).expect("room");
    std.testing.assert(slab.bytes() == ".some(3) .none");
};

#[test]
debug_writes_a_struct_by_its_fields := () {
    mut slab := std.text.Slab(128).empty();
    p: Point = .{ .x = 1, .y = -2 };
    std.fmt.print(&mut slab, "{?}", p).expect("room");
    std.testing.assert(slab.bytes() == "Point{ .x = 1, .y = -2 }");
};

#[test]
debug_reaches_the_parts_of_parts := () {
    mut slab := std.text.Slab(256).empty();
    s: Segment = .{ .from = .{ .x = 0, .y = 0 }, .to = .some(.{ .x = 3, .y = 4 }) };
    std.fmt.print(&mut slab, "{?}", s).expect("room");
    std.testing.assert(
        slab.bytes() == "Segment{ .from = Point{ .x = 0, .y = 0 }, .to = .some(Point{ .x = 3, .y = 4 }) }"
    );
};

#[test]
debug_writes_enum_variants_with_their_parts := () {
    mut slab := std.text.Slab(128).empty();
    a: Shape = .dot;
    b: Shape = .line(.{ .x = 1, .y = 2 }, .{ .x = 3, .y = 4 });
    c: Shape = .named("box");
    std.fmt.print(&mut slab, "{?} {?} {?}", a, b, c).expect("room");
    std.testing.assert(
        slab.bytes() == ".dot .line(Point{ .x = 1, .y = 2 }, Point{ .x = 3, .y = 4 }) .named(\"box\")"
    );
};

#[test]
debug_writes_a_struct_with_no_fields_as_braces := () {
    mut slab := std.text.Slab(16).empty();
    e: Empty = .{};
    std.fmt.print(&mut slab, "{?}", e).expect("room");
    std.testing.assert(slab.bytes() == "Empty{}");
};

#[test]
places_of_both_kinds_mix_in_one_format_string := () {
    mut slab := std.text.Slab(64).empty();
    std.fmt.print(&mut slab, "{} is {?}, {} is {?}", "a", "a", 1, 1).expect("room");
    std.testing.assert(slab.bytes() == "a is \"a\", 1 is 1");
};

#[test]
integers_are_written_in_base_16_and_base_2 := () {
    mut slab := std.text.Slab(128).empty();
    std.fmt.print(&mut slab, "{x} {x} {x} {b} {b} {b}", 255, 0, 4096, 5, 0, 255).expect("room");
    std.testing.assert(slab.bytes() == "ff 0 1000 101 0 11111111");
};

#[test]
a_negative_integer_has_a_minus_before_its_digits_in_any_base := () {
    mut slab := std.text.Slab(64).empty();
    n: i32 = -255;
    std.fmt.print(&mut slab, "{} {x} {b}", n, n, -2).expect("room");
    std.testing.assert(slab.bytes() == "-255 -ff -10");
};

#[test]
the_widest_integers_are_written_in_the_smallest_base := () {
    mut slab := std.text.Slab(160).empty();
    wide: u128 = 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff;
    std.fmt.print(&mut slab, "{x}", wide).expect("room");
    std.testing.assert(slab.bytes() == "ffffffffffffffffffffffffffffffff");
    mut bits := std.text.Slab(160).empty();
    std.fmt.print(&mut bits, "{b}", wide).expect("room");
    std.testing.assert(bits.len() == 128);
};

#[test]
a_width_pads_the_argument_on_the_side_its_alignment_says := () {
    mut slab := std.text.Slab(64).empty();
    std.fmt.print(&mut slab, "[{:>5}] [{:<5}] [{:^5}] [{:5}]", 42, 42, 42, 42).expect("room");
    std.testing.assert(slab.bytes() == "[   42] [42   ] [ 42  ] [42   ]");
};

#[test]
a_fill_pads_with_its_byte_and_a_specifier_comes_first := () {
    mut slab := std.text.Slab(64).empty();
    std.fmt.print(&mut slab, "{x:0>4} {b:*^7} {:->6}", 255, 5, "ab").expect("room");
    std.testing.assert(slab.bytes() == "00ff **101** ----ab");
};

#[test]
an_argument_wider_than_its_width_is_written_whole := () {
    mut slab := std.text.Slab(64).empty();
    std.fmt.print(&mut slab, "{:>2}|{?:>3}", 12345, "abc").expect("room");
    std.testing.assert(slab.bytes() == "12345|\"abc\"");
};

/// What `{}` and `{?}` write for a float.
shown := ($T: type, x: T, debug: bool) -> std.text.Slab(48) {
    mut slab := std.text.Slab(48).empty();
    if debug { std.fmt.print(&mut slab, "{?}", x).expect("room"); } else {
        std.fmt.print(&mut slab, "{}", x).expect("room");
    }
    slab
};

#[test]
floats_print_as_the_shortest_digits_that_read_back := () {
    std.testing.assert(shown(f64, 0.1, false).bytes() == "0.1" and shown(f64, 1.5, false).bytes() == "1.5");
    std.testing.assert(shown(f64, 1.0, false).bytes() == "1" and shown(f64, 1.0, true).bytes() == "1.0");
    std.testing.assert(
        shown(f64, 100.0, false).bytes() == "100" and shown(f64, -250.0, true).bytes() == "-250.0"
    );
    std.testing.assert(shown(f64, 0.1 + 0.2, false).bytes() == "0.30000000000000004");
    std.testing.assert(shown(f64, 123456789.125, false).bytes() == "123456789.125");
    std.testing.assert(shown(f64, 9007199254740992.0, false).bytes() == "9007199254740992");
    std.testing.assert(shown(f64, 0.000001, false).bytes() == "0.000001");
    std.testing.assert(
        shown(f64, 1e21, false).bytes() == "1e21" and shown(f64, 1e-7, false).bytes() == "1e-7"
    );
    std.testing.assert(shown(f64, 1.5e300, false).bytes() == "1.5e300");
    std.testing.assert(shown(f64, 5e-324, false).bytes() == "5e-324");
    std.testing.assert(shown(f64, 1.7976931348623157e308, false).bytes() == "1.7976931348623157e308");
    std.testing.assert(shown(f64, 2.2250738585072014e-308, false).bytes() == "2.2250738585072014e-308");
};

#[test]
special_floats_and_other_widths_print := () {
    std.testing.assert(shown(f64, -0.0, false).bytes() == "-0" and shown(f64, 0.0, true).bytes() == "0.0");
    std.testing.assert(shown(f64, 0.0 / 0.0, false).bytes() == "NaN");
    std.testing.assert(
        shown(f64, 1.0 / 0.0, false).bytes() == "inf" and shown(f64, -1.0 / 0.0, false).bytes() == "-inf"
    );
    std.testing.assert(
        shown(f32, 0.1, false).bytes() == "0.1" and shown(f32, 16777216.0, false).bytes() == "16777216"
    );
    std.testing.assert(shown(f32, 3.4028235e38, false).bytes() == "3.4028235e38");
    std.testing.assert(shown(f32, 1e-45, false).bytes() == "1e-45");
    // A half float is 32 apart near its greatest, so 65500 reads back as it.
    std.testing.assert(shown(f16, 65504.0, false).bytes() == "65500");
    std.testing.assert(shown(f16, 0.1, false).bytes() == "0.1");
};

/// What `fixed` writes.
fixed_text := (x: f64, decimals: usize) -> std.text.Slab(48) {
    mut slab := std.text.Slab(48).empty();
    std.fmt.float.fixed(f64, std.text.Slab(48), &mut slab, x, decimals).expect("room");
    slab
};

#[test]
fixed_decimals_round_the_exact_value_to_even := () {
    std.testing.assert(fixed_text(3.14159, 2).bytes() == "3.14" and fixed_text(3.14159, 0).bytes() == "3");
    std.testing.assert(fixed_text(2.5, 0).bytes() == "2" and fixed_text(3.5, 0).bytes() == "4");
    std.testing.assert(fixed_text(0.125, 2).bytes() == "0.12" and fixed_text(0.375, 2).bytes() == "0.38");
    std.testing.assert(fixed_text(0.0, 3).bytes() == "0.000" and fixed_text(-1.5, 1).bytes() == "-1.5");
    std.testing.assert(fixed_text(0.1, 20).bytes() == "0.10000000000000000555");
    std.testing.assert(fixed_text(1e21, 1).bytes() == "1000000000000000000000.0");
    std.testing.assert(fixed_text(0.999, 2).bytes() == "1.00" and fixed_text(5e-324, 3).bytes() == "0.000");
};

/// What `std.fmt.json.write` writes for a float.
as_json := ($T: type, x: T) -> std.text.Slab(48) {
    mut slab := std.text.Slab(48).empty();
    std.fmt.json.write(std.text.Slab(48), T, &mut slab, &x).expect("room");
    slab
};

#[test]
floats_are_json_numbers_of_their_shortest_digits := () {
    std.testing.assert(as_json(f64, 1.5).bytes() == "1.5" and as_json(f64, -0.25).bytes() == "-0.25");
    std.testing.assert(as_json(f64, 100.0).bytes() == "100" and as_json(f64, 1e21).bytes() == "1e21");
    std.testing.assert(as_json(f64, 5e-324).bytes() == "5e-324" and as_json(f32, 0.1).bytes() == "0.1");
    std.testing.assert(as_json(f64, 0.1 + 0.2).bytes() == "0.30000000000000004");
};

#[test]
a_float_json_has_no_number_for_is_null := () {
    std.testing.assert(as_json(f64, 0.0 / 0.0).bytes() == "null");
    std.testing.assert(
        as_json(f64, 1.0 / 0.0).bytes() == "null" and as_json(f32, -1.0 / 0.0).bytes() == "null"
    );
};
