//! Portable vector code (spec 04, section 3): the methods and operators of every
//! `lang.simd.Vector(n, T)`, lane by lane over the array of its lanes. An operator's lanes have
//! the type the same operator gives their lanes (`u8` lanes sum to `Int(0..=510)` lanes).

Vector: ($lanes: usize, $T: type) -> type = lang.simd.Vector;

/// How many lanes of `T` the target's vector registers hold (`lang.target.Spec.vector_bits`), one
/// where it has none or `T` is wider than they are.
lane_count := ($T: type) -> usize {
    $bytes := lang.target.current.vector_bits / 8 / lang.meta.size(T);
    $if bytes == 0 { 1 } else { bytes }
};

/// The vector of the target's width: code over it takes its lane count from the target, and
/// covers a sequence of any length through `cover`, `load_partial` and `store_partial`.
Scalable := ($T: type) -> type { Vector(lane_count(T), T) };

/// The order a reduction combines lanes in: each run of `width` lanes as a balanced tree of
/// pairs, then the runs' results in lane order. A width of 1 combines every lane in order.
Reduction := struct {
    width: Int(1..),
    /// Runs of `width` lanes, each combined as a balanced tree of pairs.
    pairwise := ($width: Int(1..)) -> Reduction { .{ .width = width } };
};

impl lang.simd.Vector($n, $T) {
    /// The vector whose every lane is `x`.
    #[panic.never]
    splat := (x: T) -> Vector(n, T) { lang.simd.of(n, T, [x; n]) };
    /// The vector of the first `n` items of `xs`, which must hold as many.
    load := (xs: &[T]) -> Vector(n, T) { lang.simd.of(n, T, [$for i in 0..n { xs[i] }]) };
    /// Writes the lanes to the first `n` items of `to`, which must hold as many.
    store := (v: Vector(n, T), to: &mut [T]) {
        lanes := lang.simd.lanes(n, T, v);
        $for i in 0..n { to[i] = lanes[i]; }
    };
    /// The vector of the items `xs` has among the first `n`, the other lanes `fill`.
    load_partial := (xs: &[T], fill: T) -> Vector(n, T) {
        lang.simd.of(n, T, [$for i in 0..n { if i < xs.len() { xs[i] } else { fill } }])
    };
    /// Writes lane `i` to `to[i]` for each of the first `n` items `to` has.
    store_partial := (v: Vector(n, T), to: &mut [T]) {
        lanes := lang.simd.lanes(n, T, v);
        $for i in 0..n { if i < to.len() { to[i] = lanes[i]; } }
    };
    /// How many items of the `left` to go the next vector of a loop covers: `n`, or `left` when
    /// fewer remain. A target with vectors of a length known only when running grants the
    /// machine's, never more than `n`, so a loop steps by what this gives and assumes no more.
    cover := (left: usize) -> usize { std.cmp.min(usize, n, left) };
    /// The vector whose lane `i` is lane `order[i]` of `v`.
    shuffle := (v: Vector(n, T), $order: [n]usize) -> Vector(n, T) {
        lanes := lang.simd.lanes(n, T, v);
        lang.simd.of(n, T, [$for i in 0..n { lanes[order[i]] }])
    };
    /// The sum of the lanes, in the order `order` states, which fixes how a float sum rounds.
    /// The lanes' sum must be of their type, as floats' is.
    reduce_add := (v: Vector(n, T), $order: Reduction) -> T {
        lanes := lang.simd.lanes(n, T, v);
        mut sum := _tree(n, T, &lanes, 0, order.width);
        $for start in lang.simd.chunks(n, order.width) {
            $if start > 0 { sum = sum + _tree(n, T, &lanes, start, order.width); }
        }
        sum
    };
}

/// The sum of the `len` items of `xs` from `start`, as a balanced tree of pairs.
_tree := ($n: usize, $T: type, xs: &[n]T, $start: usize, $len: Int(1..)) -> T {
    $if len == 1 {
        xs[start]
    } else {
        _tree(n, T, xs, start, len / 2) + _tree(n, T, xs, start + len / 2, len - len / 2)
    }
};

impl lang.ops.Add for lang.simd.Vector($n, $T) {
    Output := ($R: type) -> type { Vector(n, lang.meta.witness(lang.ops.Add, T).Output(lang.simd.Lane(R))) };
    add := ($R: type, a, b) {
        (x, y) := (lang.simd.lanes(n, T, a), lang.simd.lanes(n, lang.simd.Lane(R), b));
        lang.simd.of(n, lang.simd.Lane(Output(R)), [$for i in 0..n { x[i] + y[i] }])
    };
}

impl lang.ops.Sub for lang.simd.Vector($n, $T) {
    Output := ($R: type) -> type { Vector(n, lang.meta.witness(lang.ops.Sub, T).Output(lang.simd.Lane(R))) };
    sub := ($R: type, a, b) {
        (x, y) := (lang.simd.lanes(n, T, a), lang.simd.lanes(n, lang.simd.Lane(R), b));
        lang.simd.of(n, lang.simd.Lane(Output(R)), [$for i in 0..n { x[i] - y[i] }])
    };
}

impl lang.ops.Mul for lang.simd.Vector($n, $T) {
    Output := ($R: type) -> type { Vector(n, lang.meta.witness(lang.ops.Mul, T).Output(lang.simd.Lane(R))) };
    mul := ($R: type, a, b) {
        (x, y) := (lang.simd.lanes(n, T, a), lang.simd.lanes(n, lang.simd.Lane(R), b));
        lang.simd.of(n, lang.simd.Lane(Output(R)), [$for i in 0..n { x[i] * y[i] }])
    };
}

impl lang.ops.Div for lang.simd.Vector($n, $T) {
    Output := ($R: type) -> type { Vector(n, lang.meta.witness(lang.ops.Div, T).Output(lang.simd.Lane(R))) };
    div := ($R: type, a, b) {
        (x, y) := (lang.simd.lanes(n, T, a), lang.simd.lanes(n, lang.simd.Lane(R), b));
        lang.simd.of(n, lang.simd.Lane(Output(R)), [$for i in 0..n { x[i] / y[i] }])
    };
}
