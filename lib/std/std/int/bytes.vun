//! Integers as the bytes of their storage (spec 04, rule 7): `to_le` and `to_be` give the bytes of
//! a value, `from_le` and `from_be` read a value from them. A signed value is its two's
//! complement, so every `Int(r)` is read and written alike.

impl Int($r) {
    /// The bytes of the value's storage, least significant first.
    to_le := (x: Int(r)) -> [lang.meta.size(Int(r))]u8 {
        word := x.wrap(std.int.Word(r));
        [$for i in 0..lang.meta.size(Int(r)) { (word >> 8 * i).wrap(u8) }]
    };

    /// The bytes of the value's storage, most significant first.
    to_be := (x: Int(r)) -> [lang.meta.size(Int(r))]u8 {
        word := x.wrap(std.int.Word(r));
        [$for i in 0..lang.meta.size(Int(r)) { (word >> 8 * (lang.meta.size(Int(r)) - 1 - i)).wrap(u8) }]
    };

    /// The integer whose storage holds `bytes`, most significant first: its first
    /// `lang.meta.size(Int(r))` bytes, which it must have.
    from_be := (bytes: &[u8]) -> Int(r) {
        mut word: std.int.Word(r) = 0;
        for i in 0..lang.meta.size(Int(r)) {
            word = (word * 256 + bytes[i]).wrap(std.int.Word(r));
        }
        word.wrap(Int(r))
    };

    /// The value with its bytes in the other order.
    swap_bytes := (x: Int(r)) -> Int(r) {
        bytes := x.to_be();
        Int(r).from_le(&bytes)
    };
}
