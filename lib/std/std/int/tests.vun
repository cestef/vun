//! Tests of `std.int`: integers read from text.

#[test]
decimal_text_is_read_as_an_integer := () {
    std.testing.assert(u8.parse("42") == Option(u8).some(42));
    std.testing.assert(i32.parse("42") == Option(i32).some(42));
    std.testing.assert(u64.parse("18446744073709551615") == Option(u64).some(18446744073709551615));
    std.testing.assert(u8.parse("007") == Option(u8).some(7));
};

#[test]
a_minus_makes_a_signed_integer_negative := () {
    std.testing.assert(i32.parse("-42") == Option(i32).some(-42));
    std.testing.assert(i8.parse("-128") == Option(i8).some(-128));
    std.testing.assert(i64.parse("-9223372036854775808") == Option(i64).some(-9223372036854775808));
    std.testing.assert(i32.parse("-0") == Option(i32).some(0));
};

#[test]
text_that_is_no_integer_of_the_type_is_not_read := () {
    std.testing.assert(u8.parse("") == Option(u8).none);
    std.testing.assert(i32.parse("-") == Option(i32).none);
    std.testing.assert(i32.parse("4x") == Option(i32).none);
    std.testing.assert(i32.parse("+4") == Option(i32).none);
    std.testing.assert(i32.parse(" 4") == Option(i32).none);
    std.testing.assert(u8.parse("256") == Option(u8).none);
    std.testing.assert(i8.parse("128") == Option(i8).none);
    std.testing.assert(i8.parse("-129") == Option(i8).none);
    std.testing.assert(u8.parse("-1") == Option(u8).none);
    std.testing.assert(u64.parse("18446744073709551616") == Option(u64).none);
};

#[test]
bytes_are_given_in_either_order := () {
    std.testing.assert(u32.to_le(0x0102_0304) == [4, 3, 2, 1]);
    std.testing.assert(u32.to_be(0x0102_0304) == [1, 2, 3, 4]);
    std.testing.assert(u8.to_le(0xab) == [0xab]);
    std.testing.assert(u64.to_be(0x0102_0304_0506_0708) == [1, 2, 3, 4, 5, 6, 7, 8]);
};

#[test]
a_signed_value_gives_its_twos_complement := () {
    std.testing.assert(i16.to_le(-2) == [0xfe, 0xff]);
    std.testing.assert(i16.to_be(-2) == [0xff, 0xfe]);
    std.testing.assert(i32.to_be(-1) == [0xff, 0xff, 0xff, 0xff]);
};

#[test]
bytes_are_read_in_either_order := () {
    bytes: [4]u8 = [1, 2, 3, 4];
    std.testing.assert(u32.from_le(&bytes) == 0x0403_0201);
    std.testing.assert(u32.from_be(&bytes) == 0x0102_0304);
    std.testing.assert(i16.from_be(&[0xff, 0xfe]) == -2);
};

#[test]
swapping_bytes_reverses_them := () {
    std.testing.assert(u16.swap_bytes(0x1234) == 0x3412);
    std.testing.assert(u32.swap_bytes(0x0102_0304) == 0x0403_0201);
    std.testing.assert(i32.swap_bytes(1) == 0x0100_0000);
};

#[test]
bytes_given_are_bytes_read := (x: u64) {
    bytes := x.to_le();
    std.testing.assert(u64.from_le(&bytes) == x);
    other := x.to_be();
    std.testing.assert(u64.from_be(&other) == x);
    std.testing.assert(x.swap_bytes().swap_bytes() == x);
};

#[test]
bits_rotate_around_the_word := () {
    std.testing.assert(u8.rotate_left(0b1000_0001, 1) == 0b0000_0011);
    std.testing.assert(u8.rotate_right(0b1000_0001, 1) == 0b1100_0000);
    std.testing.assert(u32.rotate_left(0x1234_5678, 8) == 0x3456_7812);
    std.testing.assert(u32.rotate_left(0x1234_5678, 0) == 0x1234_5678);
    std.testing.assert(u32.rotate_right(0x1234_5678, 0) == 0x1234_5678);
    std.testing.assert(i8.rotate_left(-128, 1) == 1);
};

#[test]
bits_are_counted := () {
    std.testing.assert(u8.count_ones(0) == 0);
    std.testing.assert(u8.count_ones(0b1011_0001) == 4);
    std.testing.assert(i32.count_ones(-1) == 32);
    std.testing.assert(u16.leading_zeros(0x00ff) == 8);
    std.testing.assert(u16.leading_zeros(0) == 16);
    std.testing.assert(u16.trailing_zeros(0x0100) == 8);
    std.testing.assert(u16.trailing_zeros(0) == 16);
    std.testing.assert(u64.trailing_zeros(1) == 0);
};

#[test]
a_rotation_is_undone_by_the_other := (x: u32, n: Int(0..32)) {
    std.testing.assert(x.rotate_left(n).rotate_right(n) == x);
    std.testing.assert(x.rotate_left(n).count_ones() == x.count_ones());
};
