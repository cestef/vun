//! The build API used by `build.vun` files (spec 12, section 2). `build` runs at compile time,
//! in the sandbox, with a `&mut Build` capability, and records a plan: steps that the driver
//! carries out once it returns. What only the package knows, its dependencies' names and
//! parameters, a program's options, is written as records, which the driver reads by
//! reflection (decision 116).

/// The interface every `build.vun` conforms to: `package`, a record read without evaluation, and
/// `build`.
Package := lang.interface(($Self: type) -> type { struct {
    build: (b: &mut Build) = _;
} });

/// A step of the plan, by its position: later steps name it.
Step := struct { index: usize };
/// A dependency of the package, as a step builds it.
Dep := struct { step: Step };
/// A program, as a step builds it.
Program := struct { step: Step };

/// A probe attached to a device.
Probe := struct { chip: &[u8] };
/// How a program reaches its device.
Flash := enum { probe(Probe), uf2, dfu };
/// Where a program's tests run.
Runner := enum { host, qemu(&[u8]), probe(Probe) };

/// What a program is built as: an executable a system runs, or a library other programs link,
/// shared (loaded when they run) or static (copied into them). A library has no runtime and no
/// entry: its exports are its interface (spec 08, section 2).
Output := enum { executable, shared, static };

/// What a program is built from.
Options := struct {
    /// Its root file, relative to the directory of the `build.vun`.
    root: &static [_]u8,
    target: lang.target.Spec,
    /// The dependencies it uses, each by its name in `package.deps`.
    deps: &[Use] = &[],
    /// Its memory map, empty for a program an operating system loads.
    memory: &[Region] = &[],
    output: Output = .executable,
    /// What its unsafe code is checked for at run time (spec 07, section 7).
    checks: &[lang.check.Kind] = &[],
};
/// A dependency a program uses: its name in `package.deps`, as a step builds it.
Use := struct { name: lang.meta.Name, dep: Dep };
/// A region of a program's memory, such as `.flash`, and where it lies.
Region := struct { name: lang.meta.Name, origin: u64, len: u64 };

/// What a step of the plan does. Records whose types each call infers are kept with their type,
/// as `lang.meta.Any`.
Action := enum {
    dep(Needed),
    program(Options),
    flash(Flashed),
    test_on(Tested),
    /// The lint levels.
    lints(lang.meta.Any),
};
/// A dependency by its name in `package.deps`, and the parameters it is built with.
Needed := struct { name: lang.meta.Name, params: lang.meta.Any };
/// A program to write to its device, and how.
Flashed := struct { program: Program, method: Flash };
/// A program whose tests run, and where.
Tested := struct { program: Program, runner: Runner };

/// The plan being recorded.
Build := struct {
    _actions: &static [Action],

    /// A plan without steps, the one the driver lends `build`.
    new := () -> Build { .{ ._actions = &[] } };

    /// What each step does, in the order recorded.
    actions := (self: &Build) -> &static [Action] { self._actions };

    /// The dependency `name` of `package.deps`, built with `params`: a record of the parameters
    /// its own `build.vun` declares, such as `.{ .variant = .f407 }`.
    dep := (self: &mut Build, $name: lang.meta.Name, $P: type, params: P) -> Dep {
        .{ .step = self._record(.dep(.{ .name = name, .params = lang.meta.any(P, params) })) }
    };

    /// A program built from `options`.
    program := (self: &mut Build, options: Options) -> Program {
        .{ .step = self._record(.program(options)) }
    };

    /// Writes the program `built` to its device by `method`.
    flash := (self: &mut Build, built: Program, method: Flash) {
        self._record(.flash(.{ .program = built, .method = method }));
    };

    /// Runs the tests of the program `built` on `runner`.
    test_on := (self: &mut Build, built: Program, runner: Runner) {
        self._record(.test_on(.{ .program = built, .runner = runner }));
    };

    /// The level of each lint for the package: pairs of a lint and a level, such as
    /// `.{ .{ std.lints.pedantic, .warn } }`.
    lints := (self: &mut Build, $L: type, levels: L) { self._record(.lints(lang.meta.any(L, levels))); };

    /// Records `action` as a new step, after every step recorded.
    _record := (self: &mut Build, action: Action) -> Step {
        step: Step = .{ .index = self._actions.len() };
        self._actions = lang.meta.append(Action, self._actions, action);
        step
    };
};

/// What a package plans: its `build`, the declaration `Package` requires of a `build.vun`, run
/// on a plan without steps. The driver calls it, then carries out each action in order.
plan := ($build: (b: &mut Build)) -> &static [Action] {
    mut b := Build.new();
    build(&mut b);
    b.actions()
};
