//! Integer methods (spec 04, section 3): narrowing to another integer type, an impl for every
//! `Int(r)` over the primitives of `lang.int`.

/// Bringing a value into a narrower type.
Narrow := interface(($Self: type) -> type { struct {
    /// Traps when the value is outside `T`.
    to: (x: Self, $T: type) -> T = _;
    /// Reduces the value modulo the size of `T`.
    #[panic.never]
    wrap: (x: Self, $T: type) -> T = _;
    /// Clamps the value to the bounds of `T`.
    #[panic.never]
    sat: (x: Self, $T: type) -> T = _;
    /// `.none` when the value is outside `T`.
    #[panic.never]
    try_to: (x: Self, $T: type) -> ?T = _;
} });

#[impl(Narrow(Int))]
int_narrow := ($r: lang.Range) -> type { struct {
    to := (x: Int(r), $T: type) -> T { lang.int.to(r, x, T) };
    #[panic.never]
    wrap := (x: Int(r), $T: type) -> T { lang.int.wrap(r, x, T) };
    #[panic.never]
    sat := (x: Int(r), $T: type) -> T { lang.int.sat(r, x, T) };
    /// A value that fits is its own wrap, which cannot trap.
    #[panic.never]
    try_to := (x: Int(r), $T: type) -> ?T {
        if lang.int.fits(r, x, T) { .some(lang.int.wrap(r, x, T)) } else { .none }
    };
} };

#[impl(Int)]
int_methods := ($r: lang.Range) -> type { struct {
    /// The absolute value, whose range is the magnitude of `r`: `i32` gives `Int(0..=2^31)`.
    #[panic.never]
    abs := (x: Int(r)) -> Int(lang.int.magnitude(r)) { lang.int.abs(r, x) };
    /// The float of type `T` nearest the value, ties to even.
    #[panic.never]
    nearest := (x: Int(r), $T: type) -> T { lang.float.from_int(r, x, T) };
    /// The integer whose storage holds `bytes`, least significant first: its first
    /// `lang.meta.size(Int(r))` bytes, which it must have.
    from_le := (bytes: &[u8]) -> Int(r) {
        mut v: Int(r) = 0;
        mut i: usize = lang.meta.size(Int(r));
        for i > 0 {
            i -= 1;
            v = (v * 256 + bytes[i]).wrap(Int(r));
        }
        v
    };
    /// The integer the decimal digits `text` write, after a `-` when it is below zero; `.none` for
    /// an empty text, one holding anything else, or a number outside `Int(r)` or past `u64`.
    parse := (text: &[u8]) -> ?Int(r) {
        negative := text.len() > 0 and text[0] == "-"[0];
        digits := if negative { text[1..] } else { text };
        if digits.len() == 0 { return .none; }
        mut n: u64 = 0;
        for i in 0..digits.len() {
            d := digits[i];
            if d < "0"[0] or d > "9"[0] { return .none; }
            n = match (n * 10 + (d - "0"[0])).try_to(u64) {
                .some(next) => next,
                .none => return .none,
            };
        }
        if negative { (0 - n).try_to(Int(r)) } else { n.try_to(Int(r)) }
    };
} };
