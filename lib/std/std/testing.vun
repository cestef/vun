//! Tests, properties, benchmarks and simulation (spec 11). The runner is an ordinary program:
//! `start := std.testing.runner(app);` runs every test of the namespace `app` and those nested in
//! it, each on a thread of its own, since a trap ends only its thread (spec 07, section 3), and
//! writes one JSON line per test, then one of the totals (spec 11, section 3). A test whose one
//! parameter is `&mut Bench` is a benchmark (`std.testing.bench`), one whose one parameter is
//! `&mut Sim` a simulation (`std.testing.sim`); a test with other parameters is a property, run
//! with arguments generated from their types (`std.testing.property`), as a simulation runs with
//! its schedules drawn from the same choices.

/// Marks a binding as a test. Plain data: the runner finds tests by reflection.
#[lint.allow(std.lints.naming.case, "an attribute, written `#[test]`")]
test := struct {
    /// Skips the test, saying why: `#[test.ignore("needs a network")]`.
    ignore := (reason: &[u8]) -> Ignored { .{ .reason = reason } };
    /// Generates a property's parameter with `with` rather than from its type, making what a
    /// case holds for it: `(#[test.gen(small)] n: u8)`.
    gen := ($T: type, with: (c: &mut Choices) -> T) -> std.testing.property.Generated(T) { .{ .with = with } };
};

/// How a type's values are generated for property tests its own way (spec 11, section 2).
Arbitrary: lang.Interface = std.testing.property.Arbitrary;
/// The choices generated values are read from.
Choices: type = std.testing.property.Choices;
/// A value of a type read from choices: by its `Arbitrary`, or by reflection.
gen := std.testing.property.gen;
/// The loop of a benchmark.
Bench: type = std.testing.bench.Bench;
/// A simulation, and its clock.
Sim: type = std.testing.sim.Sim;
Clock: type = std.testing.sim.Clock;
/// How a run is asked for.
Options: type = std.testing.options.Options;

/// A test that is not run, and why.
Ignored := struct {
    reason: &[u8],
};

/// Traps unless `cond` holds, the failure quoting it with where it is written.
#[comptime.deferred]
assert := ($cond: lang.meta.Code(bool)) {
    if !$cond { lang.panic.fail(.assertion(cond.source(), cond.span())); }
};

/// What became of a test.
Outcome := enum {
    passed,
    /// It is not run (`test.ignore`).
    ignored(Ignored),
    /// A trap ended it: its site, and what the program's table says of it.
    trapped(Trapped),
    /// A case of a property test trapped: the smallest case found.
    falsified(Falsified),
    /// A benchmark ran measured: how many times its body ran, and how long that took.
    measured(std.testing.bench.Measured),
    /// A property was fuzzed and no case trapped: how many ran, and what they covered.
    fuzzed(std.testing.fuzz.Fuzzed),
};

/// A property test's failing case, shrunk: the trap that ended the smallest case found, the seed
/// its cases were drawn from, the case that trapped first and how many smaller cases shrinking
/// found. Its arguments are written before its line, as what the test wrote.
Falsified := struct {
    trapped: Trapped,
    seed: u64,
    case: usize,
    shrinks: usize,
};

/// A trap ending a test.
Trapped := struct {
    site: u32,
    said: ?std.trace.Site,
};

/// Totals of a run.
Totals := struct {
    passed: usize,
    trapped: usize,
    falsified: usize,
    ignored: usize,
    measured: usize,
    fuzzed: usize,
    /// How long the run took in nanoseconds, none where the system gave no clock.
    nanos: ?u64,

    /// Counts `outcome`.
    count := (self: &mut Totals, outcome: &Outcome) {
        match outcome {
            .passed => { self.passed += 1; },
            .trapped(_) => { self.trapped += 1; },
            .falsified(_) => { self.falsified += 1; },
            .ignored(_) => { self.ignored += 1; },
            .measured(_) => { self.measured += 1; },
            .fuzzed(_) => { self.fuzzed += 1; },
        }
    };
};

/// A line the runner writes: a test run and what became of it, then the totals; asked to list,
/// the tests it would run and nothing of them.
Line := enum {
    test(Ran),
    totals(Totals),
    listed(Listed),
};

/// A test the runner lists: its name, as declared, and what kind of test it is.
Listed := struct {
    name: &[u8],
    kind: Kind,
};

/// A line the runner writes before a falsified property's line, one per parameter: the argument
/// of its smallest failing case.
Argued := ($T: type) -> type { enum { argument(Argument(T)) } };

/// An argument of a property's failing case: its parameter's name, and its value, written as
/// JSON by its type.
Argument := ($T: type) -> type { struct { name: &[u8], value: T } };

/// A test run: its name, as declared, what became of it, and how long it took in nanoseconds,
/// none where the system gave no clock.
Ran := struct {
    name: &[u8],
    outcome: Outcome,
    nanos: ?u64,
};

/// The status of a run in which a test trapped.
failed: std.os.Status = 1;

/// The exports of the program running the tests of `ns`.
#[lint.allow(std.lints.naming.case, "a program's exports, written as `std.os.start` is")]
runner := ($ns: lang.meta.Namespace) -> type {
    std.os.start(struct {
        main := (sys: &mut std.os.System) -> std.os.Exit {
            options := match Options.of(sys.args()) {
                .some(options) => options,
                .none => return .code(failed),
            };
            match run(ns, sys, &options) {
                .ok(totals) => if totals.trapped == 0 and totals.falsified
                    == 0 { .ok } else { .code(failed) },
                .err(_) => .code(failed),
            }
        };
    }.main)
};

/// Runs the tests of `ns` and the namespaces in it, in the order they are declared, or those
/// `options` name, the benchmarks alone when it asks for them measured, and writes a line for
/// each to the standard output, then the totals. A test marked `test.ignore` is not run.
run := ($ns: lang.meta.Namespace, sys: &mut std.os.System, options: &Options) -> Result(Totals, std.os.Error) {
    mut out := sys.stdout();
    mut totals := Totals{
        .passed = 0,
        .trapped = 0,
        .falsified = 0,
        .ignored = 0,
        .measured = 0,
        .fuzzed = 0,
        .nanos = .none
    };
    run_time := std.time.Stopwatch.start();
    $for c in std.meta.collect(ns, test) {
        step(c.ns.$(c.decl.name), c.decl, sys, options, &mut out, &mut totals)?;
    }
    totals.nanos = run_time.elapsed_nanos();
    write(&mut out, &Line.totals(totals))?;
    .ok(totals)
};

/// Lists or runs the test `f`, declared as `decl`, when `options` choose it, and counts and writes
/// what became of it. Not inlined, so that the function running every test stays small.
#[opt.inline(.never)]
step := (
    $F: type,
    $f: F,
    $decl: lang.meta.Decl,
    sys: &mut std.os.System,
    options: &Options,
    out: &mut std.os.Stream,
    totals: &mut Totals
) -> Result((), std.os.Error) {
    if options.list and options.chosen(decl.name) and options.runs($kind(F, f)) {
        write(out, &Line.listed(.{ .name = decl.name, .kind = $kind(F, f) }))?;
    } else if options.chosen(decl.name) and options.runs($kind(F, f)) {
        lap := std.time.Stopwatch.start();
        outcome := match std.meta.attr(lang.meta.Decl, decl, Ignored) {
            .some(ignored) => Outcome.ignored(ignored),
            .none => tested(F, f, decl.name, sys, options, out)?,
        };
        totals.count(&outcome);
        write(out, &Line.test(.{ .name = decl.name, .outcome = outcome, .nanos = lap.elapsed_nanos() }))?;
    }
    .ok(())
};

/// What became of the test `f`, named `name`: a unit test runs once, a benchmark's loop once or
/// measured as `options` ask, a property over the cases they ask for, whose arguments are
/// generated, the smallest failing one's written to `out`.
tested := ($F: type, $f: F, name: &[u8], sys: &mut std.os.System, options: &Options, out: &mut std.os.Stream) -> Result(Outcome, std.os.Error) {
    $if kind(F, f) == .unit {
        // On a thread of its own; where the system runs one thread, on the calling one, and a
        // trap ends the run.
        mut g := f;
        .ok(match sys.spawn(&mut g) {
            .ok(t) => match t.join() {
                .ok(_) => Outcome.passed,
                .err(trap) => Outcome.trapped(trapped(trap)),
            },
            .err(_) => {
                g();
                Outcome.passed
            },
        })
    } else {
        $if kind(F, f) == .benchmark {
            .ok(std.testing.bench.outcome(F, f, sys, options.bench))
        } else {
            checked(F, f, name, sys, options, out)
        }
    }
};

/// What became of the property test `f`, named `name`, over the cases `options` ask for, or
/// fuzzed over as many: the smallest failing case's arguments are written to `out`.
checked := ($F: type, $f: F, name: &[u8], sys: &mut std.os.System, options: &Options, out: &mut std.os.Stream) -> Result(Outcome, std.os.Error) {
    seed := match options.seed {
        .some(seed) => seed,
        .none => seed_of(name),
    };
    found: ?(std.testing.property.Failing, usize) = if options.fuzz {
        match std.testing.fuzz.fuzz(F, f, sys, seed, options.cases.to(u64)) {
            .ok(fuzzed) => return .ok(Outcome.fuzzed(fuzzed)),
            .err(failing) => .some(failing),
        }
    } else {
        std.testing.property.check(F, f, sys, seed, options.cases)
    };
    .ok(match found {
        .none => Outcome.passed,
        .some((failing, case)) => {
            std.testing.property.write(F, f, out, &failing)?;
            Outcome.falsified(.{
                .trapped = trapped(failing.trap),
                .seed = seed,
                .case = case,
                .shrinks = failing.shrinks
            })
        },
    })
};

/// What kind of test a test is, by its parameters (spec 11, section 1): a property takes
/// arguments generated from choices, a fuzz target's and a simulation's included.
Kind := enum { unit, benchmark, property };

/// The kind of the test `f`.
kind := ($F: type, $f: F) -> Kind {
    $if lang.meta.params(F, f).len() == 0 {
        .unit
    } else {
        $if takes(F, f, &mut Bench) { .benchmark } else { .property }
    }
};

/// Whether the one parameter of `f` is a `T`.
takes := ($F: type, $f: F, $T: type) -> bool {
    $params := lang.meta.params(F, f);
    params.len() == 1 and params[0].type == T
};

/// A trap as a test's outcome reports it: its site, and what the program's table says of it.
trapped := (trap: lang.panic.Trap) -> Trapped {
    .{ .site = trap.site, .said = std.trace.Site.of(trap.site) }
};

/// The seed the cases of the property test `name` are drawn from: the FNV-1a hash of its name,
/// so every run draws the same cases.
seed_of := (name: &[u8]) -> u64 {
    mut h: u64 = 0xCBF2_9CE4_8422_2325;
    for i in 0..name.len() {
        h = h ^ name[i];
        h *%= 0x0100_0000_01B3;
    }
    h
};

/// Writes `line` and a line break.
write := (w: &mut std.os.Stream, line: &Line) -> Result((), std.os.Error) {
    std.fmt.json.write(w, line)?;
    w.write_all("\n")
};
