//! The build API used by `build.ov` files (spec 12, section 2).

/// The interface every `build.ov` conforms to.
Package := lang.interface(($Self: type) -> type { struct {
    package: Manifest = _;
    build: (b: &mut Build) = _;
}});

/// A package's description, as `build.ov` states it (spec 12, section 2).
Manifest := struct { name: &[u8], version: &[u8] };
/// The build being planned, which `build` adds steps to; the driver makes it.
Build := struct { _plan: u32 };
