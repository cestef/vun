//! Hosted runtimes and the `System` capability (spec 08, section 2). A hosted program is
//! `start := std.os.start(main)`; the runtime makes the one `System` and passes it to `main`.

/// A status a process ends with, besides success: what every system passes on unchanged. A shell
/// reads 126 and 127 as a program that could not run and 128 plus `n` as one killed by signal
/// `n`, and WASI's `proc_exit` refuses 126 and above.
Status: type = Int(1..=125);

/// How the program ends: `ok`, or a status for the process that started it.
Exit := enum {
    ok,
    code(Status);

    /// The end with status `n`, `ok` for 0.
    of := (n: Int(0..=125)) -> Exit {
        if n == 0 { .ok } else { .code(n) }
    };

    /// The status the process ends with, 0 for `ok`.
    status := (self: &Exit) -> Int(0..=125) {
        match self.* {
            .ok => 0,
            .code(n) => n,
        }
    };
};

/// The status a process ends with when it traps.
trapped: Status = 101;

/// The link symbols of this namespace's declarations, which a runtime exports (spec 08,
/// section 1): each system reaches its streams its own way.
symbols := struct {
    write := "vun_os_write";
    read := "vun_os_read";
    open := "vun_os_open";
    close := "vun_os_close";
    now := "vun_os_now";
    pause := "vun_os_pause";
    spawn := "vun_os_spawn";
    join := "vun_os_join";
};

/// Writes some of `bytes` to the stream the system knows as `fd`, returning how many.
#[link.symbol(symbols.write)]
write: (fd: i32, bytes: &[u8]) -> Result(usize, Error) = _;

/// Reads into `bytes` from the stream the system knows as `fd`, returning how many bytes it
/// read: 0 at the stream's end.
#[link.symbol(symbols.read)]
read: (fd: i32, bytes: &mut [u8]) -> Result(usize, Error) = _;

/// Opens the file at `path` in `mode`, returning the number the system knows its stream by.
#[link.symbol(symbols.open)]
open: (path: &[u8], mode: std.os.file.Mode) -> Result(i32, Error) = _;

/// Closes the stream the system knows as `fd`.
#[link.symbol(symbols.close)]
close: (fd: i32) -> Result((), Error) = _;

/// Reads `clock`.
#[link.symbol(symbols.now)]
now: (clock: std.time.Clock) -> Result(std.time.Instant, Error) = _;

/// Suspends the calling thread for at least `span`.
#[link.symbol(symbols.pause)]
pause: (span: std.time.Duration) -> Result((), Error) = _;

/// Starts a thread at `start` with the address of a copy of the `bytes` of its context at
/// `context`, returning the handle `join` takes: the copy stays, where the thread may write it,
/// until then.
#[link.symbol(symbols.spawn)]
spawn: unsafe (start: std.os.thread.Start, context: *u8, bytes: usize) -> Result(usize, Error) = _;

/// Waits for the thread of `thread` to end, then copies its context back to the `bytes` at
/// `context`, gives back what it held and tells how it ended.
#[link.symbol(symbols.join)]
join: unsafe (thread: usize, context: *u8, bytes: usize) -> std.os.thread.Ended = _;

/// A span of time as POSIX systems take and give it (`struct timespec`): whole seconds, and the
/// nanoseconds past them.
#[layout.c]
Timespec := struct {
    seconds: i64,
    nanos: i64,

    /// The span `span`.
    of := (span: std.time.Duration) -> Timespec {
        .{ .seconds = span.whole_seconds().to(i64), .nanos = span.subsec_nanos().to(i64) }
    };
    /// The reading of a clock this span after its start.
    instant := (self: &Timespec) -> std.time.Instant {
        std.time.Instant.at((self.seconds * std.time.nanos_per_second + self.nanos).to(u64))
    };
};

/// The numbers a system gives its clocks.
Clocks := struct {
    monotonic: i32,
    real: i32,

    /// The number of `clock`.
    id := (self: &Clocks, clock: std.time.Clock) -> i32 {
        match clock {
            .monotonic => self.monotonic,
            .real => self.real,
        }
    };
};

/// Why a request to the system failed: a reason `std` names, or the error number the system
/// reported where it names none.
Error := enum {
    /// No file or directory at the path.
    missing,
    /// Not permitted.
    denied,
    /// Something at the path already.
    exists,
    /// A directory where a file was wanted.
    directory,
    /// A file where a directory was wanted.
    not_directory,
    /// A path longer than the system takes, or holding a zero byte.
    path,
    /// A signal interrupted the request before it finished.
    interrupted,
    /// A stream that took no more bytes.
    closed,
    /// A stream that ended before all the bytes asked for were read.
    ended,
    /// Something the system does not offer, as threads on a system running one.
    unsupported,
    number(i32),
};

/// The error a system numbering its errors as POSIX's first systems did, Linux and macOS
/// alike, means by `number`: `EPERM`, `ENOENT`, `EINTR`, `EACCES`, `EEXIST`, `ENOTDIR` and
/// `EISDIR`, and `too_long`, its own number for a path too long (`ENAMETOOLONG`).
posix_error := (number: i32, too_long: i32) -> Error {
    if number == too_long { return .path; }
    match number {
        1 | 13 => .denied,
        2 => .missing,
        4 => .interrupted,
        17 => .exists,
        20 => .not_directory,
        21 => .directory,
        _ => .number(number),
    }
};

/// The streams every process starts with, by their numbers.
stdin_fd := 0;
stdout_fd := 1;
stderr_fd := 2;

/// Access to the operating system: files, sockets, threads, clocks, the environment.
System := struct {
    _args: Args,

    /// The process's system, started with `args`. Only a runtime claims it, once, before `main`.
    claim := unsafe (given: Args) -> System { .{ ._args = given } };
    /// The arguments the process was started with.
    args := (self: &System) -> Args { self._args };
    stdin := (self: &mut System) -> Stream { unsafe Stream.of(stdin_fd) };
    stdout := (self: &mut System) -> Stream { unsafe Stream.of(stdout_fd) };
    stderr := (self: &mut System) -> Stream { unsafe Stream.of(stderr_fd) };
    /// Opens the file at `path` in `mode`.
    open := (self: &mut System, path: &[u8], mode: std.os.file.Mode) -> Result(std.os.file.File, Error) {
        match std.os.open(path, mode) {
            .ok(fd) => .ok(unsafe std.os.file.File.of(fd)),
            .err(e) => .err(e),
        }
    };
    /// Reads `clock`.
    now := (self: &System, clock: std.time.Clock) -> Result(std.time.Instant, Error) { std.os.now(clock) };
    /// Suspends the calling thread for at least `span`.
    pause := (self: &mut System, span: std.time.Duration) -> Result((), Error) { std.os.pause(span) };
    /// Starts a thread running `f`, borrowed until the thread is joined.
    spawn := (self: &temp mut System, $R: type, $F: lang.ops.Call((), R), f: &mut F) -> Result(
        std.os.thread.Thread(R, F),
        Error
    ) {
        std.os.thread.Thread(R, F).spawn(f)
    };
};

/// The arguments a process was started with, its program's name first where the system passes
/// one: each the bytes the system passed, without the zero that ends it there.
Args := struct {
    _count: usize,
    _values: *(*u8),

    /// The `count` arguments at `values`, each ending with a zero byte, as C's `main` receives
    /// them; they must stay unchanged for as long as the arguments are read.
    of := unsafe (count: usize, values: *(*u8)) -> Args { .{ ._count = count, ._values = values } };
    /// How many arguments there are.
    len := (self: &Args) -> usize { self._count };
    /// The argument at `i`; `.none` past the last.
    get := (self: &Args, i: usize) -> ?&[u8] {
        if i >= self._count { return .none; }
        first := unsafe self._values.offset(i.to(isize)).read();
        mut n: usize = 0;
        for unsafe first.offset(n.to(isize)).read() != 0 { n += 1; }
        .some(unsafe lang.mem.items_at(u8, first, n))
    };
};

/// Each argument in order: `for arg in sys.args()`.
impl lang.ops.Iterate for Args {
    Iter: lang.Interface = std.iter.Iter(&[u8]);
    iter := (self: Args) -> Iter {
        for i in 0..self.len() {
            match self.get(i) {
                .some(arg) => yield arg,
                .none => {},
            }
        }
    };
}

/// A byte stream the system holds open: standard output, a file, a socket.
Stream := struct {
    _fd: i32,

    /// The stream the system knows as `number`, which must be open for as long as the stream is used.
    of := unsafe (number: i32) -> Stream { .{ ._fd = number } };
    /// The number the system knows it by.
    fd := (self: &Stream) -> i32 { self._fd };
};

/// Reads into `into`, returning how many bytes it read: 0 at the stream's end.
impl std.io.Reader for Stream {
    Error: type = std.os.Error;
    ended: std.os.Error = .ended;
    read := (self: &mut Stream, into: &mut [u8]) -> Result(usize, std.os.Error) {
        std.os.read(self.fd(), into)
    };
}

impl std.fmt.Writer for Stream {
    Error: type = std.os.Error;
    closed: std.os.Error = .closed;
    /// Writes some of `bytes`, returning how many.
    write := (self: &mut Stream, bytes: &[u8]) -> Result(usize, std.os.Error) {
        std.os.write(self.fd(), bytes)
    };
}

/// A program's `main`, which a runtime calls with the one `System`.
Main := (&mut System) -> Exit;

/// A hosted runtime: the system and ABI of the targets it serves, and the function making a
/// program's exports from its `main` (spec 08, section 2).
Runtime := struct {
    os: lang.meta.Name,
    abi: lang.meta.Name,
    start: ($main: Main) -> type,
};

/// The runtimes of the systems `std` knows, each declared by its system's namespace.
runtimes := [std.os.linux.runtime, std.os.linux.gnu, std.os.macos.runtime, std.os.wasi.runtime];

/// The runtime of the targets of `target`'s system and ABI.
runtime := ($target: lang.target.Spec) -> Runtime {
    $for row in runtimes {
        if row.os == target.os and row.abi == target.abi { return row; }
    }
    lang.panic.fail(.message("std knows no runtime for this target's system and ABI"))
};

/// The runtime of the target being built for: `start := std.os.start(main)`.
start := runtime(lang.target.current).start;
