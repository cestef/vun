//! Hosted runtimes and the `System` capability (spec 08, section 2). A hosted program is
//! `start := std.os.start(main)`; the runtime makes the one `System` and passes it to `main`.

/// A status a process ends with, besides success: what every system passes on unchanged. A shell
/// reads 126 and 127 as a program that could not run and 128 plus `n` as one killed by signal
/// `n`, and WASI's `proc_exit` refuses 126 and above.
Status := Int(1..=125);

/// How the program ends: `ok`, or a status for the process that started it.
Exit := enum {
    ok,
    code(Status);

    /// The end with status `n`, `ok` for 0.
    of := (n: Int(0..=125)) -> Exit {
        if n == 0 { .ok } else { .code(n) }
    };

    /// The status the process ends with, 0 for `ok`.
    status := (self: &Exit) -> Int(0..=125) {
        match self.* {
            .ok => 0,
            .code(n) => n,
        }
    };
};

/// The status a process ends with when it traps.
trapped: Status = 101;

/// The link symbols of this namespace's declarations, which a runtime exports (spec 08,
/// section 1): each system reaches its streams its own way.
symbols := struct {
    write := "vun_os_write";
};

/// Writes some of `bytes` to the stream the system knows as `fd`, returning how many.
#[link.symbol(symbols.write)]
write: (fd: i32, bytes: &[u8]) -> Result(usize, Error) = _;

/// Why a request to the system failed: the error number it reported, or a stream that took no
/// more bytes.
Error := enum { number(i32), closed };

/// The streams every process starts with, by their numbers.
stdout_fd := 1;
stderr_fd := 2;

/// Access to the operating system: files, sockets, threads, clocks, the environment.
System := struct {
    _args: Args,

    /// The process's system, started with `args`. Only a runtime claims it, once, before `main`.
    claim := unsafe (given: Args) -> System { .{ ._args = given } };
    /// The arguments the process was started with.
    args := (self: &System) -> Args { self._args };
    stdout := (self: &mut System) -> Stream { unsafe Stream.of(stdout_fd) };
    stderr := (self: &mut System) -> Stream { unsafe Stream.of(stderr_fd) };
};

/// The arguments a process was started with, its program's name first where the system passes
/// one: each the bytes the system passed, without the zero that ends it there.
Args := struct {
    _count: usize,
    _values: *(*u8),

    /// The `count` arguments at `values`, each ending with a zero byte, as C's `main` receives
    /// them; they must stay unchanged for as long as the arguments are read.
    of := unsafe (count: usize, values: *(*u8)) -> Args { .{ ._count = count, ._values = values } };
    /// How many arguments there are.
    len := (self: &Args) -> usize { self._count };
    /// The argument at `i`; `.none` past the last.
    get := (self: &Args, i: usize) -> ?&[u8] {
        if i >= self._count { return .none; }
        first := unsafe self._values.offset(i.to(isize)).read();
        mut n: usize = 0;
        for unsafe first.offset(n.to(isize)).read() != 0 { n += 1; }
        .some(unsafe lang.mem.items_at(u8, first, n))
    };
};

/// Each argument in order: `for arg in sys.args()`.
#[impl(lang.ops.Iterate(Args))]
ArgsIterate := struct {
    Iter := std.iter.Iter(&[u8]);
    iter := (self: Args) -> Iter {
        for i in 0..self.len() {
            match self.get(i) {
                .some(arg) => yield arg,
                .none => {},
            }
        }
    };
};

/// A byte stream the system holds open: standard output, a file, a socket.
Stream := struct {
    _fd: i32,

    /// The stream the system knows as `number`, which must be open for as long as the stream is used.
    of := unsafe (number: i32) -> Stream { .{ ._fd = number } };
    /// The number the system knows it by.
    fd := (self: &Stream) -> i32 { self._fd };
};

#[impl(std.fmt.Writer(Stream))]
StreamWriter := struct {
    Error := std.os.Error;
    closed: std.os.Error = .closed;
    /// Writes some of `bytes`, returning how many.
    write := (self: &mut Stream, bytes: &[u8]) -> Result(usize, std.os.Error) {
        std.os.write(self.fd(), bytes)
    };
};

/// A program's `main`, which a runtime calls with the one `System`.
Main := (&mut System) -> Exit;

/// A hosted runtime: the system and ABI of the targets it serves, and the function making a
/// program's exports from its `main` (spec 08, section 2).
Runtime := struct {
    os: lang.meta.Name,
    abi: lang.meta.Name,
    start: ($main: Main) -> type,
};

/// The runtimes of the systems `std` knows, each declared by its system's namespace.
runtimes := [std.os.linux.runtime, std.os.macos.runtime, std.os.wasi.runtime];

/// The runtime of the targets of `target`'s system and ABI.
runtime := ($target: lang.target.Spec) -> Runtime {
    $for row in runtimes {
        if row.os == target.os and row.abi == target.abi { return row; }
    }
    lang.panic.fail(.message("std knows no runtime for this target's system and ABI"))
};

/// The runtime of the target being built for: `start := std.os.start(main)`.
start := runtime(lang.target.current).start;
