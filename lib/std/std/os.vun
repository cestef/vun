//! Hosted runtimes and the `System` capability (spec 08, section 2). A hosted program is
//! `start := std.os.start(main)`; the runtime makes the one `System` and passes it to `main`.

/// How the program ends: `ok`, or a status for the process that started it.
Exit := enum { ok, code(u8) };

/// Why a request to the system failed: the error number it reported.
Error := struct { number: i32 };

/// The streams every process starts with, by their numbers.
stdout_fd := 1;
stderr_fd := 2;

/// Access to the operating system: files, sockets, threads, clocks, the environment.
System := struct {
    _args: Args,

    /// The process's system, started with `args`. Only a runtime claims it, once, before `main`.
    claim := unsafe (given: Args) -> System { .{ ._args = given } };
    /// The arguments the process was started with.
    args := (self: &System) -> Args { self._args };
    stdout := (self: &mut System) -> Stream { unsafe Stream.of(stdout_fd) };
    stderr := (self: &mut System) -> Stream { unsafe Stream.of(stderr_fd) };
};

/// The arguments a process was started with, its program's name first where the system passes
/// one: each the bytes the system passed, without the zero that ends it there.
Args := struct {
    _count: usize,
    _values: *(*u8),

    /// The `count` arguments at `values`, each ending with a zero byte, as C's `main` receives
    /// them; they must stay unchanged for as long as the arguments are read.
    of := unsafe (count: usize, values: *(*u8)) -> Args { .{ ._count = count, ._values = values } };
    /// How many arguments there are.
    len := (self: &Args) -> usize { self._count };
    /// The argument at `i`; `.none` past the last.
    get := (self: &Args, i: usize) -> ?&[u8] {
        if i >= self._count { return .none; }
        first := unsafe self._values.offset(i.to(isize)).read();
        mut n: usize = 0;
        for unsafe first.offset(n.to(isize)).read() != 0 { n += 1; }
        .some(unsafe lang.mem.items_at(u8, first, n))
    };
};

/// Each argument in order: `for arg in sys.args()`.
#[impl(lang.ops.Iterate(Args))]
ArgsIterate := struct {
    Iter := std.iter.Iter(&[u8]);
    iter := (self: Args) -> Iter {
        for i in 0..self.len() {
            match self.get(i) {
                .some(arg) => yield arg,
                .none => {},
            }
        }
    };
};

/// A byte stream the system holds open: standard output, a file, a socket.
Stream := struct {
    _fd: i32,

    /// The stream the system knows as `number`, which must be open for as long as the stream is used.
    of := unsafe (number: i32) -> Stream { .{ ._fd = number } };
    /// The number the system knows it by.
    fd := (self: &Stream) -> i32 { self._fd };
};

#[impl(std.fmt.Writer(Stream))]
StreamWriter := struct {
    Error := std.os.Error;
    /// Writes some of `bytes`, returning how many.
    write := (self: &mut Stream, bytes: &[u8]) -> Result(usize, std.os.Error) {
        written := unsafe std.os.libc.write(self.fd(), lang.mem.items_pointer(u8, bytes), bytes.len());
        if written < 0 {
            .err(.{ .number = unsafe std.os.libc.errno_location().read() })
        } else {
            .ok(written.to(usize))
        }
    };
};

/// The hosted runtime: the C library's.
start := std.os.libc.start;
