//! Asynchronous tasks and executors (spec 06).

/// A request yielded to the executor: resume the task when the event fires.
Wait := struct {
    event: &Event,
};

/// Something that happens, which an executor watches: an interrupt, a timer, a device.
Event := struct { id: u32 };

Async := ($R: type) -> lang.Interface { lang.Coroutine(Wait, R) };
