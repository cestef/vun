//! Reflection and code generation helpers over `lang.meta` (spec 03), including
//! `collect(package, attr)`, which gathers declarations carrying an attribute (decision 42).

..lang.meta.{ Field, Frame, TypeOf, align, embed, fields, name_of, same, size };

/// What a code value tells of itself (spec 03, section 4). A code value is passed by borrow:
/// a parameter of type `Code(T)` itself would receive its argument as code.
Quoted := interface(($Self: type) -> type { struct {
    /// The source text of the code, as written.
    source: (c: &Self) -> &[u8] = _;
    /// Where the code is written.
    span: (c: &Self) -> lang.meta.Origin = _;
    /// Where the bytes `bytes` of the string literal the code writes are written, inside it.
    within: (c: &Self, $bytes: lang.Range) -> lang.meta.Origin = _;
} });

impl Quoted for lang.meta.Code($T) {
    source := (c) -> &[u8] { lang.meta.source(T, c) };
    span := (c) -> lang.meta.Origin { lang.meta.span(T, c) };
    within := (c, $bytes: lang.Range) -> lang.meta.Origin { lang.meta.within(T, c, bytes) };
}

/// The name of the variant of its type `T` that `v` is, as declared.
variant_name := ($T: type, v: &T) -> &[u8] {
    at := lang.meta.variant(T, v);
    $for each in lang.meta.variants(T) {
        if at == each.index { return each.name; }
    }
    ""
};

/// The values of the attributes written on `d`, a field or a variant as reflection gives it
/// (`lang.meta.Field`, `lang.meta.Variant`): plain data, each with its type, known at compile
/// time only.
attrs := ($D: type, $d: D) -> &[lang.meta.Any] { d.attrs };

/// The first attribute written on `d` that is an `A`, as `#[Rename{ .to = "key" }]`.
attr := ($D: type, $d: D, $A: type) -> ?A {
    $for a in d.attrs {
        $if .some(v) = lang.meta.value(A, a) { return .some(v); }
    }
    .none
};

/// Whether an attribute written on `d` is `A`: the type itself, a marker such as `#[test]`, or a
/// value of it.
has := ($D: type, $d: D, $A: type) -> bool {
    $for a in d.attrs {
        $if .some(t) = lang.meta.value(type, a) {
            $if same(type, t, A) { return true; }
        }
        $if .some(_) = lang.meta.value(A, a) { return true; }
    }
    false
};

/// A member `collect` finds: the namespace declaring it and its descriptor. Its value is
/// `c.ns.$(c.decl.name)`.
Collected := struct { ns: lang.meta.Namespace, decl: lang.meta.Decl };

/// The members of `ns` and of the namespaces nested in it on which an attribute is `A` (`has`),
/// in the order they are declared: what a test runner or a command table gathers (spec 03,
/// section 6). Nothing is evaluated but their attributes, and only when it is called. It sees
/// what `std` sees: the public members of another package.
collect := ($ns: lang.meta.Namespace, $A: type) -> &[Collected] {
    mut found: &static [Collected] = &[];
    $for d in lang.meta.decls(ns) {
        $if .some(inner) = d.nested {
            found = lang.meta.concat(Collected, found, collect(inner, A));
        } else {
            $if has(d, A) { found = lang.meta.append(Collected, found, .{ .ns = ns, .decl = d }); }
        }
    }
    found
};
