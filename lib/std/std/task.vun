//! Asynchronous tasks and executors (spec 06). A task yields `Wait` requests; the executor, not
//! the task, owns wakeups. Executors are library code over frames: `run` for bare metal,
//! `block_on` for one task on a hosted system, `select` inside a task.

/// Something that happens, which an executor watches: an interrupt, a timer, a device. Firing it,
/// from an interrupt handler too, marks it until a task waiting on it takes the mark; executors
/// only look at it.
Event := struct {
    _fired: std.sync.Atomic(bool),

    init := () -> Event { .{ ._fired = std.sync.Atomic(bool).init(false) } };
    #[panic.never]
    fire := (self: &Event) { self._fired.store(true, .release); };
    /// Whether it fired since the mark was last taken, leaving the mark.
    #[panic.never]
    fired := (self: &Event) -> bool { self._fired.load(.acquire) };
    /// Whether it fired since the mark was last taken, taking it.
    #[panic.never]
    take := (self: &Event) -> bool { self._fired.swap(false, .acquire) };
    /// Waits until it fires, and takes the mark: resumed before then, it finds no mark and yields
    /// again, so a task may be resumed whenever an executor likes.
    wait := (self: &Event) -> Async(()) {
        for !self.take() { yield .on(self); }
    };
};

/// A request yielded to the executor: resume the task once an event fires. Waiting on either of
/// two tasks joins their waits, in the frames of the tasks waiting, and allocates nothing.
Wait := enum { on(&Event), either(&Wait, &Wait) };

#[impl(Wait)]
wait_ready := struct {
    /// Whether an event the wait names fired. The marks stay for the tasks to take.
    ready := (self: &Wait) -> bool {
        match self {
            .on(event) => event.fired(),
            .either(a, b) => a.ready() or b.ready(),
        }
    };
};

Async := ($R: type) -> lang.Interface { lang.Coroutine(Wait, R) };

/// Waits for the next event: sleeps the core until an interrupt, or parks a hosted thread. A
/// typed link symbol the runtime exports (spec 08, section 1).
symbols := struct {
    sleep := "vun_task_sleep";
};
#[link.symbol(symbols.sleep)]
sleep: () -> () = _;

/// Which of two tasks finished first, with its result.
Either := ($A: type, $B: type) -> type { enum { first(A), second(B) } };

/// Runs two tasks until one finishes, and gives its result; both stay for the caller to end. It is
/// resumed once either task's wait is ready and resumes both, the other finding no mark.
select := ($A: type, $B: type, $F: Async(A), $G: Async(B), tasks: (&mut F, &mut G)) -> Async(Either(A, B)) {
    for {
        first := match tasks.0.resume() {
            .done(result) => break .first(result),
            .yielded(wait) => wait,
        };
        second := match tasks.1.resume() {
            .done(result) => break .second(result),
            .yielded(wait) => wait,
        };
        yield .either(&first, &second);
    }
};

/// Runs `tasks`, borrows of tasks that never finish, forever: each resumes when an event it waits
/// on fires, and between rounds the core sleeps until an interrupt.
run := ($T: type, tasks: T) -> never {
    mut waits: [lang.meta.items(T).len()]?Wait = [.none; lang.meta.items(T).len()];
    for {
        $for i in 0..lang.meta.items(T).len() {
            ready := match waits[i] {
                .some(wait) => wait.ready(),
                .none => true,
            };
            if ready {
                match tasks.$(i).resume() {
                    .yielded(wait) => { waits[i] = .some(wait); },
                    .done(never) => never,
                }
            }
        }
        sleep();
    }
};

/// Runs one task to its end on a hosted system, sleeping while it waits.
block_on := ($R: type, $F: Async(R), task: &mut F) -> R {
    for {
        match task.resume() {
            .done(result) => break result,
            .yielded(wait) => { for !wait.ready() { sleep(); } },
        }
    }
};
