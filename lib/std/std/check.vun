//! Shadow memory for the checks of unsafe code at run time (spec 07, section 7; spec 13,
//! section 8.7): one byte for each `granule` bytes of the address space, 0 where all of them
//! may be accessed, `k` where the first `k` may, and a negative code saying why where none may.
//! The shadow of each span of `1 << span_bits` addresses is reserved the first time memory in
//! it is described, so it follows the program's memory wherever the system puts it. A runtime
//! gives how memory is mapped (`mapped`) and exports the operations of `lang.check` over the
//! state (`exports`). The state is read and written by atomic accesses, which no check rewrites.

/// The bytes of memory one shadow byte describes.
granule := lang.check.granule;

/// Why memory is poisoned, as its shadow bytes code it.
code := (why: lang.check.Violation) -> i8 {
    match why {
        .freed => -2,
        .returned => -3,
        _ => -1,
    }
};

/// What the shadow byte `b` of memory not all accessible says of it.
violation := (b: i8) -> lang.check.Violation {
    if b == -2 { .freed } else if b == -3 { .returned } else { .outside }
};

/// How many addresses the shadow of one span describes: its shadow, reserved at once and
/// backed only where touched, is an eighth of that, and the directory a word per span.
span := 1 << 32;
/// The shadow bytes of a span.
span_shadow: usize = span / granule;
/// The spans of the address space, a word of the directory for each.
spans: usize = (lang.target.usize_max / span + 1).to(usize);

/// The shadow: a directory holding where the shadow of each span is, 0 until memory in the span
/// is described, and how the runtime maps and gives back memory.
Shadow := struct {
    _directory: std.check.words.Words,
    _map: (bytes: usize) -> usize,
    _unmap: (address: usize, bytes: usize) -> (),

    of := unsafe (
        directory: std.check.words.Words,
        map: (bytes: usize) -> usize,
        unmap: (address: usize, bytes: usize) -> ()
    )
        -> Shadow
        {
            .{ ._directory = directory, ._map = map, ._unmap = unmap }
        };

    /// Where the shadow of the span holding `address` is, 0 where none is yet.
    _span := (self: Shadow, address: usize) -> usize { self._directory.get(address / span) };

    /// The shadow byte of the granule holding `address` in the shadow of its span at `at`.
    _byte := (at: usize, address: usize) -> *i8 {
        unsafe lang.mem.pointer_at(i8, (at + address % span / granule).sat(usize))
    };

    /// The shadow byte of `address`: 0, all accessible, where its span has no shadow yet.
    _get := (self: Shadow, address: usize) -> i8 {
        at := self._span(address);
        if at == 0 { 0 } else { unsafe lang.mem.atomic_load(i8, Shadow._byte(at, address), .relaxed) }
    };

    /// Sets the shadow byte of `address` to `b`, reserving the shadow of its span first where it
    /// has none; a thread losing the race to reserve it gives its own back.
    _set := (self: Shadow, address: usize, b: i8) {
        mut at := self._span(address);
        if at == 0 {
            fresh := (self._map)(span_shadow);
            at = self._directory.settle(address / span, fresh);
            if at == 0 {
                at = fresh;
            } else {
                (self._unmap)(fresh, span_shadow);
            }
        }
        unsafe lang.mem.atomic_store(i8, Shadow._byte(at, address), b, .relaxed)
    };

    /// Why the `bytes` at `address` may not be accessed, if they may not.
    access := (self: Shadow, address: usize, bytes: usize) -> ?lang.check.Violation {
        mut start: usize = address / granule * granule;
        end := (address + bytes).sat(usize);
        for start < end {
            b := self._get(start);
            // The bytes of this granule the access reaches, from its start.
            left := end - start;
            reached := if left < granule { left.sat(i8) } else { granule };
            if b < 0 or (b > 0 and reached > b) {
                return .some(violation(b));
            }
            start = (start + granule).sat(usize);
        }
        .none
    };

    /// Marks the granules the `bytes` at `address` cover whole as poisoned for `why`.
    poison := (self: Shadow, address: usize, bytes: usize, why: lang.check.Violation) {
        mut start: usize = ((address + granule - 1) / granule * granule).sat(usize);
        for start + granule <= address + bytes {
            self._set(start, code(why));
            start = (start + granule).sat(usize);
        }
    };

    /// Marks the `bytes` at `address` as accessible, the last granule as far as they reach.
    unpoison := (self: Shadow, address: usize, bytes: usize) {
        mut start: usize = address / granule * granule;
        end := (address + bytes).sat(usize);
        for start < end {
            left := end - start;
            self._set(start, if left >= granule { 0 } else { left.sat(i8) });
            start = (start + granule).sat(usize);
        }
    };

    /// Whether the granule holding `address` is poisoned as given back.
    given_back := (self: Shadow, address: usize) -> bool { self._get(address) == code(.freed) };
};

/// What the checks keep at run time: the shadow, and in words a runtime gives past it, a lock,
/// what allocators have handed out and the quarantine.
State := struct {
    shadow: Shadow,
    _words: std.check.words.Words,

    /// The words a state takes past its shadow.
    words := 1 + std.check.table.words + std.check.quarantine.words;

    of := (shadow: Shadow, at: std.check.words.Words) -> State { .{ .shadow = shadow, ._words = at } };

    _table := (self: State) -> std.check.table.Table { std.check.table.Table.of(self._words.from(1)) };

    _quarantine := (self: State) -> std.check.quarantine.Quarantine {
        std.check.quarantine.Quarantine.of(self._words.from(1 + std.check.table.words))
    };

    /// Records the `bytes` handed out at `address` and marks them accessible.
    allocated := (self: State, address: usize, bytes: usize) {
        self._words.lock(0);
        self._table().insert(address, bytes);
        self._words.unlock(0);
        self.shadow.unpoison(address, bytes);
    };

    /// Records the `bytes` at `address` given back and poisons them, unless they were given back
    /// already, never handed out, or handed out with another size.
    freed := (self: State, address: usize, bytes: usize) -> ?lang.check.Violation {
        self._words.lock(0);
        given := self._table().remove(address);
        self._words.unlock(0);
        match given {
            .none => .some(if self.shadow.given_back(address) { .double_free } else { .foreign_free }),
            .some(b) => {
                if b != bytes { return .some(.size_mismatch); }
                self.shadow.poison(address, bytes, .freed);
                .none
            },
        }
    };

    hold := (self: State, held: lang.check.Held) -> ?lang.check.Held {
        self._words.lock(0);
        back := self._quarantine().hold(held);
        self._words.unlock(0);
        back
    };

    evict := (self: State, allocator: usize) -> ?lang.check.Held {
        self._words.lock(0);
        back := self._quarantine().evict(allocator);
        self._words.unlock(0);
        back
    };
};

/// The bytes a runtime that maps memory maps for the state: the shadow's directory, then the
/// words past it.
hosted_bytes: usize = ((spans + State.words) * lang.meta.size(usize)).to(usize);
/// Where the state `mapped` gives is, 0 until a check first needs it.
mapped_at: std.sync.Atomic(usize) = .init(0);

/// The state of a hosted program in memory `map` reserves, backed only where touched, mapped the
/// first time a check needs it; a thread losing the race to map it gives its own back to `unmap`.
mapped := ($map: (bytes: usize) -> usize, $unmap: (address: usize, bytes: usize)) -> State {
    mut base := mapped_at.load(.acquire);
    if base == 0 {
        fresh := map(hosted_bytes);
        base = mapped_at.compare_swap(0, fresh, .acq_rel);
        if base == 0 {
            base = fresh;
        } else {
            unmap(fresh, hosted_bytes);
        }
    }
    directory := unsafe std.check.words.Words.of(lang.mem.pointer_at(usize, base));
    shadow := unsafe Shadow.of(directory, map, unmap);
    State.of(shadow, directory.from(spans))
};

/// `alloc` of the allocator `A`, checked (`#[lang.check.by(.allocations, alloc)]` on the
/// requirement): the bytes it hands out are recorded.
alloc := ($A: type, self: &mut A, size: usize, align: usize, $at: lang.meta.Origin)
    -> Result(*u8, std.mem.alloc.Allocator(A).Error)
    {
        given := self.alloc(size, align)?;
        lang.check.allocated(given.address(), size);
        .ok(given)
    };

/// `free` of the allocator `A`, checked: bytes given back twice, never handed out or with another
/// size fail the check made at `at`; others are poisoned and held in the quarantine, so an access
/// through a pointer kept to them fails its own. The allocator is given back what it has there
/// once the quarantine is past its bound.
free := ($A: type, self: &mut A, p: *u8, size: usize, align: usize, $at: lang.meta.Origin) {
    match lang.check.freed(p.address(), size) {
        .some(why) => lang.check.failed(at, why, p.address()),
        .none => {},
    }
    allocator := lang.mem.pointer_to(A, self).address();
    held: lang.check.Held = .{ .address = p.address(), .bytes = size, .align = align, .allocator = allocator };
    match lang.check.hold(&held) {
        .some(back) => self.free(p, back.bytes, back.align),
        .none => {},
    }
    for {
        match lang.check.evict(allocator) {
            .some(back) => self.free(unsafe lang.mem.pointer_at(u8, back.address), back.bytes, back.align),
            .none => break,
        }
    }
};

/// The exports of a runtime whose state `state` gives, and which ends the program with `status`
/// when a check fails.
exports := ($state: () -> State, $end: (status: std.os.Status) -> lang.never) -> type { struct {
    #[link.export(lang.check.symbols.access)]
    access := (address: usize, bytes: usize, how: lang.check.Access) -> ?lang.check.Violation {
        state().shadow.access(address, bytes)
    };

    #[link.export(lang.check.symbols.poison)]
    poison := (address: usize, bytes: usize, why: lang.check.Violation) {
        state().shadow.poison(address, bytes, why)
    };

    #[link.export(lang.check.symbols.unpoison)]
    unpoison := (address: usize, bytes: usize) { state().shadow.unpoison(address, bytes) };

    #[link.export(lang.check.symbols.allocated)]
    allocated := (address: usize, bytes: usize) { state().allocated(address, bytes) };

    #[link.export(lang.check.symbols.freed)]
    freed := (address: usize, bytes: usize) -> ?lang.check.Violation { state().freed(address, bytes) };

    #[link.export(lang.check.symbols.hold)]
    hold := (held: &lang.check.Held) -> ?lang.check.Held { state().hold(held.*) };

    #[link.export(lang.check.symbols.evict)]
    evict := (allocator: usize) -> ?lang.check.Held { state().evict(allocator) };

    #[link.export(lang.check.symbols.fail)]
    fail := (f: &lang.check.Failure) -> lang.never {
        std.trace.report((f: &lang.check.Failure) -> lang.never, fail, f.site, .failed(f.violation));
        end(std.os.trapped)
    };

    #[link.export(lang.check.symbols.asm_write), abi.c]
    asm_write := (address: usize, bytes: usize, site: u32) {
        match state().shadow.access(address, bytes) {
            .some(found) => {
                std.trace.report(
                    #[abi.c]
                    (address: usize, bytes: usize, site: u32) -> (),
                    asm_write,
                    site,
                    .failed(found)
                );
                end(std.os.trapped)
            },
            .none => {},
        }
    };

    #[link.export(lang.check.symbols.asm_stack), abi.c]
    asm_stack := (site: u32, before: usize, after: usize) -> lang.never {
        std.trace.report(
            #[abi.c]
            (site: u32, before: usize, after: usize) -> lang.never,
            asm_stack,
            site,
            .failed(.stack_moved)
        );
        end(std.os.trapped)
    };
} };
