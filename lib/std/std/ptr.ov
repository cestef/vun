//! Raw pointers (spec 05, section 5): methods of every `*T` over the primitives of `lang.mem`.
//! Creating a pointer and reading its address are safe; the rest is `unsafe` to call, and each
//! body vouches for the primitive it calls.

#[impl(lang.mem.Ptr)]
PtrMethods := ($T: type) -> type { struct {
    address := (p: *T) -> usize { lang.mem.address(T, p) };
    offset := unsafe (p: *T, n: isize) -> *T { unsafe lang.mem.offset(T, p, n) };
    cast := unsafe (p: *T, $U: type) -> *U { unsafe lang.mem.cast(T, U, p) };
    read := unsafe (p: *T) -> T { unsafe lang.mem.read(T, p) };
    write := unsafe (p: *T, value: T) { unsafe lang.mem.write(T, p, value) };
} };

/// A pointer to what `r` borrows.
to := ($T: type, r: &T) -> *T { lang.mem.pointer_to(T, r) };
