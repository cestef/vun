//! UTF-8 (decision 43): text is bytes, and these read and write the code points in them. A code
//! point is a `u32`.

/// The code point read where the bytes are not UTF-8: U+FFFD.
replacement: u32 = 0xFFFD;
/// The largest code point.
max: u32 = 0x10FFFF;
/// The first and last surrogates, which are no code points of text.
surrogate_first: u32 = 0xD800;
surrogate_last: u32 = 0xDFFF;
/// The bits that tell a byte in the middle of a sequence, and those it holds of the code point.
continuation_mask: u8 = 0xC0;
continuation_tag: u8 = 0x80;
continuation_bits: u8 = 0x3F;
/// The bits each byte of a sequence holds of the code point.
bits_per_byte := 6;

/// The bits of `byte` that `mask` keeps, as a code point's first bits.
low_bits := (byte: u8, mask: u8) -> u32 { (byte & mask).to(u32) };

/// The byte holding the bits of `cp` from `shift` up under the bits `tag`, a sequence's first.
byte_of := (cp: u32, shift: u32, tag: u32) -> u8 { (tag | (cp >> shift)).wrap(u8) };

/// The byte holding six bits of `cp` from `shift`, as a sequence continues.
tail_of := (cp: u32, shift: u32) -> u8 {
    (continuation_tag.to(u32) | ((cp >> shift) & continuation_bits.to(u32))).wrap(u8)
};

/// Whether `byte` is one in the middle of a sequence.
continues := (byte: u8) -> bool { (byte & continuation_mask) == continuation_tag };

/// Whether `cp` is written in UTF-8: a code point up to `max`, and no surrogate.
is_scalar := (cp: u32) -> bool { cp <= max and (cp < surrogate_first or cp > surrogate_last) };

/// The code point `text` starts with and how many bytes it takes; none for an empty text, and
/// for bytes that are not UTF-8: a sequence cut short, a byte that cannot start one or continue
/// one, a code point written longer than it needs, a surrogate, or one past `max`.
decode := (text: &[u8]) -> Option((u32, usize)) {
    if text.len() == 0 { return .none; }
    lead := text[0];
    if lead < 0x80 { return .some((lead.to(u32), 1)); }
    // The bytes of the sequence, the bits its first byte holds, and the least code point that
    // needs that many bytes.
    parts: (usize, u32, u32) = if lead >= 0xC2 and lead <= 0xDF {
        (2, low_bits(lead, 0x1F), 0x80)
    } else if lead >= 0xE0 and lead <= 0xEF {
        (3, low_bits(lead, 0x0F), 0x800)
    } else if lead >= 0xF0 and lead <= 0xF4 {
        (4, low_bits(lead, 0x07), 0x10000)
    } else {
        return .none;
    };
    (len, first, least) := parts;
    if text.len() < len { return .none; }
    mut cp: u32 = first;
    for i in 1..len {
        b := text[i];
        if !continues(b) { return .none; }
        cp = ((cp << bits_per_byte) | low_bits(b, continuation_bits)).wrap(u32);
    }
    if cp < least or !is_scalar(cp) { return .none; }
    .some((cp, len))
};

/// Whether every byte of `text` is part of UTF-8.
is_valid := (text: &[u8]) -> bool {
    mut rest: &[u8] = text;
    for rest.len() > 0 {
        match decode(rest) {
            .some((_, len)) => { rest = rest[len..]; },
            .none => return false,
        }
    }
    true
};

/// The code points of `text`, `replacement` for each byte that is not part of UTF-8.
chars := (text: &[u8]) -> std.iter.Iter(u32) {
    mut rest: &[u8] = text;
    for rest.len() > 0 {
        match decode(rest) {
            .some((cp, len)) => {
                yield cp;
                rest = rest[len..];
            },
            .none => {
                yield replacement;
                rest = rest[1..];
            },
        }
    }
};

/// The bytes a code point is written as.
Encoded := struct {
    _bytes: [4]u8,
    _len: usize,

    /// `cp` in UTF-8; `replacement` where it is a surrogate or past `max`.
    of := (cp: u32) -> Encoded {
        if !is_scalar(cp) { return Encoded.of(replacement); }
        if cp < 0x80 {
            .{ ._bytes = [cp.wrap(u8), 0, 0, 0], ._len = 1 }
        } else if cp < 0x800 {
            .{ ._bytes = [byte_of(cp, 6, 0xC0), tail_of(cp, 0), 0, 0], ._len = 2 }
        } else if cp < 0x10000 {
            .{ ._bytes = [byte_of(cp, 12, 0xE0), tail_of(cp, 6), tail_of(cp, 0), 0], ._len = 3 }
        } else {
            .{ ._bytes = [byte_of(cp, 18, 0xF0), tail_of(cp, 12), tail_of(cp, 6), tail_of(cp, 0)], ._len = 4 }
        }
    };

    /// The bytes.
    text := (self: &Encoded) -> &[u8] { &self._bytes[0..self._len] };
};

/// Writes `cp` to `w` in UTF-8.
write := ($W: std.fmt.Writer, w: &mut W, cp: u32) -> Result((), W.Error) {
    encoded := Encoded.of(cp);
    w.write_all(encoded.text())
};
