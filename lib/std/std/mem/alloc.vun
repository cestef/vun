//! Allocators are capabilities (spec 07, section 1).

..std.mem.{ Own };

Allocator := lang.interface(($Self: type) -> type { struct {
    Error: type = _;
    #[lang.check.by(.allocations, std.check.alloc)]
    alloc: (self: &mut Self, size: usize, align: usize) -> Result(*u8, Error) = _;
    #[lang.check.by(.allocations, std.check.free)]
    free: (self: &mut Self, p: *u8, size: usize, align: usize) = _;
} });

/// Why an allocation failed.
Error := enum { exhausted };

/// An allocator handing out the bytes of one buffer in order, freeing nothing until it is
/// dropped as a whole.
Fixed := struct {
    _storage: &mut [u8],
    _used: usize,

    /// An allocator over `storage`, which it borrows for as long as it lives.
    init := (storage: &mut [u8]) -> Fixed { .{ ._storage = storage, ._used = 0 } };

    /// The next `size` bytes aligned to `align`, a power of two: what its `Allocator` impl's
    /// `alloc` gives.
    take := (self: &mut Fixed, size: usize, align: usize) -> Result(*u8, Error) {
        at := lang.mem.items_pointer(u8, &self._storage.*);
        base := at.address();
        free := (base + self._used).sat(usize);
        aligned := ((free + align - 1).sat(usize) / align * align).sat(usize);
        start := (aligned - base).sat(usize);
        if start + size > self._storage.len() { return .err(.exhausted); }
        self._used = (start + size).sat(usize);
        .ok(unsafe at.offset(start.sat(isize)))
    };

    /// A place for a `T`, `uninit`, owned by the caller.
    create := (self: &mut Fixed, $T: type) -> Result(Own(T), Error) {
        p := self.take(lang.meta.size(T), lang.meta.align(T))?;
        .ok(unsafe Own(T).from_raw(p.cast(T)))
    };

    /// Gives `o` back; a fixed allocator reuses nothing, so this only ends the ownership.
    destroy := (self: &mut Fixed, $T: type, o: Own(T)) { o.into_raw(); };
};

#[impl(Allocator(Fixed))]
fixed_allocator := struct {
    Error := std.mem.alloc.Error;
    /// `size` bytes aligned to `align`, from what the buffer has left.
    alloc := (self: &mut Fixed, size: usize, align: usize) -> Result(*u8, std.mem.alloc.Error) {
        self.take(size, align)
    };
    /// Nothing: a fixed allocator reuses no bytes until it is dropped as a whole.
    free := (self: &mut Fixed, p: *u8, size: usize, align: usize) {};
};
