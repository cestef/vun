//! Memory: allocators, owning pointers, copying, and `Arena`, which hands out `&mut T` tied to
//! the arena borrow so that trees are ordinary scoped values (decision 40, spec 05, section 4).

/// An owning pointer (spec 05, section 5): linear, free, and read through with `.*` and `.`.
/// Freeing it needs the allocator it came from.
Own := ($T: type) -> type { #[kind.linear] #[kind.free] struct {
    #[kind.owns] _ptr: *T,

    /// Ownership of what `p` points to, which nothing else may hold or free.
    from_raw := unsafe (p: *T) -> Own(T) { .{ ._ptr = p } };
    /// The pointer, giving ownership up: freeing what it points to is the caller's.
    into_raw := (o: Own(T)) -> *T {
        .{ ._ptr = p } := o;
        p
    };
} };

/// Reading and writing a `lang.mem.Cell`, `unsafe` both: nothing keeps a reader holding a shared
/// borrow of the cell from seeing its value change (spec 07, section 2).
#[impl(lang.mem.Cell)]
cell_methods := ($T: type) -> type { struct {
    /// What the cell holds.
    get := unsafe (c: &lang.mem.Cell(T)) -> T { unsafe lang.mem.cell_pointer(T, c).read() };
    /// Makes the cell hold `value`.
    set := unsafe (c: &lang.mem.Cell(T), value: T) { unsafe lang.mem.cell_pointer(T, c).write(value); };
} };
