//! Time as the system keeps it (spec 08, section 2): spans of time, and readings of the clocks a
//! hosted program reaches through its `std.os.System`.

nanos_per_micro := 1_000;
nanos_per_milli := 1_000_000;
nanos_per_second := 1_000_000_000;

/// A span of time, to the nanosecond.
Duration := struct {
    _nanos: u64,

    nanos := (n: u64) -> Duration { .{ ._nanos = n } };
    micros := (n: u64) -> Duration { .{ ._nanos = (n * nanos_per_micro).to(u64) } };
    millis := (n: u64) -> Duration { .{ ._nanos = (n * nanos_per_milli).to(u64) } };
    seconds := (n: u64) -> Duration { .{ ._nanos = (n * nanos_per_second).to(u64) } };

    /// Its length in nanoseconds.
    as_nanos := (self: &Duration) -> u64 { self._nanos };
    /// Its length in whole milliseconds.
    as_millis := (self: &Duration) -> u64 { self._nanos / nanos_per_milli };
    /// Its length in whole microseconds.
    as_micros := (self: &Duration) -> u64 { self._nanos / nanos_per_micro };
    /// Whether it is no time at all.
    is_zero := (self: &Duration) -> bool { self._nanos == 0 };
    /// The span of both, none where it passes what the type holds.
    checked_add := (self: &Duration, other: Duration) -> ?Duration {
        match (self._nanos + other._nanos).try_to(u64) {
            .some(n) => .some(.{ ._nanos = n }),
            .none => .none,
        }
    };
    /// This span less `other`, none for a longer one.
    checked_sub := (self: &Duration, other: Duration) -> ?Duration {
        if other._nanos > self._nanos { .none } else {
            .some(.{ ._nanos = (self._nanos - other._nanos).to(u64) })
        }
    };
    /// This span less `other`, no time at all for a longer one.
    saturating_sub := (self: &Duration, other: Duration) -> Duration {
        .{ ._nanos = if other._nanos > self._nanos { 0 } else { (self._nanos - other._nanos).to(u64) } }
    };
    /// Its whole seconds.
    whole_seconds := (self: &Duration) -> u64 { self._nanos / nanos_per_second };
    /// The nanoseconds past its whole seconds.
    subsec_nanos := (self: &Duration) -> u64 { self._nanos % nanos_per_second };
};

/// A clock the system keeps.
Clock := enum {
    /// Never goes back; its readings are measured from an instant the system chose, such as
    /// when it booted, and mean nothing across processes.
    monotonic,
    /// The time of day, since 1970-01-01 00:00 UTC; it moves when the system's time is set.
    real,
};

/// A reading of a clock: nanoseconds since the clock's start.
Instant := struct {
    _nanos: u64,

    /// The reading `n` nanoseconds after the clock's start.
    at := (n: u64) -> Instant { .{ ._nanos = n } };
    /// Nanoseconds since the clock's start.
    as_nanos := (self: &Instant) -> u64 { self._nanos };
    /// The time from `earlier`, a reading of the same clock, to this one.
    since := (self: &Instant, earlier: &Instant) -> Duration {
        Duration.nanos((self._nanos - earlier._nanos).to(u64))
    };
};

/// The monotonic clock read at a start, to tell how long it has been since. A system that gives
/// no clock tells nothing.
Stopwatch := struct {
    _started: ?Instant,

    /// A stopwatch started now.
    start := () -> Stopwatch { .{ ._started = std.os.now(.monotonic).ok() } };

    /// The time since it started, none where the system gave no clock.
    elapsed := (self: &Stopwatch) -> ?Duration {
        match self._started {
            .some(started) => match std.os.now(.monotonic) {
                .ok(now) => .some(now.since(&started)),
                .err(_) => .none,
            },
            .none => .none,
        }
    };

    /// The nanoseconds since it started, none where the system gave no clock.
    elapsed_nanos := (self: &Stopwatch) -> ?u64 {
        match self.elapsed() {
            .some(span) => .some(span.as_nanos()),
            .none => .none,
        }
    };
};

impl std.fmt.Format for Duration {
    /// In the largest unit it reaches with two decimals, as integers: `1.50s`, `2.00ms`, `850ns`.
    format := ($W: std.fmt.Writer, value, w) {
        n := value.as_nanos();
        if n >= nanos_per_second {
            std.fmt.print(w, "{}.{:0>2}s", n / nanos_per_second, (n % nanos_per_second) / 10_000_000)
        } else if n >= nanos_per_milli {
            std.fmt.print(w, "{}.{:0>2}ms", n / nanos_per_milli, (n % nanos_per_milli) / 10_000)
        } else if n >= nanos_per_micro {
            std.fmt.print(w, "{}.{:0>2}us", n / nanos_per_micro, (n % nanos_per_micro) / 10)
        } else {
            std.fmt.print(w, "{}ns", n)
        }
    };
}
