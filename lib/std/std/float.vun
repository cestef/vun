//! Float methods (spec 04, section 2): conversions, an impl for every float type over the
//! primitives of `lang.float`.

impl lang.Float($bits) {
    /// The float of type `T` nearest the value, ties to even; a NaN gives the canonical NaN.
    #[panic.never]
    nearest := (x: lang.Float(bits), $T: type) -> T { lang.float.convert(lang.Float(bits), x, T) };
    /// The value rounded toward zero and clamped to the bounds of the integer type `T`; a NaN
    /// gives 0, clamped likewise.
    #[panic.never]
    truncate := (x: lang.Float(bits), $T: type) -> T { lang.float.to_int(lang.Float(bits), x, T) };
}
