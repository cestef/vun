//! Tests of `std.net`.

shown := ($T: type, value: T) -> std.text.Slab(48) {
    mut slab := std.text.Slab(48).empty();
    std.fmt.print(&mut slab, "{}", value).expect("room");
    slab
};

#[test]
ipv4_addresses_are_read_and_written_in_dotted_decimal := () {
    a := std.net.parse_v4("192.168.0.1").expect("an address");
    std.testing.assert(a.octets == [192, 168, 0, 1] and a.is_private() and !a.is_loopback());
    std.testing.assert(shown(std.net.Ipv4, a).bytes() == "192.168.0.1");
    std.testing.assert(a.to_u32() == 0xc0a80001);
    std.testing.assert(std.net.parse_v4("127.0.0.1").expect("an address").is_loopback());
    std.testing.assert(std.net.parse_v4("172.20.1.1").expect("an address").is_private());
    std.testing.assert(!std.net.parse_v4("172.32.1.1").expect("an address").is_private());
    std.testing.assert(std.net.parse_v4("224.0.0.1").expect("an address").is_multicast());
    std.testing.assert(std.net.parse_v4("169.254.1.1").expect("an address").is_link_local());
    std.testing.assert(std.net.parse_v4("0.0.0.0").expect("an address").is_unspecified());
};

#[test]
text_that_is_no_ipv4_address_is_refused := () {
    std.testing.assert(std.net.parse_v4("1.2.3") == Result(std.net.Ipv4, std.net.Problem).err(.malformed));
    std.testing.assert(std.net.parse_v4("1.2.3.4.5")
            == Result(std.net.Ipv4, std.net.Problem).err(.malformed));
    std.testing.assert(
        std.net.parse_v4("1.2.3.256") == Result(std.net.Ipv4, std.net.Problem).err(.out_of_range)
    );
    std.testing.assert(std.net.parse_v4("01.2.3.4") == Result(std.net.Ipv4, std.net.Problem).err(.malformed));
    std.testing.assert(std.net.parse_v4("1..3.4") == Result(std.net.Ipv4, std.net.Problem).err(.malformed));
    std.testing.assert(std.net.parse_v4("a.b.c.d") == Result(std.net.Ipv4, std.net.Problem).err(.malformed));
};

#[test]
ipv6_addresses_are_read_and_written_with_the_longest_zero_run_compressed := () {
    loopback := std.net.parse_v6("::1").expect("an address");
    std.testing.assert(loopback.is_loopback() and shown(std.net.Ipv6, loopback).bytes() == "::1");
    std.testing.assert(shown(std.net.Ipv6, std.net.parse_v6("::").expect("an address")).bytes() == "::");
    full := std.net.parse_v6("2001:0db8:0000:0000:0000:ff00:0042:8329").expect("an address");
    std.testing.assert(shown(std.net.Ipv6, full).bytes() == "2001:db8::ff00:42:8329");
    std.testing.assert(
        shown(std.net.Ipv6, std.net.parse_v6("2001:db8::ff00:42:8329").expect("an address")).bytes()
            == "2001:db8::ff00:42:8329"
    );
    // A single zero group is not compressed, and the longest run wins.
    std.testing.assert(
        shown(std.net.Ipv6, std.net.parse_v6("1:0:2:3:4:5:6:7").expect("an address")).bytes()
            == "1:0:2:3:4:5:6:7"
    );
    std.testing.assert(
        shown(std.net.Ipv6, std.net.parse_v6("1:0:0:2:0:0:0:3").expect("an address")).bytes() == "1:0:0:2::3"
    );
    std.testing.assert(std.net.parse_v6("fe80::1").expect("an address").is_link_local());
    std.testing.assert(std.net.parse_v6("ff02::1").expect("an address").is_multicast());
    std.testing.assert(std.net.parse_v6("fd12:3456::1").expect("an address").is_unique_local());
};

#[test]
text_that_is_no_ipv6_address_is_refused := () {
    std.testing.assert(std.net.parse_v6("1:2:3") == Result(std.net.Ipv6, std.net.Problem).err(.malformed));
    std.testing.assert(std.net.parse_v6("1::2::3") == Result(std.net.Ipv6, std.net.Problem).err(.malformed));
    std.testing.assert(std.net.parse_v6("12345::1") == Result(std.net.Ipv6, std.net.Problem).err(.malformed));
    std.testing.assert(
        std.net.parse_v6("1:2:3:4:5:6:7:8:9") == Result(std.net.Ipv6, std.net.Problem).err(.malformed)
    );
    std.testing.assert(std.net.parse_v6("g::1") == Result(std.net.Ipv6, std.net.Problem).err(.malformed));
};

#[test]
either_version_is_told_apart := () {
    std.testing.assert(
        std.net.parse("10.0.0.1").expect("an address") == std.net.Ip.v4(std.net.Ipv4.new(10, 0, 0, 1))
    );
    std.testing.assert(
        shown(std.net.Ip, std.net.parse("::ffff:0:1").expect("an address")).bytes() == "::ffff:0:1"
    );
};
