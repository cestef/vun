//! SplitMix64: the state steps by a constant and is mixed on the way out. Every seed is good, and
//! the same seed gives the same numbers on every target.

..std.rand.{ Rng };

SplitMix64 := struct {
    _state: u64,

    /// A generator whose numbers `seed` fixes.
    seeded := (seed: u64) -> SplitMix64 { .{ ._state = seed } };

    /// The next number.
    step := (self: &mut SplitMix64) -> u64 {
        self._state +%= 0x9E37_79B9_7F4A_7C15;
        mut z := self._state;
        z = z ^ (z >> 30);
        z *%= 0xBF58_476D_1CE4_E5B9;
        z = z ^ (z >> 27);
        z *%= 0x94D0_49BB_1331_11EB;
        z ^ (z >> 31)
    };
};

impl Rng for SplitMix64 {
    next := (self) { self.step() };
}
