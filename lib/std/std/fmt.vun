//! Formatting, with format strings read at compile time (spec 03, section 4):
//! `print(w, "{} args\n", n)` writes the text of the format string with each `{}` replaced by
//! the next argument, as its `Format` impl writes it, and each `{?}` as its `Debug` impl does.

..std.fmt.debug.{ Debug };

/// Where bytes are written (spec 02, section 3).
Writer := interface(($Self: type) -> type { struct {
    Error: type = _;
    /// The error of a writer that took none of the bytes it was given: it takes no more.
    closed: Error = _;
    /// Writes some of `bytes`, returning how many.
    write: (self: &mut Self, bytes: &[u8]) -> Result(usize, Error) = _;
    /// Writes all of `bytes`, or fails with `closed` once a write takes none of them.
    write_all := (self: &mut Self, bytes: &[u8]) -> Result((), Error) {
        mut rest := bytes;
        for rest.len() > 0 {
            n := self.write(rest)?;
            if n == 0 { return .err(closed); }
            rest = rest[n..];
        }
        .ok(())
    };
} });

/// How a value is written as text.
Format := interface(($Self: type) -> type { struct {
    format: ($W: Writer, value: &Self, w: &mut W) -> Result((), W.Error) = _;
} });

/// How an argument is written, as the bytes between the braces of its place say.
Spec := enum {
    /// `{}`: by its `Format` impl.
    display,
    /// `{?}`: by its `Debug` impl.
    debug;

    /// The bytes between the braces.
    mark := (self: Spec) -> &[u8] {
        match self {
            .display => "",
            .debug => "?",
        }
    };

    /// The interface that writes it.
    interface := (self: Spec) -> &[u8] {
        match self {
            .display => "Format",
            .debug => "Debug",
        }
    };
};

/// Every specifier.
specs := [Spec.display, Spec.debug];

/// A run of text of a format string, and the argument written after it.
Piece := struct {
    text: &[u8],
    /// The position of the argument; past the last argument for the text that ends the string.
    arg: usize,
    /// The bytes of the place that takes the argument; none for the text that ends the string.
    hole: lang.Range = 0..0,
    /// How the argument is written.
    spec: Spec = .display,
};

/// Opens and closes the place of an argument.
open := "{"[0];
close := "}"[0];

/// The place of an argument that starts at `at` in `format`: how the argument is written and how
/// many bytes the place covers; none where no place starts there.
hole := (format: &[u8], at: usize) -> Option((Spec, usize)) {
    for spec in specs {
        place := "{" ++ spec.mark() ++ "}";
        if format[at..].starts_with(place) { return .some((spec, place.len())); }
    }
    .none
};

/// The number of arguments `format` takes: its places.
holes := ($format: &[u8]) -> usize {
    mut n: usize = 0;
    mut i: usize = 0;
    for i < format.len() {
        if .some((_, len)) = hole(format, i) { n += 1; i += len; } else { i += 1; }
    }
    n
};

/// `format` split at each place of an argument: one piece per argument, then the text after the
/// last.
pieces := ($format: &[u8]) -> [holes(format) + 1]Piece {
    mut out: [holes(format) + 1]Piece = [.{ .text = "", .arg = 0 }; holes(format) + 1];
    mut n: usize = 0;
    mut start: usize = 0;
    mut i: usize = 0;
    for i < format.len() {
        if .some((spec, len)) = hole(format, i) {
            out[n] = .{ .text = format[start..i], .arg = n, .hole = i..i + len, .spec = spec };
            n += 1;
            i += len;
            start = i;
        } else {
            i += 1;
        }
    }
    out[n] = .{ .text = format[start..], .arg = n };
    out
};

/// What is wrong in a format string, whose places of arguments are `{}` and `{?}`.
Problem := enum {
    /// A `{` that no `}` closes.
    unclosed,
    /// A `{` closed after something that is no specifier.
    unknown,
    /// A `}` that closes no `{`.
    unopened;

    /// The problem, as a report says it.
    text := (self: Problem) -> &[u8] {
        match self {
            .unclosed => "this `{` is not closed",
            .unknown => "unknown format specifier",
            .unopened => "this `}` closes no `{`",
        }
    };

    /// What to do about it.
    help := (self: Problem) -> &[u8] {
        match self {
            .unclosed => "an argument goes where `{}` or `{?}` is written; close the `{` with a `}`",
            .unknown => "`{}` writes the next argument as its `Format` impl does, `{?}` as its `Debug` impl does",
            .unopened => "a `}` only closes a `{`; write `{}` where an argument goes",
        }
    };
};

/// A problem of a format string, and the bytes of the string it covers.
Error := struct {
    reason: Problem,
    at: lang.Range,
};

/// `format` split at each place of an argument, or its first problem: every `{` starts a place.
parse := ($format: &[u8]) -> Result([holes(format) + 1]Piece, Error) {
    mut i: usize = 0;
    for i < format.len() {
        if .some((_, len)) = hole(format, i) {
            i += len;
        } else if format[i] == open {
            // Not a place: a `}` closes it after something that is no specifier, or none does.
            for j in i..format.len() {
                if format[j] == close { return .err(.{ .reason = .unknown, .at = i..j + 1 }); }
            }
            return .err(.{ .reason = .unclosed, .at = i..i + 1 });
        } else if format[i] == close {
            return .err(.{ .reason = .unopened, .at = i..i + 1 });
        } else {
            i += 1;
        }
    }
    .ok(pieces(format))
};

/// The decimal digits of `n`, in compile-time memory.
number := (n: usize) -> &static [u8] {
    mut out: &static [u8] = &[];
    mut rest := n;
    for {
        out = lang.meta.concat(u8, &["0123456789"[rest % 10]], out);
        rest = rest / 10;
        if rest == 0 { break; }
    }
    out
};

/// `n` and what it counts, `1 argument`, `2 arguments`.
counted := (n: usize, one: &[u8], many: &[u8]) -> &static [u8] {
    if n == 1 { return number(n) ++ " " ++ one; }
    number(n) ++ " " ++ many
};

/// Writes `format` to `w`, each `{}` replaced by the next of `args`, one for each `{}`. A problem
/// with the format string is reported inside it, at the bytes it covers.
print := ($W: Writer, w: &mut W, $format: lang.meta.Code(&[u8]), $A: type, ..args: A) -> Result((), W.Error) {
    $if .err(bad) = parse($format) {
        $std.diag.error(.{
            .at = .some(format.within(bad.at)),
            .msg = bad.reason.text(),
            .help = .some(bad.reason.help())
        });
    } else if holes($format) != lang.meta.items(A).len() {
        $std.diag.error(.{
            .at = .some(format.span()),
            .msg = "the format string has " ++ counted(holes($format), "`{}`", "`{}`") ++ ", but "
                ++ counted(lang.meta.items(A).len(), "argument is given", "arguments are given"),
            .help = .some("pass one argument for each `{}` and `{?}`"),
        });
    } else {
        $for piece in pieces($format) {
            w.write_all(piece.text)?;
            $if piece.arg < holes($format) {
                $ty := lang.meta.Unborrowed(lang.meta.items(A)[piece.arg]);
                $debugging := lang.meta.same(Spec, piece.spec, .debug);
                $if (debugging and lang.meta.implements(Debug, ty)) or (!debugging and lang.meta.implements(
                    Format,
                    ty
                )) {
                    $if debugging { args.$(piece.arg).debug(w)?; } else { args.$(piece.arg).format(w)?; }
                } else {
                    $std.diag.error(.{
                        .at = .some(format.within(piece.hole)),
                        .msg = "`" ++ lang.meta.name_of(lang.meta.items(A)[piece.arg]) ++ "` has no `std.fmt."
                            ++ piece.spec.interface() ++ "` impl, so it cannot be written here",
                        .help = .some(
                            "write an impl of `std.fmt." ++ piece.spec.interface()
                                ++ "` for it, or pass a value that has one"
                        ),
                    });
                }
            }
        }
    }
    .ok(())
};

/// Room for the decimal digits of the widest integer.
digits_max := 40;
zero := "0"[0];
minus := "-";
radix := 10;
/// Around and between the items of a sequence.
opening := "[";
closing := "]";
separator := ", ";

#[impl(Format(Int))]
int_format := ($r: lang.Range) -> type { struct {
    /// In decimal, with `-` before a negative value.
    format := ($W: Writer, value: &Int(r), w: &mut W) -> Result((), W.Error) {
        if value.* < 0 { w.write_all(minus)?; }
        mut rest: u128 = value.*.abs();
        mut digits: [digits_max]u8 = [zero; digits_max];
        mut at: usize = digits_max - 1;
        digits[at] = (zero + rest % radix).to(u8);
        rest = rest / radix;
        for rest > 0 {
            at -= 1;
            digits[at] = (zero + rest % radix).to(u8);
            rest = rest / radix;
        }
        w.write_all(&digits[at..])
    };
} };

/// `true` or `false`.
#[impl(Format(bool))]
bool_format := struct {
    format := ($W: Writer, value: &bool, w: &mut W) -> Result((), W.Error) {
        if value.* { w.write_all("true") } else { w.write_all("false") }
    };
};

/// The items of a slice: bytes as they are, any other items as `[a, b]`, each by its own `Format`.
#[impl(Format(lang.mem.Slice))]
slice_format := ($T: type) -> type { struct {
    format := ($W: Writer, value: &[T], w: &mut W) -> Result((), W.Error) {
        $if lang.meta.same(type, T, u8) {
            w.write_all(value)
        } else {
            w.write_all(opening)?;
            for (i, item) in value.enumerate() {
                if i > 0 { w.write_all(separator)?; }
                item.format(w)?;
            }
            w.write_all(closing)
        }
    };
} };

/// The items of an array, as those of a slice; a string literal is a borrow of an array of bytes.
#[impl(Format(lang.mem.Array))]
array_format := ($n: Int(0..), $T: type) -> type { struct {
    format := ($W: Writer, value: &[n]T, w: &mut W) -> Result((), W.Error) {
        items: &[T] = value;
        items.format(w)
    };
} };
