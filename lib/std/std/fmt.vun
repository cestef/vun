//! Formatting, with format strings read at compile time (spec 03, section 4):
//! `print(w, "{} args\n", n)` writes the text of the format string with each `{}` replaced by
//! the next argument, as its `Format` impl writes it. Another specifier between the braces writes
//! it another way: `{?}` by `Debug`, `{x}` by `Hex` and `{b}` by `Binary`. After a `:` goes where
//! it sits in a width: `{:>8}` pads on the left to 8 bytes, `{x:0>4}` with `0`, `{:^5}` on both sides.

..std.fmt.debug.{ Debug };
..std.fmt.places.{ Error, Piece, Problem, Spec, holes, parse, pieces, specs };

/// Where bytes are written (spec 02, section 3).
Writer := interface(($Self: type) -> type { struct {
    Error: type = _;
    /// The error of a writer that took none of the bytes it was given: it takes no more.
    closed: Error = _;
    /// Writes some of `bytes`, returning how many.
    write: (self: &mut Self, bytes: &[u8]) -> Result(usize, Error) = _;
    /// Writes all of `bytes`, or fails with `closed` once a write takes none of them.
    write_all := (self: &mut Self, bytes: &[u8]) -> Result((), Error) {
        mut rest := bytes;
        for rest.len() > 0 {
            n := self.write(rest)?;
            if n == 0 { return .err(closed); }
            rest = rest[n..];
        }
        .ok(())
    };
} });

/// How a value is written as text.
Format := interface(($Self: type) -> type { struct {
    format: ($W: Writer, value: &Self, w: &mut W) -> Result((), W.Error) = _;
} });

/// How an integer is written in base 16, with `-` before a negative one.
Hex := interface(($Self: type) -> type { struct {
    hex: ($W: Writer, value: &Self, w: &mut W) -> Result((), W.Error) = _;
} });

/// How an integer is written in base 2, with `-` before a negative one.
Binary := interface(($Self: type) -> type { struct {
    binary: ($W: Writer, value: &Self, w: &mut W) -> Result((), W.Error) = _;
} });

/// The decimal digits of `n`, in compile-time memory.
number := (n: usize) -> &static [u8] {
    mut out: &static [u8] = &[];
    mut rest := n;
    for {
        out = lang.meta.concat(u8, &["0123456789"[rest % 10]], out);
        rest = rest / 10;
        if rest == 0 { break; }
    }
    out
};

/// `n` and what it counts, `1 argument`, `2 arguments`.
counted := (n: usize, one: &[u8], many: &[u8]) -> &static [u8] {
    if n == 1 { return number(n) ++ " " ++ one; }
    number(n) ++ " " ++ many
};

/// Writes `format` to `w`, each `{}` replaced by the next of `args`, one for each `{}`. A problem
/// with the format string is reported inside it, at the bytes it covers.
print := ($W: Writer, w: &mut W, $format: lang.meta.Code(&[u8]), $A: type, ..args: A) -> Result((), W.Error) {
    $if .err(bad) = parse($format) {
        $std.diag.error(.{
            .at = .some(format.within(bad.at)),
            .msg = bad.reason.text(),
            .help = .some(bad.reason.help())
        });
    } else if holes($format) != lang.meta.items(A).len() {
        $std.diag.error(.{
            .at = .some(format.span()),
            .msg = "the format string has " ++ counted(holes($format), "`{}`", "`{}`") ++ ", but "
                ++ counted(lang.meta.items(A).len(), "argument is given", "arguments are given"),
            .help = .some("pass one argument for each `{}`, `{?}`, `{x}` and `{b}`"),
        });
    } else {
        $for piece in pieces($format) {
            w.write_all(piece.text)?;
            $if piece.arg < holes($format) {
                $ty := lang.meta.Unborrowed(lang.meta.items(A)[piece.arg]);
                $if lang.meta.implements(piece.spec.interface, ty) {
                    $if piece.layout.width == 0 {
                        args.$(piece.arg).$(piece.spec.method)(w)?;
                    } else {
                        mut measure: std.fmt.layout.Measure(W) = .{ .len = 0 };
                        args.$(piece.arg).$(piece.spec.method)(&mut measure)?;
                        sides := piece.layout.sides(measure.len);
                        std.fmt.layout.pad(w, piece.layout.fill, sides.0)?;
                        args.$(piece.arg).$(piece.spec.method)(w)?;
                        std.fmt.layout.pad(w, piece.layout.fill, sides.1)?;
                    }
                } else {
                    $std.diag.error(.{
                        .at = .some(format.within(piece.hole)),
                        .msg = "`" ++ lang.meta.name_of(lang.meta.items(A)[piece.arg]) ++ "` has no `"
                            ++ piece.spec.name ++ "` impl, so it cannot be written here",
                        .help = .some(
                            "write an impl of `" ++ piece.spec.name
                                ++ "` for it, or pass a value that has one"
                        ),
                    });
                }
            }
        }
    }
    .ok(())
};

/// Room for the digits of the widest integer in the smallest base.
digits_max := 128;
minus := "-";
/// The digit of each value below the largest base.
alphabet := "0123456789abcdefghijklmnopqrstuvwxyz";
/// Around and between the items of a sequence.
opening := "[";
closing := "]";
separator := ", ";

/// Writes `magnitude` in `base`, 2 to 36, after a `-` when `negative`.
in_base := ($W: Writer, w: &mut W, negative: bool, magnitude: u128, base: Int(2
        ..=36)) -> Result((), W.Error) {
            if negative { w.write_all(minus)?; }
            mut rest: u128 = magnitude;
            mut digits: [digits_max]u8 = [alphabet[0]; digits_max];
            mut at: usize = digits_max - 1;
            digits[at] = alphabet[(rest % base).to(usize)];
            rest = rest / base;
            for rest > 0 {
                at -= 1;
                digits[at] = alphabet[(rest % base).to(usize)];
                rest = rest / base;
            }
            w.write_all(&digits[at..])
        };

/// In decimal, with `-` before a negative value.
impl Format for Int($r) {
    format := ($W: Writer, value: &Int(r), w: &mut W) -> Result((), W.Error) {
        in_base(w, value.* < 0, value.*.abs(), 10)
    };
}

impl Hex for Int($r) {
    hex := ($W: Writer, value: &Int(r), w: &mut W) -> Result((), W.Error) {
        in_base(w, value.* < 0, value.*.abs(), 16)
    };
}

impl Binary for Int($r) {
    binary := ($W: Writer, value: &Int(r), w: &mut W) -> Result((), W.Error) {
        in_base(w, value.* < 0, value.*.abs(), 2)
    };
}

/// `true` or `false`.
impl Format for bool {
    format := ($W: Writer, value: &bool, w: &mut W) -> Result((), W.Error) {
        if value.* { w.write_all("true") } else { w.write_all("false") }
    };
}

/// The items of a slice: bytes as they are, any other items as `[a, b]`, each by its own `Format`.
impl Format for lang.mem.Slice($T) {
    format := ($W: Writer, value: &[T], w: &mut W) -> Result((), W.Error) {
        $if lang.meta.same(type, T, u8) {
            w.write_all(value)
        } else {
            w.write_all(opening)?;
            for (i, item) in value.enumerate() {
                if i > 0 { w.write_all(separator)?; }
                item.format(w)?;
            }
            w.write_all(closing)
        }
    };
}
