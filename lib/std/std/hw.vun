//! Hardware access: memory-mapped registers over volatile operations.

/// A memory-mapped register holding a `T`: each read and write reaches the device, exactly as
/// written, in the order written. It is laid out as the `T` it holds, so a `#[layout.c]` struct of
/// registers is laid out as the device's.
Reg := ($T: type) -> type { #[layout.c] struct {
    _value: lang.mem.Cell(T),

    /// What the device holds now.
    #[panic.never]
    read := (self: &Reg(T)) -> T { unsafe lang.mem.volatile_load(T, self._at()) };
    /// Hands `value` to the device.
    #[panic.never]
    write := (self: &Reg(T), value: T) { unsafe lang.mem.volatile_store(T, self._at(), value) };

    #[panic.never]
    _at := (self: &Reg(T)) -> *T { unsafe lang.mem.cell_pointer(T, &self._value) };
} };

/// The registers of the device at `address`, a `T` laid out as the device lays them out.
#[panic.never]
at := unsafe ($T: type, address: usize) -> &T { unsafe { &lang.mem.pointer_at(T, address).* } };
