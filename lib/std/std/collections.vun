//! Collections: `Vec`, a growable array over an allocator the caller passes, struct-of-arrays
//! layouts generated by reflection, and `Handle(T)`, typed indices into a pool over nominal
//! structs (decision 41, spec 05, section 4).

/// A growable array, whose buffer an allocator gives.
Vec: ($T: type) -> type = std.collections.vec.Vec;

/// Values by key, in open addressing over a buffer an allocator gave.
HashMap: ($K: type, $V: type) -> type = std.collections.map.HashMap;
