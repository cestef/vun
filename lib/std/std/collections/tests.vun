//! Tests of `std.collections`.

Fixed: type = std.mem.alloc.Fixed;

#[test]
a_vec_holds_what_is_pushed := () {
    mut storage: [4096]u8 = [0; 4096];
    mut a := Fixed.init(&mut storage);
    mut v := std.collections.Vec(u32).empty();
    std.testing.assert(v.is_empty());
    for i in 0..20 { v.push(Fixed, &mut a, i * 3).expect("room"); }
    std.testing.assert(v.len() == 20);
    std.testing.assert(v.capacity() >= 20);
    std.testing.assert(v.items()[7] == 21);
    std.testing.assert(v.get(19) == Option(&u32).some(&57));
    std.testing.assert(v.get(20) == Option(&u32).none);
    v.deinit(Fixed, &mut a);
};

#[test]
a_vec_pops_in_reverse := () {
    mut storage: [1024]u8 = [0; 1024];
    mut a := Fixed.init(&mut storage);
    mut v := std.collections.Vec(u8).empty();
    v.push(Fixed, &mut a, 1).expect("room");
    v.push(Fixed, &mut a, 2).expect("room");
    std.testing.assert(v.pop() == Option(u8).some(2));
    std.testing.assert(v.pop() == Option(u8).some(1));
    std.testing.assert(v.pop() == Option(u8).none);
    v.deinit(Fixed, &mut a);
};

#[test]
inserting_and_removing_keep_the_order := () {
    mut storage: [1024]u8 = [0; 1024];
    mut a := Fixed.init(&mut storage);
    mut v := std.collections.Vec(u8).empty();
    v.extend(Fixed, &mut a, "acd").expect("room");
    v.insert(Fixed, &mut a, 1, "b"[0]).expect("room");
    std.testing.assert(v.items() == "abcd");
    std.testing.assert(v.remove(0) == "a"[0]);
    std.testing.assert(v.items() == "bcd");
    std.testing.assert(v.swap_remove(0) == "b"[0]);
    std.testing.assert(v.items() == "dc");
    v.deinit(Fixed, &mut a);
};

#[test]
a_vec_changes_through_its_items := () {
    mut storage: [1024]u8 = [0; 1024];
    mut a := Fixed.init(&mut storage);
    mut v := std.collections.Vec(u8).empty();
    v.extend(Fixed, &mut a, "abc").expect("room");
    v.items_mut()[1] = "X"[0];
    std.testing.assert(v.items() == "aXc");
    v.deinit(Fixed, &mut a);
};

#[test]
a_vec_fails_when_the_allocator_does := () {
    mut storage: [32]u8 = [0; 32];
    mut a := Fixed.init(&mut storage);
    mut v := std.collections.Vec(u64).empty();
    std.testing.assert(v.push(Fixed, &mut a, 1) == Result((), std.mem.alloc.Error).ok(()));
    std.testing.assert(v.reserve(Fixed, &mut a, 100) == Result((), std.mem.alloc.Error).err(.exhausted));
    v.deinit(Fixed, &mut a);
};

#[test]
a_map_gives_back_what_was_put_in := () {
    mut storage: [8192]u8 = [0; 8192];
    mut a := Fixed.init(&mut storage);
    mut m := std.collections.HashMap(u32, u32).empty();
    for i in 0..40 { _ = m.insert(Fixed, &mut a, i, i * i).expect("room"); }
    std.testing.assert(m.len() == 40);
    std.testing.assert(m.get(&7) == Option(&u32).some(&49));
    std.testing.assert(m.get(&39) == Option(&u32).some(&1521));
    std.testing.assert(m.get(&40) == Option(&u32).none);
    std.testing.assert(m.contains(&0));
    m.deinit(Fixed, &mut a);
};

#[test]
putting_a_key_again_replaces_its_value := () {
    mut storage: [2048]u8 = [0; 2048];
    mut a := Fixed.init(&mut storage);
    mut m := std.collections.HashMap(u8, u8).empty();
    std.testing.assert(m.insert(Fixed, &mut a, 1, 10).expect("room") == Option(u8).none);
    std.testing.assert(m.insert(Fixed, &mut a, 1, 11).expect("room") == Option(u8).some(10));
    std.testing.assert(m.len() == 1);
    std.testing.assert(m.get(&1) == Option(&u8).some(&11));
    m.deinit(Fixed, &mut a);
};

#[test]
a_removed_key_is_gone_and_its_slot_is_reused := () {
    mut storage: [4096]u8 = [0; 4096];
    mut a := Fixed.init(&mut storage);
    mut m := std.collections.HashMap(u8, u8).empty();
    for i in 0..5 { _ = m.insert(Fixed, &mut a, i, i + 100).expect("room"); }
    std.testing.assert(m.remove(&3) == Option(u8).some(103));
    std.testing.assert(m.remove(&3) == Option(u8).none);
    std.testing.assert(!m.contains(&3));
    std.testing.assert(m.len() == 4);
    _ = m.insert(Fixed, &mut a, 3, 7).expect("room");
    std.testing.assert(m.get(&3) == Option(&u8).some(&7));
    m.deinit(Fixed, &mut a);
};

Pair := struct { a: u8, b: u8 };

#[test]
a_map_keys_by_a_struct_without_an_impl := () {
    mut storage: [4096]u8 = [0; 4096];
    mut a := Fixed.init(&mut storage);
    mut m := std.collections.HashMap(Pair, u32).empty();
    _ = m.insert(Fixed, &mut a, Pair{ .a = 1, .b = 2 }, 5).expect("room");
    _ = m.insert(Fixed, &mut a, Pair{ .a = 2, .b = 1 }, 6).expect("room");
    std.testing.assert(m.get(&Pair{ .a = 1, .b = 2 }) == Option(&u32).some(&5));
    std.testing.assert(m.get(&Pair{ .a = 2, .b = 1 }) == Option(&u32).some(&6));
    std.testing.assert(m.get(&Pair{ .a = 2, .b = 2 }) == Option(&u32).none);
    m.deinit(Fixed, &mut a);
};

#[test]
a_map_keys_by_bytes := () {
    mut storage: [4096]u8 = [0; 4096];
    mut a := Fixed.init(&mut storage);
    mut m := std.collections.HashMap(&[u8], u32).empty();
    _ = m.insert(Fixed, &mut a, "one", 1).expect("room");
    _ = m.insert(Fixed, &mut a, "two", 2).expect("room");
    std.testing.assert(m.get(&"two") == Option(&u32).some(&2));
    std.testing.assert(m.get(&"three") == Option(&u32).none);
    m.deinit(Fixed, &mut a);
};

#[test]
a_map_visits_every_entry_once := () {
    mut storage: [4096]u8 = [0; 4096];
    mut a := Fixed.init(&mut storage);
    mut m := std.collections.HashMap(u8, u8).empty();
    for i in 0..6 { _ = m.insert(Fixed, &mut a, i, 1).expect("room"); }
    mut seen: usize = 0;
    mut sum: usize = 0;
    for (key, value) in m.entries() {
        seen += 1;
        sum += key.* + value.*;
    }
    std.testing.assert(seen == 6);
    std.testing.assert(sum == 21);
    m.deinit(Fixed, &mut a);
};
