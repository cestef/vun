//! `Vec(T)`: items of one type in a buffer an allocator gave, grown as they are pushed. It is
//! linear: it owns its buffer, which `deinit` gives back to the allocator it came from, the one
//! each growing call is passed. No allocator is held, so one allocator serves any number of them.

..std.mem.alloc.{ Allocator };

Vec := ($T: type) -> type { #[kind.linear] #[kind.free] struct {
    _items: *T,
    _len: usize,
    _cap: usize,

    /// A vector holding nothing, which owns no memory yet.
    empty := () -> Vec(T) {
        .{ ._items = unsafe lang.mem.pointer_at(T, lang.meta.align(T)), ._len = 0, ._cap = 0 }
    };

    /// A vector with room for `n` items.
    with_capacity := ($A: Allocator, a: &mut A, n: usize) -> Result(Vec(T), A.Error) {
        mut v := Vec(T).empty();
        v.reserve(A, a, n)?;
        .ok(v)
    };

    /// How many items it holds.
    #[panic.never]
    len := (self: &Vec(T)) -> usize { self._len };
    /// How many items it has room for before it grows.
    #[panic.never]
    capacity := (self: &Vec(T)) -> usize { self._cap };
    /// Whether it holds no item.
    #[panic.never]
    is_empty := (self: &Vec(T)) -> bool { self._len == 0 };

    /// The items it holds.
    items := (self: &Vec(T)) -> &[T] { unsafe lang.mem.items_at(T, self._items, self._len) };
    /// The items it holds, to change.
    items_mut := (self: &mut Vec(T)) -> &mut [T] { unsafe lang.mem.items_at_mut(T, self._items, self._len) };

    /// The item at `i`, none past the last.
    get := (self: &Vec(T), i: usize) -> ?&T {
        if i >= self._len { return .none; }
        .some(&self.items()[i])
    };

    /// Room for `extra` more items, growing the buffer if it has less; the items move to the new
    /// one, and the old one goes back to `a`.
    reserve := (self: &mut Vec(T), $A: Allocator, a: &mut A, extra: usize) -> Result((), A.Error) {
        needed := (self._len + extra).sat(usize);
        if needed <= self._cap { return .ok(()); }
        doubled := (self._cap * 2).sat(usize);
        cap := std.cmp.max(usize, std.cmp.max(usize, doubled, needed), grown_least);
        size := lang.meta.size(T);
        align := lang.meta.align(T);
        fresh := unsafe a.alloc((size * cap).sat(usize), align)?.cast(T);
        if self._len > 0 { unsafe lang.mem.copy(T, fresh, self._items, self._len); }
        if self._cap > 0 { a.free(unsafe self._items.cast(u8), (size * self._cap).sat(usize), align); }
        self._items = fresh;
        self._cap = cap;
        .ok(())
    };

    /// Adds `item` after the last, growing the buffer when it is full.
    push := (self: &mut Vec(T), $A: Allocator, a: &mut A, item: T) -> Result((), A.Error) {
        self.reserve(A, a, 1)?;
        unsafe { self._items.offset(self._len.to(isize)).write(item); }
        self._len += 1;
        .ok(())
    };

    /// Takes the last item away, none when it holds none.
    pop := (self: &mut Vec(T)) -> ?T {
        if self._len == 0 { return .none; }
        self._len -= 1;
        .some(unsafe self._items.offset(self._len.to(isize)).read())
    };

    /// Puts `item` at `i`, the items from there on one place later.
    insert := (self: &mut Vec(T), $A: Allocator, a: &mut A, i: usize, item: T) -> Result((), A.Error) {
        if i > self._len { lang.panic.fail(.message("insert past the end")); }
        self.reserve(A, a, 1)?;
        at := unsafe self._items.offset(i.to(isize));
        unsafe {
            lang.mem.copy(T, at.offset(1), at, (self._len - i).sat(usize));
            at.write(item);
        }
        self._len += 1;
        .ok(())
    };

    /// Takes the item at `i` away, the items after it one place earlier.
    remove := (self: &mut Vec(T), i: usize) -> T {
        if i >= self._len { lang.panic.fail(.message("remove past the end")); }
        at := unsafe self._items.offset(i.to(isize));
        taken := unsafe at.read();
        unsafe { lang.mem.copy(T, at, at.offset(1), (self._len - i - 1).sat(usize)); }
        self._len -= 1;
        taken
    };

    /// Takes the item at `i` away, the last item taking its place.
    swap_remove := (self: &mut Vec(T), i: usize) -> T {
        if i >= self._len { lang.panic.fail(.message("remove past the end")); }
        at := unsafe self._items.offset(i.to(isize));
        taken := unsafe at.read();
        self._len -= 1;
        if i != self._len { unsafe { at.write(self._items.offset(self._len.to(isize)).read()); } }
        taken
    };

    /// Keeps the first `n` items, dropping the others without a trace: ones owning memory are
    /// taken away with `pop` first.
    truncate := (self: &mut Vec(T), n: usize) { if n < self._len { self._len = n; } };
    /// Holds nothing again, the buffer kept.
    clear := (self: &mut Vec(T)) { self._len = 0; };

    /// Adds the items of `more`, copies of them.
    extend := (self: &mut Vec(T), $A: Allocator, a: &mut A, more: &[T]) -> Result((), A.Error) {
        self.reserve(A, a, more.len())?;
        for item in more {
            unsafe { self._items.offset(self._len.to(isize)).write(item.*); }
            self._len += 1;
        }
        .ok(())
    };

    /// Keeps the items `keep` holds for, in their order. The others are not dropped: ones
    /// owning memory are taken away first.
    retain := (self: &mut Vec(T), $F: lang.ops.Call((&T), bool), keep: F) {
        xs := self.items_mut();
        count := xs.len();
        mut kept: usize = 0;
        for i in 0..count {
            if keep(&xs[i]) {
                if kept != i { xs.swap(kept, i); }
                kept += 1;
            }
        }
        self._len = kept;
    };

    /// Keeps the first of each run of equal items.
    dedup := (self: &mut Vec(T)) {
        kept := self.items_mut().dedup();
        self._len = kept;
    };

    /// Makes it hold `n` items: the first `n` it has, or those and copies of `item`.
    resize := (self: &mut Vec(T), $A: Allocator, a: &mut A, n: usize, item: T) -> Result((), A.Error) {
        if n <= self._len {
            self._len = n;
            return .ok(());
        }
        self.reserve(A, a, (n - self._len).to(usize))?;
        for self._len < n { self.push(A, a, item)?; }
        .ok(())
    };

    /// Adds the items of `more`.
    extend_iter := (self: &mut Vec(T), $A: Allocator, a: &mut A, $G: std.iter.Iter(T), more: G) -> Result(
        (),
        A.Error
    ) {
        for item in more { self.push(A, a, item)?; }
        .ok(())
    };

    /// Gives the buffer back to `a`, which it came from. Items owning memory are taken away
    /// first: they are not dropped.
    deinit := (self: Vec(T), $A: Allocator, a: &mut A) {
        .{ ._items = buffer, ._len = _, ._cap = cap } := self;
        if cap > 0 {
            a.free(unsafe buffer.cast(u8), (lang.meta.size(T) * cap).sat(usize), lang.meta.align(T));
        }
    };
} };

/// The fewest items a buffer is made for, so that the first pushes do not each grow it.
grown_least: usize = 4;
