//! Text (decision 43): bytes held, written and cut. `Slab(n)` keeps up to `n` bytes inline, with no
//! allocator; text is UTF-8 in `&[u8]`, whose bytes `ascii` classifies and whose code points `utf8`
//! reads. Formatting is `std.fmt`, readers and writers are `std.io`, maps are `std.collections`.

/// Bytes of text a program grows, in a buffer an allocator gave.
String: type = std.text.string.String;

newline := "\n";
carriage_return := "\r"[0];

/// `text` without the white space before its first other byte.
trim_start := (text: &[u8]) -> &[u8] {
    mut at: usize = 0;
    for at < text.len() and std.text.ascii.is_space(text[at]) { at += 1; }
    text[at..]
};

/// `text` without the white space after its last other byte.
trim_end := (text: &[u8]) -> &[u8] {
    mut end := text.len();
    for end > 0 and std.text.ascii.is_space(text[end - 1]) { end -= 1; }
    text[0..end]
};

/// `text` without the white space around it.
trim := (text: &[u8]) -> &[u8] { trim_end(trim_start(text)) };

/// The lines of `text`, each without its line feed, or its carriage return and line feed; the
/// last has no line end, and `text` ending with one has no empty line after it.
lines := (text: &[u8]) -> std.iter.Iter(&[u8]) {
    mut rest: &[u8] = text;
    for rest.len() > 0 {
        mut line: &[u8] = rest;
        match rest.find(newline) {
            .some(at) => {
                line = rest[0..at];
                rest = rest[(at + newline.len()).sat(usize)..];
            },
            .none => { rest = rest[rest.len()..]; },
        }
        if line.len() > 0 and line[line.len() - 1] == carriage_return {
            line = line[0..line.len() - 1];
        }
        yield line;
    }
};

/// Whether `a` and `b` are the same text, the case of ASCII letters aside.
eq_ignore_case := (a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() { return false; }
    for i in 0..a.len() {
        if std.text.ascii.to_lower(a[i]) != std.text.ascii.to_lower(b[i]) { return false; }
    }
    true
};

/// `text` without `prefix` at its start, none if it does not start with it.
strip_prefix := (text: &[u8], prefix: &[u8]) -> ?&[u8] {
    if text.starts_with(prefix) { .some(text[prefix.len()..]) } else { .none }
};

/// `text` without `suffix` at its end, none if it does not end with it.
strip_suffix := (text: &[u8], suffix: &[u8]) -> ?&[u8] {
    if text.ends_with(suffix) { .some(text[0..text.len() - suffix.len()]) } else { .none }
};

/// The runs of `text` between white space, none of them empty.
split_whitespace := (text: &[u8]) -> std.iter.Iter(&[u8]) {
    mut rest: &[u8] = text;
    for {
        rest = trim_start(rest);
        if rest.len() == 0 { break; }
        mut end: usize = 0;
        for end < rest.len() and !std.text.ascii.is_space(rest[end]) { end += 1; }
        yield rest[0..end];
        rest = rest[end..];
    }
};

/// Makes each ASCII letter of `text` upper case, in place.
make_upper := (text: &mut [u8]) {
    for i in 0..text.len() { text[i] = std.text.ascii.to_upper(text[i]); }
};

/// Makes each ASCII letter of `text` lower case, in place.
make_lower := (text: &mut [u8]) {
    for i in 0..text.len() { text[i] = std.text.ascii.to_lower(text[i]); }
};

/// Why a `Slab` took no more bytes.
Full := enum { full };

/// Up to `n` bytes held inline: written to as any writer, read back as a slice.
Slab := ($n: Int(0..)) -> type { struct {
    _bytes: [n]u8,
    _len: Int(0..=n),

    /// A slab holding nothing.
    empty := () -> Slab(n) { .{ ._bytes = [0; n], ._len = 0 } };
    /// How many bytes it holds at most.
    capacity := (self: &Slab(n)) -> usize { n };
    /// How many bytes it holds.
    len := (self: &Slab(n)) -> usize { self._len };
    /// The bytes it holds.
    bytes := (self: &Slab(n)) -> &[u8] { &self._bytes[0..self._len] };
    /// Holds nothing again.
    clear := (self: &mut Slab(n)) { self._len = 0; };
    /// Appends as many of `more` as there is room for, and gives how many.
    append := (self: &mut Slab(n), more: &[u8]) -> usize {
        mut taken: usize = 0;
        for taken < more.len() {
            used := self._len;
            if used == n { break; }
            self._bytes[used] = more[taken];
            self._len = used + 1;
            taken += 1;
        }
        taken
    };
    /// Appends `byte`, or fails when there is no room.
    push := (self: &mut Slab(n), byte: u8) -> Result((), Full) {
        used := self._len;
        if used == n { return .err(.full); }
        self._bytes[used] = byte;
        self._len = used + 1;
        .ok(())
    };
} };

impl std.fmt.Writer for Slab($n) {
    Error: type = Full;
    closed: Full = .full;
    write := (self, more) { .ok(self.append(more)) };
}
