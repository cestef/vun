//! SHA-256 (FIPS 180-4): the message in blocks of 64 bytes, each mixed into eight 32-bit words by
//! 64 rounds. The message is padded with a one bit, zeros, and its length in bits.

..std.hash.{ Hasher };

/// The round constants: the first 32 bits of the fractional parts of the cube roots of the first
/// 64 primes.
round_constants: [64]u32 = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/// The words a hash starts from: the first 32 bits of the fractional parts of the square roots of
/// the first eight primes.
initial: [8]u32 = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

/// Bytes in a block.
block_size: usize = 64;

Sha256 := struct {
    _words: [8]u32,
    _block: [64]u8,
    _filled: usize,
    /// How many bytes were taken in.
    _length: u64,

    /// A hash of no bytes yet.
    init := () -> Sha256 { .{ ._words = initial, ._block = [0; 64], ._filled = 0, ._length = 0 } };

    /// The SHA-256 of `bytes`.
    digest := (bytes: &[u8]) -> [32]u8 {
        mut h := Sha256.init();
        h.update(bytes);
        h.finish_digest()
    };

    /// Takes `bytes` in.
    update := (self: &mut Sha256, bytes: &[u8]) {
        self._length = (self._length + bytes.len()).to(u64);
        for b in bytes {
            self._block[self._filled] = b.*;
            self._filled += 1;
            if self._filled == block_size {
                self.compress();
                self._filled = 0;
            }
        }
    };

    /// The hash of everything taken in, which stays the hasher's to take more.
    finish_digest := (self: &Sha256) -> [32]u8 {
        mut end := self.*;
        bits: u64 = (self._length * 8).wrap(u64);
        end.update_padding(bits);
        mut out: [32]u8 = [0; 32];
        for i in 0..8 {
            word := end._words[i];
            out[4 * i] = (word >> 24).wrap(u8);
            out[4 * i + 1] = (word >> 16).wrap(u8);
            out[4 * i + 2] = (word >> 8).wrap(u8);
            out[4 * i + 3] = word.wrap(u8);
        }
        out
    };

    /// Pads the last block: a one bit, zeros up to eight bytes before the block's end, and the
    /// length of the message in bits, most significant byte first.
    update_padding := (self: &mut Sha256, bits: u64) {
        self._block[self._filled] = 0x80;
        self._filled += 1;
        if self._filled > block_size - 8 {
            for self._filled < block_size { self._block[self._filled] = 0; self._filled += 1; }
            self.compress();
            self._filled = 0;
        }
        for self._filled < block_size - 8 { self._block[self._filled] = 0; self._filled += 1; }
        for i in 0..8 { self._block[block_size - 8 + i] = (bits >> (56 - 8 * i)).wrap(u8); }
        self.compress();
    };

    /// Mixes the block into the words.
    compress := (self: &mut Sha256) {
        mut w: [64]u32 = [0; 64];
        for i in 0..16 {
            w[i] = (self._block[4 * i].to(u32) << 24) | (self._block[4 * i + 1].to(u32) << 16)
                | (self._block[4 * i + 2].to(u32) << 8) | self._block[4 * i + 3].to(u32);
        }
        for i in 16..64 {
            a := w[i - 15];
            b := w[i - 2];
            s0 := a.rotate_right(7) ^ a.rotate_right(18) ^ (a >> 3);
            s1 := b.rotate_right(17) ^ b.rotate_right(19) ^ (b >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1).wrap(u32);
        }
        mut a := self._words[0];
        mut b := self._words[1];
        mut c := self._words[2];
        mut d := self._words[3];
        mut e := self._words[4];
        mut f := self._words[5];
        mut g := self._words[6];
        mut h := self._words[7];
        for i in 0..64 {
            big1 := e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            choose := (e & f) ^ ((e ^ 0xffff_ffff) & g);
            t1 := (h + big1 + choose + round_constants[i] + w[i]).wrap(u32);
            big0 := a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            majority := (a & b) ^ (a & c) ^ (b & c);
            t2 := (big0 + majority).wrap(u32);
            h = g;
            g = f;
            f = e;
            e = (d + t1).wrap(u32);
            d = c;
            c = b;
            b = a;
            a = (t1 + t2).wrap(u32);
        }
        self._words[0] = (self._words[0] + a).wrap(u32);
        self._words[1] = (self._words[1] + b).wrap(u32);
        self._words[2] = (self._words[2] + c).wrap(u32);
        self._words[3] = (self._words[3] + d).wrap(u32);
        self._words[4] = (self._words[4] + e).wrap(u32);
        self._words[5] = (self._words[5] + f).wrap(u32);
        self._words[6] = (self._words[6] + g).wrap(u32);
        self._words[7] = (self._words[7] + h).wrap(u32);
    };
};

/// The first eight bytes of the hash, as a number.
impl Hasher for Sha256 {
    write := (self, bytes) { self.update(bytes); };
    finish := (self) {
        digest := self.finish_digest();
        mut out: u64 = 0;
        for i in 0..8 { out = (out << 8) | digest[i].to(u64); }
        out
    };
}
