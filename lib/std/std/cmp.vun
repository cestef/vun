//! Comparing values through `lang.ops.Ord`, whose `<` and `>` these use.

/// The smaller of `a` and `b`, `a` when equal.
#[panic.never]
min := ($T: type, a: T, b: T) -> T { if b < a { b } else { a } };
/// The larger of `a` and `b`, `a` when equal.
#[panic.never]
max := ($T: type, a: T, b: T) -> T { if b > a { b } else { a } };
/// `x` brought within `lo..=hi`.
#[panic.never]
clamp := ($T: type, x: T, lo: T, hi: T) -> T { if x < lo { lo } else if x > hi { hi } else { x } };

/// An `Eq` witness for `T` by reflection (spec 03, section 6): two values are equal when they are
/// the same variant and each part of it is equal, by its own `Eq`. A struct is one variant, its
/// fields its parts. `#[impl(lang.ops.Eq(Point))] PointEq := std.cmp.derive_eq(Point);`
derive_eq := ($T: type) -> type { struct {
    eq := (a: &T, b: &T) -> bool {
        at := lang.meta.variant(T, a);
        if at != lang.meta.variant(T, b) { return false; }
        $for v in lang.meta.variants(T) {
            if at == v.index {
                $for p in v.parts {
                    if lang.meta.part(T, a, v.index, p.index) != lang.meta.part(T, b, v.index, p.index) {
                        return false;
                    }
                }
            }
        }
        true
    };
} };
