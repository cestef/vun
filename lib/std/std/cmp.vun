//! Comparing values through `lang.ops.Ord`, whose `<` and `>` these use.

/// The smaller of `a` and `b`, `a` when equal.
#[panic.never]
min := ($T: type, a: T, b: T) -> T { if b < a { b } else { a } };
/// The larger of `a` and `b`, `a` when equal.
#[panic.never]
max := ($T: type, a: T, b: T) -> T { if b > a { b } else { a } };
/// `x` brought within `lo..=hi`.
#[panic.never]
clamp := ($T: type, x: T, lo: T, hi: T) -> T { if x < lo { lo } else if x > hi { hi } else { x } };

/// An `Eq` witness for `T` by reflection (spec 03, section 3): a struct is equal field by field,
/// each by its own `Eq`, and an enum without payloads variant by variant.
/// `#[impl(lang.ops.Eq(Point))] PointEq := std.cmp.derive_eq(Point);`
derive_eq := ($T: type) -> type {
    $if lang.meta.variants(T).len() > 0 {
        $for v in lang.meta.variants(T) {
            $if v.payload.len() > 0 {
                $std.diag.error(.{ .msg = "`derive_eq` compares the variants of enums without payloads: write this `Eq` impl" });
            }
        }
        struct {
            eq := (a: &T, b: &T) -> bool { lang.meta.variant(T, a) == lang.meta.variant(T, b) };
        }
    } else {
        struct {
            eq := (a: &T, b: &T) -> bool {
                $for f in lang.meta.fields(T) {
                    if a.$(f.name) != b.$(f.name) { return false; }
                }
                true
            };
        }
    }
};
