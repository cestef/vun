//! Words of memory a runtime gives the checks, read and written by atomic accesses, which no
//! check rewrites.

/// A lock word no thread holds, and one a thread holds.
free: usize = 0;
held: usize = 1;

Words := struct {
    _base: *usize,

    of := unsafe (base: *usize) -> Words { .{ ._base = base } };

    _at := (self: Words, i: usize) -> *usize { unsafe self._base.offset(i.to(isize)) };

    get := (self: Words, i: usize) -> usize { unsafe lang.mem.atomic_load(usize, self._at(i), .relaxed) };

    set := (self: Words, i: usize, value: usize) {
        unsafe lang.mem.atomic_store(usize, self._at(i), value, .relaxed)
    };

    /// The words from the `i`th on.
    from := (self: Words, i: usize) -> Words { .{ ._base = self._at(i) } };

    /// Takes the lock the `i`th word is, spinning while another thread holds it.
    lock := (self: Words, i: usize) {
        for unsafe lang.mem.atomic_compare_swap(usize, self._at(i), free, held, .acquire) != free {}
    };

    unlock := (self: Words, i: usize) { unsafe lang.mem.atomic_store(usize, self._at(i), free, .release) };
};
