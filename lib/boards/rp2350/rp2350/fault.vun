//! What a program that stopped leaves behind. A board without a console shows nothing of it, so
//! a fault or a trap reboots into the boot ROM's USB mode with a record of it as the reboot's
//! parameters (`rp2350.record`): a program that stopped is a device back on the host's bus, and
//! `picotool info -a` says why.

/// Where a core was stopped, and what it said of why.
Fault := struct {
    /// The instruction it was running.
    pc: u32,
    /// The configurable fault status register: which of the memory, bus and usage faults it was.
    status: u32,
    /// The address the memory or bus fault was on, when the status says there is one.
    address: ?u32,
};

/// Why a program stopped: the core faulted, or the program trapped at a site of its own
/// (`lang.panic.Trap`).
Stop := enum { fault(Fault), trap(u32) };

/// The words of the frame the core pushed on taking the exception: `r0` to `r3`, `r12`, `lr`, the
/// instruction it was running, and the status register.
frame_pc := 6;

/// The memory fault address register holds the address when its status bit says so, and so does the
/// bus fault's: bit 7 and bit 15 of the status.
mmfar_valid: u32 = 0x80;
bfar_valid: u32 = 0x8000;

/// Reports the fault the frame at `frame` was taken for, and reboots into the boot ROM.
record := (frame: *u32) -> never {
    status := rp2350.core.register(rp2350.core.cfsr_offset).read();
    address: ?u32 = if status & bfar_valid != 0 {
        .some(rp2350.core.register(rp2350.core.bfar_offset).read())
    } else if status & mmfar_valid != 0 {
        .some(rp2350.core.register(rp2350.core.mmfar_offset).read())
    } else {
        .none
    };
    pc := unsafe frame.offset(frame_pc).read();
    rp2350.record.report(.fault(.{ .pc = pc, .status = status, .address = address }))
};

/// The trap handler a program gives as its `trap`: reports the site and reboots into the boot ROM,
/// as a fault does, so a program that trapped is a device on the host's bus and not a halted one
/// that only the button recovers.
trap := (t: &lang.panic.Trap) -> never { rp2350.record.report(.trap(t.site)) };
