//! Builds the program's exports at compile time (spec 08, section 2): the image definition, the
//! vector table the core reads at reset, the reset handler, which lays memory out and calls
//! `main`, the trap handler and the critical sections of one core.

Config := struct {
    main: (p: Peripherals) -> never,
    /// What a trap does; the default records it and returns the device to the boot ROM.
    trap: (t: &lang.panic.Trap) -> never = rp2350.fault.trap,
    interrupts: Interrupts = .{},
};

/// The device's peripherals, claimed once at reset.
Peripherals := struct {
    gpio: rp2350.gpio.Bank,
    uart0: rp2350.uart.Port0,
    timer0: rp2350.time.Timer0,

    claim := unsafe () -> Peripherals {
        .{
            .gpio = unsafe rp2350.gpio.Bank.claim(),
            .uart0 = unsafe rp2350.uart.Port0.claim(),
            .timer0 = unsafe rp2350.time.Timer0.claim()
        }
    };
};

/// What the core runs on an exception or interrupt: a function of no convention, the core having
/// pushed what it saves and left a return code in `lr`, which each handler's first and last
/// instructions keep.
Handler := #[abi.naked] () -> never;

/// Handlers of the exceptions and interrupts, plain functions the table calls through a wrapper;
/// one a program does not give runs `unhandled`.
Interrupts := struct {
    systick: () -> () = unhandled,
    /// The chip's interrupts a program handles, each by its number (`rp2350.irq`); the others run
    /// `unhandled`. A handler runs once `rp2350.nvic.enable` lets its interrupt through.
    external: &[External] = &[],
};

External := struct { irq: rp2350.irq.Number, handler: () -> () };

/// An exception or interrupt the program does not handle: it stops there.
unhandled := () {
    for {}
};

/// `h`, entered as the core enters a handler: the return code in `lr` is kept across the call, with
/// the stack kept to the 8 bytes the calling convention aligns it to.
wrapped := ($h: () -> ()) -> Handler {
    #[abi.naked] () -> never {
        unsafe {
            lang.arch.asm({
                ..lang.arch.thumb.names;
                push(r4, lr);
                bl(h);
                pop(r4, pc);
            });
            lang.hint.unreachable()
        }
    }
};

/// The vectors after the initial stack pointer: the core's 15 exceptions, then the chip's 52
/// interrupts.
vectors: usize = 67;
reset_vector: usize = 0;
systick_vector: usize = 14;
/// The vector of the chip's first interrupt.
external_first_vector: usize = 15;
/// The faults the core takes: hard (2), memory management, bus, usage and security (3 to 6).
fault_vectors: [5]usize = [2, 3, 4, 5, 6];

/// The vector table: the stack pointer the core starts with, then a handler per vector.
#[layout.c]
Table := struct {
    stack: *u32,
    handlers: [vectors]Handler,
};

/// The image definition block (datasheet, section 5.9): it marks the image as a secure Arm
/// executable, and ends the list of blocks.
image_def: [5]u32 = [0xffff_ded3, 0x1021_0142, 0x0000_01ff, 0, 0xab12_3579];

#[link.symbol("__ram_end")]
ram_end: u32 = _;
#[link.symbol("__data_start")]
data_start: u32 = _;
#[link.symbol("__data_end")]
data_end: u32 = _;
#[link.symbol("__data_load")]
data_load: u32 = _;
#[link.symbol("__bss_start")]
bss_start: u32 = _;
#[link.symbol("__bss_end")]
bss_end: u32 = _;

/// Taken by every fault, with the core's frame on the stack it runs on, which `record` is given.
fault_entry: Handler = #[abi.naked] () -> never {
    unsafe {
        lang.arch.asm({
            ..lang.arch.thumb.names;
            mov(r0, sp);
            bl(rp2350.fault.record);
        });
        lang.hint.unreachable()
    }
};

/// The table starting the stack at the end of SRAM, reset at `reset`, each interrupt at its
/// handler, and every other vector at `unhandled`.
table := ($config: Config, $reset: Handler) -> Table {
    mut handlers: [vectors]Handler = [wrapped(unhandled); vectors];
    handlers[reset_vector] = reset;
    for vector in fault_vectors {
        handlers[vector] = fault_entry;
    }
    handlers[systick_vector] = wrapped(config.interrupts.systick);
    $for external in config.interrupts.external {
        handlers[external_first_vector + external.irq] = wrapped(external.handler);
    }
    .{ .stack = lang.mem.pointer_to(u32, &ram_end), .handlers = handlers }
};

/// Copies `.data` from flash to SRAM and zeroes `.bss`, word by word, before anything reads them.
init_memory := unsafe () {
    unsafe {
        mut to := lang.mem.pointer_to(u32, &data_start);
        mut from := lang.mem.pointer_to(u32, &data_load);
        end := lang.mem.address(u32, lang.mem.pointer_to(u32, &data_end));
        for lang.mem.address(u32, to) < end {
            to.write(from.read());
            to = to.offset(1);
            from = from.offset(1);
        }
        mut zeroed := lang.mem.pointer_to(u32, &bss_start);
        last := lang.mem.address(u32, lang.mem.pointer_to(u32, &bss_end));
        for lang.mem.address(u32, zeroed) < last {
            zeroed.write(0);
            zeroed = zeroed.offset(1);
        }
    }
};

/// Stops the core, for a trap: waits for interrupts, forever. Nothing returns the device to the
/// host's bus then, so it suits a board a probe is attached to, which `rp2350.fault.trap` does not.
halt := (t: &lang.panic.Trap) -> never {
    for {
        unsafe lang.arch.asm({
            ..lang.arch.thumb.names;
            wfi();
        });
    }
};

start := ($config: Config) -> type { struct {
    #[link.section(".vectors"), link.export("__vectors")]
    vectors := table(config, reset);

    #[link.section(".embedded_block"), link.export("__embedded_block")]
    block := image_def;

    /// The first instruction run: the table gave it the stack, so it only has to call `boot`.
    #[link.export("Reset"), abi.naked]
    reset := () -> never {
        unsafe {
            lang.arch.asm({
                ..lang.arch.thumb.names;
                bl(boot);
            });
            lang.hint.unreachable()
        }
    };

    boot := () -> never {
        unsafe { init_memory(); }
        rp2350.core.enable_fpu();
        config.main(unsafe { Peripherals.claim() })
    };

    #[link.export(lang.panic.symbols.trap)]
    trap := config.trap;

    /// Masks interrupts, keeping `PRIMASK` as it was: one core, so the section is never
    /// contended and nests by restoring the mask.
    #[link.export(std.sync.symbols.enter), panic.never]
    enter := () -> std.sync.Mask {
        mut mask: usize = 0;
        unsafe lang.arch.asm({
            ..lang.arch.thumb.names;
            mrs(out(mask), primask);
            cpsid(i);
        });
        unsafe std.sync.Mask.of(mask, true)
    };

    #[link.export(std.sync.symbols.leave), panic.never]
    leave := (mask: std.sync.Mask) {
        if mask.bits() & 1 == 0 {
            unsafe lang.arch.asm({
                ..lang.arch.thumb.names;
                cpsie(i);
            });
        }
    };

    /// Waits for an interrupt.
    #[link.export(std.task.symbols.sleep)]
    sleep := () {
        unsafe lang.arch.asm({
            ..lang.arch.thumb.names;
            wfi();
        });
    };
} };
