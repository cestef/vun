//! The chip's 52 interrupts (datasheet, section 3.2), by their number in the vector table after
//! the core's exceptions, as `rp2350.runtime.Interrupts.external` and `rp2350.nvic` take them.

/// An interrupt's number.
Number: type = Int(0..52);

timer0_0: Number = 0;
timer0_1: Number = 1;
timer0_2: Number = 2;
timer0_3: Number = 3;
timer1_0: Number = 4;
timer1_1: Number = 5;
timer1_2: Number = 6;
timer1_3: Number = 7;
pwm_wrap_0: Number = 8;
pwm_wrap_1: Number = 9;
dma_0: Number = 10;
dma_1: Number = 11;
dma_2: Number = 12;
dma_3: Number = 13;
usb: Number = 14;
pio0_0: Number = 15;
pio0_1: Number = 16;
pio1_0: Number = 17;
pio1_1: Number = 18;
pio2_0: Number = 19;
pio2_1: Number = 20;
io_bank0: Number = 21;
io_bank0_ns: Number = 22;
io_qspi: Number = 23;
io_qspi_ns: Number = 24;
sio_fifo: Number = 25;
sio_bell: Number = 26;
sio_fifo_ns: Number = 27;
sio_bell_ns: Number = 28;
sio_mtimecmp: Number = 29;
clocks: Number = 30;
spi0: Number = 31;
spi1: Number = 32;
uart0: Number = 33;
uart1: Number = 34;
adc_fifo: Number = 35;
i2c0: Number = 36;
i2c1: Number = 37;
otp: Number = 38;
trng: Number = 39;
proc0_cti: Number = 40;
proc1_cti: Number = 41;
pll_sys: Number = 42;
pll_usb: Number = 43;
powman_pow: Number = 44;
powman_timer: Number = 45;
