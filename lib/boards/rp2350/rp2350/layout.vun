//! Where an RP2350 program lies: its memory map, and its sections placed in it, which a build
//! passes as a program's `memory` and `sections` (spec 12, section 2).

/// Flash, executed in place (4 MiB on a Pico 2), and the SRAM after it.
memory: &[std.build.Region] = &[
    .{ .name = .flash, .origin = 0x1000_0000, .len = 4 * 1024 * 1024 },
    .{ .name = .ram, .origin = 0x2000_0000, .len = 512 * 1024 },
];

/// The vector table first in flash, then the image definition, which the boot ROM finds within
/// the first 4 KiB, then code and constants; variables in SRAM, `.data` loaded from flash.
sections: &[std.build.Placement] = &[
    .{ .name = .vectors, .region = .flash },
    .{ .name = .embedded_block, .region = .flash },
    .{ .name = .text, .region = .flash },
    .{ .name = .rodata, .region = .flash },
    .{ .name = .data, .region = .ram, .load = .some(.flash) },
    .{ .name = .bss, .region = .ram },
];
