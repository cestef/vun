//! The boot ROM's functions (RP2350 datasheet, section 5.4): found by a code in its table, called
//! as C functions.

/// `rom_table_lookup`, whose address the ROM holds at `lookup_at` as 16 bits.
Lookup := #[abi.c] (code: u32, mask: u32) -> usize;

/// `reboot`: `flags` pick the way, `delay_ms` waits first, `p0` and `p1` are the way's own.
Reboot := #[abi.c] (flags: u32, delay_ms: u32, p0: u32, p1: u32) -> i32;

/// After the function table's pointer, at 0x14, in the ROM's header (the RP2040 kept it at 0x18, RISC-V
/// keeps it below the entry at 0x7dfc).
lookup_at := 0x16;

/// A function's code: its two letters, the first in the low byte.
code := (a: u8, b: u8) -> u32 { a.to(u32) | (b.to(u32) << 8).wrap(u32) };

/// The function table's flag for functions of Arm code in the secure state.
arm_secure: u32 = 1 << 2;

/// `reboot`'s way of restarting into the USB mass storage and PICOBOOT interfaces.
reboot_bootsel: u32 = 2;

/// `reboot`'s flag to wait for the restart rather than return.
no_return_on_success: u32 = 0x100;

/// Calls the ROM's `reboot`, returning what it returns where it does.
reboot := (flags: u32, delay_ms: u32, p0: u32, p1: u32) -> i32 {
    lookup := unsafe {
        half := lang.mem.pointer_at(u16, lookup_at).read();
        lang.mem.function_at(Lookup, half.to(usize))
    };
    found := lookup(code('R', 'B'), arm_secure);
    call := unsafe { lang.mem.function_at(Reboot, found) };
    call(flags, delay_ms, p0, p1)
};

/// Restarts the chip into BOOTSEL mode, where it takes a new program over USB.
bootsel := () -> never {
    reboot(reboot_bootsel | no_return_on_success, 10, 0, 0);
    for {}
};
