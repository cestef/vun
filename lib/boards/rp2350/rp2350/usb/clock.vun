//! The clocks the USB controller needs (datasheet, chapters 8 and 12.7): 48 MHz for its bus
//! logic, from the USB PLL, and a system clock at least as fast, since the program and the
//! controller exchange packets through memory on it. The system clock is 150 MHz from the system
//! PLL; the peripherals keep the crystal's 12 MHz, which the UART's rate is counted in.

/// A PLL: where its registers are, and its bit in the reset controller.
Pll := struct {
    base: usize,
    reset: u32,

    /// Starts it, the crystal's 12 MHz times `multiplier`, divided by the two post dividers
    /// `first` and `second`.
    start := (self: &Pll, multiplier: u32, first: u32, second: u32) {
        resets := unsafe std.hw.at(std.hw.Reg(u32), rp2350.gpio.resets);
        done := unsafe std.hw.at(std.hw.Reg(u32), rp2350.gpio.resets + rp2350.gpio.reset_done_offset);
        resets.write(resets.read() | self.reset);
        resets.write(resets.read() & ~self.reset);
        for done.read() & self.reset != self.reset {}
        self.register(control).write(refdiv);
        self.register(feedback).write(multiplier);
        power := self.register(power_offset);
        power.write(power.read() & ~(down | vco_down));
        for self.register(control).read() & locked == 0 {}
        self.register(post).write((first << 16) | (second << 12));
        power.write(power.read() & ~post_down);
    };

    register := (self: &Pll, offset: Int(0..16)) -> &std.hw.Reg(u32) {
        unsafe std.hw.at(std.hw.Reg(u32), (self.base + offset).wrap(usize))
    };
};

control := 0x0;
power_offset := 0x4;
feedback := 0x8;
post := 0xc;
refdiv: u32 = 1;
locked: u32 = 1 << 31;
/// The power bits a running PLL has clear: the PLL, its oscillator and its post dividers.
down: u32 = 1;
vco_down: u32 = 1 << 5;
post_down: u32 = 1 << 3;

pll_sys: Pll = .{ .base = 0x4005_0000, .reset = 1 << 14 };
pll_usb: Pll = .{ .base = 0x4005_8000, .reset = 1 << 15 };

clk_sys_ctrl := 0x3c;
clk_sys_selected := 0x44;
clk_peri_ctrl := 0x48;
clk_usb_ctrl := 0x60;
clk_usb_div := 0x64;
clk_enable: u32 = 1 << 11;
/// The system clock's source is the auxiliary one (the system PLL, its first choice), and the
/// switch is done when its selected-source register shows it, in its second bit.
clk_sys_aux: u32 = 1;
clk_sys_switched: u32 = 1 << 1;
/// The peripheral clock's first auxiliary source is the system clock, its fifth the crystal.
clk_peri_crystal: u32 = 4 << 5;
clk_div_one: u32 = 1 << 16;

/// Runs the system clock at 150 MHz, and the peripheral clock from the crystal as it was.
run_system_fast := () {
    rp2350.clocks.at(rp2350.clocks.clocks + clk_peri_ctrl).write(0);
    rp2350.clocks.at(rp2350.clocks.clocks + clk_peri_ctrl).write(clk_enable | clk_peri_crystal);
    // 12 MHz x 125 = 1500 MHz, divided by 5 and by 2.
    pll_sys.start(125, 5, 2);
    rp2350.clocks.at(rp2350.clocks.clocks + clk_sys_ctrl).write(0);
    rp2350.clocks.at(rp2350.clocks.clocks + clk_sys_ctrl).write(clk_sys_aux);
    for rp2350.clocks.at(rp2350.clocks.clocks + clk_sys_selected).read() & clk_sys_switched == 0 {}
};

/// Runs the USB clock at 48 MHz: 12 MHz x 100 = 1200 MHz, divided by 5 and by 5.
run_usb := () {
    pll_usb.start(100, 5, 5);
    rp2350.clocks.at(rp2350.clocks.clocks + clk_usb_ctrl).write(0);
    rp2350.clocks.at(rp2350.clocks.clocks + clk_usb_div).write(clk_div_one);
    rp2350.clocks.at(rp2350.clocks.clocks + clk_usb_ctrl).write(clk_enable);
};

/// The clocks: the crystal is started if no one has, and left alone if someone has, since the
/// system runs from it while it is restarted.
run := () {
    status := rp2350.clocks.at(rp2350.clocks.xosc + rp2350.clocks.xosc_status);
    if status.read() & rp2350.clocks.xosc_stable == 0 {
        rp2350.clocks.run_from_crystal();
    }
    run_system_fast();
    run_usb();
};
