//! STM32F4 runtime: the vector table the core starts from, the reset handler laying memory out and
//! calling the program's `main`, the peripherals, and the chip's memory map.

..stm32f4.runtime;

/// The target of the chip's processor, a Cortex-M4 with its floating-point unit.
target := targets.bare.thumbv7em.eabihf;
