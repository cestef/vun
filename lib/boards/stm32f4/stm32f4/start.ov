//! Builds the program's exports at compile time (spec 08, section 2).

Config := struct {
    main: (p: Peripherals) -> never,
    trap: (t: &lang.panic.Trap) -> never,
    interrupts: Interrupts,
};

/// The device's peripherals, claimed once at reset.
Peripherals := struct {
    claim := unsafe () -> Peripherals { .{} };
};

/// Interrupt handlers by vector.
Interrupts := struct {};

vector_table := ($interrupts: Interrupts) -> [_]usize { [] };

/// Copies `.data` and zeroes `.bss`; provided by the startup object.
#[link.symbol("__init_memory")]
init_memory: unsafe () = _;

start := ($config: Config) -> type { struct {
    #[link.section(".vectors"), link.export("__vectors")]
    vectors := vector_table(config.interrupts);

    #[link.export("Reset")]
    reset := () -> never {
        unsafe { init_memory(); }
        config.main(unsafe { Peripherals.claim() })
    };

    #[link.export(lang.panic.trap_symbol)]
    trap := config.trap;
}};
