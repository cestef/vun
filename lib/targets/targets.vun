//! Target descriptions, each at a path of one rule: `targets.<os>.<arch>.<abi>`, such as
//! `targets.linux.x86_64.kernel` or `targets.bare.thumbv7em.eabihf`. A system is a namespace, an
//! architecture a namespace in it (on bare metal, which has no baseline machine, an instruction
//! set profile), and each target in it is an ABI. What targets share is declared here once: the
//! backends each builds with, the C backend's flags, the C compilers, and the C models.

/// The targets a build is for unless told otherwise: the first whose `arch` and `os` are the
/// machine running the toolchain's.
hosts := .{
    targets.linux.x86_64.kernel,
    targets.linux.arm64.kernel,
    targets.linux.riscv64.gnu,
    targets.macos.arm64.darwin,
};

/// The flags giving the C backend's rules (spec 13, section 8.2): strict C99, freestanding C,
/// memory without type-based aliasing, and a frame pointer in every function, the chain a
/// backtrace walks (spec 07, section 3).
c_flags: &[&[u8]] = &["-std=c99", "-ffreestanding", "-fno-strict-aliasing", "-fno-omit-frame-pointer"];

/// The flags a release build adds for a GCC or Clang driver.
c_optimize: &[&[u8]] = &["-O2"];

/// A GCC or Clang driver, run as `command`, building for the machine `builds_for` says, beside
/// the `archiver` of its tools: `machine` selects the target machine (instruction set,
/// floating-point ABI) in every compile and link, which also picks the libraries built for it,
/// and its links take `link_flags` and, after the objects, `libraries`.
gnu := (
    $command: &[u8],
    $builds_for: lang.target.BuildsFor,
    $archiver: &[u8],
    $machine: &[&[u8]],
    $link_flags: &[&[u8]],
    $libraries: &[&[u8]]
) -> lang.target.CCompiler {
    .{
        .command = command,
        .builds_for = builds_for,
        .archiver = archiver,
        .flags = c_flags ++ machine,
        .optimize = c_optimize,
        .link_flags = machine ++ link_flags,
        .libraries = libraries,
        .atomics = .gnu,
        .attributes = .gnu,
        .frame_sizes = .stack_usage,
    }
};

/// The backends of a target the native backend generates code for: it for debug builds, and C
/// wherever the others are missing.
native_first: lang.target.Backends = .{ .debug = &[.native, .cranelift, .c], .release = &[.llvm, .c] };

/// The backends of a target reached through C: Cranelift or LLVM first, C wherever they are
/// missing.
through_c: lang.target.Backends = .{ .debug = &[.cranelift, .c], .release = &[.llvm, .c] };

/// The C types where `long` and addresses are 64 bits (LP64), built by `compiler`.
lp64 := ($compiler: lang.target.CCompiler) -> lang.target.C {
    .{
        .short = .{ .bits = 16, .align = 2 },
        .int = .{ .bits = 32, .align = 4 },
        .long = .{ .bits = 64, .align = 8 },
        .long_long = .{ .bits = 64, .align = 8 },
        .pointer_align = 8,
        .compiler = compiler,
    }
};

/// The C types where `int`, `long` and addresses are 32 bits (ILP32), built by `compiler`.
ilp32 := ($compiler: lang.target.CCompiler) -> lang.target.C {
    .{
        .short = .{ .bits = 16, .align = 2 },
        .int = .{ .bits = 32, .align = 4 },
        .long = .{ .bits = 32, .align = 4 },
        .long_long = .{ .bits = 64, .align = 8 },
        .pointer_align = 4,
        .compiler = compiler,
    }
};
