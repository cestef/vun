//! Apple silicon (64-bit ARM), Armv8.5 and later.

darwin := lang.target.Spec{
    .arch = .arm64,
    .isa = .arm64,
    .features = &[.lse],
    .cpu = .generic,
    .os = .macos,
    .abi = .darwin,
    .convention = .darwin_arm64,
    .pointer_bits = 64,
    .register_bits = 64,
    .floats = &[f32, f64],
    .vector_bits = 128,
    .threads = .many,
    .endian = .little,
    .object_format = .macho,
    .entry_symbol = .some("_main"),
    .os_version = .some(targets.macos._apple_silicon),
    .backends = targets.native_first,
    .linker = .lld,
    .c = targets.lp64(targets.macos._clang(&["--target=arm64-apple-macos"])),
};
