//! macOS.

/// Apple silicon (64-bit ARM).
arm64 := lang.target.Spec{
    .arch = .arm64,
    .cpu = .generic,
    .os = .macos,
    .abi = .darwin,
    .pointer_bits = 64,
    .endian = .little,
    .object_format = .macho,
    .entry_symbol = .some("_main"),
    .default_backend = .cranelift,
    .default_linker = .lld,
    .c = targets.lp64(targets.gnu("clang", &[])),
};
