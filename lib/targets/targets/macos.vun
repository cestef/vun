//! macOS.

/// Apple silicon (64-bit ARM).
arm64 := lang.target.Spec{
    .arch = .arm64,
    .isa = .arm64,
    .cpu = .generic,
    .os = .macos,
    .abi = .darwin,
    .convention = .darwin_arm64,
    .pointer_bits = 64,
    .register_bits = 64,
    .floats = &[f32, f64],
    .endian = .little,
    .object_format = .macho,
    .entry_symbol = .some("_main"),
    .backends = targets.native_first,
    .linker = .lld,
    .c = targets.lp64(targets.gnu("clang", "ar", &[], &[], &[])),
};
