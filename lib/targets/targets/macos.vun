//! macOS.

/// Apple silicon (64-bit ARM).
arm64 := lang.target.Spec{
    .arch = .arm64,
    .cpu = .generic,
    .os = .macos,
    .abi = .darwin,
    .pointer_bits = 64,
    .endian = .little,
    .object_format = .macho,
    .entry_symbol = .some("_main"),
    .default_backend = .cranelift,
    .default_linker = .lld,
    .c = lang.target.C{
        .short = .{ .bits = 16, .align = 2 },
        .int = .{ .bits = 32, .align = 4 },
        .long = .{ .bits = 64, .align = 8 },
        .long_long = .{ .bits = 64, .align = 8 },
        .pointer_align = 8,
    },
};
