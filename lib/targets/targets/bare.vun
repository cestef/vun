//! Bare metal: no system; a program brings its own runtime (spec 08), links without the C
//! runtime, and starts at its reset handler.

/// A 32-bit bare-metal target of `arch` and `cpu`, its code in the instruction set `isa`,
/// following `abi` and calling C by `convention`, its processor computing `floats`, built with
/// `command` and `archiver` for the machine its `machine` flags select.
_on := (
    $arch: lang.meta.Name,
    $isa: lang.meta.Name,
    $cpu: lang.meta.Name,
    $abi: lang.meta.Name,
    $convention: lang.target.Convention,
    $floats: &[type],
    $command: &[u8],
    $archiver: &[u8],
    $machine: &[&[u8]],
) -> lang.target.Spec {
    .{
        .arch = arch,
        .isa = isa,
        .cpu = cpu,
        .os = .bare,
        .abi = abi,
        .convention = convention,
        .pointer_bits = 32,
        .register_bits = 32,
        .floats = floats,
        .endian = .little,
        .object_format = .elf,
        .entry_symbol = .some("Reset"),
        .backends = targets.through_c,
        .linker = .lld,
        .c = targets.ilp32(targets.gnu(command, archiver, machine, &["-nostdlib", "-nostartfiles"])),
    }
};

/// ARM Cortex-M4 with its floating-point unit (Thumb-2, hard-float EABI).
cortex_m4f := _on(
    .arm,
    .thumb,
    .cortex_m4f,
    .eabihf,
    .aapcs_vfp,
    &[f32],
    "arm-none-eabi-gcc",
    "arm-none-eabi-ar",
    &["-mcpu=cortex-m4", "-mthumb", "-mfloat-abi=hard", "-mfpu=fpv4-sp-d16"],
);
/// ARM Cortex-M3, without a floating-point unit (Thumb-2, soft-float EABI).
cortex_m3 := _on(
    .arm,
    .thumb,
    .cortex_m3,
    .eabi,
    .aapcs,
    &[],
    "arm-none-eabi-gcc",
    "arm-none-eabi-ar",
    &["-mcpu=cortex-m3", "-mthumb", "-mfloat-abi=soft"],
);
/// 32-bit RISC-V with multiplication and compressed instructions (RV32IMC).
rv32imc := _on(
    .riscv32,
    .riscv32,
    .rv32imc,
    .ilp32,
    .ilp32,
    &[],
    "riscv32-unknown-elf-gcc",
    "riscv32-unknown-elf-ar",
    &["-march=rv32imc", "-mabi=ilp32"],
);
