//! Bare metal: no system and no baseline machine, so a namespace per instruction set profile
//! (`thumbv7em`, as Arm names it), holding a target per ABI. A program brings its own runtime
//! (spec 08), links without the C runtime but with the compiler's helpers (`libgcc`), through its
//! C compiler's linker, which places its sections in the memory its build declares, and starts
//! at its reset handler. A board names the target of its processor (`stm32f4.target`).

/// A 32-bit bare-metal target of `arch`, its code in the instruction set `isa`, of which it has
/// `features`, following `abi` and calling C by `convention`, its processor computing `floats`,
/// built with `command` and `archiver` for the machine its `machine` flags select.
#[visible(.within(targets.bare))]
_on := (
    $arch: lang.meta.Name,
    $isa: lang.meta.Name,
    $features: &[lang.meta.Name],
    $abi: lang.meta.Name,
    $convention: lang.target.Convention,
    $floats: &[type],
    $command: &[u8],
    $archiver: &[u8],
    $machine: &[&[u8]],
) -> lang.target.Spec {
    .{
        .arch = arch,
        .isa = isa,
        .features = features,
        .cpu = .generic,
        .os = .bare,
        .abi = abi,
        .convention = convention,
        .pointer_bits = 32,
        .register_bits = 32,
        .floats = floats,
        .endian = .little,
        .object_format = .elf,
        .entry_symbol = .some("Reset"),
        .backends = targets.through_c,
        .linker = .gnu,
        // Without the C library, but with the compiler's own helpers its code calls, such as
        // 64-bit division on a 32-bit core.
        .c = targets.ilp32(targets.gnu(command, .target, archiver, machine, &["-nostdlib", "-nostartfiles"], &["gcc"])),
    }
};
