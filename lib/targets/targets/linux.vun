//! Linux, with the GNU C library.

/// A 64-bit Linux target of `arch`, built with the system's C compiler.
_on := ($arch: lang.meta.Name) -> lang.target.Spec {
    .{
        .arch = arch,
        .cpu = .generic,
        .os = .linux,
        .abi = .gnu,
        .pointer_bits = 64,
        .endian = .little,
        .object_format = .elf,
        .entry_symbol = .some("_start"),
        .default_backend = .cranelift,
        .default_linker = .gnu,
        .c = targets.lp64(targets.gnu("cc", &[])),
    }
};

/// 64-bit x86.
x86_64 := _on(.x86_64);
/// 64-bit ARM (AArch64).
arm64 := _on(.arm64);
/// 64-bit RISC-V with the general extensions (RV64GC).
riscv64 := _on(.riscv64);
