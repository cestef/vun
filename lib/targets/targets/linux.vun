//! Linux. A target per CPU builds static programs that call the kernel themselves, with no C
//! library; `gnu` holds the targets of programs on the GNU C library (`linux.gnu.x86_64`), which
//! calling C needs.

/// A 64-bit Linux target of `arch` following `abi`, calling C by `convention`, built with the
/// system's C compiler, given `machine` when compiling and linking and `link_flags` when linking.
#[visible(.within(targets.linux))]
_on := (
    $arch: lang.meta.Name,
    $convention: lang.target.Convention,
    $abi: lang.meta.Name,
    $machine: &[&[u8]],
    $link_flags: &[&[u8]],
) -> lang.target.Spec {
    .{
        .arch = arch,
        .isa = arch,
        .cpu = .generic,
        .os = .linux,
        .abi = abi,
        .convention = convention,
        .pointer_bits = 64,
        .endian = .little,
        .object_format = .elf,
        .entry_symbol = .some("_start"),
        .backends = targets.native_first,
        .linker = .gnu,
        .c = targets.lp64(targets.gnu("cc", "ar", machine, link_flags)),
    }
};

/// A static target of `arch`, compiled with `machine`: linked without the C library's start
/// files and library, keeping the C compiler's own (`libgcc`: 128-bit division), its program
/// started by `std.os.linux.kernel`.
_kernel := ($arch: lang.meta.Name, $convention: lang.target.Convention, $machine: &[&[u8]]) -> lang.target.Spec {
    _on(arch, convention, .kernel, machine, &["-static", "-nostartfiles", "-nolibc"])
};

/// 64-bit x86.
x86_64 := _kernel(.x86_64, .sysv, &[]);
/// 64-bit ARM (AArch64). Atomics are inline instructions: the C compiler's out-of-line ones
/// choose between forms by asking the C library what the CPU has.
arm64 := _kernel(.arm64, .aapcs64, &["-mno-outline-atomics"]);
