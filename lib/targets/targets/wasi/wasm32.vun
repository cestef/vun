//! 32-bit WebAssembly.

/// Preview 1.
p1 := lang.target.Spec{
    .arch = .wasm32,
    .isa = .wasm32,
    .cpu = .generic,
    .os = .wasi,
    .abi = .p1,
    .convention = .wasm32,
    .pointer_bits = 32,
    .register_bits = 64,
    .floats = &[f32, f64],
    .features = &[.sign_extension, .saturating_conversion, .bulk_memory, .atomics, .simd128],
    .endian = .little,
    .object_format = .wasm,
    .entry_symbol = .some("_start"),
    .backends = .{ .debug = &[.wasm, .llvm], .release = &[.llvm, .wasm] },
    .linker = .wasm,
    .c = targets.ilp32(targets.gnu("clang", .target, "llvm-ar", &["--target=wasm32-wasi"], &[], &[])),
};
