//! 32-bit x86 Windows. Its programs link `ntdll` too, which defines what its C compiler calls for:
//! the division of 64-bit integers (`_aulldiv` and the like), the probe of a large frame
//! (`_chkstk`), and the copies and fills.

msvc := lang.target.Spec{
    .arch = .x86,
    .isa = .x86,
    .cpu = .generic,
    .os = .windows,
    .abi = .msvc,
    .convention = .cdecl,
    .pointer_bits = 32,
    // Its C compiler computes 64-bit integers in pairs of registers and reaches them atomically
    // (`cmpxchg8b`), as wasm32's computes them with 32-bit addresses.
    .register_bits = 64,
    .floats = &[f32, f64],
    .threads = .one,
    .endian = .little,
    .object_format = .coff,
    .entry_symbol = .some("mainCRTStartup"),
    .backends = targets.c_only,
    .linker = .lld,
    .c = targets.ilp32(targets.windows._clang(&["--target=i686-pc-windows-msvc"], &["kernel32", "ntdll"])),
};
