//! 64-bit x86 Windows.

msvc := lang.target.Spec{
    .arch = .x86_64,
    .isa = .x86_64,
    .cpu = .generic,
    .os = .windows,
    .abi = .msvc,
    .convention = .win64,
    .accepts = &[.cdecl, .stdcall, .fastcall, .thiscall],
    .pointer_bits = 64,
    .register_bits = 64,
    .floats = &[f32, f64],
    .vector_bits = 128,
    .threads = .one,
    .endian = .little,
    .object_format = .coff,
    .entry_symbol = .some("mainCRTStartup"),
    .backends = targets.c_only,
    .linker = .lld,
    .c = targets.llp64(targets.windows._clang(&["--target=x86_64-pc-windows-msvc"], &["kernel32"])),
};
